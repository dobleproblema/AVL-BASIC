10 REM Fixed Unicode buffers: editing, searching, comparison and reconstruction.
20 BENCHSTART=TIME
30 PASSES=10000
40 DIM ORIGINAL$(4),RESULT$(4)
50 SEED$="aéΩñ"
60 WHILE LEN(SEED$)<2048 : SEED$=SEED$+SEED$ : WEND
70 FOR K=1 TO 4 : ORIGINAL$(K)=LEFT$(SEED$,32*4^(K-1)) : NEXT K
80 TOTAL=0 : CHANGES=0
90 FOR PASS=1 TO PASSES
100 FOR K=1 TO 4
110 T$=ORIGINAL$(K) : N=LEN(T$)
120 POSITION=2+(PASS*17 MOD (N-5))
130 MID$(T$,POSITION,3)="ñΩé"
140 T$=LEFT$(T$,POSITION-1)+MID$(T$,POSITION,3)+RIGHT$(T$,N-POSITION-2)
150 TOTAL=TOTAL+INSTR(T$,"ñΩé")+INSTR(T$,"xyz")+ASC(MID$(T$,POSITION,1))+LEN(T$)
160 IF T$<>ORIGINAL$(K) THEN CHANGES=CHANGES+1
170 RESULT$(K)=T$
180 NEXT K
190 NEXT PASS
200 PRINT "UNICODE";CHANGES;TOTAL
210 FOR K=1 TO 4 : PRINT RESULT$(K) : NEXT K
220 PRINT "__BENCH_SECONDS__";TIME-BENCHSTART
230 END
