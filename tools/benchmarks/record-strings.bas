10 REM Deterministic record parsing, string arrays, normalization and formatting.
20 BENCHSTART=TIME
30 RECORDS=256 : PASSES=1000
40 DIM RECORD$(RECORDS),KEY$(RECORDS)
50 FOR I=1 TO RECORDS
60 RECORD$(I)="  Item-"+RIGHT$("0000"+TRIM$(STR$(I)),4)+" | Group-"+TRIM$(STR$(I MOD 17))+" | "+TRIM$(STR$(I*7))+"  "
70 NEXT I
80 TOTAL=0 : MATCHES=0
90 FOR PASS=1 TO PASSES
100 FOR I=1 TO RECORDS
110 TEXTROW$=TRIM$(RECORD$(I))
120 SEP=INSTR(TEXTROW$,"|") : SEP2=INSTR(SEP+1,TEXTROW$,"|")
130 NAME$=UPPER$(TRIM$(LEFT$(TEXTROW$,SEP-1)))
140 GROUP$=LOWER$(TRIM$(MID$(TEXTROW$,SEP+1,SEP2-SEP-1)))
150 AMOUNT=VAL(TRIM$(MID$(TEXTROW$,SEP2+1)))
160 KEY$(I)=NAME$+":"+GROUP$+":"+RIGHT$("000000"+TRIM$(STR$(AMOUNT)),6)
170 TOTAL=TOTAL+LEN(KEY$(I))+AMOUNT+ASC(MID$(KEY$(I),6,1))
180 IF LEFT$(KEY$(I),4)="ITEM" AND INSTR(KEY$(I),"group-")>0 THEN MATCHES=MATCHES+1
190 NEXT I
200 NEXT PASS
210 PRINT "RECORDS";MATCHES;TOTAL
220 FOR I=1 TO RECORDS : PRINT KEY$(I) : NEXT I
230 PRINT "__BENCH_SECONDS__";TIME-BENCHSTART
240 END
