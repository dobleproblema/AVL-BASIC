10 REM Held-out matrix composition, transpose, inverse and scalar array reads.
20 BENCHSTART=TIME
30 REPEATS=30000
40 MAT BASE 1
50 DIM A(3,3),V(3,1)
60 MAT READ A : MAT READ V
70 DATA 2,0.25,0,0,1.5,0.125,0.1,0,1
80 DATA 1,2,3
90 TOTAL=0
100 FOR PASS=1 TO REPEATS
110 MAT B=INV(A)
120 MAT C=A*B
130 MAT D=TRN(C)
140 MAT E=D*V
150 TOTAL=TOTAL+E(1,1)+2*E(2,1)+3*E(3,1)
160 NEXT PASS
170 PRINT "MATRICES";REPEATS;TOTAL
180 MAT PRINT USING "##.########";B;C;D;E
190 PRINT "__BENCH_SECONDS__";TIME-BENCHSTART
200 END
