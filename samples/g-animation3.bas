100 REM Offline cloth animation: 120 physically simulated satin frames at 30 FPS.
110 REM Generate the PNGs with g-cloth-render.bas; stop at the last frame, R replays.
120 SCREEN : MODE 800 : PAPER 0 : CLG : SMALLFONT TRANSPARENT
130 F=119 : FRATE=30 : DIM GR$(F)
140 INK RGB(235,240,255) : LOCATE 3,2 : GPRINT "LOADING CLOTH ANIMATION..." : FRAME
150 FOR I=0 TO F
160 BLOAD "assets/cloth/frame-"+RIGHT$("000"+STR$(I),3)+".png",GR$(I)
170 NEXT I
180 PT=0 : PAUSED=0 : FINISHED=0 : CAP=1 : FPS=0 : COUNT=0 : TLAST=TIME : TSIM=TIME
190 REM A real-time playback clock preserves motion speed when the cap is disabled.
200 TNOW=TIME : DT=MAX(0,TNOW-TSIM) : TSIM=TNOW
210 IF PAUSED=0 AND FINISHED=0 THEN PT=MIN(PT+DT,(F+1)/FRATE)
220 IF PT>=(F+1)/FRATE THEN FINISHED=1
225 REM Compose the image and HUD in the buffer; FRAME presents them together.
230 I=MIN(F,INT(PT*FRATE)) : SCREEN GR$(I)
240 INK RGB(235,240,255) : LOCATE 3,2 : GPRINT "AVL CLOTH - OFFLINE ANIMATION  ";USING "###.0";FPS;" FPS"
250 CP$="OFF" : IF CAP THEN CP$="ON"
260 PS$="" : IF PAUSED THEN PS$="  [PAUSED]"
270 IF FINISHED THEN PS$="  [FINISHED]"
280 LOCATE 3,HEIGHT\16-2 : GPRINT "SPACE: PAUSE  R: REPLAY  C: CAP ";CP$;"  ESC: EXIT";PS$
290 IF CAP THEN FRAME FRATE ELSE FRAME
300 COUNT=COUNT+1 : TNOW=TIME
310 IF TNOW-TLAST>=.5 THEN FPS=COUNT/(TNOW-TLAST) : COUNT=0 : TLAST=TNOW
320 K$=UPPER$(INKEY$)
330 IF K$=CHR$(27) THEN SCREEN CLOSE : END
340 IF K$=" " AND FINISHED=0 THEN PAUSED=1-PAUSED
350 IF K$="R" THEN PT=0 : PAUSED=0 : FINISHED=0 : TSIM=TIME
360 IF K$="C" THEN CAP=1-CAP : COUNT=0 : TLAST=TIME
370 GOTO 200

