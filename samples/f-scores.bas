10 ' Save scores as CSV, then read them back. Replaces f-scores.csv.
20 F$="f-scores.csv"
30 OPEN F$ FOR OUTPUT AS #1
40 WRITE #1,"PLAYER ONE",1250
50 WRITE #1,"PLAYER TWO",980
60 CLOSE #1
70 OPEN F$ FOR APPEND AS #1
80 WRITE #1,"PLAYER THREE",1420
90 CLOSE #1
100 PRINT "SAVED SCORES"
110 OPEN F$ FOR INPUT AS #1
120 WHILE NOT EOF(1)
130 INPUT #1,N$,S : PRINT N$;TAB(18);S
140 WEND
150 CLOSE #1
