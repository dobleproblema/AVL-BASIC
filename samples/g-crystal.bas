9130 IF EVIMPACT OR EVBREAK>0 THEN GOSUB 9500
9132 EVCORE=0 : IF COREPRIOR AND COREAWARDED=0 THEN COREAWARDED=1:COREBANNER=T+3:CORESHOTS=MAXSHOTS-SHOTS:EVCORE=1
