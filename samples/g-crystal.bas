5070 OLDX(P)=X(P):OLDY(P)=Y(P):OLDZ(P)=Z(P)
5080 X(P)=X(P)+PVX:Y(P)=Y(P)+PVY-PG:Z(P)=Z(P)+PVZ
5090 PDAMAGE(P)=MAX(0,PDAMAGE(P)-H*0.04)
5110 NEXT P
5120 FOR PIT=1 TO PITER
5130 FOR E=0 TO NE-1
5140 IF ACTIVE(E)=0 THEN GOTO 5260
5150 PA=EA(E):PB=EB(E):PWT=IM(PA)+IM(PB):IF PWT=0 THEN GOTO 5260
5160 PDX=X(PB)-X(PA):PDY=Y(PB)-Y(PA):PDZ=Z(PB)-Z(PA):PL=SQR(PDX*PDX+PDY*PDY+PDZ*PDZ)
5170 IF PL<0.00001 THEN GOTO 5260
5180 PS=ABS(PL-EL(E))/EL(E):STRAIN(E)=MAX(PS,STRAIN(E)*0.93)
5184 PFAIL=0.045*(1-0.7*MAX(PDAMAGE(PA),PDAMAGE(PB)))
5186 IF PA=CORE OR PB=CORE THEN PFAIL=PFAIL*0.65
5190 IF PS>PFAIL AND PSTIME>0.35 THEN GOSUB 5900:GOTO 5260
5200 PC=(PL-EL(E))/PL/PWT*0.88
5210 X(PA)=X(PA)+PDX*PC*IM(PA):Y(PA)=Y(PA)+PDY*PC*IM(PA):Z(PA)=Z(PA)+PDZ*PC*IM(PA)
5220 X(PB)=X(PB)-PDX*PC*IM(PB):Y(PB)=Y(PB)-PDY*PC*IM(PB):Z(PB)=Z(PB)-PDZ*PC*IM(PB)
5260 NEXT E
5270 FOR P=0 TO NP-1
5280 IF IM(P)=0 OR Y(P)>=0.25+NR(P) THEN GOTO 5320
5285 PVY=Y(P)-OLDY(P):IF LANDED(P)=0 AND PVY<-3.0*H THEN GOSUB 5940
5290 Y(P)=0.25+NR(P):OLDY(P)=Y(P)+MIN(0,PVY)*0.12
5300 OLDX(P)=X(P)-(X(P)-OLDX(P))*0.72:OLDZ(P)=Z(P)-(Z(P)-OLDZ(P))*0.72
5320 NEXT P
5330 NEXT PIT
5332 FALLEN=0:NMOBILE=0:PHDROP=0:PHREST=0
5334 FOR P=0 TO NP-1
5336 IF IM(P)>0 THEN NMOBILE=NMOBILE+1:PHDROP=PHDROP+MAX(0,RY(P)-Y(P)):PHREST=PHREST+RY(P)-0.25-NR(P):IF RY(P)-Y(P)>=1.5 THEN FALLEN=FALLEN+1
5338 NEXT P
5340 DEMOLITION=FALLEN/MAX(1,NMOBILE):HEIGHTLOSS=PHDROP/MAX(1,PHREST):MOBILE=NMOBILE:IF Y(CORE)<1.05 THEN COREPRIOR=1
5342 IF WON=0 AND DEMOLITION>=0.68 AND HEIGHTLOSS>=0.58 THEN WON=1:EVWIN=1
5350 RETURN
5500 REM Continuous projectile/edge contact: closest points on two segments.
5510 PBOXX=BX:PBOXY=BY:PBOXZ=BZ
5520 BVY=BVY-1.2*H:BX=BX+BVX*H:BY=BY+BVY*H:BZ=BZ+BVZ*H:BTTL=BTTL-H
5530 IF BTTL<=0 OR ABS(BX)>35 OR ABS(BZ)>35 THEN BACTIVE=0:RETURN
5540 PUX=BX-PBOXX:PUY=BY-PBOXY:PUZ=BZ-PBOXZ:PU2=PUX*PUX+PUY*PUY+PUZ*PUZ:PHIT=-1:PBEST=2
5550 FOR E=0 TO NE-1
5560 IF ACTIVE(E)=0 THEN GOTO 5740
5570 PA=EA(E):PB=EB(E)
5580 IF BX<MIN(X(PA),X(PB))-0.9 OR BX>MAX(X(PA),X(PB))+0.9 THEN GOTO 5740
5590 IF BY<MIN(Y(PA),Y(PB))-0.9 OR BY>MAX(Y(PA),Y(PB))+0.9 THEN GOTO 5740
5600 IF BZ<MIN(Z(PA),Z(PB))-0.9 OR BZ>MAX(Z(PA),Z(PB))+0.9 THEN GOTO 5740
5610 PVX=X(PB)-X(PA):PVY=Y(PB)-Y(PA):PVZ=Z(PB)-Z(PA):PV2=PVX*PVX+PVY*PVY+PVZ*PVZ:IF PV2<0.00001 THEN GOTO 5740
5620 PWX=PBOXX-X(PA):PWY=PBOXY-Y(PA):PWZ=PBOXZ-Z(PA)
5630 PUV=PUX*PVX+PUY*PVY+PUZ*PVZ:PUW=PUX*PWX+PUY*PWY+PUZ*PWZ:PVW=PVX*PWX+PVY*PWY+PVZ*PWZ:PDEN=PU2*PV2-PUV*PUV
5640 PSHOT=0:IF PDEN>1E-10 THEN PSHOT=MAX(0,MIN(1,(PUV*PVW-PV2*PUW)/PDEN))
5650 PT=MAX(0,MIN(1,(PUV*PSHOT+PVW)/PV2))
5660 PSHOT=MAX(0,MIN(1,(PUV*PT-PUW)/MAX(1E-10,PU2))):PT=MAX(0,MIN(1,(PUV*PSHOT+PVW)/PV2))
5670 PDX=PWX+PUX*PSHOT-PVX*PT:PDY=PWY+PUY*PSHOT-PVY*PT:PDZ=PWZ+PUZ*PSHOT-PVZ*PT
5680 IF PDX*PDX+PDY*PDY+PDZ*PDZ>0.28 THEN GOTO 5740
5690 IF PSHOT<PBEST THEN PHIT=E:PBEST=PSHOT
5740 NEXT E
5745 GOSUB 6200
5750 IF PHIT>=0 THEN EVENTX=PBOXX+PUX*PBEST:EVENTY=PBOXY+PUY*PBEST:EVENTZ=PBOXZ+PUZ*PBEST:GOSUB 5800:RETURN
5760 IF BY<0.45 THEN EVENTX=BX:EVENTY=0.3:EVENTZ=BZ:EVIMPACT=EVIMPACT+1:BACTIVE=0
5770 RETURN
5800 REM A resonant shock weakens nearby crystal; only strained bonds fracture.
5810 BACTIVE=0:HITCOUNT=HITCOUNT+1:EVIMPACT=EVIMPACT+1:PBVL=SQR(BVX*BVX+BVY*BVY+BVZ*BVZ):PBVL=MAX(1,PBVL):PHITX=EVENTX:PHITY=EVENTY:PHITZ=EVENTZ
5812 PWK=-1:PWKD=0.75*0.75
5814 FOR P=0 TO NP-1
5816 IF WK(P) AND WKUSED(P)=0 THEN PDX=X(P)-EVENTX:PDY=Y(P)-EVENTY:PDZ=Z(P)-EVENTZ:PL=PDX*PDX+PDY*PDY+PDZ*PDZ:IF PL<PWKD THEN PWK=P:PWKD=PL
5818 NEXT P
5820 FOR P=0 TO NP-1
5830 IF IM(P)=0 THEN GOTO 5860
5840 PDX=X(P)-EVENTX:PDY=Y(P)-EVENTY:PDZ=Z(P)-EVENTZ:PL=SQR(PDX*PDX+PDY*PDY+PDZ*PDZ):IF PL>=3 THEN GOTO 5860
5842 PDAMAGE(P)=MIN(0.7,PDAMAGE(P)+0.6*(1-PL/3))
5844 IF PL>=2.8 THEN GOTO 5860
5850 PC=(1-PL/2.8)*20*H:PL=MAX(0.35,PL):OLDX(P)=OLDX(P)-PC*(BVX/PBVL+PDX/PL*0.35):OLDY(P)=OLDY(P)-PC*(BVY/PBVL+PDY/PL*0.35+0.12):OLDZ(P)=OLDZ(P)-PC*(BVZ/PBVL+PDZ/PL*0.35)
5860 NEXT P
5870 PINBLAST=1:FOR E=0 TO NE-1
5872 IF ACTIVE(E)=0 THEN GOTO 5885
5874 PA=EA(E):PB=EB(E):PDX=X(PB)-X(PA):PDY=Y(PB)-Y(PA):PDZ=Z(PB)-Z(PA):PL=PDX*PDX+PDY*PDY+PDZ*PDZ
5876 PT=MAX(0,MIN(1,((EVENTX-X(PA))*PDX+(EVENTY-Y(PA))*PDY+(EVENTZ-Z(PA))*PDZ)/MAX(0.00001,PL)))
5878 PWX=X(PA)+PT*PDX-EVENTX:PWY=Y(PA)+PT*PDY-EVENTY:PWZ=Z(PA)+PT*PDZ-EVENTZ
5880 IF E=PHIT OR PWX*PWX+PWY*PWY+PWZ*PWZ<0.81 OR PA=PWK OR PB=PWK THEN GOSUB 5900
5885 NEXT E
5887 IF PWK>=0 THEN WKUSED(PWK)=1:WEAKHITS=WEAKHITS+1:WKBROKEN=WEAKHITS
5890 PINBLAST=0:RETURN
5900 IF BEAMBUILT THEN CBE=E:GOSUB 22000
5902 ACTIVE(E)=0:STRAIN(E)=1:BROKEN=BROKEN+1:EVBREAK=EVBREAK+1
5905 IF PINBLAST=0 THEN EVENTX=(X(EA(E))+X(EB(E)))*0.5:EVENTY=(Y(EA(E))+Y(EB(E)))*0.5:EVENTZ=(Z(EA(E))+Z(EB(E)))*0.5
5910 RETURN
5940 REM Brittle crystal fractures locally when a falling joint hits stone.
5942 LANDED(P)=1:PCOLL=P
5944 FOR E=0 TO NE-1
5946 IF ACTIVE(E) AND (EA(E)=PCOLL OR EB(E)=PCOLL) THEN GOSUB 5900
5948 NEXT E
5950 RETURN
6000 REM Launch one of ten spheres; AIM vector is normalized defensively.
6010 IF SHOTS<=0 OR BACTIVE THEN RETURN
6020 PL=SQR(AIMX*AIMX+AIMY*AIMY+AIMZ*AIMZ):IF PL<0.00001 THEN RETURN
6030 BX=LAUNCHX:BY=LAUNCHY:BZ=LAUNCHZ:BVX=AIMX/PL*32:BVY=AIMY/PL*32:BVZ=AIMZ/PL*32:BACTIVE=1:BTTL=3.0:SHOTS=SHOTS-1:EVLAUNCH=1
6040 RETURN
6200 REM Swept sphere versus intact crystal panels; edges handle rim contacts.
6210 FOR PFACE=0 TO NF-1
6220 IF ACTIVE(FE1(PFACE))=0 OR ACTIVE(FE2(PFACE))=0 OR ACTIVE(FE3(PFACE))=0 THEN GOTO 6460
6230 PFA=FA(PFACE):PFB=FB(PFACE):PFC=FC(PFACE)
6240 IF BX<MIN(X(PFA),MIN(X(PFB),X(PFC)))-0.9 OR BX>MAX(X(PFA),MAX(X(PFB),X(PFC)))+0.9 THEN GOTO 6460
6250 IF BY<MIN(Y(PFA),MIN(Y(PFB),Y(PFC)))-0.9 OR BY>MAX(Y(PFA),MAX(Y(PFB),Y(PFC)))+0.9 THEN GOTO 6460
6260 IF BZ<MIN(Z(PFA),MIN(Z(PFB),Z(PFC)))-0.9 OR BZ>MAX(Z(PFA),MAX(Z(PFB),Z(PFC)))+0.9 THEN GOTO 6460
6270 PFX=X(PFB)-X(PFA):PFY=Y(PFB)-Y(PFA):PFZ=Z(PFB)-Z(PFA):PGX=X(PFC)-X(PFA):PGY=Y(PFC)-Y(PFA):PGZ=Z(PFC)-Z(PFA)
6280 PNX=PFY*PGZ-PFZ*PGY:PNY=PFZ*PGX-PFX*PGZ:PNZ=PFX*PGY-PFY*PGX:PN2=PNX*PNX+PNY*PNY+PNZ*PNZ:IF PN2<1E-9 THEN GOTO 6460
6290 PD0=(PBOXX-X(PFA))*PNX+(PBOXY-Y(PFA))*PNY+(PBOXZ-Z(PFA))*PNZ:PD1=(BX-X(PFA))*PNX+(BY-Y(PFA))*PNY+(BZ-Z(PFA))*PNZ:PRAD=0.42*SQR(PN2)
6300 IF (PD0>PRAD AND PD1>PRAD) OR (PD0<-PRAD AND PD1<-PRAD) THEN GOTO 6460
6310 PSHOT=0:IF ABS(PD0)>PRAD AND ABS(PD0-PD1)>1E-10 THEN PSHOT=MAX(0,MIN(1,(PD0-SGN(PD0)*PRAD)/(PD0-PD1)))
6320 PQX=PBOXX+PUX*PSHOT-X(PFA):PQY=PBOXY+PUY*PSHOT-Y(PFA):PQZ=PBOXZ+PUZ*PSHOT-Z(PFA)
6330 PDIST=(PQX*PNX+PQY*PNY+PQZ*PNZ)/PN2:PQX=PQX-PDIST*PNX:PQY=PQY-PDIST*PNY:PQZ=PQZ-PDIST*PNZ
6340 PFF=PFX*PFX+PFY*PFY+PFZ*PFZ:PGG=PGX*PGX+PGY*PGY+PGZ*PGZ:PFG=PFX*PGX+PFY*PGY+PFZ*PGZ:PQF=PQX*PFX+PQY*PFY+PQZ*PFZ:PQG=PQX*PGX+PQY*PGY+PQZ*PGZ
6350 PDET=PFF*PGG-PFG*PFG:IF PDET<1E-10 THEN GOTO 6460
6360 PU=(PQF*PGG-PQG*PFG)/PDET:PV=(PQG*PFF-PQF*PFG)/PDET
6370 IF PU<-0.02 OR PV<-0.02 OR PU+PV>1.02 THEN GOTO 6460
6380 IF PSHOT<PBEST THEN PHIT=FE1(PFACE):PBEST=PSHOT
6460 NEXT PFACE
6470 RETURN
6500 REM Detached stained-glass panels retain their material as rigid triangles.
6600 IF DEBRISBUILT THEN GOTO 6640
6610 DIM FXP(95,2),FYP(95,2),FZP(95,2),FOX(95,2),FOY(95,2),FOZ(95,2),FLEN(95,2),FSTATE(95),FSLEEP(95)
6620 DEBRISBUILT=1
6640 MAT FSTATE=0 : MAT FSLEEP=0 : RETURN
6700 REM Free panels inherit node velocity, then fall under the same gravity.
6710 FOR FD=0 TO NF-1
6720 IF FSTATE(FD)=0 THEN IF ACTIVE(FE1(FD))=0 OR ACTIVE(FE2(FD))=0 OR ACTIVE(FE3(FD))=0 THEN GOSUB 6800
6730 IF FSTATE(FD)<>1 THEN GOTO 6795
6740 FOR FV=0 TO 2
6742 DVX=(FXP(FD,FV)-FOX(FD,FV))*0.992 : DVY=(FYP(FD,FV)-FOY(FD,FV))*0.992 : DVZ=(FZP(FD,FV)-FOZ(FD,FV))*0.992
6744 FOX(FD,FV)=FXP(FD,FV) : FOY(FD,FV)=FYP(FD,FV) : FOZ(FD,FV)=FZP(FD,FV)
6746 FXP(FD,FV)=FXP(FD,FV)+DVX : FYP(FD,FV)=FYP(FD,FV)+DVY-9*H*H : FZP(FD,FV)=FZP(FD,FV)+DVZ
6748 NEXT FV
6750 FOR DIT=1 TO 3
6752 FOR FV=0 TO 2
6754 DNEXT=(FV+1) MOD 3 : DDX=FXP(FD,DNEXT)-FXP(FD,FV) : DDY=FYP(FD,DNEXT)-FYP(FD,FV) : DDZ=FZP(FD,DNEXT)-FZP(FD,FV)
6756 DL=SQR(DDX*DDX+DDY*DDY+DDZ*DDZ) : IF DL<0.00001 THEN GOTO 6762
6758 DC=(DL-FLEN(FD,FV))/DL*0.48
6760 FXP(FD,FV)=FXP(FD,FV)+DDX*DC : FYP(FD,FV)=FYP(FD,FV)+DDY*DC : FZP(FD,FV)=FZP(FD,FV)+DDZ*DC : FXP(FD,DNEXT)=FXP(FD,DNEXT)-DDX*DC : FYP(FD,DNEXT)=FYP(FD,DNEXT)-DDY*DC : FZP(FD,DNEXT)=FZP(FD,DNEXT)-DDZ*DC
6762 NEXT FV
6764 FOR FV=0 TO 2
6766 IF FYP(FD,FV)>=0.28 THEN GOTO 6772
6768 DVY=FYP(FD,FV)-FOY(FD,FV) : FYP(FD,FV)=0.28 : FOY(FD,FV)=0.28+MIN(0,DVY)*0.10
6770 FOX(FD,FV)=FXP(FD,FV)-(FXP(FD,FV)-FOX(FD,FV))*0.74 : FOZ(FD,FV)=FZP(FD,FV)-(FZP(FD,FV)-FOZ(FD,FV))*0.74
6772 NEXT FV
6774 NEXT DIT
6776 IF RUBBLEMODE THEN GOTO 6795
6780 RESTING=1
6782 FOR FV=0 TO 2
6784 IF FYP(FD,FV)>0.31 OR ABS(FXP(FD,FV)-FOX(FD,FV))>0.0006 OR ABS(FZP(FD,FV)-FOZ(FD,FV))>0.0006 THEN RESTING=0
6786 NEXT FV
6788 IF RESTING THEN FSLEEP(FD)=FSLEEP(FD)+1 ELSE FSLEEP(FD)=0
6790 IF FSLEEP(FD)>45 THEN FSTATE(FD)=2
6795 NEXT FD : RETURN
6800 REM One-time detachment; preserve triangle shape and inherited momentum.
6802 DCX=(X(FA(FD))+X(FB(FD))+X(FC(FD)))/3 : DCY=(Y(FA(FD))+Y(FB(FD))+Y(FC(FD)))/3 : DCZ=(Z(FA(FD))+Z(FB(FD))+Z(FC(FD)))/3
6803 DNX=(Y(FB(FD))-Y(FA(FD)))*(Z(FC(FD))-Z(FA(FD)))-(Z(FB(FD))-Z(FA(FD)))*(Y(FC(FD))-Y(FA(FD))) : DNZ=(X(FB(FD))-X(FA(FD)))*(Y(FC(FD))-Y(FA(FD)))-(Y(FB(FD))-Y(FA(FD)))*(X(FC(FD))-X(FA(FD)))
6804 DAL=SQR(DNX*DNX+DNZ*DNZ) : DAX=1 : DAZ=0 : IF DAL>0.00001 THEN DAX=DNZ/DAL : DAZ=-DNX/DAL
6806 DSPIN=0.2*H : IF FD MOD 2 THEN DSPIN=-DSPIN
6810 FOR FV=0 TO 2
6820 NODE=FA(FD) : IF FV=1 THEN NODE=FB(FD)
6822 IF FV=2 THEN NODE=FC(FD)
6830 FXP(FD,FV)=X(NODE) : FYP(FD,FV)=Y(NODE) : FZP(FD,FV)=Z(NODE)
6840 DVX=X(NODE)-OLDX(NODE)-DAZ*(Y(NODE)-DCY)*DSPIN : DVY=Y(NODE)-OLDY(NODE)+(DAZ*(X(NODE)-DCX)-DAX*(Z(NODE)-DCZ))*DSPIN : DVZ=Z(NODE)-OLDZ(NODE)+DAX*(Y(NODE)-DCY)*DSPIN : DSPEED=SQR(DVX*DVX+DVY*DVY+DVZ*DVZ)
6850 DSCALE=1 : IF DSPEED>H*12 THEN DSCALE=H*12/DSPEED
6860 FOX(FD,FV)=FXP(FD,FV)-DVX*DSCALE : FOY(FD,FV)=FYP(FD,FV)-DVY*DSCALE : FOZ(FD,FV)=FZP(FD,FV)-DVZ*DSCALE
6870 NEXT FV
6880 FLEN(FD,0)=EL(FE1(FD)) : FLEN(FD,1)=EL(FE2(FD)) : FLEN(FD,2)=EL(FE3(FD)) : FSTATE(FD)=1 : FSLEEP(FD)=0 : RETURN
7000 REM Depth buffer is shared by platform, facets, beams and fragments.
7010 CLG OFFSCREEN : MAT D=0 : GOSUB 10500 : GOSUB 11000
7020 FOR RI=0 TO NP-1
7030 RWX=X(RI) : RWY=Y(RI) : RWZ=Z(RI) : GOSUB 8800 : SX(RI)=RX2 : SY(RI)=RY2 : DEPTHQ(RI)=RQ
7040 NEXT RI
7050 GOSUB 7500 : GOSUB 7800 : GOSUB 23000 : GOSUB 8100 : GOSUB 8500
7060 RETURN
7500 REM Stained crystal panels; their three supporting edges must survive.
7510 IF NF<1 THEN RETURN
7520 FOR RF=0 TO NF-1
7525 IF FSTATE(RF)>0 THEN GOSUB 7650:GOTO 7590
7530 IF ACTIVE(FE1(RF))=0 OR ACTIVE(FE2(RF))=0 OR ACTIVE(FE3(RF))=0 THEN GOTO 7590
7540 IA=FA(RF) : IB=FB(RF) : IC=FC(RF) : CI=1+(RF MOD 3)
7550 TA=SX(IA) : TB=SY(IA) : TQ=DEPTHQ(IA) : UA=SX(IB) : UB=SY(IB) : UQ=DEPTHQ(IB) : VA=SX(IC) : VB=SY(IC) : VQ=DEPTHQ(IC)
7560 IF MIN(TQ,MIN(UQ,VQ))<=0 THEN GOTO 7590
7570 GTRIANGLE D,TA,TB,TQ,PR(CI)*0.30,PG(CI)*0.30,PB(CI)*0.46,UA,UB,UQ,PR(CI)*0.62,PG(CI)*0.58,PB(CI)*0.76,VA,VB,VQ,PR(CI)*0.90,PG(CI)*0.86,PB(CI)*0.96
7590 NEXT RF : RETURN
7650 REM Detached panels remain visible as substantial falling glass pieces.
7652 FOR FV=0 TO 2
7654 RWX=FXP(RF,FV) : RWY=FYP(RF,FV) : RWZ=FZP(RF,FV) : GOSUB 8800
7656 IF FV=0 THEN TA=RX2:TB=RY2:TQ=RQ
7658 IF FV=1 THEN UA=RX2:UB=RY2:UQ=RQ
7660 IF FV=2 THEN VA=RX2:VB=RY2:VQ=RQ
7662 NEXT FV
7664 IF MIN(TQ,MIN(UQ,VQ))<=0 THEN RETURN
7666 CI=1+(RF MOD 3)
7668 GTRIANGLE D,TA,TB,TQ,PR(CI)*0.30,PG(CI)*0.30,PB(CI)*0.46,UA,UB,UQ,PR(CI)*0.62,PG(CI)*0.58,PB(CI)*0.76,VA,VB,VQ,PR(CI)*0.90,PG(CI)*0.86,PB(CI)*0.96
7670 RETURN
7800 REM Faceted beams join projected particles with inverse-depth interpolation.
7810 FOR RE=0 TO NE-1
7820 IF ACTIVE(RE)=0 THEN GOTO 7990
7830 IA=EA(RE) : IB=EB(RE) : QA=DEPTHQ(IA) : QB=DEPTHQ(IB) : IF QA<=0 OR QB<=0 THEN GOTO 7990
7840 EX=SX(IB)-SX(IA) : EY=SY(IB)-SY(IA) : LEN2=EX*EX+EY*EY : IF LEN2<0.01 THEN GOTO 7990
7850 INVLEN=1/SQR(LEN2) : EX=EX*INVLEN : EY=EY*INVLEN : WA=MAX(0.8,FOC*0.055*QA) : WB=MAX(0.8,FOC*0.055*QB)
7860 CI=NC(IB) : HOT=MIN(1,ABS(STRAIN(RE))*20) : RC=PR(CI)*(1-HOT)+255*HOT : GC=PG(CI)*(1-HOT)+145*HOT : BC=PB(CI)*(1-HOT)+85*HOT
7870 TA=SX(IA)-EY*WA : TB=SY(IA)+EX*WA : UA=SX(IA)+EY*WA : UB=SY(IA)-EX*WA
7880 VA=SX(IB)+EY*WB : VB=SY(IB)-EX*WB : XA=SX(IB)-EY*WB : XB=SY(IB)+EX*WB
7890 GTRIANGLE D,TA,TB,QA,RC,GC,BC,UA,UB,QA,RC*0.40,GC*0.45,BC*0.55,VA,VB,QB,RC*0.40,GC*0.45,BC*0.55
7900 GTRIANGLE D,TA,TB,QA,RC,GC,BC,VA,VB,QB,RC*0.40,GC*0.45,BC*0.55,XA,XB,QB,RC,GC,BC
7990 NEXT RE : RETURN
8100 REM Small four-facet jewels cap the structural joints.
8110 FOR RI=0 TO NP-1
8120 RQ=DEPTHQ(RI) : IF RQ<=0 THEN GOTO 8390
8130 CX=SX(RI) : CY=SY(RI) : RR=MAX(1.1,NR(RI)*FOC*RQ) : CI=NC(RI)
8140 IF RI=CORE THEN RR=RR*(1+0.045*SIN(T*4)):CI=4
8150 ROT=RI*1.71+SIMT*0.45 : SS=SIN(ROT) : CC=COS(ROT)
8160 GX1=CX+CC*RR : GY1=CY+SS*RR*0.6 : GX2=CX-SS*RR : GY2=CY+CC*RR*1.6
8170 GX3=CX-CC*RR : GY3=CY-SS*RR*0.6 : GX4=CX+SS*RR : GY4=CY-CC*RR*1.6
8180 GTRIANGLE D,CX,CY,RQ,255,255,245,GX1,GY1,RQ,PR(CI)*0.55,PG(CI)*0.65,PB(CI)*0.75,GX2,GY2,RQ,PR(CI),PG(CI),PB(CI)
8190 GTRIANGLE D,CX,CY,RQ,245,255,255,GX2,GY2,RQ,PR(CI),PG(CI),PB(CI),GX3,GY3,RQ,PR(CI)*0.35,PG(CI)*0.40,PB(CI)*0.58
8200 GTRIANGLE D,CX,CY,RQ,PR(CI)*0.75,PG(CI)*0.85,PB(CI),GX3,GY3,RQ,PR(CI)*0.35,PG(CI)*0.40,PB(CI)*0.58,GX4,GY4,RQ,PR(CI)*0.28,PG(CI)*0.30,PB(CI)*0.43
8210 GTRIANGLE D,CX,CY,RQ,PR(CI)*0.75,PG(CI)*0.85,PB(CI),GX4,GY4,RQ,PR(CI)*0.28,PG(CI)*0.30,PB(CI)*0.43,GX1,GY1,RQ,PR(CI)*0.55,PG(CI)*0.65,PB(CI)*0.75
8390 NEXT RI : RETURN
8500 REM Projectile and small depth-tested flying glass triangles.
8510 IF BACTIVE=0 THEN GOTO 8550
8520 RWX=BX : RWY=BY : RWZ=BZ : GOSUB 8800
8530 IF RQ>0 THEN RR=MAX(2,FOC*0.40*RQ):GTRIANGLE D,RX2,RY2+RR*1.4,RQ,255,255,255,RX2-RR,RY2-RR,RQ,88,211,255,RX2+RR,RY2-RR,RQ,218,248,255
8550 FOR AI=0 TO 179
8560 IF ALIFE(AI)<=0 THEN GOTO 8670
8570 RWX=AX(AI) : RWY=AY(AI) : RWZ=AZ(AI) : GOSUB 8800 : IF RQ<=0 THEN GOTO 8670
8580 RR=MAX(0.7,ASIZE(AI)*FOC*RQ) : CI=ACOL(AI) : ANG=T*5+AI*1.9 : CS=COS(ANG) : SN=SIN(ANG)
8590 BRIGHT=MIN(1,ALIFE(AI)*2)
8600 GTRIANGLE D,RX2+CS*RR,RY2+SN*RR,RQ,PR(CI)*BRIGHT,PG(CI)*BRIGHT,PB(CI)*BRIGHT,RX2-SN*RR,RY2+CS*RR,RQ,PR(CI)*0.45,PG(CI)*0.55,PB(CI)*0.7,RX2-CS*RR,RY2-SN*RR,RQ,240*BRIGHT,250*BRIGHT,255*BRIGHT
8670 NEXT AI : RETURN
8800 REM Project one world point; all solid geometry stays outside the near plane.
8810 RDX=RWX-CAMX : RDY=RWY-CAMY : RDZ=RWZ-CAMZ
8820 RDEP=RDX*CFX+RDY*CFY+RDZ*CFZ : RQ=0 : RX2=0 : RY2=0 : IF RDEP<0.35 THEN RETURN
8830 RQ=1/RDEP : RX2=320+FOC*(RDX*CRX+RDZ*CRZ)*RQ : RY2=VIEWY+FOC*(RDX*CUX+RDY*CUY+RDZ*CUZ)*RQ
8840 RETURN
