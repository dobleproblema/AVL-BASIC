15090 IF HSScores(HSI)<1 OR HSScores(HSI)>10000 OR HSScores(HSI)<>INT(HSScores(HSI)) THEN ERROR 26
15100 IF HSI>0 THEN IF HSScores(HSI)>HSScores(HSI-1) THEN ERROR 26
