13420 HSDone=1 : HSPoints=DESTSCORE : HSPos=5
13430 FOR HSI=0 TO 4
13440 IF HSPos=5 AND HSPoints>HSScores(HSI) THEN HSPos=HSI
13450 NEXT HSI
