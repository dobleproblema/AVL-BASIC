11000 REM A floating twelve-sided stone dais, rendered with actual 3D depth.
11010 FOR SECTOR=0 TO 15
11020 A=SECTOR*PI/8 : B=(SECTOR+1)*PI/8
11030 RWX=0 : RWY=0.25 : RWZ=0 : GOSUB 8800 : TA=RX2 : TB=RY2 : TQ=RQ
11040 RWX=COS(A)*8 : RWY=0.25 : RWZ=SIN(A)*8 : GOSUB 8800 : UA=RX2 : UB=RY2 : UQ=RQ
11050 RWX=COS(B)*8 : RWY=0.25 : RWZ=SIN(B)*8 : GOSUB 8800 : VA=RX2 : VB=RY2 : VQ=RQ
11060 SHADE=0.85+0.15*(SECTOR MOD 2)
11070 GTRIANGLE D,TA,TB,TQ,26,37,55,UA,UB,UQ,20*SHADE,31*SHADE,47*SHADE,VA,VB,VQ,23*SHADE,35*SHADE,52*SHADE
11080 RWX=COS(A)*8 : RWY=-0.5 : RWZ=SIN(A)*8 : GOSUB 8800 : XA=RX2 : XB=RY2 : XQ=RQ
