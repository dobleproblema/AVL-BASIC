15130 HSCode=ASC(MID$(HSNames$(HSI),HSJ,1)) : IF HSCode<32 OR (HSCode>=127 AND HSCode<160) THEN ERROR 26
15140 NEXT HSJ
15150 HSName$=HSNames$(HSI) : GOSUB 13800 : HSNames$(HSI)=HSName$
15160 NEXT HSI
