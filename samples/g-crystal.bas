20000 REM Broken beams become independent rigid rods; a sleeping rod never expires.
20010 IF BEAMBUILT THEN GOTO 20040
20020 DIM BEAMPX(499,1),BEAMPY(499,1),BEAMPZ(499,1),BEAMOX(499,1),BEAMOY(499,1),BEAMOZ(499,1),BEAMLEN(499),BSTATE(499),BEAMSLEEP(499),BEAMCOL(499)
20025 DIM BEAMVX(1),BEAMVY(1),BEAMVZ(1),BEAMTOUCH(1)
20030 BEAMBUILT=1
20040 MAT BSTATE=0 : MAT BEAMSLEEP=0 : BEAMRAD=0.055 : BEAMFLOOR=0.25+BEAMRAD+0.005 : RETURN
21000 REM Fixed-step endpoint Verlet/PBD; beam debris has no structural feedback.
21010 IF BEAMBUILT=0 THEN RETURN
21020 FOR BEAMI=0 TO NE-1
21030 IF BSTATE(BEAMI)<>1 THEN GOTO 21590
21040 FOR BEAMV=0 TO 1
21050 BEAMVX(BEAMV)=(BEAMPX(BEAMI,BEAMV)-BEAMOX(BEAMI,BEAMV))*0.994 : BEAMVY(BEAMV)=(BEAMPY(BEAMI,BEAMV)-BEAMOY(BEAMI,BEAMV))*0.994-9*H*H : BEAMVZ(BEAMV)=(BEAMPZ(BEAMI,BEAMV)-BEAMOZ(BEAMI,BEAMV))*0.994
21060 BEAMSPD=SQR(BEAMVX(BEAMV)^2+BEAMVY(BEAMV)^2+BEAMVZ(BEAMV)^2) : BEAMSCALE=1 : IF BEAMSPD>16*H THEN BEAMSCALE=16*H/BEAMSPD
21070 BEAMVX(BEAMV)=BEAMVX(BEAMV)*BEAMSCALE : BEAMVY(BEAMV)=BEAMVY(BEAMV)*BEAMSCALE : BEAMVZ(BEAMV)=BEAMVZ(BEAMV)*BEAMSCALE
21080 BEAMOX(BEAMI,BEAMV)=BEAMPX(BEAMI,BEAMV) : BEAMOY(BEAMI,BEAMV)=BEAMPY(BEAMI,BEAMV) : BEAMOZ(BEAMI,BEAMV)=BEAMPZ(BEAMI,BEAMV) : BEAMTOUCH(BEAMV)=0
21090 BEAMPX(BEAMI,BEAMV)=BEAMPX(BEAMI,BEAMV)+BEAMVX(BEAMV) : BEAMPY(BEAMI,BEAMV)=BEAMPY(BEAMI,BEAMV)+BEAMVY(BEAMV) : BEAMPZ(BEAMI,BEAMV)=BEAMPZ(BEAMI,BEAMV)+BEAMVZ(BEAMV)
21100 IF BEAMPY(BEAMI,BEAMV)>=BEAMFLOOR THEN GOTO 21150
21110 REM Sweep to the stone top before spending the remaining motion in friction.
21120 BEAMTOI=MAX(0,MIN(1,(BEAMOY(BEAMI,BEAMV)-BEAMFLOOR)/MAX(0.0000001,-BEAMVY(BEAMV))))
21130 BEAMPX(BEAMI,BEAMV)=BEAMOX(BEAMI,BEAMV)+BEAMVX(BEAMV)*(BEAMTOI+(1-BEAMTOI)*0.70) : BEAMPZ(BEAMI,BEAMV)=BEAMOZ(BEAMI,BEAMV)+BEAMVZ(BEAMV)*(BEAMTOI+(1-BEAMTOI)*0.70)
21140 BEAMPY(BEAMI,BEAMV)=BEAMFLOOR : BEAMTOUCH(BEAMV)=1
21150 NEXT BEAMV
21160 FOR BEAMIT=1 TO MAX(2,PITER)+2
21170 GOSUB 21600
21180 FOR BEAMV=0 TO 1
21190 IF BEAMPY(BEAMI,BEAMV)<BEAMFLOOR THEN BEAMPY(BEAMI,BEAMV)=BEAMFLOOR : BEAMTOUCH(BEAMV)=1
21200 NEXT BEAMV
21210 NEXT BEAMIT
21220 REM Final rigid normalization and common lift preserve both length and support.
21230 GOSUB 21600
21240 BEAMLIFT=MAX(0,BEAMFLOOR-MIN(BEAMPY(BEAMI,0),BEAMPY(BEAMI,1)))
21250 IF BEAMLIFT>0 THEN BEAMPY(BEAMI,0)=BEAMPY(BEAMI,0)+BEAMLIFT : BEAMPY(BEAMI,1)=BEAMPY(BEAMI,1)+BEAMLIFT
21260 FOR BEAMV=0 TO 1
21270 IF BEAMPY(BEAMI,BEAMV)<=BEAMFLOOR+0.000001 THEN BEAMTOUCH(BEAMV)=1
21280 IF BEAMTOUCH(BEAMV)=0 THEN GOTO 21330
21290 BEAMOX(BEAMI,BEAMV)=BEAMPX(BEAMI,BEAMV)-BEAMVX(BEAMV)*0.70 : BEAMOZ(BEAMI,BEAMV)=BEAMPZ(BEAMI,BEAMV)-BEAMVZ(BEAMV)*0.70
21300 BEAMBOUNCE=0 : IF BEAMVY(BEAMV)<-0.7*H THEN BEAMBOUNCE=-BEAMVY(BEAMV)*0.15
21310 BEAMOY(BEAMI,BEAMV)=BEAMPY(BEAMI,BEAMV)-BEAMBOUNCE
21330 NEXT BEAMV
21335 IF RUBBLEMODE THEN GOTO 21590
21340 BEAMREST=1
21350 FOR BEAMV=0 TO 1
21360 IF BEAMPY(BEAMI,BEAMV)>BEAMFLOOR+0.002 OR ABS(BEAMPX(BEAMI,BEAMV)-BEAMOX(BEAMI,BEAMV))>0.0007 OR ABS(BEAMPY(BEAMI,BEAMV)-BEAMOY(BEAMI,BEAMV))>0.0007 OR ABS(BEAMPZ(BEAMI,BEAMV)-BEAMOZ(BEAMI,BEAMV))>0.0007 THEN BEAMREST=0
21370 NEXT BEAMV
21380 IF BEAMREST THEN BEAMSLEEP(BEAMI)=BEAMSLEEP(BEAMI)+1 ELSE BEAMSLEEP(BEAMI)=0
21390 IF BEAMSLEEP(BEAMI)<45 THEN GOTO 21590
21400 BSTATE(BEAMI)=2
21410 FOR BEAMV=0 TO 1
21420 BEAMOX(BEAMI,BEAMV)=BEAMPX(BEAMI,BEAMV) : BEAMOY(BEAMI,BEAMV)=BEAMPY(BEAMI,BEAMV) : BEAMOZ(BEAMI,BEAMV)=BEAMPZ(BEAMI,BEAMV)
21430 NEXT BEAMV
21590 NEXT BEAMI : RETURN
21600 REM Equal endpoint mass gives an exact length projection.
21610 BEAMDX=BEAMPX(BEAMI,1)-BEAMPX(BEAMI,0) : BEAMDY=BEAMPY(BEAMI,1)-BEAMPY(BEAMI,0) : BEAMDZ=BEAMPZ(BEAMI,1)-BEAMPZ(BEAMI,0)
21620 BEAMDIST=SQR(BEAMDX*BEAMDX+BEAMDY*BEAMDY+BEAMDZ*BEAMDZ)
21630 IF BEAMDIST<0.0000001 THEN BEAMPX(BEAMI,0)=BEAMPX(BEAMI,0)-BEAMLEN(BEAMI)*0.5 : BEAMPX(BEAMI,1)=BEAMPX(BEAMI,1)+BEAMLEN(BEAMI)*0.5 : RETURN
21640 BEAMCORR=(BEAMDIST-BEAMLEN(BEAMI))/BEAMDIST*0.5
21650 BEAMPX(BEAMI,0)=BEAMPX(BEAMI,0)+BEAMDX*BEAMCORR : BEAMPY(BEAMI,0)=BEAMPY(BEAMI,0)+BEAMDY*BEAMCORR : BEAMPZ(BEAMI,0)=BEAMPZ(BEAMI,0)+BEAMDZ*BEAMCORR
21660 BEAMPX(BEAMI,1)=BEAMPX(BEAMI,1)-BEAMDX*BEAMCORR : BEAMPY(BEAMI,1)=BEAMPY(BEAMI,1)-BEAMDY*BEAMCORR : BEAMPZ(BEAMI,1)=BEAMPZ(BEAMI,1)-BEAMDZ*BEAMCORR : RETURN
22000 REM Called once with CBE=E immediately before the structural edge deactivates.
22010 IF BEAMBUILT=0 THEN GOSUB 20000
22020 IF CBE<0 OR CBE>=NE THEN RETURN
22030 IF BSTATE(CBE)<>0 THEN RETURN
22040 BEAMCA=EA(CBE) : BEAMCB=EB(CBE) : BEAMCOL(CBE)=NC(BEAMCB)
22050 BEAMCX=(X(BEAMCA)+X(BEAMCB))*0.5 : BEAMCY=(Y(BEAMCA)+Y(BEAMCB))*0.5 : BEAMCZ=(Z(BEAMCA)+Z(BEAMCB))*0.5
22060 BEAMDX=X(BEAMCB)-X(BEAMCA) : BEAMDY=Y(BEAMCB)-Y(BEAMCA) : BEAMDZ=Z(BEAMCB)-Z(BEAMCA) : BEAMDIST=SQR(BEAMDX^2+BEAMDY^2+BEAMDZ^2)
22070 BEAMLEN(CBE)=MAX(0.001,EL(CBE)) : IF BEAMDIST<0.65*BEAMLEN(CBE) OR BEAMDIST>1.35*BEAMLEN(CBE) THEN BEAMLEN(CBE)=MAX(0.001,BEAMDIST)
22080 BEAMHOR=SQR(BEAMDX^2+BEAMDZ^2) : BEAMAX=1 : BEAMAZ=0 : IF BEAMHOR>0.00001 THEN BEAMAX=BEAMDZ/BEAMHOR : BEAMAZ=-BEAMDX/BEAMHOR
22090 BEAMSPIN=0.2*H : IF CBE MOD 2 THEN BEAMSPIN=-BEAMSPIN
22100 FOR BEAMV=0 TO 1
22110 BEAMNODE=BEAMCA : IF BEAMV=1 THEN BEAMNODE=BEAMCB
22120 BEAMPX(CBE,BEAMV)=X(BEAMNODE) : BEAMPY(CBE,BEAMV)=Y(BEAMNODE) : BEAMPZ(CBE,BEAMV)=Z(BEAMNODE)
22130 BEAMIX=X(BEAMNODE)-OLDX(BEAMNODE)-BEAMAZ*(Y(BEAMNODE)-BEAMCY)*BEAMSPIN : BEAMIY=Y(BEAMNODE)-OLDY(BEAMNODE)+(BEAMAZ*(X(BEAMNODE)-BEAMCX)-BEAMAX*(Z(BEAMNODE)-BEAMCZ))*BEAMSPIN : BEAMIZ=Z(BEAMNODE)-OLDZ(BEAMNODE)+BEAMAX*(Y(BEAMNODE)-BEAMCY)*BEAMSPIN
22140 BEAMSPD=SQR(BEAMIX^2+BEAMIY^2+BEAMIZ^2) : BEAMSCALE=1 : IF BEAMSPD>16*H THEN BEAMSCALE=16*H/BEAMSPD
22150 BEAMOX(CBE,BEAMV)=BEAMPX(CBE,BEAMV)-BEAMIX*BEAMSCALE : BEAMOY(CBE,BEAMV)=BEAMPY(CBE,BEAMV)-BEAMIY*BEAMSCALE : BEAMOZ(CBE,BEAMV)=BEAMPZ(CBE,BEAMV)-BEAMIZ*BEAMSCALE
22160 NEXT BEAMV
22170 BSTATE(CBE)=1 : BEAMSLEEP(CBE)=0 : RETURN
23000 REM Persistent beams are solid four-sided prisms with true 3D end caps.
23010 FOR RODI=0 TO NE-1
23020 IF BSTATE(RODI)=0 THEN GOTO 23390
23030 RODUX=BEAMPX(RODI,1)-BEAMPX(RODI,0) : RODUY=BEAMPY(RODI,1)-BEAMPY(RODI,0) : RODUZ=BEAMPZ(RODI,1)-BEAMPZ(RODI,0)
23040 RODL=SQR(RODUX*RODUX+RODUY*RODUY+RODUZ*RODUZ) : IF RODL<0.00001 THEN GOTO 23390
23050 RODUX=RODUX/RODL : RODUY=RODUY/RODL : RODUZ=RODUZ/RODL
23060 RODVX=-RODUZ : RODVY=0 : RODVZ=RODUX
23070 IF ABS(RODUY)>0.9 THEN RODVX=0:RODVY=RODUZ:RODVZ=-RODUY
23080 RODL=SQR(RODVX*RODVX+RODVY*RODVY+RODVZ*RODVZ) : RODVX=RODVX/RODL : RODVY=RODVY/RODL : RODVZ=RODVZ/RODL
23090 RODWX=RODUY*RODVZ-RODUZ*RODVY : RODWY=RODUZ*RODVX-RODUX*RODVZ : RODWZ=RODUX*RODVY-RODUY*RODVX
23100 FOR RODC=0 TO 3
23110 RODDX=RODVX : RODDY=RODVY : RODDZ=RODVZ
23120 IF RODC=1 THEN RODDX=RODWX:RODDY=RODWY:RODDZ=RODWZ
23130 IF RODC=2 THEN RODDX=-RODVX:RODDY=-RODVY:RODDZ=-RODVZ
23140 IF RODC=3 THEN RODDX=-RODWX:RODDY=-RODWY:RODDZ=-RODWZ
23150 FOR RODE=0 TO 1
23160 RWX=BEAMPX(RODI,RODE)+RODDX*BEAMRAD : RWY=BEAMPY(RODI,RODE)+RODDY*BEAMRAD : RWZ=BEAMPZ(RODI,RODE)+RODDZ*BEAMRAD
23170 GOSUB 8800 : RODV=RODC+RODE*4 : RODSX(RODV)=RX2 : RODSY(RODV)=RY2 : RODSQ(RODV)=RQ
23180 NEXT RODE : NEXT RODC
23190 RODCX=(BEAMPX(RODI,0)+BEAMPX(RODI,1))*0.5 : RODCY=(BEAMPY(RODI,0)+BEAMPY(RODI,1))*0.5 : RODCZ=(BEAMPZ(RODI,0)+BEAMPZ(RODI,1))*0.5
23200 CI=BEAMCOL(RODI)
23210 FOR RODF=0 TO 5
23220 IF RODF>=4 THEN GOTO 23300
23230 RODNX=RODVX+RODWX : RODNY=RODVY+RODWY : RODNZ=RODVZ+RODWZ
23240 IF RODF=1 THEN RODNX=RODWX-RODVX:RODNY=RODWY-RODVY:RODNZ=RODWZ-RODVZ
23250 IF RODF=2 THEN RODNX=-RODVX-RODWX:RODNY=-RODVY-RODWY:RODNZ=-RODVZ-RODWZ
23260 IF RODF=3 THEN RODNX=RODVX-RODWX:RODNY=RODVY-RODWY:RODNZ=RODVZ-RODWZ
23270 RODFCX=RODCX+RODNX*BEAMRAD*0.5 : RODFCY=RODCY+RODNY*BEAMRAD*0.5 : RODFCZ=RODCZ+RODNZ*BEAMRAD*0.5
23280 RODA=RODF : RODB=(RODF+1) MOD 4 : RODD=RODF+4 : RODC2=RODB+4 : GOTO 23330
23300 RODA=0 : RODB=3 : RODC2=2 : RODD=1 : RODNX=-RODUX : RODNY=-RODUY : RODNZ=-RODUZ : RODFCX=BEAMPX(RODI,0) : RODFCY=BEAMPY(RODI,0) : RODFCZ=BEAMPZ(RODI,0)
23310 IF RODF=5 THEN RODA=4:RODB=5:RODC2=6:RODD=7:RODNX=RODUX:RODNY=RODUY:RODNZ=RODUZ:RODFCX=BEAMPX(RODI,1):RODFCY=BEAMPY(RODI,1):RODFCZ=BEAMPZ(RODI,1)
23330 IF (CAMX-RODFCX)*RODNX+(CAMY-RODFCY)*RODNY+(CAMZ-RODFCZ)*RODNZ<=0 THEN GOTO 23370
23340 RODNL=SQR(RODNX*RODNX+RODNY*RODNY+RODNZ*RODNZ) : RODLIGHT=0.38+0.62*MAX(0,MIN(1,(RODNX*0.35+RODNY*0.84+RODNZ*0.42)/RODNL))
23350 RODR=PR(CI)*RODLIGHT : RODG=PG(CI)*RODLIGHT : RODBLUE=PB(CI)*RODLIGHT : GOSUB 23500
23370 NEXT RODF
23390 NEXT RODI : RETURN
23500 IF MIN(RODSQ(RODA),MIN(RODSQ(RODB),MIN(RODSQ(RODC2),RODSQ(RODD))))<=0 THEN RETURN
23510 GTRIANGLE D,RODSX(RODA),RODSY(RODA),RODSQ(RODA),RODR,RODG,RODBLUE,RODSX(RODB),RODSY(RODB),RODSQ(RODB),RODR*0.82,RODG*0.86,RODBLUE*0.90,RODSX(RODC2),RODSY(RODC2),RODSQ(RODC2),RODR*0.82,RODG*0.86,RODBLUE*0.90
23520 GTRIANGLE D,RODSX(RODA),RODSY(RODA),RODSQ(RODA),RODR,RODG,RODBLUE,RODSX(RODC2),RODSY(RODC2),RODSQ(RODC2),RODR*0.82,RODG*0.86,RODBLUE*0.90,RODSX(RODD),RODSY(RODD),RODSQ(RODD),RODR,RODG,RODBLUE
23530 RETURN
30000 REM Fast piling: only settled debris stamps the support surface; moving pieces may overlap.
30010 IF RUBBLEBUILT THEN GOTO 30150
30020 DIM SGHEIGHT(240,240),SGSTAMPED(595),SGORDER(595),SGNEXT(595),SGHEAD(127)
30030 DIM SGX(2),SGY(2),SGZ(2),SGOX(2),SGOY(2),SGOZ(2),SGL(2)
30040 DIM SGWA(15),SGWB(15),SGWC(15),SGTARGET(15),SGHIT(15)
30050 DIM SGPASTX(595,2),SGPASTY(595,2),SGPASTZ(595,2),SGHAVE(595)
30060 RUBBLEBUILT=1
30150 MAT SGHEIGHT=0.25 : MAT SGSTAMPED=0 : MAT SGHAVE=0 : SGMAXHEIGHT=0.25 : RUBBLEMODE=1 : RBN=0 : RCN=0 : SGTOTALSTATIC=0 : SGDEPOSITED=0 : RETURN
31000 REM Visit low fragments first. Only resting geometry is added to the support surface.
31010 IF RUBBLEMODE=0 THEN RETURN
31020 MAT SGHEAD=-1 : RBN=0 : RCN=0 : SGAWAKE=0 : SGADDED=0 : SGPROBES=0
31030 FOR SGID=0 TO NE-1
31040 IF BSTATE(SGID)=0 THEN GOTO 31100
31050 RBN=RBN+1 : IF BSTATE(SGID)=2 THEN IF SGSTAMPED(SGID)=0 AND SGADDED<2 THEN GOSUB 32000 : GOSUB 33000
31060 IF BSTATE(SGID)<>1 THEN GOTO 31100
31070 SGLOW=MIN(BEAMPY(SGID,0),BEAMPY(SGID,1)) : SGBUCKET=MAX(0,MIN(127,INT((SGLOW-0.25)*4)))
31080 SGNEXT(SGID)=SGHEAD(SGBUCKET) : SGHEAD(SGBUCKET)=SGID : SGAWAKE=SGAWAKE+1
31100 NEXT SGID
31110 FOR SGFACE=0 TO NF-1
31120 SGID=500+SGFACE : IF FSTATE(SGFACE)=0 THEN GOTO 31190
31130 RBN=RBN+1 : IF FSTATE(SGFACE)=2 THEN IF SGSTAMPED(SGID)=0 AND SGADDED<2 THEN GOSUB 32000 : GOSUB 33000
31140 IF FSTATE(SGFACE)<>1 THEN GOTO 31190
31150 SGLOW=MIN(FYP(SGFACE,0),FYP(SGFACE,1),FYP(SGFACE,2)) : SGBUCKET=MAX(0,MIN(127,INT((SGLOW-0.25)*4)))
31160 SGNEXT(SGID)=SGHEAD(SGBUCKET) : SGHEAD(SGBUCKET)=SGID : SGAWAKE=SGAWAKE+1
31190 NEXT SGFACE
31200 FOR SGBUCKET=0 TO 127
31210 SGID=SGHEAD(SGBUCKET)
31220 IF SGID<0 THEN GOTO 31260
31230 SGNXT=SGNEXT(SGID) : GOSUB 32000 : GOSUB 32100 : GOSUB 32300 : GOSUB 32600
31240 SGID=SGNXT : GOTO 31220
31260 NEXT SGBUCKET : RETURN
32000 REM One fragment scratch pose; original lengths and material remain unchanged.
32010 SGNV=2 : SGRAD=0.055 : SGFLOOR=BEAMFLOOR
32020 IF SGID>=500 THEN SGNV=3 : SGRAD=0.03 : SGFLOOR=0.28 : SGFACE=SGID-500
32030 FOR SGV=0 TO SGNV-1
32040 IF SGNV=3 THEN GOTO 32070
32050 SGX(SGV)=BEAMPX(SGID,SGV) : SGY(SGV)=BEAMPY(SGID,SGV) : SGZ(SGV)=BEAMPZ(SGID,SGV) : SGOX(SGV)=BEAMOX(SGID,SGV) : SGOY(SGV)=BEAMOY(SGID,SGV) : SGOZ(SGV)=BEAMOZ(SGID,SGV) : SGL(0)=BEAMLEN(SGID) : GOTO 32080
32070 SGX(SGV)=FXP(SGFACE,SGV) : SGY(SGV)=FYP(SGFACE,SGV) : SGZ(SGV)=FZP(SGFACE,SGV) : SGOX(SGV)=FOX(SGFACE,SGV) : SGOY(SGV)=FOY(SGFACE,SGV) : SGOZ(SGV)=FOZ(SGFACE,SGV) : SGL(SGV)=FLEN(SGFACE,SGV)
32080 NEXT SGV : RETURN
32100 REM Gather support probes once; reuse their heights in the two rigid contact passes.
32110 SGTOUCH=0 : SGCOUNT=7 : SGLOW=MIN(SGY(0),SGY(1)) : IF SGNV=3 THEN SGLOW=MIN(SGLOW,SGY(2))
32120 IF SGNV=2 THEN SGSEG=MIN(12,MAX(2,2*INT(SGL(0)+0.99))) : SGCOUNT=SGSEG+1
32130 FOR SGP=0 TO SGCOUNT-1
32140 SGHIT(SGP)=0 : SGWA(SGP)=0 : SGWB(SGP)=0 : SGWC(SGP)=0
32150 IF SGNV=2 THEN SGWB(SGP)=SGP/SGSEG : SGWA(SGP)=1-SGWB(SGP) : GOTO 32210
32160 IF SGP=0 THEN SGWA(SGP)=1
32165 IF SGP=1 THEN SGWB(SGP)=1
32170 IF SGP=2 THEN SGWC(SGP)=1
32175 IF SGP=3 THEN SGWA(SGP)=0.5 : SGWB(SGP)=0.5
32180 IF SGP=4 THEN SGWB(SGP)=0.5 : SGWC(SGP)=0.5
32185 IF SGP=5 THEN SGWC(SGP)=0.5 : SGWA(SGP)=0.5
32190 IF SGP=6 THEN SGWA(SGP)=1/3 : SGWB(SGP)=1/3 : SGWC(SGP)=1/3
32210 SGAX=SGWA(SGP) : SGBX=SGWB(SGP) : SGCX=SGWC(SGP)
32220 SGPX=SGAX*SGX(0)+SGBX*SGX(1)+SGCX*SGX(2) : SGPY=SGAX*SGY(0)+SGBX*SGY(1)+SGCX*SGY(2) : SGPZ=SGAX*SGZ(0)+SGBX*SGZ(1)+SGCX*SGZ(2)
32230 SGOLDY=SGAX*SGOY(0)+SGBX*SGOY(1)+SGCX*SGOY(2) : IF SGHAVE(SGID) THEN SGOLDY=SGAX*SGPASTY(SGID,0)+SGBX*SGPASTY(SGID,1)+SGCX*SGPASTY(SGID,2)
32240 SGTOP=0.25 : SGIX=INT((SGPX+24)*5+0.5) : SGIZ=INT((SGPZ+24)*5+0.5)
32250 IF SGIX>=0 AND SGIX<=240 AND SGIZ>=0 AND SGIZ<=240 THEN SGTOP=SGHEIGHT(SGIX,SGIZ)
32260 SGTARG=SGFLOOR : IF SGTOP>0.251 THEN SGTARG=SGTOP+SGRAD+0.004
32270 SGPROBES=SGPROBES+1 : SGTARGET(SGP)=SGTARG : IF SGPY>SGTARG+0.003 THEN GOTO 32295
32280 IF SGTOP>0.251 AND SGOLDY<SGTARG-0.025 AND SGTARG-SGPY>0.13 THEN GOTO 32295
32290 SGHIT(SGP)=1 : SGTOUCH=SGTOUCH+1 : RCN=RCN+1
32295 NEXT SGP : RETURN
32300 REM Vertical sample contacts give torque through their barycentric weights.
32310 IF SGTOUCH=0 THEN GOSUB 32500 : RETURN
32320 FOR SGIT=1 TO 2
32330 FOR SGP=0 TO SGCOUNT-1
32340 IF SGHIT(SGP)=0 THEN GOTO 32420
32350 SGAX=SGWA(SGP) : SGBX=SGWB(SGP) : SGCX=SGWC(SGP) : SGDEN=SGAX*SGAX+SGBX*SGBX+SGCX*SGCX
32360 SGPY=SGAX*SGY(0)+SGBX*SGY(1)+SGCX*SGY(2) : SGPEN=SGTARGET(SGP)-SGPY
32370 IF SGPEN<=0 THEN GOTO 32400
32380 SGCOR=MIN(0.3,SGPEN)*0.88/SGDEN
32390 SGY(0)=SGY(0)+SGCOR*SGAX : SGY(1)=SGY(1)+SGCOR*SGBX : SGY(2)=SGY(2)+SGCOR*SGCX : SGOY(0)=SGOY(0)+SGCOR*SGAX : SGOY(1)=SGOY(1)+SGCOR*SGBX : SGOY(2)=SGOY(2)+SGCOR*SGCX
32400 SGVEL=SGAX*(SGY(0)-SGOY(0))+SGBX*(SGY(1)-SGOY(1))+SGCX*(SGY(2)-SGOY(2)) : IF SGVEL>=0 THEN GOTO 32420
32410 SGIMP=SGVEL/SGDEN : IF SGVEL<-0.007 THEN SGIMP=SGIMP*1.06
32415 SGOY(0)=SGOY(0)+SGIMP*SGAX : SGOY(1)=SGOY(1)+SGIMP*SGBX : SGOY(2)=SGOY(2)+SGIMP*SGCX
32420 NEXT SGP : GOSUB 32500 : NEXT SGIT
32430 SGLIFT=0 : FOR SGP=0 TO SGCOUNT-1
32440 IF SGHIT(SGP) THEN SGLIFT=MAX(SGLIFT,SGTARGET(SGP)-SGWA(SGP)*SGY(0)-SGWB(SGP)*SGY(1)-SGWC(SGP)*SGY(2))
32450 NEXT SGP
32460 IF SGLIFT>0 THEN FOR SGV=0 TO SGNV-1 : SGY(SGV)=SGY(SGV)+SGLIFT : SGOY(SGV)=SGOY(SGV)+SGLIFT : NEXT SGV
32470 FOR SGV=0 TO SGNV-1 : SGOX(SGV)=SGX(SGV)-(SGX(SGV)-SGOX(SGV))*0.72 : SGOZ(SGV)=SGZ(SGV)-(SGZ(SGV)-SGOZ(SGV))*0.72 : SGOY(SGV)=SGY(SGV)-(SGY(SGV)-SGOY(SGV))*0.85 : NEXT SGV : RETURN
32500 REM Exact shape projection with a common floor lift, preserving old-pose velocity.
32510 SGCX0=0 : SGCY0=0 : SGCZ0=0 : FOR SGV=0 TO SGNV-1 : SGCX0=SGCX0+SGX(SGV)/SGNV : SGCY0=SGCY0+SGY(SGV)/SGNV : SGCZ0=SGCZ0+SGZ(SGV)/SGNV : NEXT SGV
32520 SGEX=SGX(1)-SGX(0) : SGEY=SGY(1)-SGY(0) : SGEZ=SGZ(1)-SGZ(0) : SGEL=SQR(SGEX*SGEX+SGEY*SGEY+SGEZ*SGEZ)
32521 IF SGEL<0.000001 THEN SGEX=1 : SGEY=0 : SGEZ=0 : SGEL=1
32522 SGEX=SGEX/SGEL : SGEY=SGEY/SGEL : SGEZ=SGEZ/SGEL
32530 SGA=SGL(0) : IF SGNV=2 THEN GOTO 32575
32540 SGQX=SGX(2)-SGX(0) : SGQY=SGY(2)-SGY(0) : SGQZ=SGZ(2)-SGZ(0) : SGPROJ=SGQX*SGEX+SGQY*SGEY+SGQZ*SGEZ
32545 SGFX=SGQX-SGPROJ*SGEX : SGFY=SGQY-SGPROJ*SGEY : SGFZ=SGQZ-SGPROJ*SGEZ : SGFL=SQR(SGFX*SGFX+SGFY*SGFY+SGFZ*SGFZ)
32546 IF SGFL<0.000001 THEN SGFX=-SGEZ : SGFY=0 : SGFZ=SGEX : SGFL=SQR(SGFX*SGFX+SGFZ*SGFZ)
32547 IF SGFL<0.000001 THEN SGFX=1 : SGFY=0 : SGFZ=0 : SGFL=1
32548 SGFX=SGFX/SGFL : SGFY=SGFY/SGFL : SGFZ=SGFZ/SGFL
32550 SGB=(SGL(2)^2+SGA^2-SGL(1)^2)/(2*MAX(0.000001,SGA)) : SGC=SQR(MAX(0,SGL(2)^2-SGB^2))
32555 FOR SGV=0 TO 2
32560 SGLX=-(SGA+SGB)/3 : SGLY=-SGC/3 : IF SGV=1 THEN SGLX=SGLX+SGA
32565 IF SGV=2 THEN SGLX=SGLX+SGB : SGLY=SGLY+SGC
32570 SGNEWX=SGCX0+SGEX*SGLX+SGFX*SGLY : SGNEWY=SGCY0+SGEY*SGLX+SGFY*SGLY : SGNEWZ=SGCZ0+SGEZ*SGLX+SGFZ*SGLY : GOSUB 32590 : NEXT SGV : GOTO 32580
32575 FOR SGV=0 TO 1 : SGLX=(SGV-0.5)*SGA : SGNEWX=SGCX0+SGEX*SGLX : SGNEWY=SGCY0+SGEY*SGLX : SGNEWZ=SGCZ0+SGEZ*SGLX : GOSUB 32590 : NEXT SGV
32580 SGLIFT=0 : FOR SGV=0 TO SGNV-1 : SGLIFT=MAX(SGLIFT,SGFLOOR-SGY(SGV)) : NEXT SGV
32585 IF SGLIFT>0 THEN FOR SGV=0 TO SGNV-1 : SGY(SGV)=SGY(SGV)+SGLIFT : SGOY(SGV)=SGOY(SGV)+SGLIFT : NEXT SGV
32587 RETURN
32590 SGOX(SGV)=SGOX(SGV)+SGNEWX-SGX(SGV) : SGOY(SGV)=SGOY(SGV)+SGNEWY-SGY(SGV) : SGOZ(SGV)=SGOZ(SGV)+SGNEWZ-SGZ(SGV) : SGX(SGV)=SGNEWX : SGY(SGV)=SGNEWY : SGZ(SGV)=SGNEWZ : RETURN
32600 REM Freeze settled material into the support map. R clears all stamps and poses.
32610 SGVMAX=0 : SGHIGH=MAX(SGY(0),SGY(1)) : SGLOW=MIN(SGY(0),SGY(1)) : IF SGNV=3 THEN SGHIGH=MAX(SGHIGH,SGY(2)) : SGLOW=MIN(SGLOW,SGY(2))
32615 SGSTEEP=SGHIGH-SGLOW>0.80*SGL(0)
32620 IF SGNV=3 THEN SGSTEEP=ABS(SGEX*SGFZ-SGEZ*SGFX)<0.25
32630 FOR SGV=0 TO SGNV-1 : SGVMAX=MAX(SGVMAX,ABS(SGX(SGV)-SGOX(SGV)),ABS(SGY(SGV)-SGOY(SGV)),ABS(SGZ(SGV)-SGOZ(SGV))) : NEXT SGV
32631 SGSTABLE=0 : SGTESTSUP=0 : IF SGTOUCH>0 AND (SGVMAX<0.0028 OR SGSTEEP) THEN SGTESTSUP=1 : GOSUB 32700
32632 IF SGTESTSUP AND SGSTABLE=0 THEN GOSUB 32800
32635 SGREST=0 : IF SGNV=2 THEN SGREST=BEAMSLEEP(SGID) ELSE SGREST=FSLEEP(SGFACE)
32640 IF SGTOUCH>0 AND SGSTEEP=0 AND SGSTABLE AND SGVMAX<0.0028 THEN SGREST=SGREST+1 ELSE SGREST=0
32645 SGNEWSTATE=1 : IF SGREST>=16 THEN SGNEWSTATE=2
32650 FOR SGV=0 TO SGNV-1
32655 IF SGNEWSTATE=2 THEN SGOX(SGV)=SGX(SGV) : SGOY(SGV)=SGY(SGV) : SGOZ(SGV)=SGZ(SGV)
32660 SGPASTX(SGID,SGV)=SGX(SGV) : SGPASTY(SGID,SGV)=SGY(SGV) : SGPASTZ(SGID,SGV)=SGZ(SGV)
32665 IF SGNV=3 THEN GOTO 32675
32670 BEAMPX(SGID,SGV)=SGX(SGV) : BEAMPY(SGID,SGV)=SGY(SGV) : BEAMPZ(SGID,SGV)=SGZ(SGV) : BEAMOX(SGID,SGV)=SGOX(SGV) : BEAMOY(SGID,SGV)=SGOY(SGV) : BEAMOZ(SGID,SGV)=SGOZ(SGV) : GOTO 32680
32675 FXP(SGFACE,SGV)=SGX(SGV) : FYP(SGFACE,SGV)=SGY(SGV) : FZP(SGFACE,SGV)=SGZ(SGV) : FOX(SGFACE,SGV)=SGOX(SGV) : FOY(SGFACE,SGV)=SGOY(SGV) : FOZ(SGFACE,SGV)=SGOZ(SGV)
32680 NEXT SGV : SGHAVE(SGID)=1
32685 IF SGNV=2 THEN BSTATE(SGID)=SGNEWSTATE : BEAMSLEEP(SGID)=SGREST ELSE FSTATE(SGFACE)=SGNEWSTATE : FSLEEP(SGFACE)=SGREST
32690 IF SGNEWSTATE=2 AND SGSTAMPED(SGID)=0 AND SGADDED<2 THEN GOSUB 33000
32695 RETURN
32700 REM Freeze only when the contact footprint supports the fragment's centre of mass.
32710 SGSUPN=0 : SGSCX=0 : SGSCZ=0 : SGAMIN=1 : SGBMIN=1 : SGCMIN=1 : SGAMAX=0 : SGBMAX=0 : SGCMAX=0
32720 FOR SGP=0 TO SGCOUNT-1
32730 IF SGHIT(SGP)=0 THEN GOTO 32770
32740 SGPY=SGWA(SGP)*SGY(0)+SGWB(SGP)*SGY(1)+SGWC(SGP)*SGY(2) : IF SGPY>SGTARGET(SGP)+0.012 THEN GOTO 32770
32750 SGSUPN=SGSUPN+1 : SGSCX=SGSCX+SGWA(SGP)*SGX(0)+SGWB(SGP)*SGX(1)+SGWC(SGP)*SGX(2) : SGSCZ=SGSCZ+SGWA(SGP)*SGZ(0)+SGWB(SGP)*SGZ(1)+SGWC(SGP)*SGZ(2)
32760 SGAMIN=MIN(SGAMIN,SGWA(SGP)) : SGAMAX=MAX(SGAMAX,SGWA(SGP)) : SGBMIN=MIN(SGBMIN,SGWB(SGP)) : SGBMAX=MAX(SGBMAX,SGWB(SGP)) : SGCMIN=MIN(SGCMIN,SGWC(SGP)) : SGCMAX=MAX(SGCMAX,SGWC(SGP))
32770 NEXT SGP
32780 IF SGSUPN=0 THEN SGSCX=SGCX0 : SGSCZ=SGCZ0 : RETURN
32785 SGSCX=SGSCX/SGSUPN : SGSCZ=SGSCZ/SGSUPN
32790 IF SGNV=2 THEN SGSTABLE=SGBMIN<=0.55 AND SGBMAX>=0.45 : RETURN
32795 SGSTABLE=SGAMIN<=1/3+0.025 AND SGAMAX>=1/3-0.025 AND SGBMIN<=1/3+0.025 AND SGBMAX>=1/3-0.025 AND SGCMIN<=1/3+0.025 AND SGCMAX>=1/3-0.025 : RETURN
32800 REM An unsupported quiet piece tips away from its contacts instead of freezing in the air.
32810 SGTOPV=0 : FOR SGV=1 TO SGNV-1
32815 IF SGY(SGV)>SGY(SGTOPV)+0.01 THEN SGTOPV=SGV : GOTO 32825
32820 IF ABS(SGY(SGV)-SGY(SGTOPV))<=0.01 THEN IF (SGX(SGV)-SGSCX)^2+(SGZ(SGV)-SGSCZ)^2>(SGX(SGTOPV)-SGSCX)^2+(SGZ(SGTOPV)-SGSCZ)^2 THEN SGTOPV=SGV
32825 NEXT SGV
32830 SGKX=SGX(SGTOPV)-SGSCX : SGKZ=SGZ(SGTOPV)-SGSCZ : SGKL=SQR(SGKX*SGKX+SGKZ*SGKZ)
32840 IF SGKL<0.0001 AND SGNV=3 THEN SGKX=SGEY*SGFZ-SGEZ*SGFY : SGKZ=SGEX*SGFY-SGEY*SGFX : SGKL=SQR(SGKX*SGKX+SGKZ*SGKZ)
32850 IF SGKL<0.0001 THEN SGKX=1 : SGKZ=0.37 : SGKL=SQR(1+0.37^2)
32860 SGOX(SGTOPV)=SGOX(SGTOPV)-SGKX/SGKL*0.22*H : SGOZ(SGTOPV)=SGOZ(SGTOPV)-SGKZ/SGKL*0.22*H : RETURN
33000 REM Deposit actual footprint once. Static pieces deliberately stay fixed until rebuild.
33010 IF SGSTAMPED(SGID) THEN RETURN
33020 IF SGNV=2 THEN SGVA=0 : SGVB=1 : GOSUB 33100 : GOTO 33070
33030 SGVA=0 : SGVB=1 : GOSUB 33100 : SGVA=1 : SGVB=2 : GOSUB 33100 : SGVA=2 : SGVB=0 : GOSUB 33100 : GOSUB 33200
33070 SGSTAMPED(SGID)=1 : SGADDED=SGADDED+1 : SGDEPOSITED=SGDEPOSITED+1 : SGTOTALSTATIC=SGTOTALSTATIC+1 : RETURN
33100 REM Thin beam/edge DDA, sampled at half a grid cell rather than using a box footprint.
33110 SGDX=SGX(SGVB)-SGX(SGVA) : SGDZ=SGZ(SGVB)-SGZ(SGVA) : SGDY=SGY(SGVB)-SGY(SGVA) : SGSTEPS=MAX(1,INT(MAX(ABS(SGDX),ABS(SGDZ))*10)+1)
33120 FOR SGS=0 TO SGSTEPS
33130 SGT=SGS/SGSTEPS : SGPX=SGX(SGVA)+SGDX*SGT : SGPZ=SGZ(SGVA)+SGDZ*SGT : SGPY=SGY(SGVA)+SGDY*SGT+SGRAD : GOSUB 33300
33140 NEXT SGS : RETURN
33200 REM Fill projected triangle with barycentric surface heights; empty corners stay empty.
33210 SGTAX=SGX(1)-SGX(0) : SGTAZ=SGZ(1)-SGZ(0) : SGTBX=SGX(2)-SGX(0) : SGTBZ=SGZ(2)-SGZ(0) : SGTDEN=SGTAX*SGTBZ-SGTAZ*SGTBX : IF ABS(SGTDEN)<0.00001 THEN RETURN
33220 SGXMIN=MAX(0,INT((MIN(SGX(0),SGX(1),SGX(2))+24)*5)) : SGXMAX=MIN(240,INT((MAX(SGX(0),SGX(1),SGX(2))+24)*5)+1)
33230 SGZMIN=MAX(0,INT((MIN(SGZ(0),SGZ(1),SGZ(2))+24)*5)) : SGZMAX=MIN(240,INT((MAX(SGZ(0),SGZ(1),SGZ(2))+24)*5)+1)
33240 FOR SGIX=SGXMIN TO SGXMAX
33250 SGQPX=SGIX*0.2-24-SGX(0)
33260 FOR SGIZ=SGZMIN TO SGZMAX
33270 SGQPZ=SGIZ*0.2-24-SGZ(0) : SGU=(SGQPX*SGTBZ-SGQPZ*SGTBX)/SGTDEN : SGV0=(SGTAX*SGQPZ-SGTAZ*SGQPX)/SGTDEN
33280 IF SGU<0 OR SGV0<0 OR SGU+SGV0>1 THEN GOTO 33295
33290 SGPY=SGY(0)+(SGY(1)-SGY(0))*SGU+(SGY(2)-SGY(0))*SGV0+SGRAD : SGHEIGHT(SGIX,SGIZ)=MAX(SGHEIGHT(SGIX,SGIZ),SGPY) : SGMAXHEIGHT=MAX(SGMAXHEIGHT,SGPY)
33295 NEXT SGIZ : NEXT SGIX : RETURN
33300 SGIX=INT((SGPX+24)*5+0.5) : SGIZ=INT((SGPZ+24)*5+0.5)
33310 IF SGIX<0 OR SGIX>240 OR SGIZ<0 OR SGIZ>240 THEN RETURN
33320 SGHEIGHT(SGIX,SGIZ)=MAX(SGHEIGHT(SGIX,SGIZ),SGPY) : SGMAXHEIGHT=MAX(SGMAXHEIGHT,SGPY) : RETURN
