9140 IF EVCORE AND MUTED=0 THEN AUDIO PLAY 5,5,0,0.70
9150 EVLAUNCH=0 : EVIMPACT=0 : EVBREAK=0 : EVWIN=0 : EVCORE=0 : RETURN
9250 IF MUSIC=0 OR MUTED THEN AUDIO STOP 1:RETURN
9252 AUDIO PLAY 1,1,1,0.65 : RETURN
9260 AUDIO STOP : NEXTBREAK=T : GOSUB 9250 : RETURN
9270 IF MUTED THEN AUDIO OFF:RETURN
9272 AUDIO ON : GOSUB 9250 : RETURN
9400 REM Cosmetic shards have their own bounded pool; they never feed the solver.
9410 ADT=DT*TIMESCALE
9420 FOR AI=0 TO 179
9430 IF ALIFE(AI)<=0 THEN GOTO 9470
9440 ALIFE(AI)=ALIFE(AI)-ADT : AVY(AI)=AVY(AI)-ADT*6
9450 AX(AI)=AX(AI)+AVX(AI)*ADT : AY(AI)=AY(AI)+AVY(AI)*ADT : AZ(AI)=AZ(AI)+AVZ(AI)*ADT
9460 IF AY(AI)<0.15 THEN AY(AI)=0.15:AVY(AI)=ABS(AVY(AI))*0.25:AVX(AI)=AVX(AI)*0.7:AVZ(AI)=AVZ(AI)*0.7
9470 NEXT AI : RETURN
9500 IF PARTICLES=0 THEN RETURN
9510 NNEW=MIN(8,2+EVBREAK+EVIMPACT*2)
9520 FOR AJ=1 TO NNEW
9530 AI=SHARDHEAD : SHARDHEAD=(SHARDHEAD+1) MOD 180 : ANG=AI*2.39996+T*1.7
9540 AX(AI)=EVENTX : AY(AI)=EVENTY : AZ(AI)=EVENTZ
9550 AVX(AI)=COS(ANG)*(1.2+(AI MOD 5)*0.45) : AVZ(AI)=SIN(ANG)*(1.2+(AI MOD 7)*0.3) : AVY(AI)=1+(AI MOD 9)*0.45
9560 ALIFE(AI)=0.7+(AI MOD 11)*0.075 : ASIZE(AI)=0.028+(AI MOD 4)*0.012 : ACOL(AI)=1+(AI MOD 3)
