14680 IF HSScores(HSDraw)>0 THEN LOCATE ROUND(43*ScreenScaleX),ROUND((11+HSDraw)*ScreenScaleY):GPRINT STR$(HSScores(HSDraw))
14690 NEXT HSDraw : RETURN
15000 REM Optional CSV beside the sample. Missing/malformed data starts with an empty table.
15010 HSCount=0 : MAT HSScores=0 : FOR HSI=0 TO 4 : HSNames$(HSI)="" : NEXT HSI
15020 ON ERROR GOTO 15360
