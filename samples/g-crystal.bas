14230 IF HSIOFailed THEN INK RGB(255,184,142):LOCATE ROUND(17*ScreenScaleX),ROUND(23*ScreenScaleY):GPRINT "SAVE FAILED - SCORES KEPT THIS SESSION"
14240 FRAME 60 : HSKey$=INKEY$
14250 IF HSKey$<>CHR$(13) AND HSKey$<>CHR$(27) AND UPPER$(HSKey$)<>"H" THEN GOTO 14240
14260 GOSUB 14400 : RETURN
14400 REM Drain held action keys and reset wall-time baselines, without touching accumulated physics.
14410 WHILE KEYDOWN(13) OR KEYDOWN(27) OR KEYDOWN(72) OR KEYDOWN(82) OR KEYDOWN(68) OR KEYDOWN(32) OR MOUSELEFT : FRAME 60 : WEND
14420 CLEAR INPUT : K$="" : LAST=TIME : TLAST=LAST : FCOUNT=0 : HELDSHOT=0 : RETURN
14600 FRECTANGLE 80,80,559,400,RGB(8,17,30) : RECTANGLE 80,80,559,400,RGB(93,190,211)
14610 BIGFONT TRANSPARENT : INK RGB(255,224,142) : LOCATE ROUND(WIDTH/32-8),ROUND(6*ScreenScaleY) : GPRINT "CRYSTAL TOP FIVE"
14620 SMALLFONT TRANSPARENT : INK RGB(152,184,202) : LOCATE ROUND(17*ScreenScaleX),ROUND(9*ScreenScaleY) : GPRINT "RANK"
14622 LOCATE ROUND(22*ScreenScaleX),ROUND(9*ScreenScaleY) : GPRINT "NAME"
