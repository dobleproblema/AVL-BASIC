14050 INK RGB(152,184,202) : LOCATE ROUND(17*ScreenScaleX),ROUND(22*ScreenScaleY) : GPRINT "ENTER SAVE   BACKSPACE EDIT   ESC SKIP"
14060 FRAME 60 : HSKey$=INKEY$ : IF HSKey$="" THEN GOTO 14060
14070 HSCode=ASC(HSKey$)
14080 IF HSCode=27 THEN HSCancel=1:GOSUB 14400:RETURN
14090 IF HSCode=13 THEN GOSUB 13800:GOSUB 14400:RETURN
14100 IF HSCode=8 AND LEN(HSName$)>0 THEN HSName$=LEFT$(HSName$,LEN(HSName$)-1)
14110 IF ((HSCode>=65 AND HSCode<=90) OR (HSCode>=97 AND HSCode<=122)) AND LEN(HSName$)<3 THEN HSName$=HSName$+UPPER$(HSKey$)
14120 GOTO 14020
14200 REM H is a read-only modal: preserve pause, camera, aim, simulation and audio.
14210 GOSUB 14400 : GOSUB 14600
