100 REM ===============================================================
105 REM FAST STACKING: settled fragments form a sampled support surface.
110 REM AVL CRYSTAL SIEGE - a breakable cathedral in pure AVL BASIC
120 REM GOSUB with shared arrays; fixed-step Verlet, depth-tested facets and AUDIO.
130 REM Ten orbs: rescue the gold core, then optionally demolish what remains.
132 REM Rescue records count shots; destruction points reward damage and real collapse.
133 REM H shows the persistent top five; qualifying names use up to three uppercase A-Z letters.
134 REM Scores live in g-crystal-scores.csv beside this sample; demos never enter the table.
135 REM Beams and panels fall onto deposited rubble, forming persistent layered piles.
136 REM Structure data is loaded once from LevelFile$; R reuses its in-memory rest state.
137 REM C opens the external construction catalog; score entries are keyed by structure ID.
140 REM Arrows orbit; W/S zoom; D auto siege; T slow motion; P pause; R rebuild.
150 REM I technical info; Q solver passes (default 3); F free FPS; M display; B music; N mute; ESC exit.
155 ScreenMode=640 : REM Initial display width: 640, 800 or 1024; M cycles during play.
157 CatalogFile$="assets/crystal/structures.csv"
160 SCREEN : MODE ScreenMode : RAD : MAT BASE 0 : PAPER RGB(5,7,17) : CLG
170 DIM SX(219),SY(219),DEPTHQ(219),PR(6),PG(6),PB(6),DEMONODE(5),DEMOX(5),DEMOY(5),DEMOZ(5),DEMOCAY(5),DEMOCAP(5),DEMOCAD(5)
175 DIM RODSX(7),RODSY(7),RODSQ(7)
180 DIM STARX(89),STARY(89),STARC(89),AX(179),AY(179),AZ(179),AVX(179),AVY(179),AVZ(179),ALIFE(179),ASIZE(179),ACOL(179)
185 GOSUB 12500
190 SMALLFONT TRANSPARENT : INK RGB(145,230,243) : LOCATE ROUND(WIDTH/16-26),ROUND(14*ScreenScaleY) : GPRINT "FAST STACKING - GROWING A CATHEDRAL..." : FRAME
195 GOSUB 18000
200 GOSUB 12000 : GOSUB 2000 : GOSUB 6600 : GOSUB 20000 : GOSUB 30000 : GOSUB 9000
210 CAP=1 : PITER=3 : SLOW=0 : PAUSED=0 : MUSIC=1 : MUTED=0 : PARTICLES=1 : ShowInfo=0
220 CAMYAW=LevelYaw : CAMPITCH=LevelPitch : CAMDIST=LevelDistance : TARGETY=LevelTargetY : FOC=LevelFocus : VIEWY=LevelViewY
230 AIMSCREENX=320 : AIMSCREENY=265 : LASTMX=MOUSEX : LASTMY=MOUSEY : HELDSHOT=0
240 SIMT=0 : T=0 : ACCUM=0 : FPS=0 : FCOUNT=0 : FRAMES=0 : TLAST=TIME : LAST=TIME : SHARDHEAD=0 : BESTUSED=0 : COREAWARDED=0 : COREBANNER=-1 : CORESHOTS=0 : DESTSCORE=0 : DESTBEST=0 : DESTFALL=0 : DESTHEIGHT=0
245 DIM HSScores(4),HSNames$(4) : GOSUB 15000
250 GOSUB 9250
300 NOW=TIME : DT=MAX(0.0001,MIN(0.05,NOW-LAST)) : LAST=NOW : T=T+DT
310 K$=UPPER$(INKEY$)
320 IF K$=CHR$(27) OR KEYDOWN(27) THEN GOSUB 13400:AUDIO STOP:MOUSE 1:SCREEN CLOSE:END
330 IF K$="R" THEN GOSUB 13400:GOSUB 1400
335 IF K$="D" THEN GOSUB 13400:GOSUB 1400:HSDemo=1:AUTORUN=1:DEMOSTAGE=0:NEXTDEMO=1:SLOW=0
340 IF K$="T" THEN SLOW=1-SLOW
350 IF K$="P" THEN PAUSED=1-PAUSED
360 IF K$="F" THEN CAP=1-CAP
370 IF K$="Q" THEN PITER=PITER+1:IF PITER>5 THEN PITER=2
380 IF K$="B" THEN MUSIC=1-MUSIC:GOSUB 9250
390 IF K$="N" THEN MUTED=1-MUTED:GOSUB 9270
391 IF K$="M" THEN GOSUB 12400
392 CAMINPUT=ABS(KEYDOWN(28))+ABS(KEYDOWN(29))+ABS(KEYDOWN(30))+ABS(KEYDOWN(31))+ABS(KEYDOWN(87))+ABS(KEYDOWN(83))
393 IF K$="I" THEN ShowInfo=1-ShowInfo
394 IF CAMINPUT>0 THEN AUTORUN=0
395 IF AUTORUN THEN GOSUB 1700
396 IF K$="H" THEN GOSUB 14200
397 IF K$="C" THEN GOSUB 18500
400 CAMYAW=CAMYAW+(ABS(KEYDOWN(29))-ABS(KEYDOWN(28)))*DT*0.85
410 CAMPITCH=MAX(0.09,MIN(0.72,CAMPITCH+(ABS(KEYDOWN(30))-ABS(KEYDOWN(31)))*DT*0.45))
420 CAMDIST=MAX(MinCameraDistance,MIN(MaxCameraDistance,CAMDIST+(ABS(KEYDOWN(83))-ABS(KEYDOWN(87)))*DT*8))
430 GOSUB 1200
435 IF AUTORUN AND DEMOSTAGE<DemoCount THEN RWX=X(DEMONODE(DEMOSTAGE)):RWY=Y(DEMONODE(DEMOSTAGE)):RWZ=Z(DEMONODE(DEMOSTAGE)):GOSUB 8800:IF RQ>0 THEN AIMSCREENX=MAX(12,MIN(628,RX2)):AIMSCREENY=MAX(55,MIN(427,RY2))
440 IF MOUSEX<>LASTMX OR MOUSEY<>LASTMY THEN IF MOUSEX>8 AND MOUSEX<632 AND MOUSEY>48 AND MOUSEY<431 THEN AIMSCREENX=MOUSEX:AIMSCREENY=MOUSEY
450 LASTMX=MOUSEX : LASTMY=MOUSEY
460 DOWNFIRE=ABS(MOUSELEFT) OR ABS(KEYDOWN(32))
470 IF DOWNFIRE AND HELDSHOT=0 AND PAUSED=0 THEN AUTORUN=0:GOSUB 1300
480 HELDSHOT=DOWNFIRE
485 IF AUTORUN AND PAUSED=0 THEN GOSUB 1500
490 PHYBEGIN=TIME : H=1/90 : TIMESCALE=1 : IF SLOW THEN TIMESCALE=0.22
500 IF PAUSED=0 THEN ACCUM=ACCUM+DT*TIMESCALE
510 NSTEPS=0
520 IF PAUSED OR ACCUM<H OR NSTEPS>=4 THEN GOTO 560
530 GOSUB 5000 : GOSUB 1650 : GOSUB 6700 : GOSUB 21000 : GOSUB 31000 : SIMT=SIMT+H : ACCUM=ACCUM-H : NSTEPS=NSTEPS+1
540 GOTO 520
560 IF NSTEPS>=4 THEN ACCUM=MIN(ACCUM,H)
570 IF PAUSED=0 THEN GOSUB 9400
580 GOSUB 9100
590 PHYMS=PHYMS*0.85+(TIME-PHYBEGIN)*150 : DRAWTIME=TIME
600 GOSUB 7000
610 DRAWMS=DRAWMS*0.85+(TIME-DRAWTIME)*150 : GOSUB 10000
620 IF CAP THEN FRAME 60 ELSE FRAME
630 FRAMES=FRAMES+1 : FCOUNT=FCOUNT+1
640 IF TIME-TLAST>=0.5 THEN FPS=FCOUNT/(TIME-TLAST):FCOUNT=0:TLAST=TIME
645 GOSUB 13000
650 GOTO 300
1200 REM Camera: right/up/forward form an orthonormal world-space basis.
1210 CYAW=COS(CAMYAW) : SYAW=SIN(CAMYAW) : CPITCH=COS(CAMPITCH) : SPITCH=SIN(CAMPITCH)
1220 CFX=-CYAW*CPITCH : CFY=-SPITCH : CFZ=-SYAW*CPITCH
1230 CRX=SYAW : CRY=0 : CRZ=-CYAW : CUX=-CYAW*SPITCH : CUY=CPITCH : CUZ=-SYAW*SPITCH
1240 CAMX=-CFX*CAMDIST : CAMY=TARGETY-CFY*CAMDIST : CAMZ=-CFZ*CAMDIST
1250 RETURN
1300 REM The visible crosshair defines the same ray used by the projectile.
1310 U=(AIMSCREENX-320)/FOC : V=(AIMSCREENY-VIEWY)/FOC
1320 AIMX=CFX+CRX*U+CUX*V : AIMY=CFY+CRY*U+CUY*V : AIMZ=CFZ+CRZ*U+CUZ*V
1330 L=SQR(AIMX*AIMX+AIMY*AIMY+AIMZ*AIMZ) : AIMX=AIMX/L : AIMY=AIMY/L : AIMZ=AIMZ/L
1340 LAUNCHX=CAMX+AIMX*0.9 : LAUNCHY=CAMY+AIMY*0.9 : LAUNCHZ=CAMZ+AIMZ*0.9
1350 GOSUB 6000 : RETURN
1400 GOSUB 2000 : GOSUB 6600 : GOSUB 20000 : GOSUB 30000 : MAT ALIFE=0 : ACCUM=0 : SIMT=0 : PAUSED=0 : AUTORUN=0 : SHARDHEAD=0 : COREAWARDED=0 : COREBANNER=-1 : CORESHOTS=0 : EVCORE=0 : DESTSCORE=0 : DESTFALL=0 : DESTHEIGHT=0 : HSDone=0 : HSDemo=0 : HSQuietAt=0 : HSObserved=0 : GOSUB 9260 : LAST=TIME : RETURN
1500 REM Study the real bearing joints from several sides; no scripted collapse.
1505 IF WON OR DEMOSTAGE>=DemoCount THEN AUTORUN=0:RETURN
1510 IF SIMT<NEXTDEMO OR BACTIVE THEN RETURN
1520 LAUNCHX=DEMOX(DEMOSTAGE) : LAUNCHY=DEMOY(DEMOSTAGE) : LAUNCHZ=DEMOZ(DEMOSTAGE) : TARNODE=DEMONODE(DEMOSTAGE)
1530 AIMX=X(TARNODE)-LAUNCHX : AIMY=Y(TARNODE)-LAUNCHY : AIMZ=Z(TARNODE)-LAUNCHZ
1535 FLIGHT=SQR(AIMX*AIMX+AIMY*AIMY+AIMZ*AIMZ)/32 : AIMY=AIMY+0.6*FLIGHT*FLIGHT
1540 GOSUB 6000 : DEMOSTAGE=DEMOSTAGE+1 : NEXTDEMO=SIMT+3
1550 IF DEMOSTAGE>=DemoCount THEN AUTORUN=0
1560 RETURN
1600 REM Session record counts shots until core rescue, not optional demolition.
1610 USEDSHOTS=MAXSHOTS-SHOTS : IF USEDSHOTS<1 THEN RETURN
1620 IF BESTUSED=0 OR USEDSHOTS<BESTUSED THEN BESTUSED=USEDSHOTS
1630 RETURN
1650 REM Separate 0..10000 destruction score. Peaks retain credit through rebounds.
1655 IF HITCOUNT=0 AND BROKEN=0 THEN RETURN
1660 DESTFALL=MAX(DESTFALL,MIN(1,MAX(0,DEMOLITION)))
1670 DESTHEIGHT=MAX(DESTHEIGHT,MIN(1,MAX(0,HEIGHTLOSS)))
1680 DESTSCORE=MAX(DESTSCORE,MIN(10000,INT(3000*MIN(1,MAX(0,BROKEN/MAX(1,NE)))+3000*DESTFALL+4000*DESTHEIGHT))) : DESTBEST=MAX(DESTBEST,DESTSCORE)
1690 RETURN
1700 IF DEMOSTAGE>=DemoCount THEN RETURN
1710 CAMDELTA=DEMOCAY(DEMOSTAGE)-CAMYAW : CAMDELTA=CAMDELTA-2*PI*INT((CAMDELTA+PI)/(2*PI))
1720 EASE=MIN(1,DT*2.8) : CAMYAW=CAMYAW+CAMDELTA*EASE
1730 CAMPITCH=CAMPITCH+(DEMOCAP(DEMOSTAGE)-CAMPITCH)*EASE : CAMDIST=CAMDIST+(DEMOCAD(DEMOSTAGE)-CAMDIST)*EASE
1740 RETURN
1800 REM Destruction tally and session record remain visible in the top header.
1810 REM The main HUD paints the header before drawing its two text rows.
1820 SMALLFONT TRANSPARENT : INK RGB(143,237,183) : LOCATE ROUND(2*ScreenScaleX),ROUND(2*ScreenScaleY) : GPRINT "DESTRUCTION ";STR$(DESTSCORE);" PTS  RECORD ";STR$(DESTBEST)
1830 RETURN
2000 REM Load the selected structure once; rebuild reuses all allocated physics arrays.
2010 IF PBUILT THEN GOTO 2150
2020 DIM X(219),Y(219),Z(219),OLDX(219),OLDY(219),OLDZ(219),RX(219),RY(219),RZ(219),IM(219),NK(219),NR(219),NC(219),PDAMAGE(219),WK(219),WKUSED(219),LANDED(219)
2030 DIM EA(499),EB(499),EL(499),ACTIVE(499),STRAIN(499),PHEAT(499),FA(95),FB(95),FC(95),FE1(95),FE2(95),FE3(95)
2040 GOSUB 16000
2130 PBUILT=1
2150 FOR P=0 TO NP-1
2160 X(P)=RX(P):Y(P)=RY(P):Z(P)=RZ(P):OLDX(P)=X(P):OLDY(P)=Y(P):OLDZ(P)=Z(P):PDAMAGE(P)=0:WKUSED(P)=0:LANDED(P)=0
2170 NEXT P
2180 MAT ACTIVE=1:MAT STRAIN=0:MAT PHEAT=0
2185 MAXSHOTS=LevelShots
2190 SHOTS=MAXSHOTS:BROKEN=0:HITCOUNT=0:WON=0:BACTIVE=0:BTTL=0:PSTIME=0:EVLAUNCH=0:EVIMPACT=0:EVBREAK=0:EVWIN=0:PINBLAST=0:FALLEN=0:DEMOLITION=0:COREPRIOR=0:WEAKHITS=0:WKBROKEN=0:HEIGHTLOSS=0
2200 IF PITER<1 THEN PITER=3
2210 RETURN
5000 REM One fixed Verlet/PBD step; callers accumulate wall time and pass H.
5010 PSTIME=PSTIME+H
5020 IF BACTIVE THEN GOSUB 5500
5030 PG=9.0*H*H
5040 FOR P=0 TO NP-1
5050 IF IM(P)=0 THEN GOTO 5110
5060 PVX=(X(P)-OLDX(P))*0.994:PVY=(Y(P)-OLDY(P))*0.994:PVZ=(Z(P)-OLDZ(P))*0.994
5070 OLDX(P)=X(P):OLDY(P)=Y(P):OLDZ(P)=Z(P)
5080 X(P)=X(P)+PVX:Y(P)=Y(P)+PVY-PG:Z(P)=Z(P)+PVZ
5090 PDAMAGE(P)=MAX(0,PDAMAGE(P)-H*0.04)
5110 NEXT P
5120 FOR PIT=1 TO PITER
5130 FOR E=0 TO NE-1
5140 IF ACTIVE(E)=0 THEN GOTO 5260
5150 PA=EA(E):PB=EB(E):PWT=IM(PA)+IM(PB):IF PWT=0 THEN GOTO 5260
5160 PDX=X(PB)-X(PA):PDY=Y(PB)-Y(PA):PDZ=Z(PB)-Z(PA):PL=SQR(PDX*PDX+PDY*PDY+PDZ*PDZ)
5170 IF PL<0.00001 THEN GOTO 5260
5180 PS=ABS(PL-EL(E))/EL(E):STRAIN(E)=MAX(PS,STRAIN(E)*0.93)
5184 PFAIL=0.045*(1-0.7*MAX(PDAMAGE(PA),PDAMAGE(PB)))
5186 IF PA=CORE OR PB=CORE THEN PFAIL=PFAIL*0.65
5190 IF PS>PFAIL AND PSTIME>0.35 THEN GOSUB 5900:GOTO 5260
5200 PC=(PL-EL(E))/PL/PWT*0.88
5210 X(PA)=X(PA)+PDX*PC*IM(PA):Y(PA)=Y(PA)+PDY*PC*IM(PA):Z(PA)=Z(PA)+PDZ*PC*IM(PA)
5220 X(PB)=X(PB)-PDX*PC*IM(PB):Y(PB)=Y(PB)-PDY*PC*IM(PB):Z(PB)=Z(PB)-PDZ*PC*IM(PB)
5260 NEXT E
5270 FOR P=0 TO NP-1
5280 IF IM(P)=0 OR Y(P)>=0.25+NR(P) THEN GOTO 5320
5285 PVY=Y(P)-OLDY(P):IF LANDED(P)=0 AND PVY<-3.0*H THEN GOSUB 5940
5290 Y(P)=0.25+NR(P):OLDY(P)=Y(P)+MIN(0,PVY)*0.12
5300 OLDX(P)=X(P)-(X(P)-OLDX(P))*0.72:OLDZ(P)=Z(P)-(Z(P)-OLDZ(P))*0.72
5320 NEXT P
5330 NEXT PIT
5332 FALLEN=0:NMOBILE=0:PHDROP=0:PHREST=0
5334 FOR P=0 TO NP-1
5336 IF IM(P)>0 THEN NMOBILE=NMOBILE+1:PHDROP=PHDROP+MAX(0,RY(P)-Y(P)):PHREST=PHREST+RY(P)-0.25-NR(P):IF RY(P)-Y(P)>=1.5 THEN FALLEN=FALLEN+1
5338 NEXT P
5340 DEMOLITION=FALLEN/MAX(1,NMOBILE):HEIGHTLOSS=PHDROP/MAX(1,PHREST):MOBILE=NMOBILE:IF Y(CORE)<1.05 THEN COREPRIOR=1
5342 IF WON=0 AND DEMOLITION>=0.68 AND HEIGHTLOSS>=0.58 THEN WON=1:EVWIN=1
5350 RETURN
5500 REM Continuous projectile/edge contact: closest points on two segments.
5510 PBOXX=BX:PBOXY=BY:PBOXZ=BZ
5520 BVY=BVY-1.2*H:BX=BX+BVX*H:BY=BY+BVY*H:BZ=BZ+BVZ*H:BTTL=BTTL-H
5530 IF BTTL<=0 OR ABS(BX)>35 OR ABS(BZ)>35 THEN BACTIVE=0:RETURN
5540 PUX=BX-PBOXX:PUY=BY-PBOXY:PUZ=BZ-PBOXZ:PU2=PUX*PUX+PUY*PUY+PUZ*PUZ:PHIT=-1:PBEST=2
5550 FOR E=0 TO NE-1
5560 IF ACTIVE(E)=0 THEN GOTO 5740
5570 PA=EA(E):PB=EB(E)
5580 IF BX<MIN(X(PA),X(PB))-0.9 OR BX>MAX(X(PA),X(PB))+0.9 THEN GOTO 5740
5590 IF BY<MIN(Y(PA),Y(PB))-0.9 OR BY>MAX(Y(PA),Y(PB))+0.9 THEN GOTO 5740
5600 IF BZ<MIN(Z(PA),Z(PB))-0.9 OR BZ>MAX(Z(PA),Z(PB))+0.9 THEN GOTO 5740
5610 PVX=X(PB)-X(PA):PVY=Y(PB)-Y(PA):PVZ=Z(PB)-Z(PA):PV2=PVX*PVX+PVY*PVY+PVZ*PVZ:IF PV2<0.00001 THEN GOTO 5740
5620 PWX=PBOXX-X(PA):PWY=PBOXY-Y(PA):PWZ=PBOXZ-Z(PA)
5630 PUV=PUX*PVX+PUY*PVY+PUZ*PVZ:PUW=PUX*PWX+PUY*PWY+PUZ*PWZ:PVW=PVX*PWX+PVY*PWY+PVZ*PWZ:PDEN=PU2*PV2-PUV*PUV
5640 PSHOT=0:IF PDEN>1E-10 THEN PSHOT=MAX(0,MIN(1,(PUV*PVW-PV2*PUW)/PDEN))
5650 PT=MAX(0,MIN(1,(PUV*PSHOT+PVW)/PV2))
5660 PSHOT=MAX(0,MIN(1,(PUV*PT-PUW)/MAX(1E-10,PU2))):PT=MAX(0,MIN(1,(PUV*PSHOT+PVW)/PV2))
5670 PDX=PWX+PUX*PSHOT-PVX*PT:PDY=PWY+PUY*PSHOT-PVY*PT:PDZ=PWZ+PUZ*PSHOT-PVZ*PT
5680 IF PDX*PDX+PDY*PDY+PDZ*PDZ>0.28 THEN GOTO 5740
5690 IF PSHOT<PBEST THEN PHIT=E:PBEST=PSHOT
5740 NEXT E
5745 GOSUB 6200
5750 IF PHIT>=0 THEN EVENTX=PBOXX+PUX*PBEST:EVENTY=PBOXY+PUY*PBEST:EVENTZ=PBOXZ+PUZ*PBEST:GOSUB 5800:RETURN
5760 IF BY<0.45 THEN EVENTX=BX:EVENTY=0.3:EVENTZ=BZ:EVIMPACT=EVIMPACT+1:BACTIVE=0
5770 RETURN
5800 REM A resonant shock weakens nearby crystal; only strained bonds fracture.
5810 BACTIVE=0:HITCOUNT=HITCOUNT+1:EVIMPACT=EVIMPACT+1:PBVL=SQR(BVX*BVX+BVY*BVY+BVZ*BVZ):PBVL=MAX(1,PBVL):PHITX=EVENTX:PHITY=EVENTY:PHITZ=EVENTZ
5812 PWK=-1:PWKD=0.75*0.75
5814 FOR P=0 TO NP-1
5816 IF WK(P) AND WKUSED(P)=0 THEN PDX=X(P)-EVENTX:PDY=Y(P)-EVENTY:PDZ=Z(P)-EVENTZ:PL=PDX*PDX+PDY*PDY+PDZ*PDZ:IF PL<PWKD THEN PWK=P:PWKD=PL
5818 NEXT P
5820 FOR P=0 TO NP-1
5830 IF IM(P)=0 THEN GOTO 5860
5840 PDX=X(P)-EVENTX:PDY=Y(P)-EVENTY:PDZ=Z(P)-EVENTZ:PL=SQR(PDX*PDX+PDY*PDY+PDZ*PDZ):IF PL>=3 THEN GOTO 5860
5842 PDAMAGE(P)=MIN(0.7,PDAMAGE(P)+0.6*(1-PL/3))
5844 IF PL>=2.8 THEN GOTO 5860
5850 PC=(1-PL/2.8)*20*H:PL=MAX(0.35,PL):OLDX(P)=OLDX(P)-PC*(BVX/PBVL+PDX/PL*0.35):OLDY(P)=OLDY(P)-PC*(BVY/PBVL+PDY/PL*0.35+0.12):OLDZ(P)=OLDZ(P)-PC*(BVZ/PBVL+PDZ/PL*0.35)
5860 NEXT P
5870 PINBLAST=1:FOR E=0 TO NE-1
5872 IF ACTIVE(E)=0 THEN GOTO 5885
5874 PA=EA(E):PB=EB(E):PDX=X(PB)-X(PA):PDY=Y(PB)-Y(PA):PDZ=Z(PB)-Z(PA):PL=PDX*PDX+PDY*PDY+PDZ*PDZ
5876 PT=MAX(0,MIN(1,((EVENTX-X(PA))*PDX+(EVENTY-Y(PA))*PDY+(EVENTZ-Z(PA))*PDZ)/MAX(0.00001,PL)))
5878 PWX=X(PA)+PT*PDX-EVENTX:PWY=Y(PA)+PT*PDY-EVENTY:PWZ=Z(PA)+PT*PDZ-EVENTZ
5880 IF E=PHIT OR PWX*PWX+PWY*PWY+PWZ*PWZ<0.81 OR PA=PWK OR PB=PWK THEN GOSUB 5900
5885 NEXT E
5887 IF PWK>=0 THEN WKUSED(PWK)=1:WEAKHITS=WEAKHITS+1:WKBROKEN=WEAKHITS
5890 PINBLAST=0:RETURN
5900 IF BEAMBUILT THEN CBE=E:GOSUB 22000
5902 ACTIVE(E)=0:STRAIN(E)=1:BROKEN=BROKEN+1:EVBREAK=EVBREAK+1
5905 IF PINBLAST=0 THEN EVENTX=(X(EA(E))+X(EB(E)))*0.5:EVENTY=(Y(EA(E))+Y(EB(E)))*0.5:EVENTZ=(Z(EA(E))+Z(EB(E)))*0.5
5910 RETURN
5940 REM Brittle crystal fractures locally when a falling joint hits stone.
5942 LANDED(P)=1:PCOLL=P
5944 FOR E=0 TO NE-1
5946 IF ACTIVE(E) AND (EA(E)=PCOLL OR EB(E)=PCOLL) THEN GOSUB 5900
5948 NEXT E
5950 RETURN
6000 REM Launch one of ten spheres; AIM vector is normalized defensively.
6010 IF SHOTS<=0 OR BACTIVE THEN RETURN
6020 PL=SQR(AIMX*AIMX+AIMY*AIMY+AIMZ*AIMZ):IF PL<0.00001 THEN RETURN
6030 BX=LAUNCHX:BY=LAUNCHY:BZ=LAUNCHZ:BVX=AIMX/PL*32:BVY=AIMY/PL*32:BVZ=AIMZ/PL*32:BACTIVE=1:BTTL=3.0:SHOTS=SHOTS-1:EVLAUNCH=1
6040 RETURN
6200 REM Swept sphere versus intact crystal panels; edges handle rim contacts.
6210 FOR PFACE=0 TO NF-1
6220 IF ACTIVE(FE1(PFACE))=0 OR ACTIVE(FE2(PFACE))=0 OR ACTIVE(FE3(PFACE))=0 THEN GOTO 6460
6230 PFA=FA(PFACE):PFB=FB(PFACE):PFC=FC(PFACE)
6240 IF BX<MIN(X(PFA),MIN(X(PFB),X(PFC)))-0.9 OR BX>MAX(X(PFA),MAX(X(PFB),X(PFC)))+0.9 THEN GOTO 6460
6250 IF BY<MIN(Y(PFA),MIN(Y(PFB),Y(PFC)))-0.9 OR BY>MAX(Y(PFA),MAX(Y(PFB),Y(PFC)))+0.9 THEN GOTO 6460
6260 IF BZ<MIN(Z(PFA),MIN(Z(PFB),Z(PFC)))-0.9 OR BZ>MAX(Z(PFA),MAX(Z(PFB),Z(PFC)))+0.9 THEN GOTO 6460
6270 PFX=X(PFB)-X(PFA):PFY=Y(PFB)-Y(PFA):PFZ=Z(PFB)-Z(PFA):PGX=X(PFC)-X(PFA):PGY=Y(PFC)-Y(PFA):PGZ=Z(PFC)-Z(PFA)
6280 PNX=PFY*PGZ-PFZ*PGY:PNY=PFZ*PGX-PFX*PGZ:PNZ=PFX*PGY-PFY*PGX:PN2=PNX*PNX+PNY*PNY+PNZ*PNZ:IF PN2<1E-9 THEN GOTO 6460
6290 PD0=(PBOXX-X(PFA))*PNX+(PBOXY-Y(PFA))*PNY+(PBOXZ-Z(PFA))*PNZ:PD1=(BX-X(PFA))*PNX+(BY-Y(PFA))*PNY+(BZ-Z(PFA))*PNZ:PRAD=0.42*SQR(PN2)
6300 IF (PD0>PRAD AND PD1>PRAD) OR (PD0<-PRAD AND PD1<-PRAD) THEN GOTO 6460
6310 PSHOT=0:IF ABS(PD0)>PRAD AND ABS(PD0-PD1)>1E-10 THEN PSHOT=MAX(0,MIN(1,(PD0-SGN(PD0)*PRAD)/(PD0-PD1)))
6320 PQX=PBOXX+PUX*PSHOT-X(PFA):PQY=PBOXY+PUY*PSHOT-Y(PFA):PQZ=PBOXZ+PUZ*PSHOT-Z(PFA)
6330 PDIST=(PQX*PNX+PQY*PNY+PQZ*PNZ)/PN2:PQX=PQX-PDIST*PNX:PQY=PQY-PDIST*PNY:PQZ=PQZ-PDIST*PNZ
6340 PFF=PFX*PFX+PFY*PFY+PFZ*PFZ:PGG=PGX*PGX+PGY*PGY+PGZ*PGZ:PFG=PFX*PGX+PFY*PGY+PFZ*PGZ:PQF=PQX*PFX+PQY*PFY+PQZ*PFZ:PQG=PQX*PGX+PQY*PGY+PQZ*PGZ
6350 PDET=PFF*PGG-PFG*PFG:IF PDET<1E-10 THEN GOTO 6460
6360 PU=(PQF*PGG-PQG*PFG)/PDET:PV=(PQG*PFF-PQF*PFG)/PDET
6370 IF PU<-0.02 OR PV<-0.02 OR PU+PV>1.02 THEN GOTO 6460
6380 IF PSHOT<PBEST THEN PHIT=FE1(PFACE):PBEST=PSHOT
6460 NEXT PFACE
6470 RETURN
6500 REM Detached stained-glass panels retain their material as rigid triangles.
6600 IF DEBRISBUILT THEN GOTO 6640
6610 DIM FXP(95,2),FYP(95,2),FZP(95,2),FOX(95,2),FOY(95,2),FOZ(95,2),FLEN(95,2),FSTATE(95),FSLEEP(95)
6620 DEBRISBUILT=1
6640 MAT FSTATE=0 : MAT FSLEEP=0 : RETURN
6700 REM Free panels inherit node velocity, then fall under the same gravity.
6710 FOR FD=0 TO NF-1
6720 IF FSTATE(FD)=0 THEN IF ACTIVE(FE1(FD))=0 OR ACTIVE(FE2(FD))=0 OR ACTIVE(FE3(FD))=0 THEN GOSUB 6800
6730 IF FSTATE(FD)<>1 THEN GOTO 6795
6740 FOR FV=0 TO 2
6742 DVX=(FXP(FD,FV)-FOX(FD,FV))*0.992 : DVY=(FYP(FD,FV)-FOY(FD,FV))*0.992 : DVZ=(FZP(FD,FV)-FOZ(FD,FV))*0.992
6744 FOX(FD,FV)=FXP(FD,FV) : FOY(FD,FV)=FYP(FD,FV) : FOZ(FD,FV)=FZP(FD,FV)
6746 FXP(FD,FV)=FXP(FD,FV)+DVX : FYP(FD,FV)=FYP(FD,FV)+DVY-9*H*H : FZP(FD,FV)=FZP(FD,FV)+DVZ
6748 NEXT FV
6750 FOR DIT=1 TO 3
6752 FOR FV=0 TO 2
6754 DNEXT=(FV+1) MOD 3 : DDX=FXP(FD,DNEXT)-FXP(FD,FV) : DDY=FYP(FD,DNEXT)-FYP(FD,FV) : DDZ=FZP(FD,DNEXT)-FZP(FD,FV)
6756 DL=SQR(DDX*DDX+DDY*DDY+DDZ*DDZ) : IF DL<0.00001 THEN GOTO 6762
6758 DC=(DL-FLEN(FD,FV))/DL*0.48
6760 FXP(FD,FV)=FXP(FD,FV)+DDX*DC : FYP(FD,FV)=FYP(FD,FV)+DDY*DC : FZP(FD,FV)=FZP(FD,FV)+DDZ*DC : FXP(FD,DNEXT)=FXP(FD,DNEXT)-DDX*DC : FYP(FD,DNEXT)=FYP(FD,DNEXT)-DDY*DC : FZP(FD,DNEXT)=FZP(FD,DNEXT)-DDZ*DC
6762 NEXT FV
6764 FOR FV=0 TO 2
6766 IF FYP(FD,FV)>=0.28 THEN GOTO 6772
6768 DVY=FYP(FD,FV)-FOY(FD,FV) : FYP(FD,FV)=0.28 : FOY(FD,FV)=0.28+MIN(0,DVY)*0.10
6770 FOX(FD,FV)=FXP(FD,FV)-(FXP(FD,FV)-FOX(FD,FV))*0.74 : FOZ(FD,FV)=FZP(FD,FV)-(FZP(FD,FV)-FOZ(FD,FV))*0.74
6772 NEXT FV
6774 NEXT DIT
6776 IF RUBBLEMODE THEN GOTO 6795
6780 RESTING=1
6782 FOR FV=0 TO 2
6784 IF FYP(FD,FV)>0.31 OR ABS(FXP(FD,FV)-FOX(FD,FV))>0.0006 OR ABS(FZP(FD,FV)-FOZ(FD,FV))>0.0006 THEN RESTING=0
6786 NEXT FV
6788 IF RESTING THEN FSLEEP(FD)=FSLEEP(FD)+1 ELSE FSLEEP(FD)=0
6790 IF FSLEEP(FD)>45 THEN FSTATE(FD)=2
6795 NEXT FD : RETURN
6800 REM One-time detachment; preserve triangle shape and inherited momentum.
6802 DCX=(X(FA(FD))+X(FB(FD))+X(FC(FD)))/3 : DCY=(Y(FA(FD))+Y(FB(FD))+Y(FC(FD)))/3 : DCZ=(Z(FA(FD))+Z(FB(FD))+Z(FC(FD)))/3
6803 DNX=(Y(FB(FD))-Y(FA(FD)))*(Z(FC(FD))-Z(FA(FD)))-(Z(FB(FD))-Z(FA(FD)))*(Y(FC(FD))-Y(FA(FD))) : DNZ=(X(FB(FD))-X(FA(FD)))*(Y(FC(FD))-Y(FA(FD)))-(Y(FB(FD))-Y(FA(FD)))*(X(FC(FD))-X(FA(FD)))
6804 DAL=SQR(DNX*DNX+DNZ*DNZ) : DAX=1 : DAZ=0 : IF DAL>0.00001 THEN DAX=DNZ/DAL : DAZ=-DNX/DAL
6806 DSPIN=0.2*H : IF FD MOD 2 THEN DSPIN=-DSPIN
6810 FOR FV=0 TO 2
6820 NODE=FA(FD) : IF FV=1 THEN NODE=FB(FD)
6822 IF FV=2 THEN NODE=FC(FD)
6830 FXP(FD,FV)=X(NODE) : FYP(FD,FV)=Y(NODE) : FZP(FD,FV)=Z(NODE)
6840 DVX=X(NODE)-OLDX(NODE)-DAZ*(Y(NODE)-DCY)*DSPIN : DVY=Y(NODE)-OLDY(NODE)+(DAZ*(X(NODE)-DCX)-DAX*(Z(NODE)-DCZ))*DSPIN : DVZ=Z(NODE)-OLDZ(NODE)+DAX*(Y(NODE)-DCY)*DSPIN : DSPEED=SQR(DVX*DVX+DVY*DVY+DVZ*DVZ)
6850 DSCALE=1 : IF DSPEED>H*12 THEN DSCALE=H*12/DSPEED
6860 FOX(FD,FV)=FXP(FD,FV)-DVX*DSCALE : FOY(FD,FV)=FYP(FD,FV)-DVY*DSCALE : FOZ(FD,FV)=FZP(FD,FV)-DVZ*DSCALE
6870 NEXT FV
6880 FLEN(FD,0)=EL(FE1(FD)) : FLEN(FD,1)=EL(FE2(FD)) : FLEN(FD,2)=EL(FE3(FD)) : FSTATE(FD)=1 : FSLEEP(FD)=0 : RETURN
7000 REM Depth buffer is shared by platform, facets, beams and fragments.
7010 CLG OFFSCREEN : MAT D=0 : GOSUB 10500 : GOSUB 11000
7020 FOR RI=0 TO NP-1
7030 RWX=X(RI) : RWY=Y(RI) : RWZ=Z(RI) : GOSUB 8800 : SX(RI)=RX2 : SY(RI)=RY2 : DEPTHQ(RI)=RQ
7040 NEXT RI
7050 GOSUB 7500 : GOSUB 7800 : GOSUB 23000 : GOSUB 8100 : GOSUB 8500
7060 RETURN
7500 REM Stained crystal panels; their three supporting edges must survive.
7510 IF NF<1 THEN RETURN
7520 FOR RF=0 TO NF-1
7525 IF FSTATE(RF)>0 THEN GOSUB 7650:GOTO 7590
7530 IF ACTIVE(FE1(RF))=0 OR ACTIVE(FE2(RF))=0 OR ACTIVE(FE3(RF))=0 THEN GOTO 7590
7540 IA=FA(RF) : IB=FB(RF) : IC=FC(RF) : CI=1+(RF MOD 3)
7550 TA=SX(IA) : TB=SY(IA) : TQ=DEPTHQ(IA) : UA=SX(IB) : UB=SY(IB) : UQ=DEPTHQ(IB) : VA=SX(IC) : VB=SY(IC) : VQ=DEPTHQ(IC)
7560 IF MIN(TQ,MIN(UQ,VQ))<=0 THEN GOTO 7590
7570 GTRIANGLE D,TA,TB,TQ,PR(CI)*0.30,PG(CI)*0.30,PB(CI)*0.46,UA,UB,UQ,PR(CI)*0.62,PG(CI)*0.58,PB(CI)*0.76,VA,VB,VQ,PR(CI)*0.90,PG(CI)*0.86,PB(CI)*0.96
7590 NEXT RF : RETURN
7650 REM Detached panels remain visible as substantial falling glass pieces.
7652 FOR FV=0 TO 2
7654 RWX=FXP(RF,FV) : RWY=FYP(RF,FV) : RWZ=FZP(RF,FV) : GOSUB 8800
7656 IF FV=0 THEN TA=RX2:TB=RY2:TQ=RQ
7658 IF FV=1 THEN UA=RX2:UB=RY2:UQ=RQ
7660 IF FV=2 THEN VA=RX2:VB=RY2:VQ=RQ
7662 NEXT FV
7664 IF MIN(TQ,MIN(UQ,VQ))<=0 THEN RETURN
7666 CI=1+(RF MOD 3)
7668 GTRIANGLE D,TA,TB,TQ,PR(CI)*0.30,PG(CI)*0.30,PB(CI)*0.46,UA,UB,UQ,PR(CI)*0.62,PG(CI)*0.58,PB(CI)*0.76,VA,VB,VQ,PR(CI)*0.90,PG(CI)*0.86,PB(CI)*0.96
7670 RETURN
7800 REM Faceted beams join projected particles with inverse-depth interpolation.
7810 FOR RE=0 TO NE-1
7820 IF ACTIVE(RE)=0 THEN GOTO 7990
7830 IA=EA(RE) : IB=EB(RE) : QA=DEPTHQ(IA) : QB=DEPTHQ(IB) : IF QA<=0 OR QB<=0 THEN GOTO 7990
7840 EX=SX(IB)-SX(IA) : EY=SY(IB)-SY(IA) : LEN2=EX*EX+EY*EY : IF LEN2<0.01 THEN GOTO 7990
7850 INVLEN=1/SQR(LEN2) : EX=EX*INVLEN : EY=EY*INVLEN : WA=MAX(0.8,FOC*0.055*QA) : WB=MAX(0.8,FOC*0.055*QB)
7860 CI=NC(IB) : HOT=MIN(1,ABS(STRAIN(RE))*20) : RC=PR(CI)*(1-HOT)+255*HOT : GC=PG(CI)*(1-HOT)+145*HOT : BC=PB(CI)*(1-HOT)+85*HOT
7870 TA=SX(IA)-EY*WA : TB=SY(IA)+EX*WA : UA=SX(IA)+EY*WA : UB=SY(IA)-EX*WA
7880 VA=SX(IB)+EY*WB : VB=SY(IB)-EX*WB : XA=SX(IB)-EY*WB : XB=SY(IB)+EX*WB
7890 GTRIANGLE D,TA,TB,QA,RC,GC,BC,UA,UB,QA,RC*0.40,GC*0.45,BC*0.55,VA,VB,QB,RC*0.40,GC*0.45,BC*0.55
7900 GTRIANGLE D,TA,TB,QA,RC,GC,BC,VA,VB,QB,RC*0.40,GC*0.45,BC*0.55,XA,XB,QB,RC,GC,BC
7990 NEXT RE : RETURN
8100 REM Small four-facet jewels cap the structural joints.
8110 FOR RI=0 TO NP-1
8120 RQ=DEPTHQ(RI) : IF RQ<=0 THEN GOTO 8390
8130 CX=SX(RI) : CY=SY(RI) : RR=MAX(1.1,NR(RI)*FOC*RQ) : CI=NC(RI)
8140 IF RI=CORE THEN RR=RR*(1+0.045*SIN(T*4)):CI=4
8150 ROT=RI*1.71+SIMT*0.45 : SS=SIN(ROT) : CC=COS(ROT)
8160 GX1=CX+CC*RR : GY1=CY+SS*RR*0.6 : GX2=CX-SS*RR : GY2=CY+CC*RR*1.6
8170 GX3=CX-CC*RR : GY3=CY-SS*RR*0.6 : GX4=CX+SS*RR : GY4=CY-CC*RR*1.6
8180 GTRIANGLE D,CX,CY,RQ,255,255,245,GX1,GY1,RQ,PR(CI)*0.55,PG(CI)*0.65,PB(CI)*0.75,GX2,GY2,RQ,PR(CI),PG(CI),PB(CI)
8190 GTRIANGLE D,CX,CY,RQ,245,255,255,GX2,GY2,RQ,PR(CI),PG(CI),PB(CI),GX3,GY3,RQ,PR(CI)*0.35,PG(CI)*0.40,PB(CI)*0.58
8200 GTRIANGLE D,CX,CY,RQ,PR(CI)*0.75,PG(CI)*0.85,PB(CI),GX3,GY3,RQ,PR(CI)*0.35,PG(CI)*0.40,PB(CI)*0.58,GX4,GY4,RQ,PR(CI)*0.28,PG(CI)*0.30,PB(CI)*0.43
8210 GTRIANGLE D,CX,CY,RQ,PR(CI)*0.75,PG(CI)*0.85,PB(CI),GX4,GY4,RQ,PR(CI)*0.28,PG(CI)*0.30,PB(CI)*0.43,GX1,GY1,RQ,PR(CI)*0.55,PG(CI)*0.65,PB(CI)*0.75
8390 NEXT RI : RETURN
8500 REM Projectile and small depth-tested flying glass triangles.
8510 IF BACTIVE=0 THEN GOTO 8550
8520 RWX=BX : RWY=BY : RWZ=BZ : GOSUB 8800
8530 IF RQ>0 THEN RR=MAX(2,FOC*0.40*RQ):GTRIANGLE D,RX2,RY2+RR*1.4,RQ,255,255,255,RX2-RR,RY2-RR,RQ,88,211,255,RX2+RR,RY2-RR,RQ,218,248,255
8550 FOR AI=0 TO 179
8560 IF ALIFE(AI)<=0 THEN GOTO 8670
8570 RWX=AX(AI) : RWY=AY(AI) : RWZ=AZ(AI) : GOSUB 8800 : IF RQ<=0 THEN GOTO 8670
8580 RR=MAX(0.7,ASIZE(AI)*FOC*RQ) : CI=ACOL(AI) : ANG=T*5+AI*1.9 : CS=COS(ANG) : SN=SIN(ANG)
8590 BRIGHT=MIN(1,ALIFE(AI)*2)
8600 GTRIANGLE D,RX2+CS*RR,RY2+SN*RR,RQ,PR(CI)*BRIGHT,PG(CI)*BRIGHT,PB(CI)*BRIGHT,RX2-SN*RR,RY2+CS*RR,RQ,PR(CI)*0.45,PG(CI)*0.55,PB(CI)*0.7,RX2-CS*RR,RY2-SN*RR,RQ,240*BRIGHT,250*BRIGHT,255*BRIGHT
8670 NEXT AI : RETURN
8800 REM Project one world point; all solid geometry stays outside the near plane.
8810 RDX=RWX-CAMX : RDY=RWY-CAMY : RDZ=RWZ-CAMZ
8820 RDEP=RDX*CFX+RDY*CFY+RDZ*CFZ : RQ=0 : RX2=0 : RY2=0 : IF RDEP<0.35 THEN RETURN
8830 RQ=1/RDEP : RX2=320+FOC*(RDX*CRX+RDZ*CRZ)*RQ : RY2=VIEWY+FOC*(RDX*CUX+RDY*CUY+RDZ*CUZ)*RQ
8840 RETURN
9000 REM Original PCM music and effects; the interpreter's existing AUDIO API.
9010 AUDIO ON
9020 AUDIO LOAD 1,"assets/audio/crystal-siege/silent-prism-loop.wav"
9030 AUDIO LOAD 2,"assets/audio/crystal-siege/launch.wav"
9040 AUDIO LOAD 3,"assets/audio/crystal-siege/impact-glass.wav"
9050 AUDIO LOAD 4,"assets/audio/crystal-siege/fracture.wav"
9060 AUDIO LOAD 5,"assets/audio/crystal-siege/victory.wav"
9070 NEXTBREAK=0 : NEXTIMPACT=0 : RETURN
9100 IF EVLAUNCH THEN IF MUTED=0 THEN AUDIO PLAY 2,2,0,0.60
9110 IF EVIMPACT AND T>=NEXTIMPACT THEN NEXTIMPACT=T+0.10:IF MUTED=0 THEN AUDIO PLAY 3,3,0,0.60
9120 IF EVBREAK>0 AND T>=NEXTBREAK THEN NEXTBREAK=T+0.12:IF MUTED=0 THEN AUDIO PLAY 4,4,0,0.55,0,0.9+(BROKEN MOD 5)*0.05
9130 IF EVIMPACT OR EVBREAK>0 THEN GOSUB 9500
9132 EVCORE=0 : IF COREPRIOR AND COREAWARDED=0 THEN COREAWARDED=1:COREBANNER=T+3:CORESHOTS=MAXSHOTS-SHOTS:EVCORE=1
9135 IF EVCORE THEN GOSUB 1600
9140 IF EVCORE AND MUTED=0 THEN AUDIO PLAY 5,5,0,0.70
9150 EVLAUNCH=0 : EVIMPACT=0 : EVBREAK=0 : EVWIN=0 : EVCORE=0 : RETURN
9250 IF MUSIC=0 OR MUTED THEN AUDIO STOP 1:RETURN
9252 AUDIO PLAY 1,1,1,0.65 : RETURN
9260 AUDIO STOP : NEXTBREAK=T : GOSUB 9250 : RETURN
9270 IF MUTED THEN AUDIO OFF:RETURN
9272 AUDIO ON : GOSUB 9250 : RETURN
9400 REM Cosmetic shards have their own bounded pool; they never feed the solver.
9410 ADT=DT*TIMESCALE
9420 FOR AI=0 TO 179
9430 IF ALIFE(AI)<=0 THEN GOTO 9470
9440 ALIFE(AI)=ALIFE(AI)-ADT : AVY(AI)=AVY(AI)-ADT*6
9450 AX(AI)=AX(AI)+AVX(AI)*ADT : AY(AI)=AY(AI)+AVY(AI)*ADT : AZ(AI)=AZ(AI)+AVZ(AI)*ADT
9460 IF AY(AI)<0.15 THEN AY(AI)=0.15:AVY(AI)=ABS(AVY(AI))*0.25:AVX(AI)=AVX(AI)*0.7:AVZ(AI)=AVZ(AI)*0.7
9470 NEXT AI : RETURN
9500 IF PARTICLES=0 THEN RETURN
9510 NNEW=MIN(8,2+EVBREAK+EVIMPACT*2)
9520 FOR AJ=1 TO NNEW
9530 AI=SHARDHEAD : SHARDHEAD=(SHARDHEAD+1) MOD 180 : ANG=AI*2.39996+T*1.7
9540 AX(AI)=EVENTX : AY(AI)=EVENTY : AZ(AI)=EVENTZ
9550 AVX(AI)=COS(ANG)*(1.2+(AI MOD 5)*0.45) : AVZ(AI)=SIN(ANG)*(1.2+(AI MOD 7)*0.3) : AVY(AI)=1+(AI MOD 9)*0.45
9560 ALIFE(AI)=0.7+(AI MOD 11)*0.075 : ASIZE(AI)=0.028+(AI MOD 4)*0.012 : ACOL(AI)=1+(AI MOD 3)
9570 NEXT AJ : RETURN
10000 REM A readable frame around the world, with a restrained aiming reticle.
10010 FRECTANGLE 0,432,639,479,RGB(8,12,23) : FRECTANGLE 0,0,639,39,RGB(8,12,23)
10020 DRAW 0,431,639,431,RGB(42,111,132) : DRAW 0,40,639,40,RGB(42,111,132)
10025 BESTTXT$="--" : IF BESTUSED>0 THEN BESTTXT$=STR$(BESTUSED)
10026 CORETXT$="HELD" : IF COREAWARDED THEN CORETXT$="FREE"
10030 SMALLFONT TRANSPARENT : INK RGB(177,237,247) : LOCATE ROUND(2*ScreenScaleX),ROUND(1*ScreenScaleY) : GPRINT "CRYSTAL SIEGE  SHOTS ";STR$(SHOTS);"/";STR$(MAXSHOTS);"  GOLD ORB ";CORETXT$;"  RESCUE BEST ";BESTTXT$
10040 GOSUB 1800
10050 INK RGB(152,184,202) : LOCATE ROUND(2*ScreenScaleX),ROUND(28*ScreenScaleY) : GPRINT "CLICK/SPACE FIRE  ARROWS ORBIT  W/S ZOOM  T SLOW  P PAUSE  R REBUILD"
10060 LOCATE ROUND(2*ScreenScaleX),ROUND(29*ScreenScaleY) : GPRINT "C BUILDS  H TOP 5  D DEMO  V SPARKS  B MUSIC  N MUTE  M SIZE  I INFO  ESC EXIT"
10064 IF ShowInfo THEN
10065 PROGRESS=MIN(100,100*MIN(DEMOLITION/0.68,HEIGHTLOSS/0.58)) : INK RGB(196,201,161) : LOCATE ROUND(2*ScreenScaleX),ROUND(25*ScreenScaleY) : GPRINT "CORE ";CORETXT$;"  EXTRA DEMOLITION ";USING "###";PROGRESS;"%  BEARINGS ";STR$(WKBROKEN);"/";STR$(WKCOUNT);"  USED ";STR$(MAXSHOTS-SHOTS)
10070 INK RGB(121,159,179) : LOCATE ROUND(2*ScreenScaleX),ROUND(26*ScreenScaleY) : GPRINT NP;" NODES ";NE-BROKEN;" LINKS  Q";PITER;"  PHYS ";USING "##.0";PHYMS;"ms DRAW ";USING "##.0";DRAWMS;"ms"
10072 LOCATE ROUND(2*ScreenScaleX),ROUND(27*ScreenScaleY) : GPRINT USING "###.0";FPS;" FPS  SOLVER ";STR$(PITER);"  Q SOLVER  F FPS CAP  I HIDE INFO"
10074 ENDIF
10080 IF K$="V" THEN PARTICLES=1-PARTICLES:IF PARTICLES=0 THEN MAT ALIFE=0
10090 RETCOL=RGB(165,225,238) : IF BACTIVE OR SHOTS=0 THEN RETCOL=RGB(90,109,134)
10100 DRAW AIMSCREENX-9,AIMSCREENY,AIMSCREENX-4,AIMSCREENY,RETCOL : DRAW AIMSCREENX+4,AIMSCREENY,AIMSCREENX+9,AIMSCREENY,RETCOL
10110 DRAW AIMSCREENX,AIMSCREENY-9,AIMSCREENX,AIMSCREENY-4,RETCOL : DRAW AIMSCREENX,AIMSCREENY+4,AIMSCREENX,AIMSCREENY+9,RETCOL
10115 StatusText$="" : IF AUTORUN THEN StatusText$="AUTO "
10120 IF SLOW THEN StatusText$=StatusText$+"SLOW "
10122 IF MUTED THEN StatusText$=StatusText$+"MUTED "
10124 IF LEN(StatusText$)>0 THEN INK RGB(168,204,218) : LOCATE WIDTH/8-LEN(StatusText$)-2,ROUND(3*ScreenScaleY) : GPRINT StatusText$
10130 IF PAUSED THEN INK RGB(255,220,145):LOCATE ROUND(WIDTH/16-9),ROUND(14*ScreenScaleY):GPRINT "SIMULATION PAUSED"
10150 IF COREAWARDED=0 OR T>COREBANNER THEN GOTO 10200
10160 FRECTANGLE 123,365,517,432,RGB(10,24,34) : RECTANGLE 123,365,517,432,RGB(245,205,108)
10170 BIGFONT TRANSPARENT : INK RGB(255,224,142) : LOCATE ROUND(WIDTH/32-7),ROUND(4*ScreenScaleY) : GPRINT "GOLD CORE FREE"
10180 SMALLFONT TRANSPARENT : INK RGB(184,229,237) : LOCATE ROUND(WIDTH/16-20),ROUND(6*ScreenScaleY) : GPRINT "IN ";STR$(CORESHOTS);" SHOTS | BEST ";BESTTXT$;" | KEEP DEMOLISHING"
10190 RETURN
10200 IF SHOTS=0 AND BACTIVE=0 THEN INK RGB(244,184,142):LOCATE ROUND(WIDTH/16-32),ROUND(24*ScreenScaleY):GPRINT "NO ORBS LEFT - LET THE PIECES SETTLE OR R TO REBUILD"
10210 RETURN
10500 REM Twilight and deterministic stars are background, outside the depth buffer.
10510 FOR BG=0 TO 19
10520 FRECTANGLE 0,40+BG*20,639,59+BG*20,RGB(5+BG*0.17,8+BG*0.12,18+BG*0.45)
10530 NEXT BG
10540 FOR SI=0 TO 89 : PLOT STARX(SI),STARY(SI),STARC(SI) : NEXT SI
10550 RETURN
11000 REM A floating twelve-sided stone dais, rendered with actual 3D depth.
11010 FOR SECTOR=0 TO 15
11020 A=SECTOR*PI/8 : B=(SECTOR+1)*PI/8
11030 RWX=0 : RWY=0.25 : RWZ=0 : GOSUB 8800 : TA=RX2 : TB=RY2 : TQ=RQ
11040 RWX=COS(A)*8 : RWY=0.25 : RWZ=SIN(A)*8 : GOSUB 8800 : UA=RX2 : UB=RY2 : UQ=RQ
11050 RWX=COS(B)*8 : RWY=0.25 : RWZ=SIN(B)*8 : GOSUB 8800 : VA=RX2 : VB=RY2 : VQ=RQ
11060 SHADE=0.85+0.15*(SECTOR MOD 2)
11070 GTRIANGLE D,TA,TB,TQ,26,37,55,UA,UB,UQ,20*SHADE,31*SHADE,47*SHADE,VA,VB,VQ,23*SHADE,35*SHADE,52*SHADE
11080 RWX=COS(A)*8 : RWY=-0.5 : RWZ=SIN(A)*8 : GOSUB 8800 : XA=RX2 : XB=RY2 : XQ=RQ
11090 RWX=COS(B)*8 : RWY=-0.5 : RWZ=SIN(B)*8 : GOSUB 8800 : YA=RX2 : YB=RY2 : YQ=RQ
11100 GTRIANGLE D,UA,UB,UQ,33,61,76,XA,XB,XQ,8,14,28,YA,YB,YQ,9,15,29
11110 GTRIANGLE D,UA,UB,UQ,33,61,76,YA,YB,YQ,9,15,29,VA,VB,VQ,30,55,72
11120 NEXT SECTOR : GOSUB 11200 : RETURN
11200 REM An inlaid luminous ring follows the dais in perspective.
11210 FOR SECTOR=0 TO 31
11220 A=SECTOR*PI/16 : B=(SECTOR+0.85)*PI/16
11230 RWX=COS(A)*7.3 : RWY=0.265 : RWZ=SIN(A)*7.3 : GOSUB 8800 : TA=RX2 : TB=RY2 : TQ=RQ
11240 RWX=COS(A)*7.4 : RWY=0.265 : RWZ=SIN(A)*7.4 : GOSUB 8800 : UA=RX2 : UB=RY2 : UQ=RQ
11250 RWX=COS(B)*7.4 : RWY=0.265 : RWZ=SIN(B)*7.4 : GOSUB 8800 : VA=RX2 : VB=RY2 : VQ=RQ
11260 RWX=COS(B)*7.3 : RWY=0.265 : RWZ=SIN(B)*7.3 : GOSUB 8800 : XA=RX2 : XB=RY2 : XQ=RQ
11270 GTRIANGLE D,TA,TB,TQ,37,86,110,UA,UB,UQ,61,135,157,VA,VB,VQ,61,135,157
11280 GTRIANGLE D,TA,TB,TQ,37,86,110,VA,VB,VQ,61,135,157,XA,XB,XQ,37,86,110
11290 NEXT SECTOR : RETURN
12000 REM Palette and repeatable sky. All geometry and artwork are made in BASIC.
12010 PR(0)=93:PG(0)=211:PB(0)=220 : PR(1)=70:PG(1)=215:PB(1)=245
12020 PR(2)=174:PG(2)=122:PB(2)=249 : PR(3)=246:PG(3)=105:PB(3)=196
12030 PR(4)=255:PG(4)=216:PB(4)=100 : PR(5)=80:PG(5)=255:PB(5)=145
12040 PR(6)=180:PG(6)=205:PB(6)=244
12050 FOR SI=0 TO 89
12052 A=SIN(SI*127.1+31.7)*43758.5453 : STARX(SI)=INT((A-INT(A))*640)
12054 A=SIN(SI*269.5+13.3)*43758.5453 : STARY(SI)=45+INT((A-INT(A))*390)
12056 L=40+(SI MOD 7)*9 : STARC(SI)=RGB(L*0.75,L*0.86,L) : NEXT SI
12060 RETURN
12400 REM Display changes retain the complete simulation, camera, aim and audio.
12405 WHILE KEYDOWN(77) : FRAME : WEND
12410 NextScreenMode=640
12420 IF ScreenMode=640 THEN NextScreenMode=800
12430 IF ScreenMode=800 THEN NextScreenMode=1024
12440 ScreenMode=NextScreenMode : GOSUB 12500 : LAST=TIME : RETURN
12500 REM Keep the original logical framing; depth is always a physical pixel grid.
12505 IF ScreenMode<>640 AND ScreenMode<>800 AND ScreenMode<>1024 THEN ScreenMode=640
12510 MODE ScreenMode : DIM D(WIDTH-1,HEIGHT-1) : MAT D=0 : SCALE 0,639,0,479
12520 PAPER RGB(5,7,17) : SMALLFONT TRANSPARENT : ScreenScaleX=(WIDTH-1)/639 : ScreenScaleY=(HEIGHT-1)/479
12530 LASTMX=MOUSEX : LASTMY=MOUSEY : RETURN
13000 REM One cheap frame check; no ranking work in the physics or rendering loops.
13010 IF HSDone OR HSDemo OR SHOTS>0 OR PAUSED THEN HSQuietAt=SIMT:HSObserved=DESTSCORE:RETURN
13020 IF BACTIVE OR SGAWAKE>0 OR DESTSCORE<>HSObserved THEN HSQuietAt=SIMT:HSObserved=DESTSCORE:RETURN
13030 IF SIMT-HSQuietAt<3 THEN RETURN
13040 REM All ten shots spent: wait for quiet rubble and a stable tally before ending the attempt.
13050 GOSUB 13400
13060 GOSUB 1400 : RETURN
13400 REM At most one entry per attempt. Demo attempts stay excluded even after manual takeover.
13410 IF HSDone OR HSDemo OR DESTSCORE<=0 OR SHOTS=MAXSHOTS THEN RETURN
13420 HSDone=1 : HSPoints=DESTSCORE : HSPos=5
13430 FOR HSI=0 TO 4
13440 IF HSPos=5 AND HSPoints>HSScores(HSI) THEN HSPos=HSI
13450 NEXT HSI
13460 REM Strict comparison keeps older tied scores ahead; a tied fifth does not qualify.
13470 IF HSPos=5 THEN RETURN
13480 GOSUB 14000 : IF HSCancel THEN RETURN
13490 FOR HSI=4 TO HSPos+1 STEP -1
13500 HSScores(HSI)=HSScores(HSI-1) : HSNames$(HSI)=HSNames$(HSI-1)
13510 NEXT HSI
13520 HSScores(HSPos)=HSPoints : HSNames$(HSPos)=HSName$ : HSCount=MIN(5,HSCount+1)
13530 DESTBEST=MAX(DESTBEST,HSScores(0)) : GOSUB 15400 : GOSUB 14200 : RETURN
13800 REM Canonical A-Z arcade names; normalize old saved names without losing their scores.
13810 HSRawName$=HSName$ : HSName$=""
13820 FOR HSChar=1 TO LEN(HSRawName$)
13830 HSLetter$=MID$(HSRawName$,HSChar,1) : HSCode=ASC(HSLetter$)
13840 IF ((HSCode>=65 AND HSCode<=90) OR (HSCode>=97 AND HSCode<=122)) AND LEN(HSName$)<3 THEN HSName$=HSName$+UPPER$(HSLetter$)
13850 NEXT HSChar
13860 IF HSName$="" THEN HSName$="AAA"
13870 RETURN
14000 REM Small graphical name editor; game time is suspended until acceptance/cancellation.
14010 HSCancel=0 : HSName$="" : GOSUB 14400
14020 GOSUB 14600
14030 INK RGB(255,224,142) : LOCATE ROUND(17*ScreenScaleX),ROUND(18*ScreenScaleY) : GPRINT "TOP FIVE! ";STR$(HSPoints);" PTS"
14040 INK RGB(210,238,245) : LOCATE ROUND(17*ScreenScaleX),ROUND(19*ScreenScaleY) : GPRINT "NAME (3): ";HSName$;"_"
14050 INK RGB(152,184,202) : LOCATE ROUND(17*ScreenScaleX),ROUND(22*ScreenScaleY) : GPRINT "ENTER SAVE   BACKSPACE EDIT   ESC SKIP"
14060 FRAME 60 : HSKey$=INKEY$ : IF HSKey$="" THEN GOTO 14060
14070 HSCode=ASC(HSKey$)
14080 IF HSCode=27 THEN HSCancel=1:GOSUB 14400:RETURN
14090 IF HSCode=13 THEN GOSUB 13800:GOSUB 14400:RETURN
14100 IF HSCode=8 AND LEN(HSName$)>0 THEN HSName$=LEFT$(HSName$,LEN(HSName$)-1)
14110 IF ((HSCode>=65 AND HSCode<=90) OR (HSCode>=97 AND HSCode<=122)) AND LEN(HSName$)<3 THEN HSName$=HSName$+UPPER$(HSKey$)
14120 GOTO 14020
14200 REM H is a read-only modal: preserve pause, camera, aim, simulation and audio.
14210 GOSUB 14400 : GOSUB 14600
14220 INK RGB(152,184,202) : LOCATE ROUND(17*ScreenScaleX),ROUND(21*ScreenScaleY) : GPRINT "ENTER / ESC TO CONTINUE"
14230 IF HSIOFailed THEN INK RGB(255,184,142):LOCATE ROUND(17*ScreenScaleX),ROUND(23*ScreenScaleY):GPRINT "SAVE FAILED - SCORES KEPT THIS SESSION"
14240 FRAME 60 : HSKey$=INKEY$
14250 IF HSKey$<>CHR$(13) AND HSKey$<>CHR$(27) AND UPPER$(HSKey$)<>"H" THEN GOTO 14240
14260 GOSUB 14400 : RETURN
14400 REM Drain held action keys and reset wall-time baselines, without touching accumulated physics.
14410 WHILE KEYDOWN(13) OR KEYDOWN(27) OR KEYDOWN(67) OR KEYDOWN(28) OR KEYDOWN(29) OR KEYDOWN(30) OR KEYDOWN(31) OR KEYDOWN(72) OR KEYDOWN(82) OR KEYDOWN(68) OR KEYDOWN(32) OR MOUSELEFT : FRAME 60 : WEND
14420 CLEAR INPUT : K$="" : LAST=TIME : TLAST=LAST : FCOUNT=0 : HELDSHOT=0 : RETURN
14600 FRECTANGLE 80,80,559,400,RGB(8,17,30) : RECTANGLE 80,80,559,400,RGB(93,190,211)
14610 BIGFONT TRANSPARENT : INK RGB(255,224,142) : LOCATE ROUND(WIDTH/32-8),ROUND(6*ScreenScaleY) : GPRINT "CRYSTAL TOP FIVE"
14620 SMALLFONT TRANSPARENT : INK RGB(152,184,202) : LOCATE ROUND(17*ScreenScaleX),ROUND(9*ScreenScaleY) : GPRINT "RANK"
14622 LOCATE ROUND(22*ScreenScaleX),ROUND(9*ScreenScaleY) : GPRINT "NAME"
14624 LOCATE ROUND(43*ScreenScaleX),ROUND(9*ScreenScaleY) : GPRINT "POINTS"
14625 HSTitle$=LEFT$(LevelTitle$,32) : LOCATE ROUND(WIDTH/16-LEN(HSTitle$)/2),ROUND(8*ScreenScaleY) : GPRINT HSTitle$
14630 FOR HSDraw=0 TO 4
14640 INK RGB(177,237,247) : IF HSDraw=0 THEN INK RGB(255,224,142)
14650 LOCATE ROUND(17*ScreenScaleX),ROUND((11+HSDraw)*ScreenScaleY) : GPRINT STR$(HSDraw+1);"."
14660 HSText$="--" : IF HSScores(HSDraw)>0 THEN HSText$=HSNames$(HSDraw)
14670 LOCATE ROUND(22*ScreenScaleX),ROUND((11+HSDraw)*ScreenScaleY) : GPRINT HSText$
14680 IF HSScores(HSDraw)>0 THEN LOCATE ROUND(43*ScreenScaleX),ROUND((11+HSDraw)*ScreenScaleY):GPRINT STR$(HSScores(HSDraw))
14690 NEXT HSDraw : RETURN
15000 REM Load the shared archive once. Legacy scores belong to the original cathedral.
15005 IF HSArchiveBuilt THEN GOSUB 15600:RETURN
15010 DIM HSArchiveScores(63,4),HSArchiveNames$(63,4),HSArchiveID$(63),HSArchiveCount(63)
15015 HSArchiveBuilt=1 : HSArchiveSize=0
15020 ON ERROR GOTO 15360
15030 OPEN "g-crystal-scores.csv" FOR INPUT AS #1
15040 INPUT #1,HSMagic$,HSTotalRows
15050 HSLegacy=0 : IF HSMagic$="CRYSTAL/1" THEN HSLegacy=1
15060 IF (HSMagic$<>"CRYSTAL/1" AND HSMagic$<>"CRYSTAL/2") OR HSTotalRows<>INT(HSTotalRows) OR HSTotalRows<0 OR HSTotalRows>320 THEN ERROR 26
15070 IF HSLegacy AND HSTotalRows>5 THEN ERROR 26
15080 HSInputRow=1
15085 IF HSInputRow>HSTotalRows THEN GOTO 15200
15090 IF HSLegacy THEN HSReadID$="cathedral":INPUT #1,HSName$,HSReadScore ELSE INPUT #1,HSReadID$,HSName$,HSReadScore
15100 GOSUB 15900 : IF HSValid=0 THEN ERROR 26
15110 HSLookupID$=HSReadID$ : HSLookupCreate=1 : GOSUB 15800 : IF HSArchiveSlot<0 THEN ERROR 26
15120 HSReadPos=HSArchiveCount(HSArchiveSlot) : IF HSReadPos>=5 THEN ERROR 26
15130 IF HSReadPos>0 THEN IF HSReadScore>HSArchiveScores(HSArchiveSlot,HSReadPos-1) THEN ERROR 26
15140 HSArchiveNames$(HSArchiveSlot,HSReadPos)=HSName$ : HSArchiveScores(HSArchiveSlot,HSReadPos)=HSReadScore : HSArchiveCount(HSArchiveSlot)=HSReadPos+1
15150 HSInputRow=HSInputRow+1 : GOTO 15085
15200 IF NOT EOF(1) THEN ERROR 26
15210 CLOSE #1 : ON ERROR GOTO 0 : GOSUB 15600 : RETURN
15360 CLOSE
15370 RESUME 15380
15380 ON ERROR GOTO 0 : GOSUB 15700 : GOSUB 15600 : RETURN
15400 REM Commit the active top five, then save every ID, including unavailable structures.
15405 HSIOFailed=0 : ON ERROR GOTO 15500
15410 IF HSCount<>INT(HSCount) OR HSCount<0 OR HSCount>5 THEN ERROR 26
15415 HSReadID$=LevelId$ : HSLookupID$=LevelId$ : HSLookupCreate=1 : GOSUB 15800 : IF HSArchiveSlot<0 THEN ERROR 26
15420 HSCopy=0
15421 IF HSCopy>=HSCount THEN GOTO 15429
15422 HSName$=HSNames$(HSCopy) : HSReadScore=HSScores(HSCopy) : GOSUB 15900
15423 IF HSValid=0 THEN ERROR 26
15424 HSArchiveNames$(HSArchiveSlot,HSCopy)=HSName$ : HSArchiveScores(HSArchiveSlot,HSCopy)=HSReadScore
15425 HSCopy=HSCopy+1 : GOTO 15421
15429 HSArchiveCount(HSArchiveSlot)=HSCount
15430 HSTotalRows=0 : FOR HSSaveGroup=0 TO HSArchiveSize-1 : HSTotalRows=HSTotalRows+HSArchiveCount(HSSaveGroup) : NEXT HSSaveGroup
15435 OPEN "g-crystal-scores.csv" FOR OUTPUT AS #1
15440 WRITE #1,"CRYSTAL/2",HSTotalRows
15445 HSSaveGroup=0
15446 IF HSSaveGroup>=HSArchiveSize THEN GOTO 15470
15447 HSSaveRow=0
15448 IF HSSaveRow>=HSArchiveCount(HSSaveGroup) THEN HSSaveGroup=HSSaveGroup+1:GOTO 15446
15450 WRITE #1,HSArchiveID$(HSSaveGroup),HSArchiveNames$(HSSaveGroup,HSSaveRow),HSArchiveScores(HSSaveGroup,HSSaveRow)
15452 HSSaveRow=HSSaveRow+1 : GOTO 15448
15470 CLOSE #1 : ON ERROR GOTO 0 : RETURN
15500 CLOSE
15510 RESUME 15520
15520 ON ERROR GOTO 0 : HSIOFailed=1 : RETURN
15600 REM Restore only the selected structure. Viewing a new ID does not create an entry.
15610 HSCount=0 : DESTBEST=0 : MAT HSScores=0 : FOR HSView=0 TO 4 : HSNames$(HSView)="" : NEXT HSView
15620 HSLookupID$=LevelId$ : HSLookupCreate=0 : GOSUB 15800 : IF HSArchiveSlot<0 THEN RETURN
15630 HSCount=HSArchiveCount(HSArchiveSlot) : FOR HSView=0 TO HSCount-1 : HSScores(HSView)=HSArchiveScores(HSArchiveSlot,HSView) : HSNames$(HSView)=HSArchiveNames$(HSArchiveSlot,HSView) : NEXT HSView
15640 IF HSCount>0 THEN DESTBEST=HSScores(0)
15650 RETURN
15700 REM An unreadable archive leaves empty in-memory tables and is not rewritten on load.
15710 HSArchiveSize=0 : MAT HSArchiveCount=0 : MAT HSArchiveScores=0
15720 FOR HSResetGroup=0 TO 63 : HSArchiveID$(HSResetGroup)="" : FOR HSResetRow=0 TO 4 : HSArchiveNames$(HSResetGroup,HSResetRow)="" : NEXT HSResetRow : NEXT HSResetGroup : RETURN
15800 HSArchiveSlot=-1 : FOR HSFindSlot=0 TO HSArchiveSize-1 : IF HSArchiveID$(HSFindSlot)=HSLookupID$ THEN HSArchiveSlot=HSFindSlot
15810 NEXT HSFindSlot : IF HSArchiveSlot>=0 OR HSLookupCreate=0 THEN RETURN
15820 IF HSArchiveSize>=64 OR TRIM$(HSLookupID$)="" OR LEN(HSLookupID$)>32 THEN RETURN
15830 HSArchiveSlot=HSArchiveSize : HSArchiveID$(HSArchiveSlot)=HSLookupID$ : HSArchiveCount(HSArchiveSlot)=0 : HSArchiveSize=HSArchiveSize+1 : RETURN
15900 HSValid=1 : IF TRIM$(HSReadID$)="" OR LEN(HSReadID$)>32 OR LEN(HSName$)>3 OR TRIM$(HSName$)="" THEN HSValid=0:RETURN
15910 IF HSReadScore<1 OR HSReadScore>10000 OR HSReadScore<>INT(HSReadScore) THEN HSValid=0:RETURN
15920 FOR HSCheck=1 TO LEN(HSReadID$) : HSCode=ASC(MID$(HSReadID$,HSCheck,1)) : IF HSCode<32 OR (HSCode>=127 AND HSCode<160) THEN HSValid=0
15930 NEXT HSCheck : FOR HSCheck=1 TO LEN(HSName$) : HSCode=ASC(MID$(HSName$,HSCheck,1)) : IF HSCode<32 OR (HSCode>=127 AND HSCode<160) THEN HSValid=0
15940 NEXT HSCheck : IF HSValid THEN GOSUB 13800
15950 RETURN
16000 REM Essential structure resource: fixed-capacity CSV, read only during initial load.
16010 LevelLoadOK=0 : LDSection$="HEADER" : ON ERROR GOTO 17700
16020 OPEN LevelFile$ FOR INPUT AS #1
16030 INPUT #1,LDMagic$,LevelId$,LevelTitle$
16040 IF LDMagic$<>"CRYSTAL-STRUCTURE/1" OR TRIM$(LevelId$)="" OR TRIM$(LevelTitle$)="" THEN ERROR 26
16050 IF LEN(LevelId$)>32 OR LEN(LevelTitle$)>64 THEN ERROR 26
16055 IF ExpectedLevelId$<>"" AND LevelId$<>ExpectedLevelId$ THEN ERROR 26
16060 LDSection$="COUNTS" : INPUT #1,LDTag$,NP,NE,NF,CORE,LevelShots
16070 IF LDTag$<>"COUNTS" OR NP<>INT(NP) OR NP<1 OR NP>220 OR NE<>INT(NE) OR NE<0 OR NE>500 THEN ERROR 26
16080 IF NF<>INT(NF) OR NF<0 OR NF>96 OR CORE<>INT(CORE) OR CORE<0 OR CORE>=NP THEN ERROR 26
16090 IF LevelShots<>INT(LevelShots) OR LevelShots<1 OR LevelShots>100 THEN ERROR 26
16100 LDSection$="CAMERA" : INPUT #1,LDTag$,LevelYaw,LevelPitch,LevelDistance,LevelTargetY,LevelFocus,LevelViewY,MinCameraDistance,MaxCameraDistance
16110 IF LDTag$<>"CAMERA" OR MinCameraDistance<=0 OR MaxCameraDistance<MinCameraDistance THEN ERROR 26
16120 IF LevelDistance<MinCameraDistance OR LevelDistance>MaxCameraDistance OR LevelPitch<0.09 OR LevelPitch>0.72 THEN ERROR 26
16130 IF LevelFocus<=0 OR LevelViewY<0 OR LevelViewY>479 THEN ERROR 26
16140 LDSection$="NODES" : INPUT #1,LDTag$,LDCount : IF LDTag$<>"NODES" OR LDCount<>NP THEN ERROR 26
16150 P=0
16155 IF P>=NP THEN GOTO 16200
16160 INPUT #1,RX(P),RY(P),RZ(P),IM(P),NK(P),NR(P),NC(P)
16170 IF IM(P)<0 OR NR(P)<=0 OR NK(P)<>INT(NK(P)) OR NK(P)<0 OR NC(P)<>INT(NC(P)) OR NC(P)<0 OR NC(P)>6 THEN ERROR 26
16180 P=P+1 : GOTO 16155
16200 LDSection$="LINKS" : INPUT #1,LDTag$,LDCount : IF LDTag$<>"LINKS" OR LDCount<>NE THEN ERROR 26
16210 E=0
16215 IF E>=NE THEN GOTO 16300
16220 INPUT #1,EA(E),EB(E) : PA=EA(E) : PB=EB(E)
16230 IF PA<>INT(PA) OR PB<>INT(PB) OR PA<0 OR PB<0 OR PA>=NP OR PB>=NP OR PA=PB THEN ERROR 26
16240 EL(E)=SQR((RX(PA)-RX(PB))^2+(RY(PA)-RY(PB))^2+(RZ(PA)-RZ(PB))^2)
16250 IF EL(E)<=0 THEN ERROR 26
16260 E=E+1 : GOTO 16215
16300 LDSection$="PANELS" : INPUT #1,LDTag$,LDCount : IF LDTag$<>"PANELS" OR LDCount<>NF THEN ERROR 26
16310 F=0
16315 IF F>=NF THEN GOTO 16400
16320 INPUT #1,FA(F),FB(F),FC(F),FE1(F),FE2(F),FE3(F)
16330 IF FA(F)<>INT(FA(F)) OR FB(F)<>INT(FB(F)) OR FC(F)<>INT(FC(F)) OR FA(F)<0 OR FB(F)<0 OR FC(F)<0 OR FA(F)>=NP OR FB(F)>=NP OR FC(F)>=NP THEN ERROR 26
16340 IF FA(F)=FB(F) OR FB(F)=FC(F) OR FC(F)=FA(F) THEN ERROR 26
16350 IF FE1(F)<>INT(FE1(F)) OR FE2(F)<>INT(FE2(F)) OR FE3(F)<>INT(FE3(F)) OR FE1(F)<0 OR FE2(F)<0 OR FE3(F)<0 OR FE1(F)>=NE OR FE2(F)>=NE OR FE3(F)>=NE THEN ERROR 26
16360 LDNodeA=FA(F) : LDNodeB=FB(F) : LDEdge=FE1(F)
16362 IF NOT ((EA(LDEdge)=LDNodeA AND EB(LDEdge)=LDNodeB) OR (EA(LDEdge)=LDNodeB AND EB(LDEdge)=LDNodeA)) THEN ERROR 26
16370 LDNodeA=FB(F) : LDNodeB=FC(F) : LDEdge=FE2(F)
16372 IF NOT ((EA(LDEdge)=LDNodeA AND EB(LDEdge)=LDNodeB) OR (EA(LDEdge)=LDNodeB AND EB(LDEdge)=LDNodeA)) THEN ERROR 26
16380 LDNodeA=FC(F) : LDNodeB=FA(F) : LDEdge=FE3(F)
16382 IF NOT ((EA(LDEdge)=LDNodeA AND EB(LDEdge)=LDNodeB) OR (EA(LDEdge)=LDNodeB AND EB(LDEdge)=LDNodeA)) THEN ERROR 26
16390 F=F+1 : GOTO 16315
16400 LDSection$="BEARINGS" : INPUT #1,LDTag$,WKCOUNT
16410 IF LDTag$<>"BEARINGS" OR WKCOUNT<>INT(WKCOUNT) OR WKCOUNT<0 OR WKCOUNT>NP THEN ERROR 26
16420 MAT WK=0 : LDIndex=1
16425 IF LDIndex>=WKCOUNT+1 THEN GOTO 16500
16430 INPUT #1,LDNode : IF LDNode<>INT(LDNode) OR LDNode<0 OR LDNode>=NP THEN ERROR 26
16440 IF WK(LDNode) THEN ERROR 26
16450 WK(LDNode)=1 : LDIndex=LDIndex+1 : GOTO 16425
16500 LDSection$="DEMO" : INPUT #1,LDTag$,DemoCount
16510 IF LDTag$<>"DEMO" OR DemoCount<>INT(DemoCount) OR DemoCount<0 OR DemoCount>6 THEN ERROR 26
16520 DEMOI=0
16525 IF DEMOI>=DemoCount THEN GOTO 16600
16530 INPUT #1,DEMONODE(DEMOI),DEMOX(DEMOI),DEMOY(DEMOI),DEMOZ(DEMOI),DEMOCAY(DEMOI),DEMOCAP(DEMOI),DEMOCAD(DEMOI)
16540 LDNode=DEMONODE(DEMOI) : IF LDNode<>INT(LDNode) OR LDNode<0 OR LDNode>=NP THEN ERROR 26
16550 IF DEMOCAP(DEMOI)<0.09 OR DEMOCAP(DEMOI)>0.72 OR DEMOCAD(DEMOI)<MinCameraDistance OR DEMOCAD(DEMOI)>MaxCameraDistance THEN ERROR 26
16560 DEMOI=DEMOI+1 : GOTO 16525
16600 LDSection$="END" : IF NOT EOF(1) THEN ERROR 26
16610 CLOSE #1 : ON ERROR GOTO 0 : LevelLoadOK=1 : RETURN
17700 LDError=ERR : LDErrorLine=ERL : CLOSE
17710 RESUME 17720
17720 ON ERROR GOTO 0 : IF LevelLoadOptional THEN RETURN
17725 SCREEN CLOSE
17730 PRINT "Cannot load Crystal structure: ";LevelFile$
17740 PRINT "Section: ";LDSection$;"  BASIC line ";LDErrorLine;"  Error ";LDError
17750 PRINT "Check the structure file and run the game again." : END
17800 REM Snapshot only rest data before an optional construction change; no per-frame copies.
17805 DIM SavedLevelMeta(14)
17810 SavedLevelMeta(0)=NP : SavedLevelMeta(1)=NE : SavedLevelMeta(2)=NF : SavedLevelMeta(3)=CORE : SavedLevelMeta(4)=WKCOUNT
17815 SavedLevelMeta(5)=LevelShots : SavedLevelMeta(6)=DemoCount : SavedLevelMeta(7)=LevelYaw : SavedLevelMeta(8)=LevelPitch : SavedLevelMeta(9)=LevelDistance
17820 SavedLevelMeta(10)=LevelTargetY : SavedLevelMeta(11)=LevelFocus : SavedLevelMeta(12)=LevelViewY : SavedLevelMeta(13)=MinCameraDistance : SavedLevelMeta(14)=MaxCameraDistance
17825 MAT SavedLevelRX=RX : MAT SavedLevelRY=RY : MAT SavedLevelRZ=RZ : MAT SavedLevelIM=IM
17830 MAT SavedLevelNK=NK : MAT SavedLevelNR=NR : MAT SavedLevelNC=NC : MAT SavedLevelEA=EA
17835 MAT SavedLevelEB=EB : MAT SavedLevelEL=EL : MAT SavedLevelFA=FA : MAT SavedLevelFB=FB
17840 MAT SavedLevelFC=FC : MAT SavedLevelFE1=FE1 : MAT SavedLevelFE2=FE2 : MAT SavedLevelFE3=FE3
17845 MAT SavedLevelWK=WK : MAT SavedLevelDEMONODE=DEMONODE : MAT SavedLevelDEMOX=DEMOX : MAT SavedLevelDEMOY=DEMOY
17850 MAT SavedLevelDEMOZ=DEMOZ : MAT SavedLevelDEMOCAY=DEMOCAY : MAT SavedLevelDEMOCAP=DEMOCAP : MAT SavedLevelDEMOCAD=DEMOCAD
17855 RETURN
17900 REM Restore the still-running construction after rejecting a candidate file.
17905 NP=SavedLevelMeta(0) : NE=SavedLevelMeta(1) : NF=SavedLevelMeta(2) : CORE=SavedLevelMeta(3) : WKCOUNT=SavedLevelMeta(4)
17910 LevelShots=SavedLevelMeta(5) : DemoCount=SavedLevelMeta(6) : LevelYaw=SavedLevelMeta(7) : LevelPitch=SavedLevelMeta(8) : LevelDistance=SavedLevelMeta(9)
17915 LevelTargetY=SavedLevelMeta(10) : LevelFocus=SavedLevelMeta(11) : LevelViewY=SavedLevelMeta(12) : MinCameraDistance=SavedLevelMeta(13) : MaxCameraDistance=SavedLevelMeta(14)
17920 MAT RX=SavedLevelRX : MAT RY=SavedLevelRY : MAT RZ=SavedLevelRZ : MAT IM=SavedLevelIM
17925 MAT NK=SavedLevelNK : MAT NR=SavedLevelNR : MAT NC=SavedLevelNC : MAT EA=SavedLevelEA
17930 MAT EB=SavedLevelEB : MAT EL=SavedLevelEL : MAT FA=SavedLevelFA : MAT FB=SavedLevelFB
17935 MAT FC=SavedLevelFC : MAT FE1=SavedLevelFE1 : MAT FE2=SavedLevelFE2 : MAT FE3=SavedLevelFE3
17940 MAT WK=SavedLevelWK : MAT DEMONODE=SavedLevelDEMONODE : MAT DEMOX=SavedLevelDEMOX : MAT DEMOY=SavedLevelDEMOY
17945 MAT DEMOZ=SavedLevelDEMOZ : MAT DEMOCAY=SavedLevelDEMOCAY : MAT DEMOCAP=SavedLevelDEMOCAP : MAT DEMOCAD=SavedLevelDEMOCAD
17950 RETURN
18000 REM The catalog is loaded once; adding a building needs a CSV and one catalog row.
18010 DIM CatalogIds$(31),CatalogTitles$(31),CatalogFiles$(31) : ON ERROR GOTO 19800
18020 OPEN CatalogFile$ FOR INPUT AS #1
18030 INPUT #1,CGMagic$,CatalogCount
18040 IF CGMagic$<>"CRYSTAL-CATALOG/1" OR CatalogCount<>INT(CatalogCount) OR CatalogCount<1 OR CatalogCount>32 THEN ERROR 26
18050 FOR CGIndex=0 TO CatalogCount-1
18060 INPUT #1,CatalogIds$(CGIndex),CatalogTitles$(CGIndex),CatalogFiles$(CGIndex)
18070 IF LEN(CatalogIds$(CGIndex))<1 OR LEN(CatalogIds$(CGIndex))>32 OR TRIM$(CatalogTitles$(CGIndex))="" OR LEN(CatalogTitles$(CGIndex))>64 OR TRIM$(CatalogFiles$(CGIndex))="" THEN ERROR 26
18080 FOR CGChar=1 TO LEN(CatalogIds$(CGIndex))
18090 CGCode=ASC(MID$(CatalogIds$(CGIndex),CGChar,1))
18100 IF (CGCode<65 OR CGCode>90) AND (CGCode<97 OR CGCode>122) AND (CGCode<48 OR CGCode>57) AND CGCode<>45 AND CGCode<>95 THEN ERROR 26
18110 NEXT CGChar
18120 FOR CGPrevious=0 TO CGIndex-1 : IF CatalogIds$(CGPrevious)=CatalogIds$(CGIndex) THEN ERROR 26
18130 NEXT CGPrevious : NEXT CGIndex
18140 IF NOT EOF(1) THEN ERROR 26
18150 CLOSE #1 : ON ERROR GOTO 0
18160 CurrentStructure=0 : LevelFile$=CatalogFiles$(CurrentStructure) : ExpectedLevelId$=CatalogIds$(CurrentStructure) : RETURN
18500 REM Choosing the current item or cancelling preserves the running attempt.
18510 GOSUB 14400 : SelectorChoice=CurrentStructure : SelectorError$=""
18520 GOSUB 19100
18530 FRAME 60 : SelectorKey$=INKEY$ : IF SelectorKey$="" THEN GOTO 18530
18540 IF SelectorKey$=CHR$(27) OR UPPER$(SelectorKey$)="C" THEN GOSUB 14400:RETURN
18550 IF SelectorKey$=CHR$(30) OR SelectorKey$=CHR$(28) THEN SelectorChoice=(SelectorChoice+CatalogCount-1) MOD CatalogCount:GOTO 18520
18560 IF SelectorKey$=CHR$(31) OR SelectorKey$=CHR$(29) THEN SelectorChoice=(SelectorChoice+1) MOD CatalogCount:GOTO 18520
18570 IF SelectorKey$<>CHR$(13) THEN GOTO 18530
18580 IF SelectorChoice=CurrentStructure THEN GOSUB 14400:RETURN
18590 GOSUB 18700
18600 IF LevelLoadOK=0 THEN SelectorError$="COULD NOT LOAD THIS CONSTRUCTION":GOTO 18520
18610 GOSUB 14400 : RETURN
18700 REM Validate before ending the current attempt; reject errors without losing its state.
18710 PreviousLevelFile$=LevelFile$ : PreviousLevelId$=LevelId$ : PreviousLevelTitle$=LevelTitle$
18720 GOSUB 17800
18730 LevelFile$=CatalogFiles$(SelectorChoice) : ExpectedLevelId$=CatalogIds$(SelectorChoice)
18740 LevelLoadOptional=1 : GOSUB 16000 : LevelLoadOptional=0
18750 IF LevelLoadOK=0 THEN GOSUB 17900:LevelFile$=PreviousLevelFile$:LevelId$=PreviousLevelId$:LevelTitle$=PreviousLevelTitle$:ExpectedLevelId$=CatalogIds$(CurrentStructure):RETURN
18760 SelectedLevelId$=LevelId$ : SelectedLevelTitle$=LevelTitle$
18770 REM The just-finished score still belongs to the previous construction.
18780 LevelId$=PreviousLevelId$ : LevelTitle$=PreviousLevelTitle$ : GOSUB 13400
18790 LevelId$=SelectedLevelId$ : LevelTitle$=SelectedLevelTitle$ : CurrentStructure=SelectorChoice
18800 BESTUSED=0 : GOSUB 15600 : GOSUB 1400
18810 CAMYAW=LevelYaw : CAMPITCH=LevelPitch : CAMDIST=LevelDistance : TARGETY=LevelTargetY : FOC=LevelFocus : VIEWY=LevelViewY
18820 AIMSCREENX=320 : AIMSCREENY=265 : HELDSHOT=0 : GOSUB 1200 : RETURN
19100 FRECTANGLE 80,80,559,400,RGB(8,17,30) : RECTANGLE 80,80,559,400,RGB(93,190,211)
19110 BIGFONT TRANSPARENT : INK RGB(255,224,142) : LOCATE ROUND(WIDTH/32-6.5),ROUND(6*ScreenScaleY) : GPRINT "CONSTRUCTIONS"
19120 SMALLFONT TRANSPARENT : INK RGB(152,184,202) : LOCATE ROUND(17*ScreenScaleX),ROUND(8*ScreenScaleY) : GPRINT "CURRENT: ";LEFT$(LevelTitle$,28)
19130 SelectorFirst=MAX(0,MIN(SelectorChoice-3,CatalogCount-8))
19140 FOR SelectorRow=SelectorFirst TO MIN(CatalogCount-1,SelectorFirst+7)
19150 INK RGB(177,237,247) : SelectorMark$="  " : IF SelectorRow=SelectorChoice THEN INK RGB(255,224,142):SelectorMark$="> "
19160 LOCATE ROUND(17*ScreenScaleX),ROUND((10+SelectorRow-SelectorFirst)*ScreenScaleY) : GPRINT SelectorMark$;LEFT$(CatalogTitles$(SelectorRow),32)
19170 NEXT SelectorRow
19180 INK RGB(152,184,202) : LOCATE ROUND(17*ScreenScaleX),ROUND(21*ScreenScaleY) : GPRINT "ARROWS CHOOSE   ENTER LOAD   ESC BACK"
19190 IF SelectorError$<>"" THEN INK RGB(255,184,142):LOCATE ROUND(17*ScreenScaleX),ROUND(23*ScreenScaleY):GPRINT SelectorError$
19200 RETURN
19800 CGError=ERR : CGErrorLine=ERL : CLOSE
19810 RESUME 19820
19820 ON ERROR GOTO 0 : SCREEN CLOSE
19830 PRINT "Cannot load Crystal catalog: ";CatalogFile$
19840 PRINT "BASIC line ";CGErrorLine;"  Error ";CGError
19850 PRINT "Check the construction list and run the game again." : END
20000 REM Broken beams become independent rigid rods; a sleeping rod never expires.
20010 IF BEAMBUILT THEN GOTO 20040
20020 DIM BEAMPX(499,1),BEAMPY(499,1),BEAMPZ(499,1),BEAMOX(499,1),BEAMOY(499,1),BEAMOZ(499,1),BEAMLEN(499),BSTATE(499),BEAMSLEEP(499),BEAMCOL(499)
20025 DIM BEAMVX(1),BEAMVY(1),BEAMVZ(1),BEAMTOUCH(1)
20030 BEAMBUILT=1
20040 MAT BSTATE=0 : MAT BEAMSLEEP=0 : BEAMRAD=0.055 : BEAMFLOOR=0.25+BEAMRAD+0.005 : RETURN
21000 REM Fixed-step endpoint Verlet/PBD; beam debris has no structural feedback.
21010 IF BEAMBUILT=0 THEN RETURN
21020 FOR BEAMI=0 TO NE-1
21030 IF BSTATE(BEAMI)<>1 THEN GOTO 21590
21040 FOR BEAMV=0 TO 1
21050 BEAMVX(BEAMV)=(BEAMPX(BEAMI,BEAMV)-BEAMOX(BEAMI,BEAMV))*0.994 : BEAMVY(BEAMV)=(BEAMPY(BEAMI,BEAMV)-BEAMOY(BEAMI,BEAMV))*0.994-9*H*H : BEAMVZ(BEAMV)=(BEAMPZ(BEAMI,BEAMV)-BEAMOZ(BEAMI,BEAMV))*0.994
21060 BEAMSPD=SQR(BEAMVX(BEAMV)^2+BEAMVY(BEAMV)^2+BEAMVZ(BEAMV)^2) : BEAMSCALE=1 : IF BEAMSPD>16*H THEN BEAMSCALE=16*H/BEAMSPD
21070 BEAMVX(BEAMV)=BEAMVX(BEAMV)*BEAMSCALE : BEAMVY(BEAMV)=BEAMVY(BEAMV)*BEAMSCALE : BEAMVZ(BEAMV)=BEAMVZ(BEAMV)*BEAMSCALE
21080 BEAMOX(BEAMI,BEAMV)=BEAMPX(BEAMI,BEAMV) : BEAMOY(BEAMI,BEAMV)=BEAMPY(BEAMI,BEAMV) : BEAMOZ(BEAMI,BEAMV)=BEAMPZ(BEAMI,BEAMV) : BEAMTOUCH(BEAMV)=0
21090 BEAMPX(BEAMI,BEAMV)=BEAMPX(BEAMI,BEAMV)+BEAMVX(BEAMV) : BEAMPY(BEAMI,BEAMV)=BEAMPY(BEAMI,BEAMV)+BEAMVY(BEAMV) : BEAMPZ(BEAMI,BEAMV)=BEAMPZ(BEAMI,BEAMV)+BEAMVZ(BEAMV)
21100 IF BEAMPY(BEAMI,BEAMV)>=BEAMFLOOR THEN GOTO 21150
21110 REM Sweep to the stone top before spending the remaining motion in friction.
21120 BEAMTOI=MAX(0,MIN(1,(BEAMOY(BEAMI,BEAMV)-BEAMFLOOR)/MAX(0.0000001,-BEAMVY(BEAMV))))
21130 BEAMPX(BEAMI,BEAMV)=BEAMOX(BEAMI,BEAMV)+BEAMVX(BEAMV)*(BEAMTOI+(1-BEAMTOI)*0.70) : BEAMPZ(BEAMI,BEAMV)=BEAMOZ(BEAMI,BEAMV)+BEAMVZ(BEAMV)*(BEAMTOI+(1-BEAMTOI)*0.70)
21140 BEAMPY(BEAMI,BEAMV)=BEAMFLOOR : BEAMTOUCH(BEAMV)=1
21150 NEXT BEAMV
21160 FOR BEAMIT=1 TO MAX(2,PITER)+2
21170 GOSUB 21600
21180 FOR BEAMV=0 TO 1
21190 IF BEAMPY(BEAMI,BEAMV)<BEAMFLOOR THEN BEAMPY(BEAMI,BEAMV)=BEAMFLOOR : BEAMTOUCH(BEAMV)=1
21200 NEXT BEAMV
21210 NEXT BEAMIT
21220 REM Final rigid normalization and common lift preserve both length and support.
21230 GOSUB 21600
21240 BEAMLIFT=MAX(0,BEAMFLOOR-MIN(BEAMPY(BEAMI,0),BEAMPY(BEAMI,1)))
21250 IF BEAMLIFT>0 THEN BEAMPY(BEAMI,0)=BEAMPY(BEAMI,0)+BEAMLIFT : BEAMPY(BEAMI,1)=BEAMPY(BEAMI,1)+BEAMLIFT
21260 FOR BEAMV=0 TO 1
21270 IF BEAMPY(BEAMI,BEAMV)<=BEAMFLOOR+0.000001 THEN BEAMTOUCH(BEAMV)=1
21280 IF BEAMTOUCH(BEAMV)=0 THEN GOTO 21330
21290 BEAMOX(BEAMI,BEAMV)=BEAMPX(BEAMI,BEAMV)-BEAMVX(BEAMV)*0.70 : BEAMOZ(BEAMI,BEAMV)=BEAMPZ(BEAMI,BEAMV)-BEAMVZ(BEAMV)*0.70
21300 BEAMBOUNCE=0 : IF BEAMVY(BEAMV)<-0.7*H THEN BEAMBOUNCE=-BEAMVY(BEAMV)*0.15
21310 BEAMOY(BEAMI,BEAMV)=BEAMPY(BEAMI,BEAMV)-BEAMBOUNCE
21330 NEXT BEAMV
21335 IF RUBBLEMODE THEN GOTO 21590
21340 BEAMREST=1
21350 FOR BEAMV=0 TO 1
21360 IF BEAMPY(BEAMI,BEAMV)>BEAMFLOOR+0.002 OR ABS(BEAMPX(BEAMI,BEAMV)-BEAMOX(BEAMI,BEAMV))>0.0007 OR ABS(BEAMPY(BEAMI,BEAMV)-BEAMOY(BEAMI,BEAMV))>0.0007 OR ABS(BEAMPZ(BEAMI,BEAMV)-BEAMOZ(BEAMI,BEAMV))>0.0007 THEN BEAMREST=0
21370 NEXT BEAMV
21380 IF BEAMREST THEN BEAMSLEEP(BEAMI)=BEAMSLEEP(BEAMI)+1 ELSE BEAMSLEEP(BEAMI)=0
21390 IF BEAMSLEEP(BEAMI)<45 THEN GOTO 21590
21400 BSTATE(BEAMI)=2
21410 FOR BEAMV=0 TO 1
21420 BEAMOX(BEAMI,BEAMV)=BEAMPX(BEAMI,BEAMV) : BEAMOY(BEAMI,BEAMV)=BEAMPY(BEAMI,BEAMV) : BEAMOZ(BEAMI,BEAMV)=BEAMPZ(BEAMI,BEAMV)
21430 NEXT BEAMV
21590 NEXT BEAMI : RETURN
21600 REM Equal endpoint mass gives an exact length projection.
21610 BEAMDX=BEAMPX(BEAMI,1)-BEAMPX(BEAMI,0) : BEAMDY=BEAMPY(BEAMI,1)-BEAMPY(BEAMI,0) : BEAMDZ=BEAMPZ(BEAMI,1)-BEAMPZ(BEAMI,0)
21620 BEAMDIST=SQR(BEAMDX*BEAMDX+BEAMDY*BEAMDY+BEAMDZ*BEAMDZ)
21630 IF BEAMDIST<0.0000001 THEN BEAMPX(BEAMI,0)=BEAMPX(BEAMI,0)-BEAMLEN(BEAMI)*0.5 : BEAMPX(BEAMI,1)=BEAMPX(BEAMI,1)+BEAMLEN(BEAMI)*0.5 : RETURN
21640 BEAMCORR=(BEAMDIST-BEAMLEN(BEAMI))/BEAMDIST*0.5
21650 BEAMPX(BEAMI,0)=BEAMPX(BEAMI,0)+BEAMDX*BEAMCORR : BEAMPY(BEAMI,0)=BEAMPY(BEAMI,0)+BEAMDY*BEAMCORR : BEAMPZ(BEAMI,0)=BEAMPZ(BEAMI,0)+BEAMDZ*BEAMCORR
21660 BEAMPX(BEAMI,1)=BEAMPX(BEAMI,1)-BEAMDX*BEAMCORR : BEAMPY(BEAMI,1)=BEAMPY(BEAMI,1)-BEAMDY*BEAMCORR : BEAMPZ(BEAMI,1)=BEAMPZ(BEAMI,1)-BEAMDZ*BEAMCORR : RETURN
22000 REM Called once with CBE=E immediately before the structural edge deactivates.
22010 IF BEAMBUILT=0 THEN GOSUB 20000
22020 IF CBE<0 OR CBE>=NE THEN RETURN
22030 IF BSTATE(CBE)<>0 THEN RETURN
22040 BEAMCA=EA(CBE) : BEAMCB=EB(CBE) : BEAMCOL(CBE)=NC(BEAMCB)
22050 BEAMCX=(X(BEAMCA)+X(BEAMCB))*0.5 : BEAMCY=(Y(BEAMCA)+Y(BEAMCB))*0.5 : BEAMCZ=(Z(BEAMCA)+Z(BEAMCB))*0.5
22060 BEAMDX=X(BEAMCB)-X(BEAMCA) : BEAMDY=Y(BEAMCB)-Y(BEAMCA) : BEAMDZ=Z(BEAMCB)-Z(BEAMCA) : BEAMDIST=SQR(BEAMDX^2+BEAMDY^2+BEAMDZ^2)
22070 BEAMLEN(CBE)=MAX(0.001,EL(CBE)) : IF BEAMDIST<0.65*BEAMLEN(CBE) OR BEAMDIST>1.35*BEAMLEN(CBE) THEN BEAMLEN(CBE)=MAX(0.001,BEAMDIST)
22080 BEAMHOR=SQR(BEAMDX^2+BEAMDZ^2) : BEAMAX=1 : BEAMAZ=0 : IF BEAMHOR>0.00001 THEN BEAMAX=BEAMDZ/BEAMHOR : BEAMAZ=-BEAMDX/BEAMHOR
22090 BEAMSPIN=0.2*H : IF CBE MOD 2 THEN BEAMSPIN=-BEAMSPIN
22100 FOR BEAMV=0 TO 1
22110 BEAMNODE=BEAMCA : IF BEAMV=1 THEN BEAMNODE=BEAMCB
22120 BEAMPX(CBE,BEAMV)=X(BEAMNODE) : BEAMPY(CBE,BEAMV)=Y(BEAMNODE) : BEAMPZ(CBE,BEAMV)=Z(BEAMNODE)
22130 BEAMIX=X(BEAMNODE)-OLDX(BEAMNODE)-BEAMAZ*(Y(BEAMNODE)-BEAMCY)*BEAMSPIN : BEAMIY=Y(BEAMNODE)-OLDY(BEAMNODE)+(BEAMAZ*(X(BEAMNODE)-BEAMCX)-BEAMAX*(Z(BEAMNODE)-BEAMCZ))*BEAMSPIN : BEAMIZ=Z(BEAMNODE)-OLDZ(BEAMNODE)+BEAMAX*(Y(BEAMNODE)-BEAMCY)*BEAMSPIN
22140 BEAMSPD=SQR(BEAMIX^2+BEAMIY^2+BEAMIZ^2) : BEAMSCALE=1 : IF BEAMSPD>16*H THEN BEAMSCALE=16*H/BEAMSPD
22150 BEAMOX(CBE,BEAMV)=BEAMPX(CBE,BEAMV)-BEAMIX*BEAMSCALE : BEAMOY(CBE,BEAMV)=BEAMPY(CBE,BEAMV)-BEAMIY*BEAMSCALE : BEAMOZ(CBE,BEAMV)=BEAMPZ(CBE,BEAMV)-BEAMIZ*BEAMSCALE
22160 NEXT BEAMV
22170 BSTATE(CBE)=1 : BEAMSLEEP(CBE)=0 : RETURN
23000 REM Persistent beams are solid four-sided prisms with true 3D end caps.
23010 FOR RODI=0 TO NE-1
23020 IF BSTATE(RODI)=0 THEN GOTO 23390
23030 RODUX=BEAMPX(RODI,1)-BEAMPX(RODI,0) : RODUY=BEAMPY(RODI,1)-BEAMPY(RODI,0) : RODUZ=BEAMPZ(RODI,1)-BEAMPZ(RODI,0)
23040 RODL=SQR(RODUX*RODUX+RODUY*RODUY+RODUZ*RODUZ) : IF RODL<0.00001 THEN GOTO 23390
23050 RODUX=RODUX/RODL : RODUY=RODUY/RODL : RODUZ=RODUZ/RODL
23060 RODVX=-RODUZ : RODVY=0 : RODVZ=RODUX
23070 IF ABS(RODUY)>0.9 THEN RODVX=0:RODVY=RODUZ:RODVZ=-RODUY
23080 RODL=SQR(RODVX*RODVX+RODVY*RODVY+RODVZ*RODVZ) : RODVX=RODVX/RODL : RODVY=RODVY/RODL : RODVZ=RODVZ/RODL
23090 RODWX=RODUY*RODVZ-RODUZ*RODVY : RODWY=RODUZ*RODVX-RODUX*RODVZ : RODWZ=RODUX*RODVY-RODUY*RODVX
23100 FOR RODC=0 TO 3
23110 RODDX=RODVX : RODDY=RODVY : RODDZ=RODVZ
23120 IF RODC=1 THEN RODDX=RODWX:RODDY=RODWY:RODDZ=RODWZ
23130 IF RODC=2 THEN RODDX=-RODVX:RODDY=-RODVY:RODDZ=-RODVZ
23140 IF RODC=3 THEN RODDX=-RODWX:RODDY=-RODWY:RODDZ=-RODWZ
23150 FOR RODE=0 TO 1
23160 RWX=BEAMPX(RODI,RODE)+RODDX*BEAMRAD : RWY=BEAMPY(RODI,RODE)+RODDY*BEAMRAD : RWZ=BEAMPZ(RODI,RODE)+RODDZ*BEAMRAD
23170 GOSUB 8800 : RODV=RODC+RODE*4 : RODSX(RODV)=RX2 : RODSY(RODV)=RY2 : RODSQ(RODV)=RQ
23180 NEXT RODE : NEXT RODC
23190 RODCX=(BEAMPX(RODI,0)+BEAMPX(RODI,1))*0.5 : RODCY=(BEAMPY(RODI,0)+BEAMPY(RODI,1))*0.5 : RODCZ=(BEAMPZ(RODI,0)+BEAMPZ(RODI,1))*0.5
23200 CI=BEAMCOL(RODI)
23210 FOR RODF=0 TO 5
23220 IF RODF>=4 THEN GOTO 23300
23230 RODNX=RODVX+RODWX : RODNY=RODVY+RODWY : RODNZ=RODVZ+RODWZ
23240 IF RODF=1 THEN RODNX=RODWX-RODVX:RODNY=RODWY-RODVY:RODNZ=RODWZ-RODVZ
23250 IF RODF=2 THEN RODNX=-RODVX-RODWX:RODNY=-RODVY-RODWY:RODNZ=-RODVZ-RODWZ
23260 IF RODF=3 THEN RODNX=RODVX-RODWX:RODNY=RODVY-RODWY:RODNZ=RODVZ-RODWZ
23270 RODFCX=RODCX+RODNX*BEAMRAD*0.5 : RODFCY=RODCY+RODNY*BEAMRAD*0.5 : RODFCZ=RODCZ+RODNZ*BEAMRAD*0.5
23280 RODA=RODF : RODB=(RODF+1) MOD 4 : RODD=RODF+4 : RODC2=RODB+4 : GOTO 23330
23300 RODA=0 : RODB=3 : RODC2=2 : RODD=1 : RODNX=-RODUX : RODNY=-RODUY : RODNZ=-RODUZ : RODFCX=BEAMPX(RODI,0) : RODFCY=BEAMPY(RODI,0) : RODFCZ=BEAMPZ(RODI,0)
23310 IF RODF=5 THEN RODA=4:RODB=5:RODC2=6:RODD=7:RODNX=RODUX:RODNY=RODUY:RODNZ=RODUZ:RODFCX=BEAMPX(RODI,1):RODFCY=BEAMPY(RODI,1):RODFCZ=BEAMPZ(RODI,1)
23330 IF (CAMX-RODFCX)*RODNX+(CAMY-RODFCY)*RODNY+(CAMZ-RODFCZ)*RODNZ<=0 THEN GOTO 23370
23340 RODNL=SQR(RODNX*RODNX+RODNY*RODNY+RODNZ*RODNZ) : RODLIGHT=0.38+0.62*MAX(0,MIN(1,(RODNX*0.35+RODNY*0.84+RODNZ*0.42)/RODNL))
23350 RODR=PR(CI)*RODLIGHT : RODG=PG(CI)*RODLIGHT : RODBLUE=PB(CI)*RODLIGHT : GOSUB 23500
23370 NEXT RODF
23390 NEXT RODI : RETURN
23500 IF MIN(RODSQ(RODA),MIN(RODSQ(RODB),MIN(RODSQ(RODC2),RODSQ(RODD))))<=0 THEN RETURN
23510 GTRIANGLE D,RODSX(RODA),RODSY(RODA),RODSQ(RODA),RODR,RODG,RODBLUE,RODSX(RODB),RODSY(RODB),RODSQ(RODB),RODR*0.82,RODG*0.86,RODBLUE*0.90,RODSX(RODC2),RODSY(RODC2),RODSQ(RODC2),RODR*0.82,RODG*0.86,RODBLUE*0.90
23520 GTRIANGLE D,RODSX(RODA),RODSY(RODA),RODSQ(RODA),RODR,RODG,RODBLUE,RODSX(RODC2),RODSY(RODC2),RODSQ(RODC2),RODR*0.82,RODG*0.86,RODBLUE*0.90,RODSX(RODD),RODSY(RODD),RODSQ(RODD),RODR,RODG,RODBLUE
23530 RETURN
30000 REM Fast piling: only settled debris stamps the support surface; moving pieces may overlap.
30010 IF RUBBLEBUILT THEN GOTO 30150
30020 DIM SGHEIGHT(240,240),SGSTAMPED(595),SGORDER(595),SGNEXT(595),SGHEAD(127)
30030 DIM SGX(2),SGY(2),SGZ(2),SGOX(2),SGOY(2),SGOZ(2),SGL(2)
30040 DIM SGWA(15),SGWB(15),SGWC(15),SGTARGET(15),SGHIT(15)
30050 DIM SGPASTX(595,2),SGPASTY(595,2),SGPASTZ(595,2),SGHAVE(595)
30060 RUBBLEBUILT=1
30150 MAT SGHEIGHT=0.25 : MAT SGSTAMPED=0 : MAT SGHAVE=0 : SGMAXHEIGHT=0.25 : RUBBLEMODE=1 : RBN=0 : RCN=0 : SGTOTALSTATIC=0 : SGDEPOSITED=0 : RETURN
31000 REM Visit low fragments first. Only resting geometry is added to the support surface.
31010 IF RUBBLEMODE=0 THEN RETURN
31020 MAT SGHEAD=-1 : RBN=0 : RCN=0 : SGAWAKE=0 : SGADDED=0 : SGPROBES=0
31030 FOR SGID=0 TO NE-1
31040 IF BSTATE(SGID)=0 THEN GOTO 31100
31050 RBN=RBN+1 : IF BSTATE(SGID)=2 THEN IF SGSTAMPED(SGID)=0 AND SGADDED<2 THEN GOSUB 32000 : GOSUB 33000
31060 IF BSTATE(SGID)<>1 THEN GOTO 31100
31070 SGLOW=MIN(BEAMPY(SGID,0),BEAMPY(SGID,1)) : SGBUCKET=MAX(0,MIN(127,INT((SGLOW-0.25)*4)))
31080 SGNEXT(SGID)=SGHEAD(SGBUCKET) : SGHEAD(SGBUCKET)=SGID : SGAWAKE=SGAWAKE+1
31100 NEXT SGID
31110 FOR SGFACE=0 TO NF-1
31120 SGID=500+SGFACE : IF FSTATE(SGFACE)=0 THEN GOTO 31190
31130 RBN=RBN+1 : IF FSTATE(SGFACE)=2 THEN IF SGSTAMPED(SGID)=0 AND SGADDED<2 THEN GOSUB 32000 : GOSUB 33000
31140 IF FSTATE(SGFACE)<>1 THEN GOTO 31190
31150 SGLOW=MIN(FYP(SGFACE,0),FYP(SGFACE,1),FYP(SGFACE,2)) : SGBUCKET=MAX(0,MIN(127,INT((SGLOW-0.25)*4)))
31160 SGNEXT(SGID)=SGHEAD(SGBUCKET) : SGHEAD(SGBUCKET)=SGID : SGAWAKE=SGAWAKE+1
31190 NEXT SGFACE
31200 FOR SGBUCKET=0 TO 127
31210 SGID=SGHEAD(SGBUCKET)
31220 IF SGID<0 THEN GOTO 31260
31230 SGNXT=SGNEXT(SGID) : GOSUB 32000 : GOSUB 32100 : GOSUB 32300 : GOSUB 32600
31240 SGID=SGNXT : GOTO 31220
31260 NEXT SGBUCKET : RETURN
32000 REM One fragment scratch pose; original lengths and material remain unchanged.
32010 SGNV=2 : SGRAD=0.055 : SGFLOOR=BEAMFLOOR
32020 IF SGID>=500 THEN SGNV=3 : SGRAD=0.03 : SGFLOOR=0.28 : SGFACE=SGID-500
32030 FOR SGV=0 TO SGNV-1
32040 IF SGNV=3 THEN GOTO 32070
32050 SGX(SGV)=BEAMPX(SGID,SGV) : SGY(SGV)=BEAMPY(SGID,SGV) : SGZ(SGV)=BEAMPZ(SGID,SGV) : SGOX(SGV)=BEAMOX(SGID,SGV) : SGOY(SGV)=BEAMOY(SGID,SGV) : SGOZ(SGV)=BEAMOZ(SGID,SGV) : SGL(0)=BEAMLEN(SGID) : GOTO 32080
32070 SGX(SGV)=FXP(SGFACE,SGV) : SGY(SGV)=FYP(SGFACE,SGV) : SGZ(SGV)=FZP(SGFACE,SGV) : SGOX(SGV)=FOX(SGFACE,SGV) : SGOY(SGV)=FOY(SGFACE,SGV) : SGOZ(SGV)=FOZ(SGFACE,SGV) : SGL(SGV)=FLEN(SGFACE,SGV)
32080 NEXT SGV : RETURN
32100 REM Gather support probes once; reuse their heights in the two rigid contact passes.
32110 SGTOUCH=0 : SGCOUNT=7 : SGLOW=MIN(SGY(0),SGY(1)) : IF SGNV=3 THEN SGLOW=MIN(SGLOW,SGY(2))
32120 IF SGNV=2 THEN SGSEG=MIN(12,MAX(2,2*INT(SGL(0)+0.99))) : SGCOUNT=SGSEG+1
32130 FOR SGP=0 TO SGCOUNT-1
32140 SGHIT(SGP)=0 : SGWA(SGP)=0 : SGWB(SGP)=0 : SGWC(SGP)=0
32150 IF SGNV=2 THEN SGWB(SGP)=SGP/SGSEG : SGWA(SGP)=1-SGWB(SGP) : GOTO 32210
32160 IF SGP=0 THEN SGWA(SGP)=1
32165 IF SGP=1 THEN SGWB(SGP)=1
32170 IF SGP=2 THEN SGWC(SGP)=1
32175 IF SGP=3 THEN SGWA(SGP)=0.5 : SGWB(SGP)=0.5
32180 IF SGP=4 THEN SGWB(SGP)=0.5 : SGWC(SGP)=0.5
32185 IF SGP=5 THEN SGWC(SGP)=0.5 : SGWA(SGP)=0.5
32190 IF SGP=6 THEN SGWA(SGP)=1/3 : SGWB(SGP)=1/3 : SGWC(SGP)=1/3
32210 SGAX=SGWA(SGP) : SGBX=SGWB(SGP) : SGCX=SGWC(SGP)
32220 SGPX=SGAX*SGX(0)+SGBX*SGX(1)+SGCX*SGX(2) : SGPY=SGAX*SGY(0)+SGBX*SGY(1)+SGCX*SGY(2) : SGPZ=SGAX*SGZ(0)+SGBX*SGZ(1)+SGCX*SGZ(2)
32230 SGOLDY=SGAX*SGOY(0)+SGBX*SGOY(1)+SGCX*SGOY(2) : IF SGHAVE(SGID) THEN SGOLDY=SGAX*SGPASTY(SGID,0)+SGBX*SGPASTY(SGID,1)+SGCX*SGPASTY(SGID,2)
32240 SGTOP=0.25 : SGIX=INT((SGPX+24)*5+0.5) : SGIZ=INT((SGPZ+24)*5+0.5)
32250 IF SGIX>=0 AND SGIX<=240 AND SGIZ>=0 AND SGIZ<=240 THEN SGTOP=SGHEIGHT(SGIX,SGIZ)
32260 SGTARG=SGFLOOR : IF SGTOP>0.251 THEN SGTARG=SGTOP+SGRAD+0.004
32270 SGPROBES=SGPROBES+1 : SGTARGET(SGP)=SGTARG : IF SGPY>SGTARG+0.003 THEN GOTO 32295
32280 IF SGTOP>0.251 AND SGOLDY<SGTARG-0.025 AND SGTARG-SGPY>0.13 THEN GOTO 32295
32290 SGHIT(SGP)=1 : SGTOUCH=SGTOUCH+1 : RCN=RCN+1
32295 NEXT SGP : RETURN
32300 REM Vertical sample contacts give torque through their barycentric weights.
32310 IF SGTOUCH=0 THEN GOSUB 32500 : RETURN
32320 FOR SGIT=1 TO 2
32330 FOR SGP=0 TO SGCOUNT-1
32340 IF SGHIT(SGP)=0 THEN GOTO 32420
32350 SGAX=SGWA(SGP) : SGBX=SGWB(SGP) : SGCX=SGWC(SGP) : SGDEN=SGAX*SGAX+SGBX*SGBX+SGCX*SGCX
32360 SGPY=SGAX*SGY(0)+SGBX*SGY(1)+SGCX*SGY(2) : SGPEN=SGTARGET(SGP)-SGPY
32370 IF SGPEN<=0 THEN GOTO 32400
32380 SGCOR=MIN(0.3,SGPEN)*0.88/SGDEN
32390 SGY(0)=SGY(0)+SGCOR*SGAX : SGY(1)=SGY(1)+SGCOR*SGBX : SGY(2)=SGY(2)+SGCOR*SGCX : SGOY(0)=SGOY(0)+SGCOR*SGAX : SGOY(1)=SGOY(1)+SGCOR*SGBX : SGOY(2)=SGOY(2)+SGCOR*SGCX
32400 SGVEL=SGAX*(SGY(0)-SGOY(0))+SGBX*(SGY(1)-SGOY(1))+SGCX*(SGY(2)-SGOY(2)) : IF SGVEL>=0 THEN GOTO 32420
32410 SGIMP=SGVEL/SGDEN : IF SGVEL<-0.007 THEN SGIMP=SGIMP*1.06
32415 SGOY(0)=SGOY(0)+SGIMP*SGAX : SGOY(1)=SGOY(1)+SGIMP*SGBX : SGOY(2)=SGOY(2)+SGIMP*SGCX
32420 NEXT SGP : GOSUB 32500 : NEXT SGIT
32430 SGLIFT=0 : FOR SGP=0 TO SGCOUNT-1
32440 IF SGHIT(SGP) THEN SGLIFT=MAX(SGLIFT,SGTARGET(SGP)-SGWA(SGP)*SGY(0)-SGWB(SGP)*SGY(1)-SGWC(SGP)*SGY(2))
32450 NEXT SGP
32460 IF SGLIFT>0 THEN FOR SGV=0 TO SGNV-1 : SGY(SGV)=SGY(SGV)+SGLIFT : SGOY(SGV)=SGOY(SGV)+SGLIFT : NEXT SGV
32470 FOR SGV=0 TO SGNV-1 : SGOX(SGV)=SGX(SGV)-(SGX(SGV)-SGOX(SGV))*0.72 : SGOZ(SGV)=SGZ(SGV)-(SGZ(SGV)-SGOZ(SGV))*0.72 : SGOY(SGV)=SGY(SGV)-(SGY(SGV)-SGOY(SGV))*0.85 : NEXT SGV : RETURN
32500 REM Exact shape projection with a common floor lift, preserving old-pose velocity.
32510 SGCX0=0 : SGCY0=0 : SGCZ0=0 : FOR SGV=0 TO SGNV-1 : SGCX0=SGCX0+SGX(SGV)/SGNV : SGCY0=SGCY0+SGY(SGV)/SGNV : SGCZ0=SGCZ0+SGZ(SGV)/SGNV : NEXT SGV
32520 SGEX=SGX(1)-SGX(0) : SGEY=SGY(1)-SGY(0) : SGEZ=SGZ(1)-SGZ(0) : SGEL=SQR(SGEX*SGEX+SGEY*SGEY+SGEZ*SGEZ)
32521 IF SGEL<0.000001 THEN SGEX=1 : SGEY=0 : SGEZ=0 : SGEL=1
32522 SGEX=SGEX/SGEL : SGEY=SGEY/SGEL : SGEZ=SGEZ/SGEL
32530 SGA=SGL(0) : IF SGNV=2 THEN GOTO 32575
32540 SGQX=SGX(2)-SGX(0) : SGQY=SGY(2)-SGY(0) : SGQZ=SGZ(2)-SGZ(0) : SGPROJ=SGQX*SGEX+SGQY*SGEY+SGQZ*SGEZ
32545 SGFX=SGQX-SGPROJ*SGEX : SGFY=SGQY-SGPROJ*SGEY : SGFZ=SGQZ-SGPROJ*SGEZ : SGFL=SQR(SGFX*SGFX+SGFY*SGFY+SGFZ*SGFZ)
32546 IF SGFL<0.000001 THEN SGFX=-SGEZ : SGFY=0 : SGFZ=SGEX : SGFL=SQR(SGFX*SGFX+SGFZ*SGFZ)
32547 IF SGFL<0.000001 THEN SGFX=1 : SGFY=0 : SGFZ=0 : SGFL=1
32548 SGFX=SGFX/SGFL : SGFY=SGFY/SGFL : SGFZ=SGFZ/SGFL
32550 SGB=(SGL(2)^2+SGA^2-SGL(1)^2)/(2*MAX(0.000001,SGA)) : SGC=SQR(MAX(0,SGL(2)^2-SGB^2))
32555 FOR SGV=0 TO 2
32560 SGLX=-(SGA+SGB)/3 : SGLY=-SGC/3 : IF SGV=1 THEN SGLX=SGLX+SGA
32565 IF SGV=2 THEN SGLX=SGLX+SGB : SGLY=SGLY+SGC
32570 SGNEWX=SGCX0+SGEX*SGLX+SGFX*SGLY : SGNEWY=SGCY0+SGEY*SGLX+SGFY*SGLY : SGNEWZ=SGCZ0+SGEZ*SGLX+SGFZ*SGLY : GOSUB 32590 : NEXT SGV : GOTO 32580
32575 FOR SGV=0 TO 1 : SGLX=(SGV-0.5)*SGA : SGNEWX=SGCX0+SGEX*SGLX : SGNEWY=SGCY0+SGEY*SGLX : SGNEWZ=SGCZ0+SGEZ*SGLX : GOSUB 32590 : NEXT SGV
32580 SGLIFT=0 : FOR SGV=0 TO SGNV-1 : SGLIFT=MAX(SGLIFT,SGFLOOR-SGY(SGV)) : NEXT SGV
32585 IF SGLIFT>0 THEN FOR SGV=0 TO SGNV-1 : SGY(SGV)=SGY(SGV)+SGLIFT : SGOY(SGV)=SGOY(SGV)+SGLIFT : NEXT SGV
32587 RETURN
32590 SGOX(SGV)=SGOX(SGV)+SGNEWX-SGX(SGV) : SGOY(SGV)=SGOY(SGV)+SGNEWY-SGY(SGV) : SGOZ(SGV)=SGOZ(SGV)+SGNEWZ-SGZ(SGV) : SGX(SGV)=SGNEWX : SGY(SGV)=SGNEWY : SGZ(SGV)=SGNEWZ : RETURN
32600 REM Freeze settled material into the support map. R clears all stamps and poses.
32610 SGVMAX=0 : SGHIGH=MAX(SGY(0),SGY(1)) : SGLOW=MIN(SGY(0),SGY(1)) : IF SGNV=3 THEN SGHIGH=MAX(SGHIGH,SGY(2)) : SGLOW=MIN(SGLOW,SGY(2))
32615 SGSTEEP=SGHIGH-SGLOW>0.80*SGL(0)
32620 IF SGNV=3 THEN SGSTEEP=ABS(SGEX*SGFZ-SGEZ*SGFX)<0.25
32630 FOR SGV=0 TO SGNV-1 : SGVMAX=MAX(SGVMAX,ABS(SGX(SGV)-SGOX(SGV)),ABS(SGY(SGV)-SGOY(SGV)),ABS(SGZ(SGV)-SGOZ(SGV))) : NEXT SGV
32631 SGSTABLE=0 : SGTESTSUP=0 : IF SGTOUCH>0 AND (SGVMAX<0.0028 OR SGSTEEP) THEN SGTESTSUP=1 : GOSUB 32700
32632 IF SGTESTSUP AND SGSTABLE=0 THEN GOSUB 32800
32635 SGREST=0 : IF SGNV=2 THEN SGREST=BEAMSLEEP(SGID) ELSE SGREST=FSLEEP(SGFACE)
32640 IF SGTOUCH>0 AND SGSTEEP=0 AND SGSTABLE AND SGVMAX<0.0028 THEN SGREST=SGREST+1 ELSE SGREST=0
32645 SGNEWSTATE=1 : IF SGREST>=16 THEN SGNEWSTATE=2
32650 FOR SGV=0 TO SGNV-1
32655 IF SGNEWSTATE=2 THEN SGOX(SGV)=SGX(SGV) : SGOY(SGV)=SGY(SGV) : SGOZ(SGV)=SGZ(SGV)
32660 SGPASTX(SGID,SGV)=SGX(SGV) : SGPASTY(SGID,SGV)=SGY(SGV) : SGPASTZ(SGID,SGV)=SGZ(SGV)
32665 IF SGNV=3 THEN GOTO 32675
32670 BEAMPX(SGID,SGV)=SGX(SGV) : BEAMPY(SGID,SGV)=SGY(SGV) : BEAMPZ(SGID,SGV)=SGZ(SGV) : BEAMOX(SGID,SGV)=SGOX(SGV) : BEAMOY(SGID,SGV)=SGOY(SGV) : BEAMOZ(SGID,SGV)=SGOZ(SGV) : GOTO 32680
32675 FXP(SGFACE,SGV)=SGX(SGV) : FYP(SGFACE,SGV)=SGY(SGV) : FZP(SGFACE,SGV)=SGZ(SGV) : FOX(SGFACE,SGV)=SGOX(SGV) : FOY(SGFACE,SGV)=SGOY(SGV) : FOZ(SGFACE,SGV)=SGOZ(SGV)
32680 NEXT SGV : SGHAVE(SGID)=1
32685 IF SGNV=2 THEN BSTATE(SGID)=SGNEWSTATE : BEAMSLEEP(SGID)=SGREST ELSE FSTATE(SGFACE)=SGNEWSTATE : FSLEEP(SGFACE)=SGREST
32690 IF SGNEWSTATE=2 AND SGSTAMPED(SGID)=0 AND SGADDED<2 THEN GOSUB 33000
32695 RETURN
32700 REM Freeze only when the contact footprint supports the fragment's centre of mass.
32710 SGSUPN=0 : SGSCX=0 : SGSCZ=0 : SGAMIN=1 : SGBMIN=1 : SGCMIN=1 : SGAMAX=0 : SGBMAX=0 : SGCMAX=0
32720 FOR SGP=0 TO SGCOUNT-1
32730 IF SGHIT(SGP)=0 THEN GOTO 32770
32740 SGPY=SGWA(SGP)*SGY(0)+SGWB(SGP)*SGY(1)+SGWC(SGP)*SGY(2) : IF SGPY>SGTARGET(SGP)+0.012 THEN GOTO 32770
32750 SGSUPN=SGSUPN+1 : SGSCX=SGSCX+SGWA(SGP)*SGX(0)+SGWB(SGP)*SGX(1)+SGWC(SGP)*SGX(2) : SGSCZ=SGSCZ+SGWA(SGP)*SGZ(0)+SGWB(SGP)*SGZ(1)+SGWC(SGP)*SGZ(2)
32760 SGAMIN=MIN(SGAMIN,SGWA(SGP)) : SGAMAX=MAX(SGAMAX,SGWA(SGP)) : SGBMIN=MIN(SGBMIN,SGWB(SGP)) : SGBMAX=MAX(SGBMAX,SGWB(SGP)) : SGCMIN=MIN(SGCMIN,SGWC(SGP)) : SGCMAX=MAX(SGCMAX,SGWC(SGP))
32770 NEXT SGP
32780 IF SGSUPN=0 THEN SGSCX=SGCX0 : SGSCZ=SGCZ0 : RETURN
32785 SGSCX=SGSCX/SGSUPN : SGSCZ=SGSCZ/SGSUPN
32790 IF SGNV=2 THEN SGSTABLE=SGBMIN<=0.55 AND SGBMAX>=0.45 : RETURN
32795 SGSTABLE=SGAMIN<=1/3+0.025 AND SGAMAX>=1/3-0.025 AND SGBMIN<=1/3+0.025 AND SGBMAX>=1/3-0.025 AND SGCMIN<=1/3+0.025 AND SGCMAX>=1/3-0.025 : RETURN
32800 REM An unsupported quiet piece tips away from its contacts instead of freezing in the air.
32810 SGTOPV=0 : FOR SGV=1 TO SGNV-1
32815 IF SGY(SGV)>SGY(SGTOPV)+0.01 THEN SGTOPV=SGV : GOTO 32825
32820 IF ABS(SGY(SGV)-SGY(SGTOPV))<=0.01 THEN IF (SGX(SGV)-SGSCX)^2+(SGZ(SGV)-SGSCZ)^2>(SGX(SGTOPV)-SGSCX)^2+(SGZ(SGTOPV)-SGSCZ)^2 THEN SGTOPV=SGV
32825 NEXT SGV
32830 SGKX=SGX(SGTOPV)-SGSCX : SGKZ=SGZ(SGTOPV)-SGSCZ : SGKL=SQR(SGKX*SGKX+SGKZ*SGKZ)
32840 IF SGKL<0.0001 AND SGNV=3 THEN SGKX=SGEY*SGFZ-SGEZ*SGFY : SGKZ=SGEX*SGFY-SGEY*SGFX : SGKL=SQR(SGKX*SGKX+SGKZ*SGKZ)
32850 IF SGKL<0.0001 THEN SGKX=1 : SGKZ=0.37 : SGKL=SQR(1+0.37^2)
32860 SGOX(SGTOPV)=SGOX(SGTOPV)-SGKX/SGKL*0.22*H : SGOZ(SGTOPV)=SGOZ(SGTOPV)-SGKZ/SGKL*0.22*H : RETURN
33000 REM Deposit actual footprint once. Static pieces deliberately stay fixed until rebuild.
33010 IF SGSTAMPED(SGID) THEN RETURN
33020 IF SGNV=2 THEN SGVA=0 : SGVB=1 : GOSUB 33100 : GOTO 33070
33030 SGVA=0 : SGVB=1 : GOSUB 33100 : SGVA=1 : SGVB=2 : GOSUB 33100 : SGVA=2 : SGVB=0 : GOSUB 33100 : GOSUB 33200
33070 SGSTAMPED(SGID)=1 : SGADDED=SGADDED+1 : SGDEPOSITED=SGDEPOSITED+1 : SGTOTALSTATIC=SGTOTALSTATIC+1 : RETURN
33100 REM Thin beam/edge DDA, sampled at half a grid cell rather than using a box footprint.
33110 SGDX=SGX(SGVB)-SGX(SGVA) : SGDZ=SGZ(SGVB)-SGZ(SGVA) : SGDY=SGY(SGVB)-SGY(SGVA) : SGSTEPS=MAX(1,INT(MAX(ABS(SGDX),ABS(SGDZ))*10)+1)
33120 FOR SGS=0 TO SGSTEPS
33130 SGT=SGS/SGSTEPS : SGPX=SGX(SGVA)+SGDX*SGT : SGPZ=SGZ(SGVA)+SGDZ*SGT : SGPY=SGY(SGVA)+SGDY*SGT+SGRAD : GOSUB 33300
33140 NEXT SGS : RETURN
33200 REM Fill projected triangle with barycentric surface heights; empty corners stay empty.
33210 SGTAX=SGX(1)-SGX(0) : SGTAZ=SGZ(1)-SGZ(0) : SGTBX=SGX(2)-SGX(0) : SGTBZ=SGZ(2)-SGZ(0) : SGTDEN=SGTAX*SGTBZ-SGTAZ*SGTBX : IF ABS(SGTDEN)<0.00001 THEN RETURN
33220 SGXMIN=MAX(0,INT((MIN(SGX(0),SGX(1),SGX(2))+24)*5)) : SGXMAX=MIN(240,INT((MAX(SGX(0),SGX(1),SGX(2))+24)*5)+1)
33230 SGZMIN=MAX(0,INT((MIN(SGZ(0),SGZ(1),SGZ(2))+24)*5)) : SGZMAX=MIN(240,INT((MAX(SGZ(0),SGZ(1),SGZ(2))+24)*5)+1)
33240 FOR SGIX=SGXMIN TO SGXMAX
33250 SGQPX=SGIX*0.2-24-SGX(0)
33260 FOR SGIZ=SGZMIN TO SGZMAX
33270 SGQPZ=SGIZ*0.2-24-SGZ(0) : SGU=(SGQPX*SGTBZ-SGQPZ*SGTBX)/SGTDEN : SGV0=(SGTAX*SGQPZ-SGTAZ*SGQPX)/SGTDEN
33280 IF SGU<0 OR SGV0<0 OR SGU+SGV0>1 THEN GOTO 33295
33290 SGPY=SGY(0)+(SGY(1)-SGY(0))*SGU+(SGY(2)-SGY(0))*SGV0+SGRAD : SGHEIGHT(SGIX,SGIZ)=MAX(SGHEIGHT(SGIX,SGIZ),SGPY) : SGMAXHEIGHT=MAX(SGMAXHEIGHT,SGPY)
33295 NEXT SGIZ : NEXT SGIX : RETURN
33300 SGIX=INT((SGPX+24)*5+0.5) : SGIZ=INT((SGPZ+24)*5+0.5)
33310 IF SGIX<0 OR SGIX>240 OR SGIZ<0 OR SGIZ>240 THEN RETURN
33320 SGHEIGHT(SGIX,SGIZ)=MAX(SGHEIGHT(SGIX,SGIZ),SGPY) : SGMAXHEIGHT=MAX(SGMAXHEIGHT,SGPY) : RETURN
