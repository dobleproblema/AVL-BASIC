100 REM CHORDS
105 SCALE 0,8,0,6,20 : CLG : RAD
110 DIM X(25),Y(25)
115 N=20 : R=3 : S=2*PI/N
120 A=0 : N=N-1
125 T=TIME
130 FOR C=0 TO N
135   X(C)=4+R*COS(A)
140   Y(C)=3+R*SIN(A)
145   A=A+S
150 NEXT C
155 FOR C=0 TO N
160   FOR W=N TO C+1 STEP -1
165     MOVE X(C),Y(C)
170     DRAW X(W),Y(W)
175     FRAME
180   NEXT W
185 NEXT C
190 T=TIME-T
195 LDIR 90 : MOVE 8,0
200 LABEL "TIEMPO EMPLEADO: "+STR$(ROUND(T,3))
205 END
