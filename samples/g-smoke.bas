100 REM AVL-SMOKE - 2D fluid simulation in pure AVL-BASIC
110 REM Advanced settings below: ITER pressure sweeps, VORT on/off, CAP FPS limit.
120 REM Velocity in cells/second. ITER pressure sweeps use SOR, omega=1.5.
130 SCREEN : MODE 640 : RAD : PAPER 0 : CLG : MAT BASE 0
200 LEVEL=4 : ITER=4 : VORT=1 : SMOOTH=1 : HUD=1 : FROZEN=0 : CAP=60
210 DYE=24 : FADE=0.38 : VDRAG=0.06 : EPS=8
220 DIM TONE(2048),TR(2048),TG(2048),TB(2048),PALR(2),PALG(2),PALB(2)
230 DATA 0.03,0.68,1,1,0.04,0.65,1,0.44,0.02
240 FOR I=0 TO 2 : READ PALR(I),PALG(I),PALB(I) : NEXT I
245 REM Dye remains in [0,16]; include the endpoint in the tone tables.
250 FOR I=0 TO 2048 : TONE(I)=INT(244*(1-EXP(-I/128))) : TR(I)=(TONE(I)+2)*65536 : TG(I)=(TONE(I)+4)*256 : TB(I)=TONE(I)+9 : NEXT I
260 GOSUB 2000
270 LAST=TIME : TLAST=TIME : FPS=0 : COUNT=0 : T=0
300 REM Main loop; capped elapsed time prevents huge jumps after a slow frame
310 NOW=TIME : DT=MAX(0.001,MIN(0.05,NOW-LAST)) : LAST=NOW
320 K$=UPPER$(INKEY$)
330 IF K$=CHR$(27) OR KEYDOWN(27) THEN SCREEN CLOSE:END
350 IF K$=" " THEN FROZEN=1-FROZEN
360 IF K$="H" THEN HUD=1-HUD
380 IF K$="B" THEN SMOOTH=1-SMOOTH:GOSUB 2200
400 IF K$="Q" THEN LEVEL=(LEVEL+1) MOD 5:GOSUB 2000:LAST=TIME:GOTO 300
410 IF K$="R" THEN GOSUB 2000:LAST=TIME:GOTO 300
490 IF FROZEN THEN GOTO 610
500 T=T+DT
501 REM Advect the previous projected velocity before adding this step 's forces.
505 GOSUB 3800
510 GOSUB 1000
530 IF VORT THEN GOSUB 3000 ELSE GOSUB 4600
560 GOSUB 3400
570 GOSUB 4200
610 CLG OFFSCREEN
620 IF SMOOTH THEN GOSUB 5000 ELSE GOSUB 5200
640 IF HUD THEN GOSUB 5500
650 FRAME CAP
660 COUNT=COUNT+1
670 IF TIME-TLAST>=0.5 THEN FPS=COUNT/(TIME-TLAST):COUNT=0:TLAST=TIME
680 GOTO 300
1000 REM Three moving emitters supply real momentum and colored dye
1010 PX=0.5*NX+0.25*NX*SIN(T*0.7) : PY=0.5*NY+0.3*NY*COS(T*0.93)
1020 VX=0.175*NX*COS(T*0.7) : VY=-0.279*NY*SIN(T*0.93)
1030 VX=VX*3 : VY=VY*3 : ER=PALR(0) : EG=PALG(0) : EB=PALB(0) : GOSUB 1400
1040 PX=0.5*NX+0.28*NX*SIN(T*0.8+2.1) : PY=0.5*NY+0.29*NY*COS(T*0.61+1.7)
1050 VX=0.224*NX*COS(T*0.8+2.1) : VY=-0.1769*NY*SIN(T*0.61+1.7)
1060 VX=VX*3 : VY=VY*3 : ER=PALR(1) : EG=PALG(1) : EB=PALB(1) : GOSUB 1400
1070 PX=0.5*NX+0.25*NX*COS(T*0.57+0.8) : PY=0.5*NY+0.28*NY*SIN(T*0.77+2.8)
1080 VX=-0.1425*NX*SIN(T*0.57+0.8) : VY=0.2156*NY*COS(T*0.77+2.8)
1090 VX=VX*3 : VY=VY*3 : ER=PALR(2) : EG=PALG(2) : EB=PALB(2) : GOSUB 1400
1100 RETURN
1400 REM Smooth circular source; its impulse/rate are independent of FPS
1410 RAD2=BRUSH*BRUSH : COUPLE=1-EXP(-18*DT) : AMOUNT=DYE*DT
1420 XLO=MAX(1,INT(PX-BRUSH)) : XHI=MIN(NX,INT(PX+BRUSH)+1)
1430 YLO=MAX(1,INT(PY-BRUSH)) : YHI=MIN(NY,INT(PY+BRUSH)+1)
1440 FOR Y=YLO TO YHI
1450 FOR X=XLO TO XHI
1460 D2=(X-PX)^2+(Y-PY)^2 : IF D2>=RAD2 THEN GOTO 1510
1470 W=(1-D2/RAD2)^2 : I=Y*S+X : A=COUPLE*W
1480 U(I)=U(I)+(VX-U(I))*A : V(I)=V(I)+(VY-V(I))*A
1500 R(Y,X)=MIN(16,R(Y,X)+ER*AMOUNT*W) : G(Y,X)=MIN(16,G(Y,X)+EG*AMOUNT*W) : B(Y,X)=MIN(16,B(Y,X)+EB*AMOUNT*W)
1510 NEXT X
1520 NEXT Y
1530 RETURN
2000 REM Quality levels use square cells across the full 640 x 480 screen
2005 REM Each 4:3 grid stays within the cell count of its former 16:10 level.
2010 NX=36 : QUALITY$="MIN" : IF LEVEL=1 THEN NX=56:QUALITY$="LOW"
2020 IF LEVEL=2 THEN NX=72:QUALITY$="MEDIUM"
2030 IF LEVEL=3 THEN NX=84:QUALITY$="HIGH"
2040 IF LEVEL=4 THEN NX=116:QUALITY$="MAX"
2050 NY=NX*3\4 : S=NX+2 : TOTAL=S*(NY+2) : BRUSH=NX*0.035
2055 NXH=NX+0.5 : NYH=NY+0.5
2060 DIM U(TOTAL-1),V(TOTAL-1),U0(TOTAL-1),V0(TOTAL-1)
2070 DIM P(TOTAL-1),DIV(TOTAL-1),CURL(TOTAL-1)
2080 DIM R(NY+1,NX+1),G(NY+1,NX+1),B(NY+1,NX+1)
2090 DIM R0(NY+1,NX+1),G0(NY+1,NX+1),B0(NY+1,NX+1)
2100 REM A mild initial rotation, subsequently evolved by the fluid solver
2110 FOR Y=1 TO NY
2120 FOR X=1 TO NX
2130 I=Y*S+X : U(I)=-(Y-(NY+1)/2)*0.35 : V(I)=(X-(NX+1)/2)*0.35
2140 NEXT X
2150 NEXT Y
2160 GOSUB 4600 : GOSUB 2200 : T=0
2165 GOSUB 3400 : REM Start with projected velocity, including after Q/R reset
2170 RETURN
2200 REM Direct separable bilinear display resampling uses quarter weights
2210 RX=NX : RY=NY : IF SMOOTH THEN RX=NX*2:RY=NY*2
2220 DIM XX0(RX-1),XX1(RX-1),YY0(RY-1),YY1(RY-1)
2230 FOR X=0 TO RX-1 : XX0(X)=INT(X*640/RX) : XX1(X)=INT((X+1)*640/RX)-1 : NEXT X
2240 FOR Y=0 TO RY-1 : YY0(Y)=INT(Y*480/RY) : YY1(Y)=INT((Y+1)*480/RY)-1 : NEXT Y
2250 IF SMOOTH=0 THEN RETURN
2260 DIM HR(NX+1),HG(NX+1),HB(NX+1),XA0(NX),XA1(NX),XB0(NX),XB1(NX)
2270 FOR X=1 TO NX : DX=2*X-2 : XA0(X)=XX0(DX) : XA1(X)=XX1(DX) : XB0(X)=XX0(DX+1) : XB1(X)=XX1(DX+1) : NEXT X
2330 RETURN
3000 REM Vorticity confinement; direct indices preserve row-major evaluation order
3010 MAT CURL=0 : EDT=EPS*DT
3020 FOR Y=1 TO NY
3030 FOR I=Y*S+1 TO Y*S+NX : CURL(I)=0.5*(V(I+1)-V(I-1)-U(I+S)+U(I-S)) : NEXT I
3060 NEXT Y
3070 FOR Y=2 TO NY-1
3080 FOR I=Y*S+2 TO Y*S+NX-1 : GX=ABS(CURL(I+1))-ABS(CURL(I-1)) : GY=ABS(CURL(I+S))-ABS(CURL(I-S)) : L=SQR(GX*GX+GY*GY)+0.00001 : W=EDT*CURL(I)/L : U(I)=U(I)+GY*W : V(I)=V(I)-GX*W : NEXT I
3130 NEXT Y
3140 GOSUB 4600
3150 RETURN
3400 REM SOR pressure projection: faster convergence per sweep than Gauss-Seidel
3410 MAT P=0 : MAT DIV=0
3420 FOR Y=1 TO NY
3430 FOR I=Y*S+1 TO Y*S+NX : DIV(I)=-0.5*(U(I+1)-U(I-1)+V(I+S)-V(I-S)) : NEXT I
3460 NEXT Y
3470 FOR PASS=1 TO ITER
3480 FOR Y=1 TO NY
3485 REM omega=1.5: new pressure = 1.5*(divergence + neighbours)/4 - 0.5*old
3490 FOR I=Y*S+1 TO Y*S+NX : P(I)=0.375*(DIV(I)+P(I-1)+P(I+1)+P(I-S)+P(I+S))-0.5*P(I) : NEXT I
3520 NEXT Y
3530 FOR X=1 TO NX : P(X)=P(S+X) : P((NY+1)*S+X)=P(NY*S+X) : NEXT X
3540 FOR Y=1 TO NY : P(Y*S)=P(Y*S+1) : P(Y*S+NX+1)=P(Y*S+NX) : NEXT Y
3550 NEXT PASS
3560 FOR Y=1 TO NY
3570 FOR I=Y*S+1 TO Y*S+NX : U(I)=U(I)-0.5*(P(I+1)-P(I-1)) : V(I)=V(I)-0.5*(P(I+S)-P(I-S)) : NEXT I
3600 NEXT Y
3610 GOSUB 4600
3620 RETURN
3800 REM Advect both velocity components using the SAME previous field
3810 MAT U0=U : MAT V0=V : DRAG=EXP(-VDRAG*DT)
3820 FOR Y=1 TO NY : I=Y*S
3830 FOR X=1 TO NX : I=I+1 : AX=MAX(0.5,MIN(NXH,X-DT*U0(I))) : AY=MAX(0.5,MIN(NYH,Y-DT*V0(I))) : X0=INT(AX) : Y0=INT(AY) : FX=AX-X0 : FY=AY-Y0 : I0=Y0*S+X0 : I1=I0+1 : I2=I0+S : I3=I2+1 : W0=(1-FX)*(1-FY) : W1=FX*(1-FY) : W2=(1-FX)*FY : W3=FX*FY : U(I)=(U0(I0)*W0+U0(I1)*W1+U0(I2)*W2+U0(I3)*W3)*DRAG : V(I)=(V0(I0)*W0+V0(I1)*W1+V0(I2)*W2+V0(I3)*W3)*DRAG : NEXT X
3910 NEXT Y
3920 GOSUB 4600
3930 RETURN
4200 REM RGB dye shares one backtrace and one set of bilinear weights
4210 GOSUB 4800 : MAT R0=R : MAT G0=G : MAT B0=B : DECAY=EXP(-FADE*DT)
4220 FOR Y=1 TO NY : I=Y*S
4230 FOR X=1 TO NX : I=I+1 : AX=MAX(0.5,MIN(NXH,X-DT*U(I))) : AY=MAX(0.5,MIN(NYH,Y-DT*V(I))) : X0=INT(AX) : Y0=INT(AY) : FX=AX-X0 : FY=AY-Y0 : X1=X0+1 : Y1=Y0+1 : W0=(1-FX)*(1-FY) : W1=FX*(1-FY) : W2=(1-FX)*FY : W3=FX*FY : R(Y,X)=(R0(Y0,X0)*W0+R0(Y0,X1)*W1+R0(Y1,X0)*W2+R0(Y1,X1)*W3)*DECAY : G(Y,X)=(G0(Y0,X0)*W0+G0(Y0,X1)*W1+G0(Y1,X0)*W2+G0(Y1,X1)*W3)*DECAY : B(Y,X)=(B0(Y0,X0)*W0+B0(Y0,X1)*W1+B0(Y1,X0)*W2+B0(Y1,X1)*W3)*DECAY : NEXT X
4310 NEXT Y
4320 GOSUB 4800
4330 RETURN
4600 REM Reflect normal velocity at solid walls; copy the tangential component
4610 FOR X=1 TO NX
4620 I=NY*S+X : J=(NY+1)*S+X
4630 U(X)=U(S+X) : V(X)=-V(S+X) : U(J)=U(I) : V(J)=-V(I)
4640 NEXT X
4650 FOR Y=1 TO NY
4660 I=Y*S : J=I+NX+1
4670 U(I)=-U(I+1) : V(I)=V(I+1) : U(J)=-U(J-1) : V(J)=V(J-1)
4680 NEXT Y
4690 U(0)=0.5*(U(1)+U(S)) : V(0)=0.5*(V(1)+V(S))
4700 U(NX+1)=0.5*(U(NX)+U(2*S-1)) : V(NX+1)=0.5*(V(NX)+V(2*S-1))
4710 I=(NY+1)*S : U(I)=0.5*(U(I+1)+U(I-S)) : V(I)=0.5*(V(I+1)+V(I-S))
4720 I=TOTAL-1 : U(I)=0.5*(U(I-1)+U(I-S)) : V(I)=0.5*(V(I-1)+V(I-S))
4730 RETURN
4800 REM Dye has zero normal gradient at the four walls
4810 FOR X=1 TO NX
4820 R(0,X)=R(1,X) : G(0,X)=G(1,X) : B(0,X)=B(1,X)
4830 R(NY+1,X)=R(NY,X) : G(NY+1,X)=G(NY,X) : B(NY+1,X)=B(NY,X)
4840 NEXT X
4850 FOR Y=0 TO NY+1
4860 R(Y,0)=R(Y,1) : G(Y,0)=G(Y,1) : B(Y,0)=B(Y,1)
4870 R(Y,NX+1)=R(Y,NX) : G(Y,NX+1)=G(Y,NX) : B(Y,NX+1)=B(Y,NX)
4880 NEXT Y
4890 RETURN
5000 REM Exact bilinear densities before tone mapping; row scale 32 = 128/4
5005 REM Quarter weights need only two neighbours, not dense matrix products.
5010 FOR Y=0 TO RY-1 : TOP=YY0(Y) : BOT=YY1(Y)
5020 Y0=INT(0.75+Y*0.5) : Y1=Y0+1 : W1=0.75-0.5*(Y MOD 2) : W0=1-W1
5030 FOR X=0 TO NX+1 : HR(X)=(R(Y0,X)*W0+R(Y1,X)*W1)*32 : HG(X)=(G(Y0,X)*W0+G(Y1,X)*W1)*32 : HB(X)=(B(Y0,X)*W0+B(Y1,X)*W1)*32 : NEXT X
5060 FOR X=1 TO NX : FRECTANGLE XA0(X),TOP,XA1(X),BOT,TR(INT(HR(X-1)+HR(X)*3))+TG(INT(HG(X-1)+HG(X)*3))+TB(INT(HB(X-1)+HB(X)*3)) : FRECTANGLE XB0(X),TOP,XB1(X),BOT,TR(INT(HR(X)*3+HR(X+1)))+TG(INT(HG(X)*3+HG(X+1)))+TB(INT(HB(X)*3+HB(X+1))) : NEXT X
5150 NEXT Y
5160 RETURN
5200 REM Coarse cell display exposes the numerical grid and saves drawing work
5210 FOR Y=0 TO RY-1 : TOP=YY0(Y) : BOT=YY1(Y)
5220 FOR X=0 TO RX-1 : FRECTANGLE XX0(X),TOP,XX1(X),BOT,TR(INT(R(Y+1,X+1)*128))+TG(INT(G(Y+1,X+1)*128))+TB(INT(B(Y+1,X+1)*128)) : NEXT X
5270 NEXT Y
5280 RETURN
5500 REM Transparent HUD drawn over the fluid: quality, smoothing and FPS
5510 SMALLFONT TRANSPARENT : INK RGB(218,232,232)
5520 LOCATE 2,1 : GPRINT "AVL-SMOKE               ";USING "###.0";FPS;" FPS   SMOOTH ";IIF(SMOOTH,"ON","OFF")
5525 LOCATE 64,1 : GPRINT "QUALITY ";QUALITY$
5530 LOCATE 2,28 : GPRINT "Q QUALITY  B SMOOTH  SPACE PAUSE  R RESET  H HUD  ESC EXIT"
5540 RETURN
