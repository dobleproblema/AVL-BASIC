10 SCREEN : MODE 640 : PAPER 0 : CLG
20 INK 14 : FRECTANGLE 0,0,63,7
30 Paddle$=SPRITE$(0,0,63,7)
40 X=(WIDTH-64)\2
50 INK 1 : FCIRCLE 80,4,4
60 Ball$=SPRITE$(76,0,84,8)
70 BX=X+28 : BY=24 : DX=3 : DY=3
80 INK 12 : FRECTANGLE 96,0,151,15
90 Brick$=SPRITE$(96,0,151,15)
100 N=8 : DIM Broken(N) : BricksLeft=N
110 RowX=(WIDTH-(N*72-16))\2
120 RowY=HEIGHT-96
130 COLMODE 2
200 WHILE INKEY$<>CHR$(27) AND BricksLeft>0
210   MX=MOUSEX
220   IF MX>=0 THEN X=MAX(0,MIN(WIDTH-64,MX-32))
230   CLG OFFSCREEN
240   SPRITE Paddle$,X,16,0,100
250   FOR I=1 TO N
260     IF Broken(I)=0 THEN SPRITE Brick$,RowX+(I-1)*72,RowY,0,I
270   NEXT I
280   SPRITE Ball$,BX,BY,0,101
290   FRAME 60
300   IF BX+DX<0 OR BX+DX>WIDTH-9 THEN DX=-DX
310   IF BY+DY>HEIGHT-9 THEN DY=-DY
320   SPRITE HITTEST Ball$,BX+DX,BY+DY,0,101
330   IF HITID=100 AND DY<0 AND BY>=24 THEN
340     IF BX+4<X+32 THEN DX=-3 ELSE DX=3
350     DY=-DY : BY=24
360   ENDIF
365   IF HITID>=1 AND HITID<=N THEN
370     I=HITID : Broken(I)=1 : BricksLeft=BricksLeft-1
375     SPRITE HITTEST Ball$,BX+DX,BY,0,101
380     IF HITID=I THEN DX=-DX ELSE DY=-DY
385   ENDIF
400   BX=MAX(0,MIN(WIDTH-9,BX+DX)) : BY=BY+DY
410   IF BY<=-9 THEN BX=X+28 : BY=24 : DX=3 : DY=3
490 WEND
500 IF BricksLeft=0 THEN
505   CLG OFFSCREEN : INK 1 : MOVE 120,HEIGHT\2
510   LABEL "Row cleared! Press any key." : FRAME : PAUSE
515 ENDIF
520 SCREEN CLOSE
