10 SCREEN : MODE 640 : PAPER 0 : CLG
20 INK 14 : FRECTANGLE 0,0,63,7
30 Paddle$=SPRITE$(0,0,63,7)
40 X=(WIDTH-64)\2
50 INK 1 : FCIRCLE 80,4,4
60 Ball$=SPRITE$(76,0,84,8)
70 BX=X+28 : BY=24 : DX=3 : DY=3
200 WHILE INKEY$<>CHR$(27)
210   MX=MOUSEX
220   IF MX>=0 THEN X=MAX(0,MIN(WIDTH-64,MX-32))
230   CLG OFFSCREEN
240   SPRITE Paddle$,X,16
280   SPRITE Ball$,BX,BY,0
290   FRAME 60
300   IF BX+DX<0 OR BX+DX>WIDTH-9 THEN DX=-DX
310   IF BY+DY>HEIGHT-9 THEN DY=-DY
400   BX=MAX(0,MIN(WIDTH-9,BX+DX)) : BY=BY+DY
410   IF BY<=-9 THEN BX=X+28 : BY=24 : DX=3 : DY=3
490 WEND
520 SCREEN CLOSE
