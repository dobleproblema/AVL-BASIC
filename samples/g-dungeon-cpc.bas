9000 REM CPC arrangement of The Lantern Path: 100 BPM, D dorian, 64 x 15cs.
9001 REM Original MIDI score from dungeon-theme-patterns.json; no WAV assets needed.
9002 REM A=lead, C=bass, B=percussion/FX. ON SQ feeds one note per callback.
9003 REM Music meets every four ticks; only initial/beat notes carry rendezvous bits.
9004 AUDIO ON : MUSIC=1 : MUTED=0 : CPCPLAY=0 : CPCCELEBRATE=0
9005 CPCLN=33 : CPCBN=32 : CPCFXPRI=0 : CPCFXUNTIL=0 : CPCDRUMIDX=-1
9006 DIM CPCLP(32),CPCLD(32),CPCLENV(32),CPCLSYNC(32),CPCBP(31),CPCBD(31),CPCDRUM(15),CPCFP(7),CPCFD(7)
9007 RESTORE 10000 : FOR CPCI=0 TO CPCLN-1 : READ CPCLP(CPCI),CPCLD(CPCI),CPCLENV(CPCI),CPCLSYNC(CPCI) : NEXT CPCI
9008 RESTORE 10200 : FOR CPCI=0 TO CPCBN-1 : READ CPCBP(CPCI),CPCBD(CPCI) : NEXT CPCI
9009 RESTORE 10300 : FOR CPCI=0 TO 15 : READ CPCDRUM(CPCI) : NEXT CPCI
9010 RESTORE 10320 : FOR CPCI=0 TO 7 : READ CPCFP(CPCI),CPCFD(CPCI) : NEXT CPCI
9011 REM Soft lead articulation for one to four ticks; zero at each note 's tail.
9012 ENV 1,1,8,1,6,-1,2,1,-2,1
9013 ENV 2,1,8,1,6,-1,4,1,-2,1
9014 ENV 3,1,8,1,6,-1,7,1,-2,1
9015 ENV 4,1,8,1,6,-1,9,1,-2,1
9016 ENV 5,1,6,1,1,-1,10,1,-1,10,1,-1,17,1,-3,3
9017 ENT -1,1,1,4,2,-1,4,1,1,4
9018 REM Kick, snare and hat; only channel B uses the shared noise generator.
9019 ENV 6,1,6,1,6,-1,1 : ENT 2,6,90,1
9020 ENV 7,1,4,1,4,-1,1 : ENV 8,1,2,1,2,-1,1
9021 REM Alternating quiet shoe friction; no pitched footstep tone.
9022 ENV 9,1,3,1,3,-1,3 : ENV 10,1,3,1,3,-1,4
9023 ENV 11,1,11,1,10,-1,3,1,-1,3
9024 ENV 12,2,4,3,6,-1,9,1,-2,12 : ENT 3,6,42,7,=220,4,=1050,12
9025 ENV 13,1,8,1,8,-1,2 : ENT 4,3,55,2
9026 ENV 14,1,12,1,8,-1,10,1,-4,7
9027 ENV 15,1,6,1,5,-1,24,1,-1,31
9028 RETURN
9100 REM Distance-driven footsteps replace percussion, but never important FX.
9110 IF WON OR MOVED<0.000001 THEN RETURN
9120 FOOTDIST=FOOTDIST+MOVED
9130 IF FOOTDIST<0.62 THEN RETURN
9140 FOOTDIST=FOOTDIST-0.62 : FOOT=1-FOOT
9150 IF MUTED OR (CPCFXPRI>1 AND TIME<CPCFXUNTIL) THEN RETURN
9160 CPCFXPRI=1 : CPCFXUNTIL=TIME+(10+FOOT*3)/100
9162 SOUND 130,0,10+FOOT*3,0,9+FOOT,0,12+FOOT*2+RUNNING
9170 RETURN
9200 REM B toggles music; N toggles all audio. Preferences survive R.
9210 IF K$="B" THEN MUSIC=1-MUSIC:GOSUB 9250
9220 IF K$="N" THEN MUTED=1-MUTED:GOSUB 9260
9225 GOSUB 9600
9230 RETURN
9250 IF WON THEN RETURN
9251 GOSUB 9270
9252 IF MUSIC=0 OR MUTED THEN RETURN
9253 DI : CPCLIDX=0 : CPCBIDX=0 : CPCDRUMIDX=-1 : CPCSTART=TIME+0.01 : CPCPLAY=1
9254 GOSUB 9400 : GOSUB 9500 : EI : RETURN
9260 GOSUB 9280
9261 IF MUTED THEN AUDIO OFF:RETURN
9262 AUDIO ON : GOSUB 9250 : RETURN
9270 REM Disarm before flushing A/C; leave an important effect on B intact.
9271 DI : CPCPLAY=0 : ON SQ(1) GOSUB 0 : ON SQ(4) GOSUB 0
9272 SOUND 133,0,1,0
9273 IF CPCFXPRI=0 THEN SOUND 130,0,1,0
9274 EI : RETURN
9280 REM Explicit cleanup for R, mute, victory and Esc; END alone keeps queues.
9281 DI : CPCPLAY=0 : CPCCELEBRATE=0
9282 ON SQ(1) GOSUB 0 : ON SQ(2) GOSUB 0 : ON SQ(4) GOSUB 0
9283 SOUND 135,0,1,0 : CPCFXPRI=0 : CPCFXUNTIL=0 : CPCDRUMIDX=-1
9284 EI : RETURN
9300 REM Key: D6/F6/A6 reward arpeggio, above steps and the stuck latch.
9301 IF MUTED OR (CPCFXPRI>3 AND TIME<CPCFXUNTIL) THEN RETURN
9302 CPCFXPRI=3 : CPCFXUNTIL=TIME+0.54
9303 SOUND 130,53,9,0,11 : SOUND 2,45,9,0,11 : SOUND 2,36,36,0,11
9305 RETURN
9310 REM Heavy gate: descending rumble, noisy wood friction and one bright creak.
9311 IF MUTED OR (CPCFXPRI>4 AND TIME<CPCFXUNTIL) THEN RETURN
9312 CPCFXPRI=4 : CPCFXUNTIL=TIME+0.78
9313 SOUND 130,844,78,0,12,3,20
9315 RETURN
9320 REM Victory uses all three voices: melody, low D and delayed A bass.
9321 GOSUB 9280 : IF MUTED THEN RETURN
9322 DI : CPCCELEBRATE=1 : CPCFIDX=0 : CPCFXPRI=5 : CPCFXUNTIL=TIME+1.75
9323 GOSUB 9700 : SOUND 42,426,152,0,15
9324 SOUND 28,0,60,0 : SOUND 4,284,88,0,15 : EI : RETURN
9330 REM Two latch attempts; repeat is limited to once every half second.
9332 IF MUTED OR T<LOCKUNTIL OR (CPCFXPRI>2 AND TIME<CPCFXUNTIL) THEN RETURN
9333 CPCFXPRI=2 : CPCFXUNTIL=TIME+0.46 : LOCKUNTIL=T+0.5
9334 SOUND 130,240,9,0,13,4,7 : SOUND 2,0,8,0 : SOUND 2,260,29,0,13,4,9
9336 RETURN
9400 REM Lead ISR: private variables only; never READ or RESTORE while playing.
9401 IF CPCPLAY=0 OR MUSIC=0 OR MUTED OR WON THEN RETURN
9402 SOUND 1+CPCLSYNC(CPCLIDX),CPCLP(CPCLIDX),CPCLD(CPCLIDX),0,CPCLENV(CPCLIDX),1
9403 CPCLIDX=(CPCLIDX+1) MOD CPCLN : ON SQ(1) GOSUB 9400
9404 RETURN
9500 REM Bass alternates 41cs tone/19cs rest, exactly one quarter note per pair.
9501 IF CPCPLAY=0 OR MUSIC=0 OR MUTED OR WON THEN RETURN
9502 CPCBSTATE=4 : CPCBENV=0
9503 IF CPCBIDX MOD 2=0 THEN CPCBSTATE=12:CPCBENV=5
9504 SOUND CPCBSTATE,CPCBP(CPCBIDX),CPCBD(CPCBIDX),0,CPCBENV
9505 CPCBIDX=(CPCBIDX+1) MOD CPCBN : ON SQ(4) GOSUB 9500
9506 RETURN
9600 REM Percussion follows real TIME, not the game 's clamped motion clock T.
9601 IF CPCPLAY=0 OR MUTED OR WON THEN RETURN
9602 CPCDTICK=INT((TIME-CPCSTART)/0.15)
9603 IF CPCDTICK<0 OR CPCDTICK=CPCDRUMIDX THEN RETURN
9604 CPCDRUMIDX=CPCDTICK
9605 IF TIME<CPCFXUNTIL OR SQ(2)<>4 THEN RETURN
9606 CPCDRUMTYPE=CPCDRUM(CPCDTICK MOD 16) : IF CPCDRUMTYPE=0 THEN RETURN
9607 CPCFXPRI=0
9608 IF CPCDRUMTYPE=1 THEN SOUND 2,690,7,0,6,2:RETURN
9609 IF CPCDRUMTYPE=2 THEN SOUND 2,0,5,0,7,0,12:RETURN
9610 SOUND 2,0,3,0,8,0,3 : RETURN
9700 REM Finite fanfare callback: seven note/rest events and a quiet final tail.
9701 IF CPCCELEBRATE=0 OR MUTED THEN RETURN
9702 CPCFSTATE=1 : CPCFENV=14 : IF CPCFIDX=0 THEN CPCFSTATE=49
9703 IF CPCFP(CPCFIDX)=0 THEN CPCFENV=0
9704 SOUND CPCFSTATE,CPCFP(CPCFIDX),CPCFD(CPCFIDX),0,CPCFENV
9705 CPCFIDX=CPCFIDX+1
9706 IF CPCFIDX<8 THEN ON SQ(1) GOSUB 9700 ELSE CPCCELEBRATE=0
9707 RETURN
