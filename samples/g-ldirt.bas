10 CLG : BIGFONT : DEG
20 T$="ROTATING LETTERS AROUND THE CIRCLE - "
30 T=P=1 : L=LEN(T$) : A=360/L
40 T1=TIME
50 FOR C=1 TO 1000
60 CLG OFFSCREEN
70 FOR I=1 TO L
80 X=T+(I-1)*A : MOVE WIDTH\2+SIN(X)*200,HEIGHT\2+COS(X)*200
90 C$=MID$(T$,P,1)
100 P=(P MOD L)+1
110 LDIR -X : LABEL C$,1,-1
120 NEXT
130 P=(P MOD L)+1 : FRAME : T=T+A-1
140 NEXT C
150 PRINT "Elapsed time";TIME-T1
