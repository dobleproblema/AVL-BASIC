10 DEF SUB clover(CX,CY,R)
15   LOCAL S,A,X,Y
20   S=PI/2 : X=Y=-R
25   FOR A=0 TO 3*S STEP S
30     FCIRCLE CX+X,CY+Y,R,3,A,A-S
35     CIRCLE CX+X,CY+Y,R,1,A,A-S
40     SWAP X,Y : Y=-Y
45   NEXT
50   FRECTANGLE CX+X,CY+Y,CX-X,CY-Y,3
55 SUBEND
60 T1=TIME
65 CLG
70 FOR X=1 TO 5000
75   CALL clover(INT(WIDTH*RND),INT(HEIGHT*RND),32)
80   FRAME
85 NEXT
90 PRINT TIME-T1;"sec."
95 END
