100 REM A rotating cube illuminated by a mouse-controlled light.
110 REM SPACE pauses rotation; the mouse-controlled light remains active.
115 REM C toggles the 60 FPS limit; ESC exits.
120 SCREEN : MODE 640 : RAD : PAPER RGB(7,10,18) : CLG : MOUSE ON
130 W=WIDTH : H=HEIGHT : FOC=450 : DIST=4.8
140 DIM D(W-1,H-1)
150 DIM P1(8),P2(8),P3(8),WX(8),WY(8),WZ(8),PX(8),PY(8),Q(8)
160 DIM F(6,4),R(4),G(4),B(4)
170 FOR I=1 TO 8 : READ P1(I) : NEXT I
180 FOR I=1 TO 8 : READ P2(I) : NEXT I
190 FOR I=1 TO 8 : READ P3(I) : NEXT I
200 FOR I=1 TO 6 : FOR J=1 TO 4 : READ F(I,J) : NEXT J : NEXT I
210 A1=.45 : A2=.65 : PAUSED=0 : SMALLFONT TRANSPARENT
215 CAP=1 : FPS=0 : COUNT=0 : TLAST=TIME : TSIM=TIME
220 MX=160 : MY=390 : LZ=-2 'The light moves on a plane in front of the cube
230 ON MOUSE MOVE GOSUB 1000 : ON MOUSE LEFTDRAG GOSUB 1000 : ON MOUSE RIGHTDRAG GOSUB 1000
300 SX=MX : SY=MY : LX=(SX-W/2)*LZ/FOC : LY=(SY-H/2)*LZ/FOC
305 TNOW=TIME : DT=MIN(TNOW-TSIM,.15) : TSIM=TNOW
310 IF PAUSED=0 THEN A1=A1+.72*DT : A2=A2+.96*DT
320 S1=SIN(A1) : C1=COS(A1) : S2=SIN(A2) : C2=COS(A2)
330 CLG OFFSCREEN : MAT D=0
340 FOR I=1 TO 8
350 Y=P2(I)*C1-P3(I)*S1 : Z=P3(I)*C1+P2(I)*S1
360 X=P1(I)*C2-Z*S2 : Z=Z*C2+P1(I)*S2-DIST
370 WX(I)=X : WY(I)=Y : WZ(I)=Z
380 PX(I)=X*FOC/Z+W/2 : PY(I)=Y*FOC/Z+H/2 : Q(I)=-1/Z
390 NEXT I
400 REM Draw all faces; the depth array hides those behind nearer surfaces.
410 FOR FACE=1 TO 6
420 IA=F(FACE,1) : IB=F(FACE,2) : IC=F(FACE,3) : ID=F(FACE,4)
430 REM For this unit cube, face centre minus cube centre is its unit normal.
440 NX=(WX(IA)+WX(IB)+WX(IC)+WX(ID))/4
450 NY=(WY(IA)+WY(IB)+WY(IC)+WY(ID))/4
460 NZ=(WZ(IA)+WZ(IB)+WZ(IC)+WZ(ID))/4+DIST
470 FOR J=1 TO 4
480 IV=F(FACE,J) : DX=LX-WX(IV) : DY=LY-WY(IV) : DZ=LZ-WZ(IV)
490 D2=DX*DX+DY*DY+DZ*DZ
500 DIFF=MAX(0,(NX*DX+NY*DY+NZ*DZ)/SQR(D2))
510 BR=MIN(1,.15+1.6*DIFF/(1+.14*D2)) 'Ambient + Lambert + soft distance falloff
520 R(J)=195*BR : G(J)=215*BR : B(J)=245*BR
530 NEXT J
550 GTRIANGLE D,PX(IA),PY(IA),Q(IA),R(1),G(1),B(1),PX(IB),PY(IB),Q(IB),R(2),G(2),B(2),PX(IC),PY(IC),Q(IC),R(3),G(3),B(3)
560 GTRIANGLE D,PX(IC),PY(IC),Q(IC),R(3),G(3),B(3),PX(ID),PY(ID),Q(ID),R(4),G(4),B(4),PX(IA),PY(IA),Q(IA),R(1),G(1),B(1)
570 NEXT FACE
600 INK RGB(255,232,155) : CIRCLE SX,SY,9 : FCIRCLE SX,SY,3
620 PS$="" : IF PAUSED THEN PS$="  [PAUSED]"
630 INK RGB(235,240,255) : LOCATE 3,2 : GPRINT "GTRIANGLE - CUBE LIGHT  ";USING "####.0";FPS;" FPS  LIGHT STAYS ACTIVE WHEN PAUSED"
640 CP$="OFF" : IF CAP THEN CP$="ON"
650 LOCATE 3,28 : GPRINT "MOUSE: LIGHT  SPACE: PAUSE  C: CAP ";CP$;"  ESC: EXIT";PS$
660 IF CAP THEN FRAME 60 ELSE FRAME
661 COUNT=COUNT+1 : TNOW=TIME
662 IF TNOW-TLAST>=.5 THEN FPS=COUNT/(TNOW-TLAST) : COUNT=0 : TLAST=TNOW
670 K$=UPPER$(INKEY$)
680 IF K$=CHR$(27) THEN ON MOUSE MOVE GOSUB 0 : ON MOUSE LEFTDRAG GOSUB 0 : ON MOUSE RIGHTDRAG GOSUB 0 : SCREEN CLOSE : END
700 IF K$=" " THEN PAUSED=1-PAUSED
705 IF K$="C" THEN CAP=1-CAP : COUNT=0 : TLAST=TIME
710 GOTO 300
800 DATA -1,1,1,-1,-1,1,1,-1
810 DATA 1,1,-1,-1,1,1,-1,-1
820 DATA 1,1,1,1,-1,-1,-1,-1
830 DATA 1,2,3,4
840 DATA 5,6,2,1
850 DATA 8,7,6,5
860 DATA 4,3,7,8
870 DATA 2,6,7,3
880 DATA 5,1,4,8
1000 MX=MAX(0,MIN(W-1,MOUSEX)) : MY=MAX(0,MIN(H-1,MOUSEY)) : RETURN
