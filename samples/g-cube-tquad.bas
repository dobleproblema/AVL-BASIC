100 REM ============================================================
110 REM  PERSPECTIVE TEXTURED 3D CUBE - AVL BASIC
120 REM Press ESC to exit.
130 REM ============================================================
140 TEXFILE$="assets/texture.png" 'Try also assets/tunnel.png
150 W=640 : H=480
160 SCREEN : MODE 640
170 PAPER 0 : CLG
180 BLOAD TEXFILE$,TEX$
190 P1=INSTR(TEX$,"x") : P2=INSTR(TEX$,":")
200 IF P1=0 OR P2=0 THEN PRINT "Invalid graphics format":END
210 TW=VAL(LEFT$(TEX$,P1-1))
220 TH=VAL(MID$(TEX$,P1+1,P2-P1-1))
230 XC=(W-1)/2 : YC=(H-1)/2
240 FOC=430 : DIST=4.2
250 REM One native perspective-correct TQUAD per face, sharing a depth buffer.
260 DIM PX0(8),PY0(8),PZ0(8)
270 DIM VX(8),VY(8),VQ(8)
280 DIM F(6,4)
285 DIM D(W-1,H-1)
290 FOR I=1 TO 8 : READ Q : PX0(I)=Q : NEXT I
300 FOR I=1 TO 8 : READ Q : PY0(I)=Q : NEXT I
310 FOR I=1 TO 8 : READ Q : PZ0(I)=Q : NEXT I
320 FOR I=1 TO 6
330   FOR J=1 TO 4
340     READ Q : F(I,J)=Q
350   NEXT J
360 NEXT I
370 TSTART=TIME
380 FCOUNT=0 : TLAST=TIME : FPS=0
390 REM MAIN LOOP
400 T=TIME-TSTART
410 A=T*0.82 : B=T*1.08 : C=T*0.37
420 SA=SIN(A) : CA=COS(A)
430 SB=SIN(B) : CB=COS(B)
440 SC=SIN(C) : CC=COS(C)
450 CLG OFFSCREEN : MAT D=0
460 REM Project the 8 cube vertices once; q=1/Z3 is positive inverse depth.
470 FOR I=1 TO 8
480   PX=PX0(I) : PY=PY0(I) : PZ=PZ0(I)
490   GOSUB 2000
500   VX(I)=GX : VY(I)=GY : VQ(I)=1/Z3
510 NEXT I
515 REM Draw all faces: native depth testing handles their visibility.
520 FOR FC=1 TO 6
530   IA=F(FC,1) : IB=F(FC,2) : IC=F(FC,3) : ID=F(FC,4)
540   TQUAD TEX$,D,VX(IA),VY(IA),VQ(IA),0,0,VX(IB),VY(IB),VQ(IB),TW,0,VX(IC),VY(IC),VQ(IC),TW,TH,VX(ID),VY(ID),VQ(ID),0,TH
690 NEXT FC
700 FCOUNT=FCOUNT+1
710 IF TIME-TLAST>=0.5 THEN FPS=FCOUNT/(TIME-TLAST):FCOUNT=0:TLAST=TIME
720 SMALLFONT OPAQUE : PAPER 0 : INK 18
730 LOCATE 1,1
740 GPRINT "AVL-BASIC PERSPECTIVE CUBE  FPS: ";USING "###.0";FPS;"  ESC=EXIT"
750 FRAME 60
760 IF KEYDOWN(27) THEN SCREEN CLOSE:END
770 GOTO 400
2000 REM Rotate and project PX,PY,PZ -> GX,GY,Z3
2010 RY=PY*CA-PZ*SA
2020 RZ=PZ*CA+PY*SA
2030 RX=PX*CB+RZ*SB
2040 RZ=RZ*CB-PX*SB
2050 X3=RX*CC-RY*SC
2060 Y3=RY*CC+RX*SC
2070 Z3=RZ+DIST
2080 GX=XC+X3*FOC/Z3
2090 GY=YC+Y3*FOC/Z3
2100 RETURN
4000 DATA -1, 1, 1, -1, -1, 1, 1, -1
4010 DATA 1, 1, -1, -1, 1, 1, -1, -1
4020 DATA 1, 1, 1, 1, -1, -1, -1, -1
4030 DATA 1, 2, 3, 4
4040 DATA 5, 6, 2, 1
4050 DATA 8, 7, 6, 5
4060 DATA 4, 3, 7, 8
4070 DATA 2, 6, 7, 3
4080 DATA 5, 1, 4, 8
