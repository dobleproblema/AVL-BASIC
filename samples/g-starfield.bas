100 REM 3D starfield
110 SCREEN : MODE 800 : DEG : PAPER RGB$(1,2,9) : CLG : SMALLFONT TRANSPARENT
120 STARS=2000 : SNEAR=70 : SFAR=950 : VPDIST=4200
130 DIRPH=35 : FCOUNT=0 : TLAST=TIME : FPS=0
140 DIM STX(STARS),STY(STARS),STZ(STARS)
150 RANDOMIZE TIME : GOSUB 1000
160 INFO$="AVL-BASIC 3D STARFIELD  STARS:"+STR$(STARS)+"  FPS:"
200 REM Main loop
210 CLG OFFSCREEN
230 DIRPH=DIRPH+0.65 : IF DIRPH>=360 THEN DIRPH=DIRPH-360
240 FLOW=5.2*COS(DIRPH) : SIDEX=2.6*SIN(DIRPH) : SIDEY=1.7*SIN(DIRPH*0.61+70)
250 VPX=WIDTH/2+VPDIST*COS(DIRPH)
260 VPY=HEIGHT/2+VPDIST*SIN(DIRPH)
270 FOR I=1 TO STARS
280   OX=STX(I) : OY=STY(I) : Q=(SFAR-STZ(I))/(SFAR-SNEAR)
285   Q2=Q*Q : STEP3D=0.1*FLOW*(0.08+0.92*Q)/STZ(I) : PAR=0.05+1.95*Q2
290   STX(I)=STX(I)+STEP3D*(STX(I)-VPX)+SIDEX*PAR
300   STY(I)=STY(I)+STEP3D*(STY(I)-VPY)+SIDEY*PAR
310   STZ(I)=STZ(I)-FLOW : RESET=0
315   REM Depth recycling is random; edge recycling wraps to preserve the flow
320   IF FLOW>=0 AND STZ(I)<SNEAR THEN STZ(I)=SFAR:STX(I)=RND*WIDTH:STY(I)=RND*HEIGHT:RESET=1
330   IF FLOW<0 AND STZ(I)>SFAR THEN STZ(I)=SNEAR:STX(I)=RND*WIDTH:STY(I)=RND*HEIGHT:RESET=1
340   IF STX(I)<0 THEN STX(I)=STX(I)+WIDTH:RESET=1
342   IF STX(I)>=WIDTH THEN STX(I)=STX(I)-WIDTH:RESET=1
344   IF STY(I)<0 THEN STY(I)=STY(I)+HEIGHT:RESET=1
346   IF STY(I)>=HEIGHT THEN STY(I)=STY(I)-HEIGHT:RESET=1
360   Q=(SFAR-STZ(I))/(SFAR-SNEAR) : BR=70+INT(185*Q)
370   C=RGB(INT(BR*0.68),INT(BR*0.8),BR)
380   IF I MOD 13=0 THEN C=RGB(BR,INT(BR*0.76),INT(BR*0.58))
390   INK C : IF RESET THEN PLOT STX(I),STY(I) ELSE MOVE OX,OY:DRAW STX(I),STY(I)
400   IF Q>0.72 THEN FRECTANGLE STX(I)-1,STY(I)-1,STX(I)+1,STY(I)+1,C
410   IF Q>0.94 THEN FRECTANGLE STX(I)-2,STY(I)-2,STX(I)+2,STY(I)+2,C
420 NEXT I
430 FCOUNT=FCOUNT+1
440 IF TIME-TLAST>=0.5 THEN FPS=FCOUNT/(TIME-TLAST):FCOUNT=0:TLAST=TIME
460 INK 18 : LOCATE 1,1 : GPRINT INFO$;USING "###.0";FPS;"  ESC=EXIT"
470 FRAME 60
480 IF KEYDOWN(27) THEN SCREEN CLOSE:END
490 GOTO 210
1000 REM Fill the whole view volume: no visible central convergence
1010 FOR I=1 TO STARS
1020   STX(I)=RND*WIDTH : STY(I)=RND*HEIGHT
1030   STZ(I)=SNEAR+RND*(SFAR-SNEAR)
1040 NEXT I
1050 RETURN
