1000 REM Calculate pi with Machin 's formula.
1010 REM Set P in the main program to choose the number of decimal digits.
1020 REM **Main program**
1030 P=1000 'INPUT "DIGITS: ",P
1040 L=9 'Safe 9-digit blocks: keeps R*F+B4(A) exact (no rounding) up to 1,000,000 decimal digits
1050 F=10^L : G=FNBLOCKCOUNT(P,L) : F$=FNFORMAT$(L)
1060 DIM B1(G),B2(G),B3(G),B4(G)
1070 T1=TIME
1080 CALL ATANINV(5)
1090 CALL MULB1(16,1)
1100 CALL ATANINV(239)
1110 CALL MULB1(4,0)
1120 CALL SUBB2(1)
1130 T2=TIME
1140 REM Print
1150 FOR A=0 TO G
1160   PRINT USING F$;B1(A);
1170   IF A>0 AND A MOD 8 = 7 THEN PRINT
1180 NEXT A
1190 PRINT : PRINT USING "#.###";T2-T1;" SEC."
1200 END
1210 REM **Helper functions**
1220 DEF FNBLOCKCOUNT(DIGITS,BLOCKSIZE)
1230   FNBLOCKCOUNT=(DIGITS+1)\BLOCKSIZE
1240 FNEND
1250 DEF FNFORMAT$(BLOCKSIZE)
1260   FNFORMAT$="0"+STRING$(BLOCKSIZE-1,"#")+" "
1270 FNEND
1280 REM **Arithmetic routines**
1290 DEF SUB ADDB1B2
1300   LOCAL A,K,D
1310   K=0 : D=0
1320   IF H<=G THEN
1330     FOR A=G TO H STEP -1
1340       D=B1(A)+B2(A)+K
1350       IF D>=F THEN D=D-F:K=1 ELSE K=0
1360       B1(A)=D
1370     NEXT A
1380   ENDIF
1390   IF K<>0 THEN
1400     FOR A=H-1 TO 0 STEP -1
1410       D=B1(A)+K
1420       IF D>=F THEN D=D-F:K=1 ELSE K=0
1430       B1(A)=D
1440       IF K=0 THEN A=0
1450     NEXT A
1460   ENDIF
1470 SUBEND
1480 DEF SUB SUBB2(USEB3)
1490   LOCAL A,K,D
1500   K=0
1510   IF USEB3 THEN
1520     FOR A=G TO 0 STEP -1
1530       D=B3(A)-B2(A)-K
1540       IF D<0 THEN D=D+F:K=1 ELSE K=0
1550       B1(A)=D
1560     NEXT A
1570   ELSE
1580     IF H<=G THEN
1590       FOR A=G TO H STEP -1
1600         D=B1(A)-B2(A)-K
1610         IF D<0 THEN D=D+F:K=1 ELSE K=0
1620         B1(A)=D
1630       NEXT A
1640     ENDIF
1650     IF K<>0 THEN
1660       FOR A=H-1 TO 0 STEP -1
1670         D=B1(A)-K
1680         IF D<0 THEN D=D+F:K=1 ELSE K=0
1690         B1(A)=D
1700         IF K=0 THEN A=0
1710       NEXT A
1720     ENDIF
1730   ENDIF
1740 SUBEND
1750 DEF SUB MULB1(FACTOR,TOB3)
1760   LOCAL A,K,D
1770   K=0
1780   FOR A=G TO 0 STEP -1
1790     IF B1(A) OR K THEN
1800       D=B1(A)*FACTOR+K
1810       IF D>=F THEN K=D\F:D=D MOD F ELSE K=0
1820       IF TOB3 THEN B3(A)=D:B1(A)=0 ELSE B2(A)=D
1830     ENDIF
1840   NEXT A
1850 SUBEND
1860 DEF SUB DIVB4TOB2(DIVISOR)
1870   LOCAL A,R,D,C,O
1880   R=0 : O=H : H=G+1
1890   IF O<J THEN
1900     FOR A=O TO J-1
1910       B2(A)=0
1920     NEXT A
1930   ENDIF
1940   FOR A=J TO G
1950     IF B4(A)=0 AND R=0 THEN
1960       B2(A)=0
1970     ELSE
1980       D=R*F+B4(A)
1990       C=D\DIVISOR
2000       R=D MOD DIVISOR
2010       B2(A)=C
2020       IF C THEN
2030         IF H>G THEN H=A
2040       ENDIF
2050     ENDIF
2060   NEXT A
2070 SUBEND
2080 DEF SUB DIVB4TOB4(DIVISOR)
2090   LOCAL A,R,D,C,O
2100   Z=1 : O=J : J=G+1 : R=0
2110   FOR A=O TO G
2120     IF B4(A) OR R THEN
2130       D=R*F+B4(A)
2140       C=D\DIVISOR
2150       R=D MOD DIVISOR
2160       B4(A)=C
2170       IF C THEN
2180         Z=0
2190         IF J>G THEN J=A
2200       ENDIF
2210     ENDIF
2220   NEXT A
2230 SUBEND
2240 DEF SUB RECIP(DIVISOR)
2250   LOCAL A,R
2260   R=F
2270   J=G+1
2280   FOR A=0 TO G
2290     B4(A)=R\DIVISOR
2300     IF B4(A) THEN
2310       IF J>G THEN J=A
2320     ENDIF
2330     R=(R MOD DIVISOR)*F
2340   NEXT A
2350 SUBEND
2360 DEF SUB ATANINV(DIVISOR)
2370   LOCAL N,Q
2380   N=1 : Q=DIVISOR*DIVISOR
2390   CALL RECIP(DIVISOR)
2400   Z=0
2410   WHILE Z=0
2420     CALL DIVB4TOB2(N)
2430     CALL ADDB1B2
2440     CALL DIVB4TOB4(Q)
2450     N=N+2
2460     IF Z=0 THEN
2470       CALL DIVB4TOB2(N)
2480       CALL SUBB2(0)
2490       CALL DIVB4TOB4(Q)
2500       N=N+2
2510     ENDIF
2520   WEND
2530 SUBEND
