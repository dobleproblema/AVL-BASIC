100 REM A large multicolored anime fairy fades over a sunny anime background.
110 REM ALPHA is opacity: 0=invisible, 1=opaque; magenta marks the sprite exterior.
120 REM SPACE: pause; C: FPS cap; ESC: exit.
130 SCREEN : MODE 640 : RAD : PAPER 0 : CLG OFFSCREEN : SMALLFONT TRANSPARENT
140 BLOAD "assets/anime.png",BACKGROUND$
150 BLOAD "assets/fairy-sprite.png",FAIRY$
160 W=WIDTH : H=HEIGHT : SW=320 : SH=320
200 COLMODE 0 : SPRITE FAIRY$,0,0,RGB(255,0,255),1 ALPHA 0
210 T=0 : PAUSED=0 : CAP=1 : FRAMEI=0 : FPS=0 : COUNT=0
220 TSIM=TIME : TLAST=TSIM : MAXFRAMES=0 : FIXEDDT=0 : FINALPNG$=""
230 REM Optional capture: MAXFRAMES=150, FIXEDDT=1/60, FINALPNG$="alpha.png".
240 TNOW=TIME : DT=MIN(TNOW-TSIM,0.15) : TSIM=TNOW
250 IF FIXEDDT>0 THEN DT=FIXEDDT
260 IF PAUSED=0 THEN T=T+DT
270 X=(W-SW)/2+145*SIN(T*0.73) : Y=(H-SH)/2+30*SIN(T*0.91)
280 REM An eight-second cycle holds both 0% and 100% before fading again.
290 FADESPEED=0.25 : PHASE=T*FADESPEED-8*INT(T*FADESPEED/8) : OPACITY=MIN(1,MAX(0,1.5-ABS(PHASE-4)/2))
300 REM Restore the background each frame; repeated blending would leave trails.
310 SCREEN BACKGROUND$
320 SPRITE MOVE 1,X,Y ALPHA OPACITY
330 REM A translucent HUD uses exactly the same per-command ALPHA clause.
340 FRECTANGLE 0,H-48,W-1,H-1,RGB(8,14,24) ALPHA 0.7
350 FRECTANGLE 0,0,W-1,40,RGB(8,14,24) ALPHA 0.7
360 INK RGB(245,248,255) : LOCATE 3,1 : GPRINT "MOVING SPRITE / ALPHA 0 TO 100%"
370 LOCATE 3,2 : GPRINT "OPACITY ";USING "###";OPACITY*100;"%    ";USING "###.0";FPS;" FPS"
380 FRECTANGLE 350,H-34,610,H-23,RGB(80,90,105)
390 IF OPACITY>0 THEN FRECTANGLE 350,H-34,350+260*OPACITY,H-23,RGB(255,225,100)
400 PS$="" : IF PAUSED THEN PS$="  [PAUSED]"
410 CP$="ON" : IF CAP=0 THEN CP$="OFF"
420 LOCATE 3,28 : GPRINT "SPACE:PAUSE  C:CAP ";CP$;"  ESC:EXIT";PS$
430 IF CAP THEN FRAME 60 ELSE FRAME
440 FRAMEI=FRAMEI+1 : COUNT=COUNT+1 : TNOW=TIME
450 IF TNOW-TLAST>=0.5 THEN FPS=COUNT/(TNOW-TLAST):COUNT=0:TLAST=TNOW
460 IF MAXFRAMES>0 AND FRAMEI>=MAXFRAMES THEN GOTO 520
470 K$=UPPER$(INKEY$) : IF K$=CHR$(27) THEN GOTO 520
480 IF K$=" " THEN PAUSED=1-PAUSED
490 IF K$="C" THEN CAP=1-CAP:COUNT=0:TLAST=TIME
500 GOTO 240
520 IF FINALPNG$<>"" THEN BSAVE FINALPNG$
530 SCREEN CLOSE : END
