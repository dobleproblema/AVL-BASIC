100 REM A rotating mathematical surface with smooth red and blue shading.
110 REM SPACE pauses rotation; C toggles the 60 FPS limit; ESC exits.
120 SCREEN : MODE 640 : DEG : PAPER 0 : CLG
130 W=WIDTH : H=HEIGHT : N=50 : NV=(N+1)*(N+1)
140 DEF FNZ(X,Y)=(X^2+3*Y^2)*EXP(1-X^2-Y^2)
150 SCAL=68 : DIST=100 : FOC=SCAL*DIST : ALPHA=235 : BETA=45 : CY=H/2-16
160 CB=COS(BETA) : SB=SIN(BETA)
170 DIM D(W-1,H-1),PX(NV-1),PY(NV-1),Q(NV-1),X0(NV-1),Y0(NV-1),Z0(NV-1)
180 DIM R(NV-1),B(NV-1),BR(NV-1)
190 ZMIN=1E30 : ZMAX=-1E30 : AZ=135 : EL=25
195 LX=COS(EL)*COS(AZ) : LY=COS(EL)*SIN(AZ) : LZ=SIN(EL)
200 FOR I=0 TO N : X=-2.5+5*I/N
210 FOR J=0 TO N : Y=-2.5+5*J/N : K=I*(N+1)+J
220 Z=FNZ(X,Y) : X0(K)=X : Y0(K)=Y : Z0(K)=Z : ZMIN=MIN(ZMIN,Z) : ZMAX=MAX(ZMAX,Z)
230 EE=EXP(1-X*X-Y*Y) : ZZ=X*X+3*Y*Y
240 FX=2*X*EE*(1-ZZ) : FY=2*Y*EE*(3-ZZ) : LNG=SQR(FX*FX+FY*FY+1)
250 BR(K)=MIN(1,.15+.9*MAX(0,(-FX*LX-FY*LY+LZ)/LNG))
290 NEXT J : NEXT I
300 FOR K=0 TO NV-1
310 T=(Z0(K)-ZMIN)/(ZMAX-ZMIN) : R(K)=255*T*BR(K) : B(K)=255*(1-T)*BR(K)
320 NEXT K
340 PAUSED=0 : CAP=1 : FPS=0 : COUNT=0 : TLAST=TIME : TSIM=TIME
350 SMALLFONT TRANSPARENT
400 TNOW=TIME : DT=MIN(TNOW-TSIM,.1) : TSIM=TNOW
410 IF PAUSED=0 THEN ALPHA=(ALPHA+45*DT) MOD 360
420 CA=COS(ALPHA) : SA=SIN(ALPHA)
430 CLG OFFSCREEN : MAT D=0
440 FOR K=0 TO NV-1
450 X=X0(K) : Y=Y0(K) : Z=Z0(K) : YR=X*SA+Y*CA
460 Q(K)=1/(DIST+SB*YR-CB*Z)
470 PX(K)=W/2+FOC*(X*CA-Y*SA)*Q(K) : PY(K)=CY+FOC*(YR*CB+Z*SB)*Q(K)
480 NEXT K
500 FOR I=0 TO N-1 : FOR J=0 TO N-1
510 IA=I*(N+1)+J : IB=IA+N+1 : IC=IB+1 : ID=IA+1
520 GTRIANGLE D,PX(IA),PY(IA),Q(IA),R(IA),0,B(IA),PX(IB),PY(IB),Q(IB),R(IB),0,B(IB),PX(IC),PY(IC),Q(IC),R(IC),0,B(IC)
530 GTRIANGLE D,PX(IA),PY(IA),Q(IA),R(IA),0,B(IA),PX(IC),PY(IC),Q(IC),R(IC),0,B(IC),PX(ID),PY(ID),Q(ID),R(ID),0,B(ID)
540 NEXT J : NEXT I
600 INK RGB(235,240,255) : LOCATE 3,2 : GPRINT "GTRIANGLE - ROTATING SURFACE  ";USING "###.0";FPS;" FPS"
610 CP$="OFF" : IF CAP THEN CP$="ON"
620 PS$="" : IF PAUSED THEN PS$="  [PAUSED]"
630 LOCATE 3,28 : GPRINT "SPACE: PAUSE ROTATION  C: CAP ";CP$;"  ESC: EXIT";PS$
640 IF CAP THEN FRAME 60 ELSE FRAME
650 COUNT=COUNT+1 : TNOW=TIME
660 IF TNOW-TLAST>=.5 THEN FPS=COUNT/(TNOW-TLAST) : COUNT=0 : TLAST=TNOW
670 K$=UPPER$(INKEY$)
680 IF K$=CHR$(27) THEN SCREEN CLOSE : END
690 IF K$=" " THEN PAUSED=1-PAUSED
700 IF K$="C" THEN CAP=1-CAP : COUNT=0 : TLAST=TIME
710 GOTO 400

