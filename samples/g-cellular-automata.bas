10 REM Elementary cellular automata. SPACE switches rules; ESC exits.
20 IMPORT "lib/automata.bas" AS Automata
30 SCREEN : MODE 640,360 : MAT BASE 0
40 DIM Cells(120) : RuleNo=90
50 PAPER RGB(10,17,30) : CLG OFFSCREEN : SMALLFONT TRANSPARENT
60 MAT Cells=0 : Cells(60)=1
70 INK RGB(223,233,250) : MOVE 18,350 : LABEL "ELEMENTARY CELLULAR AUTOMATA"
80 INK RGB(154,174,202) : MOVE 18,327 : LABEL "RULE "+DEC$(RuleNo,"0")+"   SPACE: CHANGE RULE   ESC: EXIT"
90 AliveColor=RGB(92,214,197)
100 IF RuleNo=30 THEN AliveColor=RGB(255,178,86)
110 FOR Gen=0 TO 59
120   Y=306-Gen*5
130   FOR I=0 TO 120
140     IF Cells(I) THEN X=18+5*I : FRECTANGLE X,Y,X+3,Y+3,AliveColor
150   NEXT I
160   CALL Automata.NextGeneration(Cells,RuleNo)
170 NEXT Gen
180 FRAME 60 : Key$=INKEY$
190 IF Key$=CHR$(27) THEN SCREEN CLOSE : END
200 IF Key$=" " THEN RuleNo=120-RuleNo : GOTO 50
210 GOTO 180
