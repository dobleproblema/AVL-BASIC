100 REM  RETRO ZOOMER-ROTATOR FOR AVL BASIC
130 IMG$="assets/anime.png" '640x480 PNG LOADED WITH BLOAD
140 W=640 : H=480
150 S=2 '16=FOR PYTHON :-), 8=FAST BUT CHUNKY, 4 or 3=GOOD COMPROMISE, 2=FOR FAST CPUS, 1=FOR *REALLY* FAST CPUS
170 NX=W\S : NY=H\S
180 DIM PIX(NX-1,NY-1)
190 SCREEN : MODE 640
200 PAPER 0 : CLG
210 DEG
220 HS=S/2 : SM1=S-1 : IS=1/S : INX=1/NX : INY=1/NY
230 REM LOAD THE ORIGINAL IMAGE AND SAMPLE IT INTO A BLOCK TEXTURE
240 BLOAD IMG$
250 FOR J=0 TO NY-1
260   Y=J*S+HS
270   FOR I=0 TO NX-1
280     X=I*S+HS
290     PIX(I,J)=TEST(X,Y)
300   NEXT I
310 NEXT J
320 REM PARAMETERS
330 CX=(W-1)/2 : CY=(H-1)/2
340 DX0=HS-CX : DY0=HS-CY
350 T0=TIME
360 FCOUNT=0
370 TLAST=TIME
380 FPS=0
390 REM MAIN LOOP
400 T=TIME-T0
410 REM ROTATION ANGLE
420 A=T*25
430 REM PULSING ZOOM
440 Z=0.5+2*(1+SIN(T*60))^2 'Z=P1+P2*(1+SIN(... P1=MIDDLE POINT, P2=RANGE
450 REM DINAMIC OFFSET FOR LIVELIER MOTION OR FIXED VALUES
460 UOFF=180*SIN(T*137) '0
470 VOFF=130*COS(T*113) '0
480 IZ=1/Z : CA=COS(A) : SA=SIN(A)
490 DSU=CA*IZ : DSV=-SA*IZ
500 RSU=SA*IZ : RSV=CA*IZ
510 U0=((DX0*CA+DY0*SA)*IZ+CX+UOFF)*IS
520 V0=((-DX0*SA+DY0*CA)*IZ+CY+VOFF)*IS
530 FOR J=0 TO NY-1
540   REM REBASE ONCE PER ROW; GUARD BANDS KEEP U AND V POSITIVE IN THE INNER LOOP
550   U=U0-NX*INT(U0*INX)+2*NX
560   V=V0-NY*INT(V0*INY)+3*NY
570   REM CHOOSE THE DRAWING PRIMITIVE ONCE PER ROW, OUTSIDE THE HOT INNER LOOP
580   IF S=1 THEN
590     FOR I=0 TO NX-1
600       PLOT I,J,PIX(INT(U) MOD NX,INT(V) MOD NY)
610       U=U+DSU : V=V+DSV
620     NEXT I
630   ELSE
640     FOR I=0 TO NX-1
650       FRECTANGLE I*S,J*S,I*S+SM1,J*S+SM1,PIX(INT(U) MOD NX,INT(V) MOD NY)
660       U=U+DSU : V=V+DSV
670     NEXT I
680   END IF
690   U0=U0+RSU : V0=V0+RSV
700 NEXT J
710 REM --- FPS COUNTER ---
720 FCOUNT=FCOUNT+1
730 IF TIME-TLAST>=0.5 THEN
740   FPS=FCOUNT/(TIME-TLAST)
750   FCOUNT=0
760   TLAST=TIME
770 END IF
780 REM OPTIONAL DEMO-STYLE LABEL
790 SMALLFONT TRANSPARENT : INK 18 : LOCATE 1,1
800 GPRINT "AVL-BASIC ZOOMER-ROTATOR  FPS: ";USING ".0";FPS;"  ESC=EXIT"
810 FRAME
820 IF KEYDOWN(27) THEN SCREEN CLOSE:END
830 GOTO 400
