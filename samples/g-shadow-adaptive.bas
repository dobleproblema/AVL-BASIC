100 REM Advanced shadow example with shared grid calculations and adaptive floor detail.
105 REM Higher-quality projected shadows and faster rendering than g-shadow.bas.
110 REM GTRIANGLE renders the light and camera views using two depth arrays.
115 REM C toggles the 60 FPS limit; measured FPS include any frame waiting.
120 SCREEN : MODE 640 : RAD : PAPER RGB(9,13,21) : CLG : MOUSE ON
130 W=WIDTH : H=HEIGHT : FOC=520 : CY=230
140 GN=128 : LIMIT=3.2 : NC=32 : RI=1 : RO=1.35 : PIERH=1 : THICK=.35
150 GF=(GN+1)*(GN+1) : NV=GF+8*(NC+1)+32 : NT=8*NC+16
160 DIM D(W-1,H-1),SD(W-1,H-1)
170 DIM OX(NV-1),OY(NV-1),OZ(NV-1),NX(NV-1),NY(NV-1),NZ(NV-1)
180 DIM PX(NV-1),PY(NV-1),Q(NV-1),R(NV-1),G(NV-1),B(NV-1)
190 DIM UX(NV-1),UY(NV-1),UQ(NV-1),T1(NT-1),T2(NT-1),T3(NT-1)
195 DIM DX2(GN),DZ2(GN),TXF(GN),TYF(GN),IYF(GN),WYF(GN)
200 REM Generate a dense floor; its many vertices carry the shadow colors.
210 K=0 : TT=0
220 FOR I=0 TO GN : FOR J=0 TO GN
230 X=-LIMIT+2*LIMIT*I/GN : Y=0 : Z=-LIMIT+2*LIMIT*J/GN
240 AX=0 : AY=1 : AZ=0 : GOSUB 3000
250 NEXT J : NEXT I
300 REM Only arch faces need indices; the regular floor is drawn from its grid.
310 FOR I=0 TO NC
320 A=4*ATN(1)*I/NC : CA=COS(A) : SA=SIN(A)
330 FOR SIDE=0 TO 7
340 RADIAL=RI : IF SIDE=0 OR SIDE=2 OR SIDE=4 OR SIDE=5 THEN RADIAL=RO
350 X=RADIAL*CA : Y=PIERH+RADIAL*SA : Z=-THICK
360 IF SIDE=2 OR SIDE=3 OR SIDE=5 OR SIDE=7 THEN Z=THICK
370 AX=0 : AY=0 : AZ=-1 : IF SIDE=2 OR SIDE=3 THEN AZ=1
380 IF SIDE>=4 THEN AX=CA : AY=SA : AZ=0
390 IF SIDE>=6 THEN AX=-CA : AY=-SA
400 GOSUB 3000 : NEXT SIDE : NEXT I
410 FOR I=0 TO NC-1 : FOR SIDE=0 TO 6 STEP 2
420 IA=GF+8*I+SIDE : IB=IA+1 : IC=IB+8 : ID=IA+8 : GOSUB 3100
430 NEXT SIDE : NEXT I
450 REM Add two straight piers. Their tops meet the curved arch exactly.
460 FOR P=0 TO 1 : SGN1=2*P-1
470 FOR SIDE=0 TO 3
480 IA=K : IB=K+1 : IC=K+2 : ID=K+3
490 FOR V=0 TO 3
500 EDGE=0 : IF V=1 OR V=2 THEN EDGE=1
510 Y=0 : IF V>=2 THEN Y=PIERH
520 X=SGN1*(RI+(RO-RI)*EDGE) : Z=-THICK : AX=0 : AY=0 : AZ=-1
530 IF SIDE=1 THEN Z=THICK : AZ=1
540 IF SIDE>=2 THEN X=SGN1*RO : Z=-THICK+2*THICK*EDGE : AX=SGN1 : AZ=0
550 IF SIDE=3 THEN X=SGN1*RI : AX=-SGN1
560 GOSUB 3000 : NEXT V : GOSUB 3100
570 NEXT SIDE : NEXT P
700 REM A fixed camera lets us project every vertex just once.
710 EX=5 : EY=5.2 : EZ=-7.5 : FX=-EX : FY=.7-EY : FZ=-EZ
720 LNG=SQR(FX*FX+FY*FY+FZ*FZ) : FX=FX/LNG : FY=FY/LNG : FZ=FZ/LNG
730 RX=FZ : RZ=-FX : LNG=SQR(RX*RX+RZ*RZ) : RX=RX/LNG : RZ=RZ/LNG
740 UPX=FY*RZ : UPY=FZ*RX-FX*RZ : UPZ=-FY*RX
750 FOR K=0 TO NV-1
760 DX=OX(K)-EX : DY=OY(K)-EY : DZ=OZ(K)-EZ : DEPTH=DX*FX+DY*FY+DZ*FZ
770 Q(K)=1/DEPTH : PX(K)=W/2+FOC*(DX*RX+DZ*RZ)*Q(K)
780 PY(K)=CY+FOC*(DX*UPX+DY*UPY+DZ*UPZ)*Q(K)
790 NEXT K
800 REM Move the light horizontally above the scene. Both views use inverse depth.
810 MX=130 : MY=420 : LH=4 : SF=160 : SHADOWS=1 : QB=1/(LH-.015)
815 CAP=1 : FPS=0 : COUNT=0 : TLAST=TIME
820 SMALLFONT TRANSPARENT
830 ON MOUSE MOVE GOSUB 5000 : ON MOUSE LEFTDRAG GOSUB 5000 : ON MOUSE RIGHTDRAG GOSUB 5000
1000 REM The camera and model stay fixed; only the light and colors change.
1010 SX=MX : SY=MY : LX=4*(SX/W-.5) : LZ=4*(.5-SY/H)
1020 CLG OFFSCREEN : MAT D=0
1030 IF SHADOWS=0 THEN GOTO 1160
1040 MAT SD=0
1042 REM Projected arch bounds let floor vertices skip unreachable shadow samples.
1045 SMINX=W : SMAXX=0 : SMINY=H : SMAXY=0
1050 FOR K=GF TO NV-1
1060 UQ(K)=1/(LH-OY(K)) : UX(K)=W/2+SF*(OX(K)-LX)*UQ(K)
1070 UY(K)=H/2+SF*(OZ(K)-LZ)*UQ(K)
1075 SMINX=MIN(SMINX,UX(K)) : SMAXX=MAX(SMAXX,UX(K)) : SMINY=MIN(SMINY,UY(K)) : SMAXY=MAX(SMAXY,UY(K))
1080 NEXT K
1085 SMINX=INT(SMINX)-1 : SMAXX=INT(SMAXX)+1 : SMINY=INT(SMINY)-1 : SMAXY=INT(SMAXY)+1
1090 REM Only the arch writes light depth. The flat floor is the receiver.
1100 FOR T=0 TO NT-1
1110 IA=T1(T) : IB=T2(T) : IC=T3(T)
1120 GTRIANGLE SD,UX(IA),UY(IA),UQ(IA),0,0,0,UX(IB),UY(IB),UQ(IB),0,0,0,UX(IC),UY(IC),UQ(IC),0,0,0
1130 NEXT T
1150 CLG OFFSCREEN 'Discard the light view's colors; preserve its depth array
1156 REM Share light distances and shadow coordinates along each floor axis.
1160 FOR J=0 TO GN
1170 DX=OX(J*(GN+1))-LX : DZ=OZ(J)-LZ
1180 DX2(J)=DX*DX : DZ2(J)=DZ*DZ
1181 TXF(J)=W/2+SF*DX/LH-.5 : TYF(J)=H/2+SF*DZ/LH-.5
1182 IYF(J)=INT(TYF(J)) : WYF(J)=TYF(J)-IYF(J)
1184 NEXT J
1185 REM The floor normal is (0,1,0), so its diffuse term is just LH / distance.
1190 CR=122 : CG=157 : CB=165
1200 K=0 : FOR I=0 TO GN
1201 ROW2=DX2(I)+LH*LH : TX=TXF(I) : IX=INT(TX) : WX=TX-IX
1203 FOR J=0 TO GN
1210 D2=ROW2+DZ2(J)
1220 DIFF=LH/SQR(D2)
1230 DIRECT=2.8*DIFF/(1+.08*D2) : VIS=1
1240 IF SHADOWS=0 THEN GOTO 1400
1250 TY=TYF(J)
1255 IF TX<SMINX OR TX>SMAXX OR TY<SMINY OR TY>SMAXY THEN GOTO 1400
1260 IY=IYF(J) : WY=WYF(J)
1270 IF IX<0 OR IY<0 OR IX>=W-1 OR IY>=H-1 THEN GOTO 1400
1280 REM BASIC comparisons return -1/0; negation gives each tap a 1/0 visibility.
1290 V00=-(SD(IX,IY)<=QB) : V10=-(SD(IX+1,IY)<=QB)
1300 V01=-(SD(IX,IY+1)<=QB) : V11=-(SD(IX+1,IY+1)<=QB)
1310 VIS=(1-WX)*(1-WY)*V00+WX*(1-WY)*V10+(1-WX)*WY*V01+WX*WY*V11
1315 REM Blend visibility after comparison, preserving smooth shadow edges.
1400 BR=.16+DIRECT*VIS
1410 IF BR>.8 THEN BR=.8+.2*(BR-.8)/(.2+BR-.8)
1430 R(K)=CR*BR : G(K)=CG*BR : B(K)=CB*BR
1440 K=K+1 : NEXT J : NEXT I
1450 REM Curved arch faces use their own normals and copper material.
1455 CR=230 : CG=167 : CB=95 : FOR K=GF TO NV-1
1460 DX=LX-OX(K) : DY=LH-OY(K) : DZ=LZ-OZ(K) : D2=DX*DX+DY*DY+DZ*DZ
1462 DIFF=MAX(0,(NX(K)*DX+NY(K)*DY+NZ(K)*DZ)/SQR(D2))
1465 BR=.16+2.8*DIFF/(1+.08*D2)
1466 IF BR>.8 THEN BR=.8+.2*(BR-.8)/(.2+BR-.8)
1470 R(K)=CR*BR : G(K)=CG*BR : B(K)=CB*BR
1480 NEXT K
1500 REM Keep all fine cells near the shadow; group 2x2 cells only outside its bounds.
1501 FOR I=0 TO GN-1 STEP 2 : FOR J=0 TO GN-1 STEP 2
1502 STEPF=1
1503 IF SHADOWS=0 OR TXF(I+2)<SMINX OR TXF(I)>SMAXX OR TYF(J+2)<SMINY OR TYF(J)>SMAXY THEN STEPF=2
1504 FOR II=I TO I+1 STEP STEPF : FOR JJ=J TO J+1 STEP STEPF
1505 IA=II*(GN+1)+JJ : IB=IA+STEPF : ID=IA+STEPF*(GN+1) : IC=ID+STEPF
1506 GTRIANGLE D,PX(IA),PY(IA),Q(IA),R(IA),G(IA),B(IA),PX(IB),PY(IB),Q(IB),R(IB),G(IB),B(IB),PX(IC),PY(IC),Q(IC),R(IC),G(IC),B(IC)
1507 GTRIANGLE D,PX(IC),PY(IC),Q(IC),R(IC),G(IC),B(IC),PX(ID),PY(ID),Q(ID),R(ID),G(ID),B(ID),PX(IA),PY(IA),Q(IA),R(IA),G(IA),B(IA)
1508 NEXT JJ : NEXT II : NEXT J : NEXT I
1509 REM The arch uses its original triangles and the same camera depth buffer.
1510 FOR T=0 TO NT-1
1520 IA=T1(T) : IB=T2(T) : IC=T3(T)
1530 GTRIANGLE D,PX(IA),PY(IA),Q(IA),R(IA),G(IA),B(IA),PX(IB),PY(IB),Q(IB),R(IB),G(IB),B(IB),PX(IC),PY(IC),Q(IC),R(IC),G(IC),B(IC)
1540 NEXT T
1700 REM Show the actual light position using the same fixed camera.
1710 DX=LX-EX : DY=LH-EY : DZ=LZ-EZ : DEPTH=DX*FX+DY*FY+DZ*FZ
1720 LPX=W/2+FOC*(DX*RX+DZ*RZ)/DEPTH : LPY=CY+FOC*(DX*UPX+DY*UPY+DZ*UPZ)/DEPTH
1730 INK RGB(255,231,152) : CIRCLE LPX,LPY,7 : FCIRCLE LPX,LPY,3
1800 INK RGB(235,240,255) : LOCATE 3,2 : GPRINT "GTRIANGLE - SHADOWS: ADAPTIVE FLOOR MESH  ";USING "###.0";FPS;" FPS"
1810 SH$="OFF" : IF SHADOWS THEN SH$="ON"
1815 CP$="OFF" : IF CAP THEN CP$="ON"
1820 LOCATE 3,28 : GPRINT "MOUSE: LIGHT  S: SHADOWS ";SH$;"  C: CAP ";CP$;"  ESC: EXIT"
1840 IF CAP THEN FRAME 60 ELSE FRAME
1841 COUNT=COUNT+1 : TNOW=TIME
1842 IF TNOW-TLAST>=.5 THEN FPS=COUNT/(TNOW-TLAST) : COUNT=0 : TLAST=TNOW
1850 K$=UPPER$(INKEY$)
1860 IF K$=CHR$(27) THEN ON MOUSE MOVE GOSUB 0 : ON MOUSE LEFTDRAG GOSUB 0 : ON MOUSE RIGHTDRAG GOSUB 0 : SCREEN CLOSE : END
1870 IF K$="S" THEN SHADOWS=1-SHADOWS
1875 IF K$="C" THEN CAP=1-CAP : COUNT=0 : TLAST=TIME
1880 GOTO 1010
3000 OX(K)=X : OY(K)=Y : OZ(K)=Z : NX(K)=AX : NY(K)=AY : NZ(K)=AZ : K=K+1 : RETURN
3100 T1(TT)=IA : T2(TT)=IB : T3(TT)=IC : TT=TT+1
3110 T1(TT)=IC : T2(TT)=ID : T3(TT)=IA : TT=TT+1 : RETURN
5000 MX=MAX(0,MIN(W-1,MOUSEX)) : MY=MAX(0,MIN(H-1,MOUSEY)) : RETURN
