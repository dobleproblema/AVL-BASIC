10 CLG : BIGFONT : DEG
20 T$="ROTATING LETTERS AROUND THE CIRCLE - "
30 T1=T2=P1=P2=1 : L=LEN(T$) : A=360/L
40 T0=TIME
50 FOR C=1 TO 200
60 CLG OFFSCREEN
70 FOR I=1 TO L
80 X=T1+(I-1)*A : MOVE WIDTH\2+SIN(X)*200,HEIGHT\2+COS(X)*200
90 C$=MID$(T$,P1,1)
100 P1=(P1 MOD L)+1
110 LDIR -X : LABEL C$
120 NEXT
130 FOR I=1 TO L
140 X=T2+(I-1)*A : MOVE WIDTH\2+SIN(X)*100,HEIGHT\2+COS(X)*100
150 C$=MID$(T$,P2,1)
160 P2=(P2 MOD L)+1
170 LDIR -X : LABEL C$,1,-1
180 NEXT
190 P1=(P1 MOD L)+1 : P2=(P2 MOD L)+1
195 FRAME : T1=T1+A-1 : T2=T2+A-4
200 NEXT C
210 PRINT "Elapsed time:";TIME-T0
