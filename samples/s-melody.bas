10 REM Classic envelopes, a held chord, and a short melody
20 PRINT "Three voices, then a melody with vibrato."
30 IF AUDIOAVAILABLE=0 THEN PRINT "Silent timing: ";AUDIOERROR$
40 ENV 1,12,-1,2
50 ENT -1,1,1,2,1,-1,2
60 SOUND 65,478,30,12,1,1
70 SOUND 66,379,30,12,1,1
80 SOUND 68,319,30,12,1,1
90 RELEASE 7
100 WHILE SQ(1)<>4 OR SQ(2)<>4 OR SQ(4)<>4
110 PAUSE 10
120 WEND
130 FOR I=1 TO 8
140 READ P:SOUND 1,P,24,12,1,1
150 NEXT I
160 WHILE SQ(1)<>4
170 PAUSE 10
180 WEND
190 PRINT "Finished.":END
200 DATA 478,426,379,358,319,379,426,478
