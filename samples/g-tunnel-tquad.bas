1000 REM ============================================================
1010 REM PERSPECTIVE TEXTURED TUNNEL - AVL BASIC
1020 REM Press ESC to exit.
1030 REM ============================================================
1040 TEXFILE$="assets/tunnel.png"
1050 SCREEN : MODE 640
1060 W=WIDTH : H=HEIGHT
1070 PAPER 0 : CLG
1080 DEG
1090 BLOAD TEXFILE$,TEX$
1100 P1=INSTR(TEX$,"x") : P2=INSTR(TEX$,":")
1110 IF P1=0 OR P2=0 THEN PRINT "Invalid graphics format":END
1120 TW=VAL(LEFT$(TEX$,P1-1))
1130 TH=VAL(MID$(TEX$,P1+1,P2-P1-1))
1140 CX=(W-1)/2 : CY=(H-1)/2
1150 SN=48
1160 HOLE=42 : OUT=SQR(W*W+H*H)/2+1
1170 UREP=6 : VREP=7
1180 DIM X(1,SN),Y(1,SN),U(SN),V(1),Q(1),D(W-1,H-1)
1190 REM Two rings bound each planar wall; inverse depth is proportional to radius.
1200 FOR A=0 TO SN
1210   U(A)=TW*UREP*A/SN
1220 NEXT A
1230 FOR R=0 TO 1
1240   RR=HOLE+(OUT-HOLE)*R
1250   Q(R)=RR/OUT
1260   V(R)=TH*VREP*R
1270   FOR A=0 TO SN-1
1280     ANG=360*A/SN
1290     X(R,A)=CX+RR*COS(ANG)
1300     Y(R,A)=CY+RR*SIN(ANG)
1310   NEXT A
1315   X(R,SN)=X(R,0)
1317   Y(R,SN)=Y(R,0)
1320 NEXT R
1330 T0=TIME
1340 FCOUNT=0 : TLAST=TIME : FPS=0
1350 REM MAIN LOOP
1360 T=TIME-T0
1370 UO=TW*0.55*T
1380 VO=TH*2.4*T
1390 CLG OFFSCREEN : MAT D=0
1400 REM One native perspective-correct quad per wall; no depth subdivisions.
1410 FOR A=0 TO SN-1
1420   TQUAD TEX$,D,X(0,A),Y(0,A),Q(0),U(A)+UO,V(0)+VO,X(0,A+1),Y(0,A+1),Q(0),U(A+1)+UO,V(0)+VO,X(1,A+1),Y(1,A+1),Q(1),U(A+1)+UO,V(1)+VO,X(1,A),Y(1,A),Q(1),U(A)+UO,V(1)+VO
1430 NEXT A
1450 FCIRCLE CX,CY,HOLE,0
1460 FCOUNT=FCOUNT+1
1470 IF TIME-TLAST>=0.5 THEN FPS=FCOUNT/(TIME-TLAST):FCOUNT=0:TLAST=TIME
1480 SMALLFONT OPAQUE : PAPER 0 : INK 18
1490 LOCATE 1,1
1500 GPRINT "AVL-BASIC PERSPECTIVE TUNNEL  FPS: ";USING "###.0";FPS;"  ESC=EXIT"
1510 FRAME 60
1520 IF KEYDOWN(27) THEN SCREEN CLOSE:END
1530 GOTO 1360
