100 REM Old-school demo: 3D starfield, copper bars and pixel-column sine scroller
110 SCREEN : MODE 640 : DEG : PAPER 0 : CLG : BIGFONT
120 GS=4 : CW=16*GS+10 : GH=16*GS+8
130 OX=16 : OY=94 : BAS=HEIGHT\2-GH\2 : AMP=70
140 SCROLL=0 : SCROLLSPEED=4 : WPH=0 : WAVESPEED=8 : WAVE=0.45
150 RES=4 'Horizontal scroller resolution: 1=pixel perfect, 2/3/... faster
160 MSG$="      AVL-BASIC PRESENTS THE OLD-SCHOOL DEMO - A TRUE PIXEL-RESOLUTION SINE SCROLLER OVER A 3D STARFIELD - JUST CODE AND A LOT OF NOSTALGIA..."
170 CHARS$=" ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-.,$"
180 N=LEN(MSG$) : TW=N*CW
190 STARS=600 : SNEAR=70 : SFAR=950 : VPDIST=4200 : DIRPH=35
200 DIM GC$(LEN(CHARS$)*CW-1),MAP(TW+WIDTH+RES-1),STX(STARS),STY(STARS),STZ(STARS)
210 REM Build the bitmap font and fill the star volume
220 GOSUB 600 : PAPER RGB$(1,2,9) : CLG : SMALLFONT TRANSPARENT
230 RANDOMIZE TIME : GOSUB 1000
240 FCOUNT=0 : TLAST=TIME : FPS=0
300 REM Main loop: stars, copper bars and one text column every RES pixels
310 CLG OFFSCREEN
315 GOSUB 1100
320 GOSUB 500
330 FOR X=0 TO WIDTH-1 STEP RES
340   M=MAP(SCROLL+X)
350   IF M>=0 THEN Y=BAS+AMP*SIN(X*WAVE+WPH):SPRITE GC$(M),X,Y,0
360 NEXT X
370 INK 18 : LOCATE 1,1 : GPRINT "AVL-BASIC OLD-SCHOOL DEMO  STARS:";STARS;"  FPS:";USING "###.0";FPS;"  ESC=EXIT"
380 FCOUNT=FCOUNT+1
390 IF TIME-TLAST>=0.5 THEN FPS=FCOUNT/(TIME-TLAST):FCOUNT=0:TLAST=TIME
400 SCROLL=SCROLL+SCROLLSPEED : IF SCROLL>=TW THEN SCROLL=SCROLL-TW
405 WPH=WPH+WAVESPEED : IF WPH>=360 THEN WPH=WPH-360
410 FRAME 60
420 IF KEYDOWN(27) THEN SCREEN CLOSE:END
430 GOTO 300
500 REM Copper-ish bands behind the scroller
510 FOR B=0 TO 9
520   BY=BAS-74+B*20+7*SIN(WPH+B*23)
530   C=28+B*15
540   FRECTANGLE 0,BY,WIDTH-1,BY+5,RGB(0,C,92+C)
550 NEXT B
560 RETURN
600 REM Render each unique glyph, expand it, and capture every pixel column
610 FOR GI=1 TO LEN(CHARS$)
620   C$=MID$(CHARS$,GI,1)
630   CLG
640   IF C$<>" " THEN MOVE 0,15:LABEL C$,1,-1:GOSUB 800
650   FOR XX=0 TO CW-1
660     K=(GI-1)*CW+XX
670     IF C$<>" " AND XX<16*GS+2 THEN GC$(K)=SPRITE$(OX+XX,OY,OX+XX+RES-1,OY+GH-1)
680   NEXT XX
690 NEXT GI
700 REM Build the scrolling strip as indexes into the glyph-column table
710 FOR I=1 TO N
720   C$=MID$(MSG$,I,1) : P=INSTR(CHARS$,C$) : IF P=0 THEN P=1
730   FOR XX=0 TO CW-1
740     K=(I-1)*CW+XX
750     IF P=1 OR XX>=16*GS+2 THEN MAP(K)=-1 ELSE MAP(K)=(P-1)*CW+XX
760   NEXT XX
770 NEXT I
780 FOR I=0 TO WIDTH+RES-1 : MAP(TW+I)=MAP(I) : NEXT I
790 RETURN
800 REM Expand the built-in 16x16 glyph into a shaded bitmap font
810 FOR SY=0 TO 15
820   FOR SX=0 TO 15
830     IF TEST(SX,SY)=0 THEN GOTO 910
840     DX=OX+SX*GS : DY=OY+4+SY*GS
850     FRECTANGLE DX+2,DY-2,DX+GS+1,DY+GS-3,RGB(0,10,54)
860     FRECTANGLE DX+1,DY-1,DX+GS,DY+GS-2,RGB(146,28,190)
870     FRECTANGLE DX,DY,DX+GS-1,DY+GS-1,RGB(255,192,32)
880     IF SY>7 THEN FRECTANGLE DX,DY,DX+GS-1,DY+GS-1,RGB(255,236,92)
890     IF SY>11 THEN FRECTANGLE DX,DY,DX+GS-1,DY+GS-1,RGB(255,255,210)
900     IF SX=0 OR SY=0 THEN PLOT DX,DY,RGB(255,255,255)
910   NEXT SX
920 NEXT SY
930 RETURN
1000 REM Fill the whole view volume: no visible central convergence
1010 FOR I=1 TO STARS
1020   STX(I)=RND*WIDTH : STY(I)=RND*HEIGHT
1030   STZ(I)=SNEAR+RND*(SFAR-SNEAR)
1040 NEXT I
1050 RETURN
1100 REM Move and draw the rotating 3D starfield
1110 DIRPH=DIRPH+0.65 : IF DIRPH>=360 THEN DIRPH=DIRPH-360
1120 FLOW=5.2*COS(DIRPH) : SIDEX=2.6*SIN(DIRPH) : SIDEY=1.7*SIN(DIRPH*0.61+70)
1130 VPX=WIDTH/2+VPDIST*COS(DIRPH)
1140 VPY=HEIGHT/2+VPDIST*SIN(DIRPH)
1150 FOR I=1 TO STARS
1160   OLDX=STX(I) : OLDY=STY(I) : Q=(SFAR-STZ(I))/(SFAR-SNEAR)
1170   Q2=Q*Q : STEP3D=0.1*FLOW*(0.08+0.92*Q)/STZ(I) : PAR=0.05+1.95*Q2
1180   STX(I)=STX(I)+STEP3D*(STX(I)-VPX)+SIDEX*PAR
1190   STY(I)=STY(I)+STEP3D*(STY(I)-VPY)+SIDEY*PAR
1200   STZ(I)=STZ(I)-FLOW : RESET=0
1210   REM Random depth recycling; edge wrapping keeps the field uniformly filled
1220   IF FLOW>=0 AND STZ(I)<SNEAR THEN STZ(I)=SFAR:STX(I)=RND*WIDTH:STY(I)=RND*HEIGHT:RESET=1
1230   IF FLOW<0 AND STZ(I)>SFAR THEN STZ(I)=SNEAR:STX(I)=RND*WIDTH:STY(I)=RND*HEIGHT:RESET=1
1240   IF STX(I)<0 THEN STX(I)=STX(I)+WIDTH:RESET=1
1250   IF STX(I)>=WIDTH THEN STX(I)=STX(I)-WIDTH:RESET=1
1260   IF STY(I)<0 THEN STY(I)=STY(I)+HEIGHT:RESET=1
1270   IF STY(I)>=HEIGHT THEN STY(I)=STY(I)-HEIGHT:RESET=1
1280   Q=(SFAR-STZ(I))/(SFAR-SNEAR) : BR=45+INT(155*Q)
1290   C=RGB(INT(BR*0.68),INT(BR*0.8),BR)
1300   IF I MOD 13=0 THEN C=RGB(BR,INT(BR*0.76),INT(BR*0.58))
1310   INK C : IF RESET THEN PLOT STX(I),STY(I) ELSE MOVE OLDX,OLDY:DRAW STX(I),STY(I)
1320   IF Q>0.78 THEN FRECTANGLE STX(I)-1,STY(I)-1,STX(I)+1,STY(I)+1,C
1330   IF Q>0.97 THEN FRECTANGLE STX(I)-2,STY(I)-2,STX(I)+2,STY(I)+2,C
1340 NEXT I
1350 RETURN
