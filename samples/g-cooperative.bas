10 REM SINGLE-THREADED COOPERATIVE SIMULATION: g-ldir3 + g-bernoulli
20 REM AVL-BASIC DOES NOT RUN THESE ROUTINES IN PARALLEL
25 REM EVERY DRIVES THE CLOCK; THE SCHEDULER CALLS EACH STEP SEQUENTIALLY
30 SCREEN : CLG
40 LL=8 : LR=WIDTH\2-5 : RL=WIDTH\2+4 : RR=WIDTH-9
50 PB=28 : PT=HEIGHT-32
60 LCX=(LL+LR)\2 : RCX=(RL+RR)\2 : PCY=(PB+PT)\2
70 LRAD=MIN((LR-LL)\2-18,(PT-PB)\2-18)
80 BS=MIN((RR-RL-20)/300,(PT-PB-20)/300)
90 LT$="COPYRIGHT 2025 JOSE ANTONIO AVILA - "
100 LLEN=LEN(LT$) : LPH=1 : LPOS=1
110 H$="COOPERATIVE SIMULATION - SINGLE THREAD"
120 SCALE : ORIGIN : SMALLFONT TRANSPARENT : LDIR 0 : PENWIDTH 1
125 INK 10 : MOVE (WIDTH-LEN(H$)*8)\2,HEIGHT-8 : LABEL H$
130 INK 8 : MOVE WIDTH\2,PB : DRAW WIDTH\2,PT
140 INK 7 : MOVE 12,20 : LABEL "LDIR: ONE FRAME / STEP"
150 MOVE WIDTH\2+12,20 : LABEL "BERNOULLI: ONE FRAME / STEP"
160 TICK=0
170 EVERY 1,0 GOSUB 9000
200 WHILE TICK=0
210   PAUSE 1
220 WEND
230 TICK=0
240 GOSUB 1000
250 GOSUB 2000
260 FRAME
270 IF INKEY$="" THEN 200
280 CANCEL 0
290 SCALE : ORIGIN : LDIR 0 : SMALLFONT
300 END
1000 REM LDIR STEP: redraw the complete figure
1010 SCALE : ORIGIN LCX,PCY,LL,LR,PT,PB
1020 DEG : BIGFONT TRANSPARENT : PENWIDTH 1 : PAPER 0 : INK 1 : CLG OFFSCREEN
1030 FOR LX=LPH TO LPH+360 STEP 10
1040   MOVE SIN(LX)*LRAD,COS(LX)*LRAD
1050   LC$=MID$(LT$,LPOS,1)
1060   LPOS=LPOS+1 : IF LPOS>LLEN THEN LPOS=1
1070   LDIR -LX : LABEL LC$,1,-1
1080 NEXT LX
1090 LPH=LPH+9
1100 RETURN
2000 REM BERNOULLI STEP: redraw the complete figure
2010 SCALE : ORIGIN RCX,PCY,RL,RR,PT,PB
2020 RAD : SMALLFONT TRANSPARENT : LDIR 0 : PENWIDTH 4 : PAPER 0 : CLG OFFSCREEN
2030 BT=TIME
2040 FOR BI=1 TO 100
2050   BA=BI*2*PI/100
2060   BX=BS*(90+60*SIN(5*BA+BT))
2070   PLOT BX*COS(BA+BT),BX*SIN(BA+BT),(BI MOD 6)+1
2080 NEXT BI
2100 RETURN
9000 TICK=-1
9010 RETURN
