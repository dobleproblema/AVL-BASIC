10 ' Widescreen, fullscreen, refresh synchronization and scaled mouse input.
20 ' MODE selects the canvas; SCREEN FULL only changes its presentation.
30 ' Bars move by elapsed time, so V and C change presentation, not their speed.
40 SCREEN : MODE 960 : SCREEN FULL ON : MOUSE ON
50 SyncEnabled=1 : Limited=0 : Started=TIME : SCREEN SYNC ON
60 WHILE 1
70   K$=UPPER$(INKEY$)
80   IF K$=CHR$(27) THEN EXIT WHILE
90   IF K$="1" THEN MODE 960
100  IF K$="2" THEN MODE 640,360
110  IF K$="3" THEN MODE 640,480
120  IF K$="4" THEN MODE 1280,720
130  IF K$="F" THEN SCREEN FULL ON
150  IF K$="W" THEN SCREEN FULL OFF
160  IF K$="S" THEN SCREEN : MOUSE ON
170  IF K$="V" THEN
180    IF SyncEnabled THEN SCREEN SYNC OFF ELSE SCREEN SYNC ON
190    SyncEnabled=1-SyncEnabled
200  ENDIF
210  IF K$="C" THEN Limited=1-Limited
220  CLG OFFSCREEN
230  Offset=INT((TIME-Started)*180) MOD 80
240  INK RGB(230,230,230)
250  FOR X=Offset-80 TO WIDTH STEP 80
260    FRECTANGLE X,0,X+24,HEIGHT/3
270  NEXT X
280  INK RGB(90,180,230) : RECTANGLE 0,0,WIDTH-1,HEIGHT-1
290  MOVE WIDTH/2,0 : DRAW WIDTH/2,HEIGHT-1
300  MOVE 0,HEIGHT/2 : DRAW WIDTH-1,HEIGHT/2
310  INK RGB(240,225,160) : SMALLFONT TRANSPARENT
320  SyncText$="OFF" : IF SyncEnabled THEN SyncText$="ON"
330  CapText$="UNLIMITED" : IF Limited THEN CapText$="60"
340  LOCATE 2,2 : GPRINT "CANVAS: ";WIDTH;" x ";HEIGHT;" pixels"
350  LOCATE 2,4 : GPRINT "1: 960 x 540  2: 640 x 360  3: 640 x 480  4: 1280 x 720"
360  LOCATE 2,6 : GPRINT "F: FULLSCREEN   W: WINDOW"
370  LOCATE 2,8 : GPRINT "ALT+ENTER: SWITCH  S: RESET GRAPHICS STATE  ESC: QUIT"
380  LOCATE 2,10 : GPRINT "V: SYNC ";SyncText$;"  C: FPS CAP ";CapText$
390  LOCATE 2,12 : GPRINT "MOUSE X: ";MOUSEX;"   Y: ";MOUSEY;"   LEFT: ";MOUSELEFT
400  LOCATE 2,14 : GPRINT "Mode 3 fullscreen: side margins are outside the canvas."
410  IF Limited THEN FRAME 60 ELSE FRAME
420 WEND
430 SCREEN CLOSE
440 END
