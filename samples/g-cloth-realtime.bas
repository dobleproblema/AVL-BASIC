100 REM Watch satin cloth fall and drape over a sphere.
105 REM SPACE pauses; N advances one simulation step while paused.
110 REM Drag with the mouse while running; arrow keys orbit; +/- zoom.
115 REM S: shadows; B: sphere motion; W: wind; M: material.
120 REM R restarts the fall; ESC exits.
130 SCREEN : MODE 800 : RAD : PAPER 0 : CLG : MAT BASE 0
140 WID=WIDTH : HEI=HEIGHT : XC=WID*.5 : YC=HEI*.49 : FOC=WID*1.04
145 REM NX and NY count cloth cells; PhysicsHz sets simulation steps per second.
148 REM Uncomment line 154 for a smaller sheet.
149 ClothWidth=4.6 : ClothDepth=3.7
150 NX=24 : NY=16 : PhysicsHz=10
151 IF PhysicsHz<=0 THEN PRINT "PhysicsHz must be positive." : SCREEN CLOSE : END
152 H=1/PhysicsHz : STEPS=3
153 REM STEPS sets the number of physical substeps in each timing batch.
154 REM NX=16 : NY=12 : ClothWidth=3.68 : ClothDepth=2.775
155 XPBDITERS=8 : RELAXITERS=12 : SELFCONTACT=1 : FLOORCONTACT=0
156 REM Self-contact separates nearby cloth particles.
157 SelfSeparation=.95 : SelfNeighborSkip=1 : SelfFinalPasses=2
158 COLLISIONTHICKNESS=.025
159 REM SelfSeparation is a fraction of cell spacing; SelfFinalPasses adds contact sweeps.
160 SPNL=20 : SPNT=14 : SHADOWS=1 : SHPCF=5
162 REM SPNL and SPNT set the number of sphere segments and rings.
165 REM FLOORCONTACT=1 enables an invisible horizontal collider at Y=.035.
170 BX0=0 : BY0=1.45 : BZ0=-.25 : BRAD=.9
180 AZ=.48 : EL=.45 : DIST=7.2 : TARGETY=1.6
190 SCENE=1 : PINMODE=0 : WIND=1 : MATERIAL=0 : BALLMOVE=0
195 SHOWHUD=1 : SETTLESTEPS=0
197 MAXCATCHUP=4 : INTERPOLATE=1 : DEMOSECONDS=0
200 REM BENCHMODE=1 enables timing; BENCHPHASE: 0=both, 1=physics, 2=drawing.
205 BENCHMODE=0 : BENCHPHASE=0 : BENCHFRAMES=5 : BENCHWARMUP=1
210 STATEIN$="" : STATEOUT$="" : FINALPNG$=""
215 REM SETTLESTEPS advances the initial simulation; DEMOSECONDS sets an optional time limit.
220 IF NX<2 OR NY<2 OR NX<>INT(NX) OR NY<>INT(NY) THEN PRINT "Invalid cloth grid." : SCREEN CLOSE : END
221 IF ClothWidth<=0 OR ClothDepth<=0 THEN PRINT "Cloth dimensions must be positive." : SCREEN CLOSE : END
222 IF H<=0 OR STEPS<1 OR STEPS<>INT(STEPS) THEN PRINT "Invalid fixed physical step." : SCREEN CLOSE : END
223 IF SelfSeparation<=0 OR SelfNeighborSkip<1 OR SelfNeighborSkip<>INT(SelfNeighborSkip) OR SelfFinalPasses<0 OR SelfFinalPasses<>INT(SelfFinalPasses) THEN PRINT "Invalid self contact settings." : SCREEN CLOSE : END
224 IF XPBDITERS<1 OR RELAXITERS<1 OR XPBDITERS<>INT(XPBDITERS) OR RELAXITERS<>INT(RELAXITERS) THEN PRINT "Invalid solver sweeps." : SCREEN CLOSE : END
225 IF COLLISIONTHICKNESS<0 THEN PRINT "Invalid collision thickness." : SCREEN CLOSE : END
226 IF SPNL<3 OR SPNT<2 OR SPNL<>INT(SPNL) OR SPNT<>INT(SPNT) THEN PRINT "Invalid sphere tessellation." : SCREEN CLOSE : END
227 IF MAXCATCHUP<1 OR MAXCATCHUP<>INT(MAXCATCHUP) OR DEMOSECONDS<0 THEN PRINT "Invalid realtime clock settings." : SCREEN CLOSE : END
228 IF SETTLESTEPS<0 OR SETTLESTEPS<>INT(SETTLESTEPS) THEN PRINT "Invalid settling steps." : SCREEN CLOSE : END
230 IF BENCHFRAMES<0 OR BENCHFRAMES<>INT(BENCHFRAMES) OR BENCHWARMUP<0 OR BENCHWARMUP<>INT(BENCHWARMUP) OR BENCHPHASE<0 OR BENCHPHASE>2 THEN PRINT "Invalid benchmark settings." : SCREEN CLOSE : END
235 FPSOUT=1/(H*STEPS) : T=0 : FRAMEI=0 : GRAB=-1 : LASTLEFT=0
240 BALLT=0 : BALLBX=BX0 : BALLBY=BY0 : BALLBZ=BZ0 : GOSUB 1000
250 IF STATEIN$<>"" THEN GOSUB 4000
260 GOSUB 5000 : GOSUB 6000
270 IF STATEIN$="" THEN FOR SETTLE=1 TO SETTLESTEPS : T=T+H : GOSUB 2000 : NEXT SETTLE : BALLT=T
275 GOSUB 4800 : RENDERALPHA=1
280 GOSUB 6100 : IF SHOWHUD AND BENCHMODE=0 THEN GOSUB 9000
290 FRAME
300 IF BENCHMODE THEN GOTO 400
310 FROZEN=0 : ONESTEP=0 : DONE=0 : FPS=0 : COUNT=0 : ACCUM=0 : DROPPEDTIME=0 : LIVEFRAMES=0 : PHYSTEPS=0
315 PRINT "CLOTH_LIVE_BEGIN ";T;" ";H;" ";NX;" ";NY
318 LIVESTART=TIME : LASTWALL=LIVESTART : TLAST=LIVESTART
320 TNOW=TIME : WALLDT=MAX(0,TNOW-LASTWALL) : LASTWALL=TNOW : DT=MIN(.1,WALLDT) : GOSUB 9700
325 IF DEMOSECONDS>0 AND TNOW-LIVESTART>=DEMOSECONDS THEN DONE=1
330 IF DONE THEN GOTO 900
335 IF FROZEN THEN ACCUM=0:RENDERALPHA=1:GOTO 350
340 ACCUM=ACCUM+WALLDT : GOSUB 4900 : RENDERALPHA=MAX(0,MIN(1,ACCUM/H)) : GOTO 360
350 IF ONESTEP THEN GOSUB 4700
355 ONESTEP=0
360 GOSUB 6100 : IF SHOWHUD THEN GOSUB 9000
365 FRAME
370 LIVEFRAMES=LIVEFRAMES+1 : COUNT=COUNT+1 : TNOW=TIME : IF TNOW-TLAST>=.5 THEN FPS=COUNT/(TNOW-TLAST):COUNT=0:TLAST=TNOW
380 GOTO 320
400 REM Timings exclude initialization, initial render, final exports and warmup markers.
405 IF BENCHFRAMES=0 THEN GOTO 900
410 FOR BENCHI=1-BENCHWARMUP TO BENCHFRAMES
420 IF BENCHI>0 THEN PRINT "CLOTH_FRAME_BEGIN ";BENCHI;" ";T
430 IF BENCHPHASE=2 THEN GOTO 460
435 IF BENCHI>0 THEN PRINT "CLOTH_PH_BEGIN ";BENCHI;" ";T
440 GOSUB 4600
445 IF BENCHI>0 THEN PRINT "CLOTH_PH_DONE ";BENCHI;" ";T
460 IF BENCHPHASE=1 THEN GOTO 480
465 GOSUB 6100 : FRAME
470 IF BENCHI>0 THEN PRINT "CLOTH_RENDER_DONE ";BENCHI;" ";T
480 IF BENCHI>0 THEN PRINT "CLOTH_FRAME_DONE ";BENCHI;" ";T
490 NEXT BENCHI
900 REM Save the final image and physical checkpoint, if requested.
902 IF BENCHMODE=0 THEN LIVESECONDS=TIME-LIVESTART:PRINT "CLOTH_LIVE_DONE ";LIVEFRAMES;" ";PHYSTEPS;" ";T;" ";LIVESECONDS;" ";DROPPEDTIME
903 IF BENCHMODE=0 THEN PRINT "CLOTH_DRAW_TIME ";DRAWTIME
905 IF BENCHMODE AND BENCHPHASE=1 THEN GOSUB 6100 : FRAME
910 IF FINALPNG$<>"" THEN BSAVE FINALPNG$
920 IF STATEOUT$<>"" THEN GOSUB 4200
930 IF BENCHMODE THEN PRINT "CLOTH_BENCH_DONE ";FRAMEI;" ";T
940 SCREEN CLOSE : END
1000 REM Cloth solver: area masses, XPBD membrane, curvature bending, stretch limits.
1002 REM Inputs: NX,NY,ClothWidth,ClothDepth,H,PINMODE,GRAB,WIND,SCENE,BX0,BY0,BZ0,BRAD; helper names PH*.
1004 PHSTRIDE=NX+1 : N=PHSTRIDE*(NY+1) : PHDX=ClothWidth/NX : PHDY=ClothDepth/NY
1006 IF H=0 THEN H=1/180
1008 PHRHO=0.075 : PHSTRETCH=0.00002 : PHSHEAR=0.00010 : PHBENDRIG=0.00003
1010 PHITERS=XPBDITERS : PHTHICK=COLLISIONTHICKNESS : PHMU=0.28 : PHSELF=SELFCONTACT : PHSELFD=MIN(PHDX,PHDY)*SelfSeparation
1012 PHTIME=0 : PHBPX=BX0 : PHBPY=BY0 : PHBPZ=BZ0
1014 DIM X(N-1),Y(N-1),Z(N-1),OX(N-1),OY(N-1),OZ(N-1),IM(N-1)
1016 DIM NORX(N-1),NORY(N-1),NORZ(N-1),PHMASS(N-1),PHBASEIM(N-1)
1018 DIM PHVX(N-1),PHVY(N-1),PHVZ(N-1),PHFX(N-1),PHFY(N-1),PHFZ(N-1)
1020 DIM PHCN(N-1),PHCT(N-1),PHNX(N-1),PHNY(N-1),PHNZ(N-1)
1022 PHCMAX=6*N : DIM PHEA(PHCMAX-1),PHEB(PHCMAX-1),PHEL(PHCMAX-1),PHEC(PHCMAX-1),PHELAM(PHCMAX-1)
1024 PHBMAX=2*N : DIM PHBA(PHBMAX-1),PHBB(PHBMAX-1),PHBC(PHBMAX-1),PHBG(PHBMAX-1)
1026 DIM PHBLX(PHBMAX-1),PHBLY(PHBMAX-1),PHBLZ(PHBMAX-1)
1028 PHNT=2*NX*NY : DIM PHTA(PHNT-1),PHTB(PHNT-1),PHTC(PHNT-1)
1030 PHHASHN=4099 : DIM PHHEAD(PHHASHN-1),PHNEXT(N-1),PHHX(N-1),PHHY(N-1),PHHZ(N-1)
1032 PHNE=0 : PHNB=0 : PHNTRI=0 : MAT PHMASS=0
1034 DIM PHTLEFT(N-1),PHTRIGHT(N-1)
1040 FOR PHJ=0 TO NY
1042 PHV=PHJ/NY
1044 FOR PHI=0 TO NX
1046 PHU=PHI/NX : PHK=PHJ*PHSTRIDE+PHI
1047 PHTLEFT(PHK)=1.01*SQR((PHI*PHDX)^2+(PHJ*PHDY)^2):PHTRIGHT(PHK)=1.01*SQR(((NX-PHI)*PHDX)^2+(PHJ*PHDY)^2)
1048 X(PHK)=-1.6+3.2*PHU : Y(PHK)=3.9-3.4*PHV
1050 Z(PHK)=0.34*SIN(4*PI*PHU)+1.1*SIN(PI*PHV/2)
1051 IF SCENE=1 THEN X(PHK)=ClothWidth*(PHU-.5):Y(PHK)=3.02+.015*SIN(2*PI*PHU)*SIN(2*PI*PHV):Z(PHK)=ClothDepth*(PHV-.5)-.25
1052 IF PHI<NX THEN PHIA=PHK:PHIB=PHK+1:PHLEN=PHDX:PHCOM=PHSTRETCH:GOSUB 1600
1054 IF PHJ<NY THEN PHIA=PHK:PHIB=PHK+PHSTRIDE:PHLEN=PHDY:PHCOM=PHSTRETCH:GOSUB 1600
1056 IF PHI<NX AND PHJ<NY THEN GOSUB 1500
1058 IF PHI>0 AND PHI<NX THEN PHIA=PHK-1:PHIB=PHK:PHIC=PHK+1:PHG=SQR(PHDX*PHDY)/(PHDX*PHDX):GOSUB 1650
1060 IF PHJ>0 AND PHJ<NY THEN PHIA=PHK-PHSTRIDE:PHIB=PHK:PHIC=PHK+PHSTRIDE:PHG=SQR(PHDX*PHDY)/(PHDY*PHDY):GOSUB 1650
1062 NEXT PHI
1064 NEXT PHJ
1070 FOR PHK=0 TO N-1 : PHBASEIM(PHK)=1/PHMASS(PHK) : NEXT PHK
1072 MAT IM=PHBASEIM : IF PINMODE>=1 THEN IM(0)=0
1074 IF PINMODE=2 THEN IM(NX)=0
1076 IF GRAB>=0 AND GRAB<N THEN IM(GRAB)=0
1078 GOSUB 2800
1080 MAT OX=X : MAT OY=Y : MAT OZ=Z : MAT PHVX=0 : MAT PHVY=0 : MAT PHVZ=0
1082 GOSUB 3000 : RETURN
1500 REM Both cloth diagonals resist shear; triangles face the positive-Z side.
1502 PHLEN=SQR(PHDX*PHDX+PHDY*PHDY) : PHCOM=PHSHEAR
1504 PHIA=PHK : PHIB=PHK+PHSTRIDE+1 : GOSUB 1600
1506 PHIA=PHK+1 : PHIB=PHK+PHSTRIDE : GOSUB 1600
1508 PHIA=PHK : PHIB=PHK+PHSTRIDE+1 : PHIC=PHK+1 : GOSUB 1700
1510 PHIA=PHK : PHIB=PHK+PHSTRIDE : PHIC=PHK+PHSTRIDE+1 : GOSUB 1700
1512 RETURN
1600 PHEA(PHNE)=PHIA : PHEB(PHNE)=PHIB : PHEL(PHNE)=PHLEN : PHEC(PHNE)=PHCOM : PHNE=PHNE+1 : RETURN
1650 PHBA(PHNB)=PHIA : PHBB(PHNB)=PHIB : PHBC(PHNB)=PHIC : PHBG(PHNB)=PHG : PHNB=PHNB+1 : RETURN
1700 PHTA(PHNTRI)=PHIA : PHTB(PHNTRI)=PHIB : PHTC(PHNTRI)=PHIC : PHNTRI=PHNTRI+1
1702 PHDM=PHRHO*PHDX*PHDY/6
1704 PHMASS(PHIA)=PHMASS(PHIA)+PHDM : PHMASS(PHIB)=PHMASS(PHIB)+PHDM : PHMASS(PHIC)=PHMASS(PHIC)+PHDM : RETURN
2000 REM One fixed physical substep, independent of rendering rate.
2002 PHH2=H*H : PHDAMP=EXP(-0.18*H) : PHTIME=PHTIME+H
2004 MAT IM=PHBASEIM
2006 IF PINMODE>=1 THEN IM(0)=0:X(0)=-1.6:Y(0)=3.9:Z(0)=0
2008 IF PINMODE=2 THEN IM(NX)=0:X(NX)=1.6:Y(NX)=3.9:Z(NX)=0
2010 IF GRAB>=0 AND GRAB<N THEN IM(GRAB)=0
2011 GOSUB 2070
2012 PHSDX=BX0-PHBPX : PHSDY=BY0-PHBPY : PHSDZ=BZ0-PHBPZ
2014 MAT OX=X : MAT OY=Y : MAT OZ=Z
2016 MAT PHFX=0 : MAT PHFY=0 : MAT PHFZ=0 : GOSUB 3100
2020 FOR PHK=0 TO N-1
2022 IF IM(PHK)=0 THEN PHVX(PHK)=0:PHVY(PHK)=0:PHVZ(PHK)=0:GOTO 2030
2024 PHVX(PHK)=(PHVX(PHK)+H*IM(PHK)*PHFX(PHK))*PHDAMP
2026 PHVY(PHK)=(PHVY(PHK)+H*(IM(PHK)*PHFY(PHK)-9.81))*PHDAMP
2028 PHVZ(PHK)=(PHVZ(PHK)+H*IM(PHK)*PHFZ(PHK))*PHDAMP
2029 X(PHK)=X(PHK)+H*PHVX(PHK):Y(PHK)=Y(PHK)+H*PHVY(PHK):Z(PHK)=Z(PHK)+H*PHVZ(PHK)
2030 NEXT PHK
2032 MAT PHELAM=0 : MAT PHBLX=0 : MAT PHBLY=0 : MAT PHBLZ=0
2034 MAT PHCN=0 : MAT PHCT=0
2040 FOR PHITER=1 TO PHITERS
2042 GOSUB 2400 : GOSUB 2600
2043 GOSUB 2700 : GOSUB 2730
2044 IF PHSELF AND PHITER>=PHITERS-1 THEN GOSUB 3300
2046 GOSUB 2800
2048 NEXT PHITER
2050 GOSUB 2950 : GOSUB 2800
2051 FOR PHLIMITITER=1 TO RELAXITERS : PHITER=PHLIMITITER : GOSUB 2700 : GOSUB 2730 : GOSUB 2800 : NEXT PHLIMITITER : IF PHSELF THEN FOR PHFINAL=1 TO SelfFinalPasses : GOSUB 3300 : GOSUB 2800 : NEXT PHFINAL
2052 FOR PHK=0 TO N-1
2054 PHVX(PHK)=(X(PHK)-OX(PHK))/H : PHVY(PHK)=(Y(PHK)-OY(PHK))/H : PHVZ(PHK)=(Z(PHK)-OZ(PHK))/H
2056 IF IM(PHK)=0 THEN PHVX(PHK)=0:PHVY(PHK)=0:PHVZ(PHK)=0
2058 NEXT PHK
2060 PHBPX=BX0 : PHBPY=BY0 : PHBPZ=BZ0 : RETURN
2070 REM A held vertex respects the moving sphere and optional invisible floor.
2072 IF GRAB<0 OR GRAB>=N THEN RETURN
2074 PHGEX=X(GRAB)-BX0 : PHGEY=Y(GRAB)-BY0 : PHGEZ=Z(GRAB)-BZ0 : PHGL=SQR(PHGEX^2+PHGEY^2+PHGEZ^2)
2076 IF PHGL<.00000001 THEN PHGEX=0:PHGEY=0:PHGEZ=.00000001:PHGL=.00000001
2078 IF PHGL<BRAD+PHTHICK THEN PHGS=(BRAD+PHTHICK)/PHGL:X(GRAB)=BX0+PHGEX*PHGS:Y(GRAB)=BY0+PHGEY*PHGS:Z(GRAB)=BZ0+PHGEZ*PHGS
2080 IF FLOORCONTACT THEN Y(GRAB)=MAX(.035+PHTHICK,Y(GRAB))
2082 RETURN
2400 REM XPBD distance constraints; reverse sweeps reduce directional bias.
2402 PHSTART=0 : PHSTOP=PHNE-1 : PHSTEP=1
2404 IF PHITER MOD 2=0 THEN PHSTART=PHNE-1:PHSTOP=0:PHSTEP=-1
2406 FOR PHQ=PHSTART TO PHSTOP STEP PHSTEP
2408 PHIA=PHEA(PHQ) : PHIB=PHEB(PHQ) : PHWA=IM(PHIA) : PHWB=IM(PHIB)
2410 IF PHWA+PHWB=0 THEN GOTO 2430
2412 PHEX=X(PHIA)-X(PHIB):PHEY=Y(PHIA)-Y(PHIB):PHEZ=Z(PHIA)-Z(PHIB)
2414 PHLL=SQR(PHEX*PHEX+PHEY*PHEY+PHEZ*PHEZ) : IF PHLL<0.00000001 THEN GOTO 2430
2416 PHAT=PHEC(PHQ)/PHH2 : PHDL=(-(PHLL-PHEL(PHQ))-PHAT*PHELAM(PHQ))/(PHWA+PHWB+PHAT)
2418 PHELAM(PHQ)=PHELAM(PHQ)+PHDL : PHEX=PHEX/PHLL : PHEY=PHEY/PHLL : PHEZ=PHEZ/PHLL
2420 X(PHIA)=X(PHIA)+PHWA*PHDL*PHEX:Y(PHIA)=Y(PHIA)+PHWA*PHDL*PHEY:Z(PHIA)=Z(PHIA)+PHWA*PHDL*PHEZ
2422 X(PHIB)=X(PHIB)-PHWB*PHDL*PHEX:Y(PHIB)=Y(PHIB)-PHWB*PHDL*PHEY:Z(PHIB)=Z(PHIB)-PHWB*PHDL*PHEZ
2430 NEXT PHQ : RETURN
2600 REM Cvec=sqrt(dualarea)/step^2*(xa-2xb+xc); isotropic quadratic bending.
2602 PHAT=1/(PHBENDRIG*PHH2) : PHSTART=0 : PHSTOP=PHNB-1 : PHSTEP=1
2604 IF PHITER MOD 2=0 THEN PHSTART=PHNB-1:PHSTOP=0:PHSTEP=-1
2606 FOR PHQ=PHSTART TO PHSTOP STEP PHSTEP
2608 PHIA=PHBA(PHQ):PHIB=PHBB(PHQ):PHIC=PHBC(PHQ):PHG=PHBG(PHQ)
2610 PHWA=IM(PHIA):PHWB=IM(PHIB):PHWC=IM(PHIC)
2612 PHDEN=PHG*PHG*(PHWA+4*PHWB+PHWC)+PHAT
2614 PHDLX=(-PHG*(X(PHIA)-2*X(PHIB)+X(PHIC))-PHAT*PHBLX(PHQ))/PHDEN
2616 PHDLY=(-PHG*(Y(PHIA)-2*Y(PHIB)+Y(PHIC))-PHAT*PHBLY(PHQ))/PHDEN
2618 PHDLZ=(-PHG*(Z(PHIA)-2*Z(PHIB)+Z(PHIC))-PHAT*PHBLZ(PHQ))/PHDEN
2620 PHBLX(PHQ)=PHBLX(PHQ)+PHDLX:PHBLY(PHQ)=PHBLY(PHQ)+PHDLY:PHBLZ(PHQ)=PHBLZ(PHQ)+PHDLZ
2622 PHWA=PHWA*PHG:PHWB=-2*PHWB*PHG:PHWC=PHWC*PHG
2624 X(PHIA)=X(PHIA)+PHWA*PHDLX:Y(PHIA)=Y(PHIA)+PHWA*PHDLY:Z(PHIA)=Z(PHIA)+PHWA*PHDLZ
2626 X(PHIB)=X(PHIB)+PHWB*PHDLX:Y(PHIB)=Y(PHIB)+PHWB*PHDLY:Z(PHIB)=Z(PHIB)+PHWB*PHDLZ
2628 X(PHIC)=X(PHIC)+PHWC*PHDLX:Y(PHIC)=Y(PHIC)+PHWC*PHDLY:Z(PHIC)=Z(PHIC)+PHWC*PHDLZ
2630 NEXT PHQ : RETURN
2700 REM Long-range unilateral attachment bounds, active only for hanging pins.
2702 IF SCENE<>0 OR PINMODE<1 THEN RETURN
2704 FOR PHK=0 TO N-1
2706 IF IM(PHK)=0 THEN GOTO 2712
2708 PHTANCH=0:PHTMAX=PHTLEFT(PHK):GOSUB 2750
2710 IF PINMODE=2 THEN PHTANCH=NX:PHTMAX=PHTRIGHT(PHK):GOSUB 2750
2712 NEXT PHK:RETURN
2730 REM Hard unilateral one-percent tensile strain bounds, structure and shear.
2731 PHSTART=0:PHSTOP=PHNE-1:PHSTEP=1
2732 IF PHITER MOD 2=0 THEN PHSTART=PHNE-1:PHSTOP=0:PHSTEP=-1
2733 FOR PHQ=PHSTART TO PHSTOP STEP PHSTEP
2734 PHIA=PHEA(PHQ):PHIB=PHEB(PHQ):PHWA=IM(PHIA):PHWB=IM(PHIB):IF PHWA+PHWB=0 THEN GOTO 2748
2735 PHEX=X(PHIA)-X(PHIB):PHEY=Y(PHIA)-Y(PHIB):PHEZ=Z(PHIA)-Z(PHIB):PHTMAX=PHEL(PHQ)*1.01
2736 PHL2=PHEX*PHEX+PHEY*PHEY+PHEZ*PHEZ:IF PHL2<=PHTMAX*PHTMAX THEN GOTO 2748
2737 PHLL=SQR(PHL2):PHCOR=(PHTMAX-PHLL)/((PHWA+PHWB)*PHLL)
2738 X(PHIA)=X(PHIA)+PHWA*PHCOR*PHEX:Y(PHIA)=Y(PHIA)+PHWA*PHCOR*PHEY:Z(PHIA)=Z(PHIA)+PHWA*PHCOR*PHEZ
2740 X(PHIB)=X(PHIB)-PHWB*PHCOR*PHEX:Y(PHIB)=Y(PHIB)-PHWB*PHCOR*PHEY:Z(PHIB)=Z(PHIB)-PHWB*PHCOR*PHEZ
2748 NEXT PHQ : RETURN
2750 PHEX=X(PHK)-X(PHTANCH):PHEY=Y(PHK)-Y(PHTANCH):PHEZ=Z(PHK)-Z(PHTANCH)
2752 PHL2=PHEX*PHEX+PHEY*PHEY+PHEZ*PHEZ:IF PHL2<=PHTMAX*PHTMAX THEN RETURN
2754 PHLL=SQR(PHL2):PHWA=IM(PHK):PHWB=IM(PHTANCH):IF PHWA+PHWB=0 THEN RETURN
2756 PHCOR=(PHTMAX-PHLL)/((PHWA+PHWB)*PHLL)
2758 X(PHK)=X(PHK)+PHWA*PHCOR*PHEX:Y(PHK)=Y(PHK)+PHWA*PHCOR*PHEY:Z(PHK)=Z(PHK)+PHWA*PHCOR*PHEZ
2760 X(PHTANCH)=X(PHTANCH)-PHWB*PHCOR*PHEX:Y(PHTANCH)=Y(PHTANCH)-PHWB*PHCOR*PHEY:Z(PHTANCH)=Z(PHTANCH)-PHWB*PHCOR*PHEZ
2762 RETURN
2800 REM Sphere and optional floor contacts with Coulomb friction.
2802 FOR PHK=0 TO N-1
2804 IF IM(PHK)=0 THEN GOTO 2830
2806 PHEX=X(PHK)-BX0:PHEY=Y(PHK)-BY0:PHEZ=Z(PHK)-BZ0
2808 PHLL=SQR(PHEX*PHEX+PHEY*PHEY+PHEZ*PHEZ)
2810 IF PHLL>=BRAD+PHTHICK THEN GOTO 2824
2812 IF PHLL<0.00000001 THEN PHEX=0:PHEY=0:PHEZ=1:PHLL=1
2814 PHEX=PHEX/PHLL:PHEY=PHEY/PHLL:PHEZ=PHEZ/PHLL
2816 PHCOR=BRAD+PHTHICK-SQR((X(PHK)-BX0)^2+(Y(PHK)-BY0)^2+(Z(PHK)-BZ0)^2)
2818 X(PHK)=BX0+PHEX*(BRAD+PHTHICK):Y(PHK)=BY0+PHEY*(BRAD+PHTHICK):Z(PHK)=BZ0+PHEZ*(BRAD+PHTHICK)
2820 PHCN(PHK)=PHCN(PHK)+PHCOR:PHCT(PHK)=1:PHNX(PHK)=PHEX:PHNY(PHK)=PHEY:PHNZ(PHK)=PHEZ
2824 IF FLOORCONTACT=0 OR Y(PHK)>=0.035+PHTHICK THEN GOTO 2830
2826 PHCN(PHK)=PHCN(PHK)+0.035+PHTHICK-Y(PHK):Y(PHK)=0.035+PHTHICK
2828 PHCT(PHK)=2:PHNX(PHK)=0:PHNY(PHK)=1:PHNZ(PHK)=0
2830 NEXT PHK : RETURN
2950 REM One Coulomb-bounded tangential correction relative to the moving collider.
2952 FOR PHK=0 TO N-1
2954 IF IM(PHK)=0 OR PHCN(PHK)<=0 THEN GOTO 2984
2956 PHEX=X(PHK)-OX(PHK):PHEY=Y(PHK)-OY(PHK):PHEZ=Z(PHK)-OZ(PHK)
2958 IF PHCT(PHK)=1 THEN PHEX=PHEX-PHSDX:PHEY=PHEY-PHSDY:PHEZ=PHEZ-PHSDZ
2960 PHDOT=PHEX*PHNX(PHK)+PHEY*PHNY(PHK)+PHEZ*PHNZ(PHK)
2962 PHEX=PHEX-PHDOT*PHNX(PHK):PHEY=PHEY-PHDOT*PHNY(PHK):PHEZ=PHEZ-PHDOT*PHNZ(PHK)
2964 PHLL=SQR(PHEX*PHEX+PHEY*PHEY+PHEZ*PHEZ):IF PHLL<0.00000001 THEN GOTO 2984
2966 PHCOR=MIN(1,PHMU*PHCN(PHK)/PHLL)
2968 X(PHK)=X(PHK)-PHCOR*PHEX:Y(PHK)=Y(PHK)-PHCOR*PHEY:Z(PHK)=Z(PHK)-PHCOR*PHEZ
2984 NEXT PHK : RETURN
3000 REM Compute area-weighted vertex normals.
3002 MAT NORX=0 : MAT NORY=0 : MAT NORZ=0
3004 FOR PHQ=0 TO PHNTRI-1
3006 PHIA=PHTA(PHQ):PHIB=PHTB(PHQ):PHIC=PHTC(PHQ):GOSUB 3900
3008 NORX(PHIA)=NORX(PHIA)+PHCROSSX:NORY(PHIA)=NORY(PHIA)+PHCROSSY:NORZ(PHIA)=NORZ(PHIA)+PHCROSSZ
3010 NORX(PHIB)=NORX(PHIB)+PHCROSSX:NORY(PHIB)=NORY(PHIB)+PHCROSSY:NORZ(PHIB)=NORZ(PHIB)+PHCROSSZ
3012 NORX(PHIC)=NORX(PHIC)+PHCROSSX:NORY(PHIC)=NORY(PHIC)+PHCROSSY:NORZ(PHIC)=NORZ(PHIC)+PHCROSSZ
3014 NEXT PHQ
3016 FOR PHK=0 TO N-1
3018 PHLL=SQR(NORX(PHK)^2+NORY(PHK)^2+NORZ(PHK)^2)
3020 IF PHLL<0.00000001 THEN NORX(PHK)=0:NORY(PHK)=0:NORZ(PHK)=1:GOTO 3024
3022 NORX(PHK)=NORX(PHK)/PHLL:NORY(PHK)=NORY(PHK)/PHLL:NORZ(PHK)=NORZ(PHK)/PHLL
3024 NEXT PHK : RETURN
3100 REM Two-sided pressure drag and weak tangential skin drag, per triangle.
3102 FOR PHQ=0 TO PHNTRI-1
3104 PHIA=PHTA(PHQ):PHIB=PHTB(PHQ):PHIC=PHTC(PHQ):GOSUB 3900
3106 IF PHCLEN<0.00000001 THEN GOTO 3130
3108 PHNORMX=PHCROSSX/PHCLEN:PHNORMY=PHCROSSY/PHCLEN:PHNORMZ=PHCROSSZ/PHCLEN
3110 PHMIDY=(Y(PHIA)+Y(PHIB)+Y(PHIC))/3
3112 PHUX=0.35*WIND*SIN(PHTIME*0.7+PHMIDY*0.8)-(PHVX(PHIA)+PHVX(PHIB)+PHVX(PHIC))/3
3114 PHUY=0.08*WIND*SIN(PHTIME*0.5)-(PHVY(PHIA)+PHVY(PHIB)+PHVY(PHIC))/3
3116 PHUZ=WIND*(-0.45+0.22*SIN(PHTIME*0.8+PHMIDY*0.6))-(PHVZ(PHIA)+PHVZ(PHIB)+PHVZ(PHIC))/3
3118 PHUN=PHUX*PHNORMX+PHUY*PHNORMY+PHUZ*PHNORMZ : PHUS=SQR(PHUX*PHUX+PHUY*PHUY+PHUZ*PHUZ)
3120 PHP=0.5*1.2*(PHCLEN*0.5)/3 : PHN=1.1*PHUN*ABS(PHUN):PHT=0.015*PHUS
3122 PHFAX=PHP*(PHN*PHNORMX+PHT*(PHUX-PHUN*PHNORMX))
3124 PHFAY=PHP*(PHN*PHNORMY+PHT*(PHUY-PHUN*PHNORMY))
3126 PHFAZ=PHP*(PHN*PHNORMZ+PHT*(PHUZ-PHUN*PHNORMZ))
3127 PHFX(PHIA)=PHFX(PHIA)+PHFAX:PHFY(PHIA)=PHFY(PHIA)+PHFAY:PHFZ(PHIA)=PHFZ(PHIA)+PHFAZ
3128 PHFX(PHIB)=PHFX(PHIB)+PHFAX:PHFY(PHIB)=PHFY(PHIB)+PHFAY:PHFZ(PHIB)=PHFZ(PHIB)+PHFAZ
3129 PHFX(PHIC)=PHFX(PHIC)+PHFAX:PHFY(PHIC)=PHFY(PHIC)+PHFAY:PHFZ(PHIC)=PHFZ(PHIC)+PHFAZ
3130 NEXT PHQ : RETURN
3300 REM Repel nearby cloth particles using a spatial hash.
3302 MAT PHHEAD=-1
3304 FOR PHK=0 TO N-1
3306 PHHX(PHK)=INT(X(PHK)/PHSELFD):PHHY(PHK)=INT(Y(PHK)/PHSELFD):PHHZ(PHK)=INT(Z(PHK)/PHSELFD)
3308 PHHASH=(PHHX(PHK)*92837111+PHHY(PHK)*689287499+PHHZ(PHK)*283923481) MOD PHHASHN
3310 IF PHHASH<0 THEN PHHASH=PHHASH+PHHASHN
3312 PHNEXT(PHK)=PHHEAD(PHHASH):PHHEAD(PHHASH)=PHK
3314 NEXT PHK
3316 FOR PHK=0 TO N-1
3318 PHRI=PHK\PHSTRIDE:PHCI=PHK MOD PHSTRIDE
3320 FOR PHOIZ=-1 TO 1:FOR PHOIY=-1 TO 1:FOR PHOIX=-1 TO 1
3322 PHIX=PHHX(PHK)+PHOIX:PHIY=PHHY(PHK)+PHOIY:PHIZ=PHHZ(PHK)+PHOIZ
3324 PHHASH=(PHIX*92837111+PHIY*689287499+PHIZ*283923481) MOD PHHASHN
3326 IF PHHASH<0 THEN PHHASH=PHHASH+PHHASHN
3328 PHOTHER=PHHEAD(PHHASH)
3330 WHILE PHOTHER>=0
3332 IF PHOTHER<=PHK THEN GOTO 3364
3334 IF PHHX(PHOTHER)<>PHIX OR PHHY(PHOTHER)<>PHIY OR PHHZ(PHOTHER)<>PHIZ THEN GOTO 3364
3336 PHRJ=PHOTHER\PHSTRIDE:PHCJ=PHOTHER MOD PHSTRIDE
3338 IF ABS(PHRI-PHRJ)<=SelfNeighborSkip AND ABS(PHCI-PHCJ)<=SelfNeighborSkip THEN GOTO 3364
3340 PHWA=IM(PHK):PHWB=IM(PHOTHER):IF PHWA+PHWB=0 THEN GOTO 3364
3342 PHEX=X(PHK)-X(PHOTHER):PHEY=Y(PHK)-Y(PHOTHER):PHEZ=Z(PHK)-Z(PHOTHER)
3344 PHL2=PHEX*PHEX+PHEY*PHEY+PHEZ*PHEZ:IF PHL2>=PHSELFD*PHSELFD THEN GOTO 3364
3346 PHLL=SQR(PHL2):IF PHLL<0.00000001 THEN PHEX=0.00000001:PHEY=0:PHEZ=0:PHLL=0.00000001
3348 PHCOR=(PHSELFD-PHLL)/(PHWA+PHWB):PHEX=PHEX/PHLL:PHEY=PHEY/PHLL:PHEZ=PHEZ/PHLL
3350 X(PHK)=X(PHK)+PHWA*PHCOR*PHEX:Y(PHK)=Y(PHK)+PHWA*PHCOR*PHEY:Z(PHK)=Z(PHK)+PHWA*PHCOR*PHEZ
3352 X(PHOTHER)=X(PHOTHER)-PHWB*PHCOR*PHEX:Y(PHOTHER)=Y(PHOTHER)-PHWB*PHCOR*PHEY:Z(PHOTHER)=Z(PHOTHER)-PHWB*PHCOR*PHEZ
3364 PHOTHER=PHNEXT(PHOTHER)
3366 WEND
3368 NEXT PHOIX:NEXT PHOIY:NEXT PHOIZ
3370 NEXT PHK : RETURN
3900 PHAX=X(PHIB)-X(PHIA):PHAY=Y(PHIB)-Y(PHIA):PHAZ=Z(PHIB)-Z(PHIA)
3902 PHBX=X(PHIC)-X(PHIA):PHBY=Y(PHIC)-Y(PHIA):PHBZ=Z(PHIC)-Z(PHIA)
3904 PHCROSSX=PHAY*PHBZ-PHAZ*PHBY:PHCROSSY=PHAZ*PHBX-PHAX*PHBZ:PHCROSSZ=PHAX*PHBY-PHAY*PHBX
3906 PHCLEN=SQR(PHCROSSX*PHCROSSX+PHCROSSY*PHCROSSY+PHCROSSZ*PHCROSSZ):RETURN
4000 REM Load physical checkpoint v1-v4; camera and render quality stay configurable.
4010 OPEN STATEIN$ FOR INPUT AS #1
4020 INPUT #1,STVER,STNX,STNY,STH,STFPS,FRAMEI,T,PHTIME
4030 IF (STVER<>1 AND STVER<>2 AND STVER<>3 AND STVER<>4) OR STNX<>NX OR STNY<>NY OR STH<>H OR STFPS<>FPSOUT THEN CLOSE #1 : PRINT "Saved state configuration mismatch." : SCREEN CLOSE : END
4031 IF STVER<4 AND (ClothWidth<>4.6 OR ClothDepth<>3.7) THEN CLOSE #1 : PRINT "Legacy states require the original cloth dimensions." : SCREEN CLOSE : END
4032 IF STVER<3 AND COLLISIONTHICKNESS<>.008 THEN CLOSE #1 : PRINT "Legacy states require collision thickness .008." : SCREEN CLOSE : END
4033 IF STVER<4 AND (SelfSeparation<>.65 OR SelfNeighborSkip<>2 OR SelfFinalPasses<>0) THEN CLOSE #1 : PRINT "Legacy states require the original self contact settings." : SCREEN CLOSE : END
4035 IF FRAMEI<0 OR FRAMEI<>INT(FRAMEI) OR T<0 OR ABS(T-PHTIME)>1E-9 THEN CLOSE #1 : PRINT "Invalid saved state time or frame." : SCREEN CLOSE : END
4040 INPUT #1,SCENE,PINMODE,WIND,BX0,BY0,BZ0,BRAD,PHBPX,PHBPY,PHBPZ
4050 INPUT #1,STN
4060 IF STN<>N OR SCENE<>1 OR PINMODE<>0 OR BRAD<=0 THEN CLOSE #1 : PRINT "Saved state scene mismatch." : SCREEN CLOSE : END
4062 BALLT=T : BALLBX=BX0 : BALLBY=BY0 : BALLBZ=BZ0
4064 IF STVER=1 THEN GOTO 4072
4065 IF STVER=2 THEN INPUT #1,STITERS,STRELAX,STSELF,STFLOOR,BALLMOVE,BALLT,BALLBX,BALLBY,BALLBZ
4066 IF STVER=3 THEN INPUT #1,STITERS,STRELAX,STSELF,STFLOOR,BALLMOVE,BALLT,BALLBX,BALLBY,BALLBZ,STTHICK
4067 IF STVER=4 THEN INPUT #1,STITERS,STRELAX,STSELF,STFLOOR,BALLMOVE,BALLT,BALLBX,BALLBY,BALLBZ,STTHICK,STWIDTH,STDEPTH,STSEPARATION,STSKIP,STFINAL
4068 IF STITERS<>XPBDITERS OR STRELAX<>RELAXITERS OR STSELF<>SELFCONTACT OR STFLOOR<>FLOORCONTACT THEN CLOSE #1 : PRINT "Saved state solver mismatch." : SCREEN CLOSE : END
4069 IF STVER>=3 AND STTHICK<>COLLISIONTHICKNESS THEN CLOSE #1 : PRINT "Saved state collision thickness mismatch." : SCREEN CLOSE : END
4070 IF STVER=4 AND (STWIDTH<>ClothWidth OR STDEPTH<>ClothDepth) THEN CLOSE #1 : PRINT "Saved state cloth dimensions mismatch." : SCREEN CLOSE : END
4071 IF STVER=4 AND (STSEPARATION<>SelfSeparation OR STSKIP<>SelfNeighborSkip OR STFINAL<>SelfFinalPasses) THEN CLOSE #1 : PRINT "Saved state self contact mismatch." : SCREEN CLOSE : END
4072 FOR STK=0 TO N-1 : INPUT #1,X(STK),Y(STK),Z(STK),PHVX(STK),PHVY(STK),PHVZ(STK) : NEXT STK : CLOSE #1
4080 MAT OX=X : MAT OY=Y : MAT OZ=Z : RETURN
4200 REM Full checkpoint at a substep boundary: topology, clocks, collider history and velocities.
4210 OPEN STATEOUT$ FOR OUTPUT AS #1
4220 WRITE #1,4,NX,NY,H,FPSOUT,FRAMEI,T,PHTIME
4230 WRITE #1,SCENE,PINMODE,WIND,BX0,BY0,BZ0,BRAD,PHBPX,PHBPY,PHBPZ
4240 WRITE #1,N
4242 WRITE #1,XPBDITERS,RELAXITERS,SELFCONTACT,FLOORCONTACT,BALLMOVE,BALLT,BALLBX,BALLBY,BALLBZ,COLLISIONTHICKNESS,ClothWidth,ClothDepth,SelfSeparation,SelfNeighborSkip,SelfFinalPasses
4250 FOR STK=0 TO N-1 : WRITE #1,X(STK),Y(STK),Z(STK),PHVX(STK),PHVY(STK),PHVZ(STK) : NEXT STK : CLOSE #1 : RETURN
4500 REM Smooth analytic collider motion evaluated at the same fixed step as the cloth.
4510 IF BALLMOVE=0 THEN RETURN
4520 BT=T-BALLT : BX0=BALLBX+.65*SIN(BT*.8) : BY0=BALLBY+.2*SIN(BT*.55) : BZ0=BALLBZ+.5*SIN(BT*.7) : RETURN
4600 REM Advance STEPS physical substeps for a timing batch.
4610 FOR SUBSTEP=1 TO STEPS : T=T+H : GOSUB 4500 : GOSUB 2000 : NEXT SUBSTEP
4620 FRAMEI=FRAMEI+1 : RETURN
4700 REM Cache one physical state, then advance exactly one H-second substep.
4710 GOSUB 4800 : T=T+H : GOSUB 4500 : GOSUB 2000
4720 PHYSTEPS=PHYSTEPS+1 : FRAMEI=FRAMEI+1 : RETURN
4800 REM Rendering owns these copies; the solver still owns X/Y/Z and the actual collider.
4810 MAT PREVX=X : MAT PREVY=Y : MAT PREVZ=Z
4820 PREVBX=BX0 : PREVBY=BY0 : PREVBZ=BZ0 : PREVT=T : RETURN
4900 REM Bounded catch-up prevents a slow display from accumulating an endless physics backlog.
4910 CATCHUPS=0
4920 WHILE ACCUM>=H AND CATCHUPS<MAXCATCHUP
4930 GOSUB 4700 : ACCUM=MAX(0,ACCUM-H) : CATCHUPS=CATCHUPS+1
4940 WEND
4950 IF ACCUM<H THEN RETURN
4960 LAGDROP=INT(ACCUM/H)*H : DROPPEDTIME=DROPPEDTIME+LAGDROP : ACCUM=MAX(0,ACCUM-LAGDROP) : RETURN
5000 REM Cloth and one smoothly lit sphere share the perspective depth array.
5005 VMAX=N+(SPNL+1)*(SPNT+1) : TMAX=2*NX*NY+2*SPNL*(SPNT-1)
5010 DIM VX(VMAX-1),VY(VMAX-1),VZ(VMAX-1),VNX(VMAX-1),VNY(VMAX-1),VNZ(VMAX-1),VU(VMAX-1),VV(VMAX-1),VTYPE(VMAX-1)
5020 DIM SX(VMAX-1),SY(VMAX-1),VQ(VMAX-1),VR(VMAX-1),VG(VMAX-1),VB(VMAX-1),VU0(VMAX-1),VV0(VMAX-1),VD0(VMAX-1)
5025 DIM PREVX(N-1),PREVY(N-1),PREVZ(N-1)
5030 DIM IA(TMAX-1),IB(TMAX-1),IC(TMAX-1),ZBUF(WID-1,HEI-1),SBUF(255,255)
5035 DIM DrawFace(TMAX-1),SphereVisible(VMAX-1)
5040 DIM CLPX(4),CLPY(4),CLPZ(4),CLPR(4),CLPG(4),CLPB(4),RTI(2)
5050 VN=N : TN=0 : STRIDE=NX+1
5060 FOR J=0 TO NY : FOR I=0 TO NX : VI=J*STRIDE+I : VTYPE(VI)=0 : VU(VI)=I/NX : VV(VI)=J/NY : NEXT I : NEXT J
5070 FOR J=0 TO NY-1 : FOR I=0 TO NX-1 : VA=J*STRIDE+I : VBB=VA+1 : VC=VA+STRIDE+1 : VE=VA+STRIDE
5080 IA(TN)=VA : IB(TN)=VC : IC(TN)=VBB : TN=TN+1 : IA(TN)=VA : IB(TN)=VE : IC(TN)=VC : TN=TN+1
5090 NEXT I : NEXT J
5100 SPX=BX0 : SPY=BY0 : SPZ=BZ0 : SPRA=BRAD : SPMAT=1 : BALLFIRST=VN : GOSUB 5400 : BALLLAST=VN-1
5220 DIM BALLX(BALLLAST-BALLFIRST),BALLY(BALLLAST-BALLFIRST),BALLZ(BALLLAST-BALLFIRST)
5230 FOR VI=BALLFIRST TO BALLLAST : BI=VI-BALLFIRST : BALLX(BI)=VX(VI)-BX0 : BALLY(BI)=VY(VI)-BY0 : BALLZ(BI)=VZ(VI)-BZ0 : NEXT VI
5240 RETURN
5400 REM Configurable UV sphere, smooth analytic normals, no pole degenerates.
5410 SPBASE=VN
5420 FOR SPJ=0 TO SPNT : SPTH=PI*SPJ/SPNT : SPS=SIN(SPTH) : SPCOS=COS(SPTH)
5430 FOR SPI=0 TO SPNL : SPAN=2*PI*SPI/SPNL : VI=VN : VN=VN+1
5440 VNX(VI)=SPS*COS(SPAN) : VNY(VI)=SPCOS : VNZ(VI)=SPS*SIN(SPAN) : VX(VI)=SPX+SPRA*VNX(VI) : VY(VI)=SPY+SPRA*VNY(VI) : VZ(VI)=SPZ+SPRA*VNZ(VI) : VTYPE(VI)=SPMAT
5450 NEXT SPI : NEXT SPJ
5460 FOR SPJ=0 TO SPNT-1 : FOR SPI=0 TO SPNL-1 : VA=SPBASE+SPJ*(SPNL+1)+SPI : VBB=VA+1 : VC=VA+SPNL+2 : VE=VA+SPNL+1
5465 IF SPJ>0 THEN IA(TN)=VA:IB(TN)=VBB:IC(TN)=VC:TN=TN+1
5470 IF SPJ<SPNT-1 THEN IA(TN)=VA:IB(TN)=VC:IC(TN)=VE:TN=TN+1
5475 NEXT SPI : NEXT SPJ
5480 RETURN
6000 REM Warm key, cool fill and a grazing rim. Shadow space is orthographic.
6010 LX=-.50 : LY=.42 : LZ=.76 : LL=SQR(LX^2+LY^2+LZ^2) : LX=LX/LL : LY=LY/LL : LZ=LZ/LL
6020 LUX=LZ : LUY=0 : LUZ=-LX : LL=SQR(LUX^2+LUZ^2) : LUX=LUX/LL : LUZ=LUZ/LL
6030 LVX=LY*LUZ : LVY=LZ*LUX-LX*LUZ : LVZ=-LY*LUX : SMUL=25
6040 FLX=.8 : FLY=.28 : FLZ=.35 : LL=SQR(FLX^2+FLY^2+FLZ^2) : FLX=FLX/LL : FLY=FLY/LL : FLZ=FLZ/LL
6050 RLX=.2 : RLY=.45 : RLZ=-.87 : LL=SQR(RLX^2+RLY^2+RLZ^2) : RLX=RLX/LL : RLY=RLY/LL : RLZ=RLZ/LL
6060 RETURN
6100 REM Interpolate only render geometry; static BENCHMODE renders the current state exactly.
6105 RA=1 : IF BENCHMODE=0 AND INTERPOLATE THEN RA=MAX(0,MIN(1,RENDERALPHA))
6107 DRAWTIME=T : IF RA<1 THEN DRAWTIME=PREVT+(T-PREVT)*RA
6110 CAMX=DIST*SIN(AZ)*COS(EL) : CAMY=TARGETY+DIST*SIN(EL) : CAMZ=DIST*COS(AZ)*COS(EL)
6120 RIGHTX=COS(AZ) : RIGHTZ=-SIN(AZ) : UPX=-SIN(AZ)*SIN(EL) : UPY=COS(EL) : UPZ=-COS(AZ)*SIN(EL)
6130 BACKX=SIN(AZ)*COS(EL) : BACKY=SIN(EL) : BACKZ=COS(AZ)*COS(EL)
6140 FOR VI=0 TO N-1 : VX(VI)=X(VI) : VY(VI)=Y(VI) : VZ(VI)=Z(VI)
6141 IF RA<1 THEN VX(VI)=PREVX(VI)+(X(VI)-PREVX(VI))*RA:VY(VI)=PREVY(VI)+(Y(VI)-PREVY(VI))*RA:VZ(VI)=PREVZ(VI)+(Z(VI)-PREVZ(VI))*RA
6142 NEXT VI : GOSUB 6300
6145 DRAWBX=BX0 : DRAWBY=BY0 : DRAWBZ=BZ0
6146 IF RA<1 THEN DRAWBX=PREVBX+(BX0-PREVBX)*RA:DRAWBY=PREVBY+(BY0-PREVBY)*RA:DRAWBZ=PREVBZ+(BZ0-PREVBZ)*RA
6147 SphereCull=-( (DRAWBX-CAMX)*BACKX+(DRAWBY-CAMY)*BACKY+(DRAWBZ-CAMZ)*BACKZ)>=BRAD+.15
6150 FOR VI=BALLFIRST TO BALLLAST : BI=VI-BALLFIRST : VX(VI)=DRAWBX+BALLX(BI) : VY(VI)=DRAWBY+BALLY(BI) : VZ(VI)=DRAWBZ+BALLZ(BI) : NEXT VI
6160 FOR VI=0 TO VN-1
6170 IF SHADOWS THEN VU0(VI)=128+SMUL*(VX(VI)*LUX+VY(VI)*LUY+VZ(VI)*LUZ):VV0(VI)=60+SMUL*(VX(VI)*LVX+VY(VI)*LVY+VZ(VI)*LVZ):VD0(VI)=VX(VI)*LX+VY(VI)*LY+VZ(VI)*LZ
6180 DX=VX(VI)-CAMX : DY=VY(VI)-CAMY : DZ=VZ(VI)-CAMZ : CAMDEPTH=-(DX*BACKX+DY*BACKY+DZ*BACKZ) : VQ(VI)=1/MAX(.01,CAMDEPTH)
6190 SX(VI)=XC+(DX*RIGHTX+DZ*RIGHTZ)*FOC*VQ(VI) : SY(VI)=YC+(DX*UPX+DY*UPY+DZ*UPZ)*FOC*VQ(VI) : NEXT VI
6195 IF SHADOWS=0 THEN GOTO 6230
6200 MAT SBUF=-1E30
6210 FOR RT=0 TO TN-1 : VA=IA(RT) : VBB=IB(RT) : VC=IC(RT)
6215 IF VTYPE(VA)=1 THEN IF (VU0(VBB)-VU0(VA))*(VV0(VC)-VV0(VA))-(VV0(VBB)-VV0(VA))*(VU0(VC)-VU0(VA))<=0 THEN GOTO 6225
6220 SSA=VU0(VA) : STA=VV0(VA) : SDA=VD0(VA) : SSB=VU0(VBB) : STB=VV0(VBB) : SDB=VD0(VBB) : SSC=VU0(VC) : STC=VV0(VC) : SDC=VD0(VC) : GOSUB 8000
6225 NEXT RT
6228 REM Only visible sphere faces need lit vertices; the cloth remains two-sided.
6230 MAT DrawFace=1 : MAT SphereVisible=0
6231 IF SphereCull=0 THEN GOTO 6238
6232 FOR RT=2*NX*NY TO TN-1 : VA=IA(RT) : VBB=IB(RT) : VC=IC(RT)
6233 IF (SX(VBB)-SX(VA))*(SY(VC)-SY(VA))-(SY(VBB)-SY(VA))*(SX(VC)-SX(VA))<=0 THEN DrawFace(RT)=0 : GOTO 6236
6234 SphereVisible(VA)=1 : SphereVisible(VBB)=1 : SphereVisible(VC)=1
6236 NEXT RT
6238 FOR VI=0 TO VN-1
6239 IF VI<N OR SphereCull=0 OR SphereVisible(VI) THEN GOSUB 6500
6240 NEXT VI : CLG OFFSCREEN : MAT ZBUF=0
6260 FOR RT=0 TO TN-1 : IF DrawFace(RT)=0 THEN GOTO 6275
6270 VA=IA(RT) : VBB=IB(RT) : VC=IC(RT) : GOSUB 7100
6275 NEXT RT
6280 RETURN
6300 REM Compute area-weighted normals from the interpolated drawing positions.
6310 FOR RNI=0 TO N-1 : VNX(RNI)=0 : VNY(RNI)=0 : VNZ(RNI)=0 : NEXT RNI
6320 FOR RNQ=0 TO PHNTRI-1 : RNA=PHTA(RNQ) : RNB=PHTB(RNQ) : RNC=PHTC(RNQ)
6330 RNAX=VX(RNB)-VX(RNA) : RNAY=VY(RNB)-VY(RNA) : RNAZ=VZ(RNB)-VZ(RNA)
6340 RNBX=VX(RNC)-VX(RNA) : RNBY=VY(RNC)-VY(RNA) : RNBZ=VZ(RNC)-VZ(RNA)
6350 RNCX=RNAY*RNBZ-RNAZ*RNBY : RNCY=RNAZ*RNBX-RNAX*RNBZ : RNCZ=RNAX*RNBY-RNAY*RNBX
6360 VNX(RNA)=VNX(RNA)+RNCX : VNY(RNA)=VNY(RNA)+RNCY : VNZ(RNA)=VNZ(RNA)+RNCZ
6370 VNX(RNB)=VNX(RNB)+RNCX : VNY(RNB)=VNY(RNB)+RNCY : VNZ(RNB)=VNZ(RNB)+RNCZ
6380 VNX(RNC)=VNX(RNC)+RNCX : VNY(RNC)=VNY(RNC)+RNCY : VNZ(RNC)=VNZ(RNC)+RNCZ : NEXT RNQ
6390 FOR RNI=0 TO N-1 : RNLEN=SQR(VNX(RNI)^2+VNY(RNI)^2+VNZ(RNI)^2)
6400 IF RNLEN<.00000001 THEN VNX(RNI)=0:VNY(RNI)=0:VNZ(RNI)=1:GOTO 6420
6410 VNX(RNI)=VNX(RNI)/RNLEN : VNY(RNI)=VNY(RNI)/RNLEN : VNZ(RNI)=VNZ(RNI)/RNLEN
6420 NEXT RNI : RETURN
6500 REM Two-sided satin: anisotropic microfacet highlight, soft sheen and hem.
6510 SNX=VNX(VI) : SNY=VNY(VI) : SNZ=VNZ(VI) : SVX=CAMX-VX(VI) : SVY=CAMY-VY(VI) : SVZ=CAMZ-VZ(VI) : SL=SQR(SVX^2+SVY^2+SVZ^2) : SVX=SVX/SL : SVY=SVY/SL : SVZ=SVZ/SL
6520 SNDV=SNX*SVX+SNY*SVY+SNZ*SVZ : IF SNDV<0 THEN SNX=-SNX:SNY=-SNY:SNZ=-SNZ:SNDV=-SNDV
6530 SNL=MAX(0,SNX*LX+SNY*LY+SNZ*LZ) : SFL=MAX(0,SNX*FLX+SNY*FLY+SNZ*FLZ) : SRL=MAX(0,SNX*RLX+SNY*RLY+SNZ*RLZ)
6535 SVIS=1 : IF SHADOWS=0 THEN GOTO 6550
6540 SS=VU0(VI) : ST=VV0(VI) : SD=VD0(VI) : SHBIAS=.010+.018*(1-SNL) : SHGRADU=0 : SHGRADV=0 : SDEN=SNX*LX+SNY*LY+SNZ*LZ
6542 IF ABS(SDEN)>.10 THEN SHGRADU=-(SNX*LUX+SNY*LUY+SNZ*LUZ)/(SMUL*SDEN):SHGRADV=-(SNX*LVX+SNY*LVY+SNZ*LVZ)/(SMUL*SDEN)
6544 GOSUB 8300 : SVIS=.15+.85*VIS
6550 BASER=.012 : BASEG=.10 : BASEB=.20 : SAX=.15 : SAY=.42
6560 IF MATERIAL=1 THEN BASER=.50:BASEG=.10:BASEB=.035
6570 IF MATERIAL=2 THEN BASER=.70:BASEG=.64:BASEB=.46
6580 IF VTYPE(VI)=0 THEN SEAM=MIN(VU(VI),1-VU(VI),VV(VI),1-VV(VI)):IF SEAM<.018 THEN BASER=.23:BASEG=.14:BASEB=.055
6590 IF VTYPE(VI)=1 THEN BASER=.22:BASEG=.20:BASEB=.18:SAX=.3:SAY=.3
6620 STX=1-SNX*SNX : STY=-SNX*SNY : STZ=-SNX*SNZ : STL=SQR(STX^2+STY^2+STZ^2)
6622 IF VTYPE(VI)<>0 THEN GOTO 6630
6624 SROW=VI\STRIDE : SLEFT=MAX(SROW*STRIDE,VI-1) : SRIGHT=MIN((SROW+1)*STRIDE-1,VI+1)
6626 STX=VX(SRIGHT)-VX(SLEFT) : STY=VY(SRIGHT)-VY(SLEFT) : STZ=VZ(SRIGHT)-VZ(SLEFT) : STD=STX*SNX+STY*SNY+STZ*SNZ : STX=STX-STD*SNX : STY=STY-STD*SNY : STZ=STZ-STD*SNZ : STL=SQR(STX^2+STY^2+STZ^2)
6630 IF STL<.01 THEN STX=0:STY=1-SNY*SNY:STZ=-SNY*SNZ:STL=SQR(STY^2+STZ^2)
6640 STX=STX/MAX(.0001,STL) : STY=STY/MAX(.0001,STL) : STZ=STZ/MAX(.0001,STL) : SBX=SNY*STZ-SNZ*STY : SBY=SNZ*STX-SNX*STZ : SBZ=SNX*STY-SNY*STX
6650 LLX=LX : LLY=LY : LLZ=LZ : GOSUB 8500 : KEYSPEC=SSPEC*SVIS
6660 LLX=FLX : LLY=FLY : LLZ=FLZ : GOSUB 8500 : FILLSPEC=SSPEC
6690 SHEEN=(1-SNDV)^4 * (.3+.7*SRL) : DIFF=.08+.78*SNL*SVIS+.16*SFL
6700 IF VTYPE(VI)<>0 THEN SHEEN=SHEEN*.1
6710 AO=1
6720 IF VTYPE(VI)=0 THEN AO=.68+.32*MIN(1,MAX(0,(SQR((VX(VI)-DRAWBX)^2+(VY(VI)-DRAWBY)^2+(VZ(VI)-DRAWBZ)^2)-BRAD)*7))
6730 LINR=AO*(BASER*DIFF+6.75*KEYSPEC+.9*FILLSPEC+.08*SHEEN) : LING=AO*(BASEG*DIFF+5.6*KEYSPEC+1.6*FILLSPEC+.16*SHEEN) : LINB=AO*(BASEB*DIFF+4.5*KEYSPEC+2.8*FILLSPEC+.23*SHEEN)
6740 VR(VI)=255*(LINR/(1+LINR))^.4545 : VG(VI)=255*(LING/(1+LING))^.4545 : VB(VI)=255*(LINB/(1+LINB))^.4545
6760 RETURN
6800 REM Clip all geometry to a true near plane before perspective rasterization.
6810 RTI(0)=VA : RTI(1)=VBB : RTI(2)=VC : CLCOUNT=0
6820 FOR CLE=0 TO 2 : CLIA=RTI(CLE) : CLIB=RTI((CLE+1) MOD 3)
6830 CLAX=VX(CLIA)-CAMX : CLAY=VY(CLIA)-CAMY : CLAZ=VZ(CLIA)-CAMZ : CLAD=-(CLAX*BACKX+CLAY*BACKY+CLAZ*BACKZ)
6840 CLBX=VX(CLIB)-CAMX : CLBY=VY(CLIB)-CAMY : CLBZ=VZ(CLIB)-CAMZ : CLBD=-(CLBX*BACKX+CLBY*BACKY+CLBZ*BACKZ)
6850 IF CLAD>=.15 THEN CLPX(CLCOUNT)=CLAX:CLPY(CLCOUNT)=CLAY:CLPZ(CLCOUNT)=CLAZ:CLPR(CLCOUNT)=VR(CLIA):CLPG(CLCOUNT)=VG(CLIA):CLPB(CLCOUNT)=VB(CLIA):CLCOUNT=CLCOUNT+1
6860 IF (CLAD>=.15)=(CLBD>=.15) THEN GOTO 6890
6870 CLT=(.15-CLAD)/(CLBD-CLAD) : CLPX(CLCOUNT)=CLAX+(CLBX-CLAX)*CLT : CLPY(CLCOUNT)=CLAY+(CLBY-CLAY)*CLT : CLPZ(CLCOUNT)=CLAZ+(CLBZ-CLAZ)*CLT
6880 CLPR(CLCOUNT)=VR(CLIA)+(VR(CLIB)-VR(CLIA))*CLT : CLPG(CLCOUNT)=VG(CLIA)+(VG(CLIB)-VG(CLIA))*CLT : CLPB(CLCOUNT)=VB(CLIA)+(VB(CLIB)-VB(CLIA))*CLT : CLCOUNT=CLCOUNT+1
6890 NEXT CLE
6900 IF CLCOUNT<3 THEN RETURN
6910 FOR CLI=0 TO CLCOUNT-1 : CLDEP=-(CLPX(CLI)*BACKX+CLPY(CLI)*BACKY+CLPZ(CLI)*BACKZ) : CLQ=1/CLDEP : CLX=XC+(CLPX(CLI)*RIGHTX+CLPZ(CLI)*RIGHTZ)*FOC*CLQ : CLY=YC+(CLPX(CLI)*UPX+CLPY(CLI)*UPY+CLPZ(CLI)*UPZ)*FOC*CLQ
6920 CLPX(CLI)=CLX : CLPY(CLI)=CLY : CLPZ(CLI)=CLQ : NEXT CLI
6930 FOR CLI=1 TO CLCOUNT-2
6940 AX=CLPX(0) : AY=CLPY(0) : AQ=CLPZ(0) : AR=CLPR(0) : AG=CLPG(0) : AB=CLPB(0)
6950 BX=CLPX(CLI) : BY=CLPY(CLI) : BQ=CLPZ(CLI) : BR=CLPR(CLI) : BG=CLPG(CLI) : BB=CLPB(CLI)
6960 CX=CLPX(CLI+1) : CY=CLPY(CLI+1) : CQ=CLPZ(CLI+1) : CR=CLPR(CLI+1) : CG=CLPG(CLI+1) : CB=CLPB(CLI+1) : GOSUB 7000 : NEXT CLI
6970 RETURN
7000 GTRIANGLE ZBUF,AX,AY,AQ,AR,AG,AB,BX,BY,BQ,BR,BG,BB,CX,CY,CQ,CR,CG,CB
7005 RETURN
7100 REM Reuse projected vertices when the whole triangle is in front of the near plane.
7110 IF VQ(VA)>1/.15 OR VQ(VBB)>1/.15 OR VQ(VC)>1/.15 THEN GOSUB 6800 : RETURN
7130 AX=SX(VA) : AY=SY(VA) : AQ=VQ(VA) : AR=VR(VA) : AG=VG(VA) : AB=VB(VA)
7140 BX=SX(VBB) : BY=SY(VBB) : BQ=VQ(VBB) : BR=VR(VBB) : BG=VG(VBB) : BB=VB(VBB)
7150 CX=SX(VC) : CY=SY(VC) : CQ=VQ(VC) : CR=VR(VC) : CG=VG(VC) : CB=VB(VC)
7160 GOSUB 7000 : RETURN
8000 REM Raster a two-sided triangle into SBUF(255,255); larger depth faces light.
8001 REM Inputs SSA,STA,SDA / SSB,STB,SDB / SSC,STC,SDC stay unchanged.
8002 REM Integer texel centres; triangles may extend beyond all four map edges.
8003 REM Caller dimensions SBUF and clears it to -1E30 before the shadow pass.
8005 SHDET=(SSB-SSA)*(STC-STA)-(STB-STA)*(SSC-SSA)
8010 IF ABS(SHDET)<1E-10 THEN RETURN
8015 SHX0=MAX(0,-INT(-MIN(SSA,SSB,SSC))) : SHX1=MIN(255,INT(MAX(SSA,SSB,SSC)))
8020 SHY0=MAX(0,-INT(-MIN(STA,STB,STC))) : SHY1=MIN(255,INT(MAX(STA,STB,STC)))
8025 IF SHX0>SHX1 OR SHY0>SHY1 THEN RETURN
8030 SHINV=1/SHDET
8035 SHAX=(STB-STC)*SHINV : SHAY=(SSC-SSB)*SHINV
8040 SHBX=(STC-STA)*SHINV : SHBY=(SSA-SSC)*SHINV
8045 SHRA=((SSB-SHX0)*(STC-SHY0)-(STB-SHY0)*(SSC-SHX0))*SHINV
8050 SHRB=((SSC-SHX0)*(STA-SHY0)-(STC-SHY0)*(SSA-SHX0))*SHINV
8055 SHDX=SHAX*(SDA-SDC)+SHBX*(SDB-SDC)
8060 SHDY=SHAY*(SDA-SDC)+SHBY*(SDB-SDC)
8065 SHRD=SDC+SHRA*(SDA-SDC)+SHRB*(SDB-SDC)
8070 FOR SHY=SHY0 TO SHY1
8075 SHWA=SHRA : SHWB=SHRB : SHD=SHRD
8080 FOR SHX=SHX0 TO SHX1
8085 IF SHWA<-1E-9 OR SHWB<-1E-9 OR SHWA+SHWB>1.000000001 THEN GOTO 8100
8090 IF SHD>SBUF(SHX,SHY) THEN SBUF(SHX,SHY)=SHD
8100 SHWA=SHWA+SHAX : SHWB=SHWB+SHBX : SHD=SHD+SHDX
8105 NEXT SHX
8110 SHRA=SHRA+SHAY : SHRB=SHRB+SHBY : SHRD=SHRD+SHDY
8115 NEXT SHY
8120 RETURN
8300 REM Filtered shadow query: SS,ST,SD -> VIS in [0,1]; inputs stay unchanged.
8301 REM SHPCF=5 selects 5x5; other values use 3x3. All taps have equal weight.
8302 REM SHBIAS>0 overrides the default 0.025 metre comparison bias.
8303 REM Points outside 0..255 and taps beyond the map are fully illuminated.
8304 REM SHGRADU,SHGRADV are receiver depth gradients (metres/texel), read only.
8305 VIS=1 : IF SS<0 OR SS>255 OR ST<0 OR ST>255 THEN RETURN
8310 SHCX=INT(SS+0.5) : SHCY=INT(ST+0.5)
8315 SHRAD=1 : IF SHPCF=5 THEN SHRAD=2
8320 SHCUT=SD+0.025 : IF SHBIAS>0 THEN SHCUT=SD+SHBIAS
8325 SHLIT=0
8330 FOR SHV=-SHRAD TO SHRAD
8335 SHSY=SHCY+SHV : SHROWCUT=SHCUT+SHGRADV*(SHSY-ST)
8340 FOR SHU=-SHRAD TO SHRAD
8345 SHSX=SHCX+SHU : SHTAPCUT=SHROWCUT+SHGRADU*(SHSX-SS)
8350 IF SHSX<0 OR SHSX>255 OR SHSY<0 OR SHSY>255 THEN SHLIT=SHLIT+1:GOTO 8360
8355 IF SHTAPCUT>=SBUF(SHSX,SHSY) THEN SHLIT=SHLIT+1
8360 NEXT SHU
8365 NEXT SHV
8370 VIS=SHLIT/(2*SHRAD+1)^2
8375 RETURN
8500 REM Anisotropic GGX for one broad studio light; tangent follows the material warp.
8510 SHX=SVX+LLX : SHY=SVY+LLY : SHZ=SVZ+LLZ : SHL=SQR(SHX^2+SHY^2+SHZ^2) : SHX=SHX/SHL : SHY=SHY/SHL : SHZ=SHZ/SHL
8520 SNH=MAX(.001,SNX*SHX+SNY*SHY+SNZ*SHZ) : STH=SHX*STX+SHY*STY+SHZ*STZ : SBH=SHX*SBX+SHY*SBY+SHZ*SBZ : SNLL=MAX(0,SNX*LLX+SNY*LLY+SNZ*LLZ)
8530 SDIST=1/(PI*SAX*SAY*((STH/SAX)^2+(SBH/SAY)^2+SNH^2)^2) : SVH=MAX(.0001,SHX*SVX+SHY*SVY+SHZ*SVZ) : SF=.045+.955*(1-SVH)^5
8540 SGEO=MIN(1,2*SNH*MIN(SNDV,SNLL)/SVH) : SSPEC=MIN(2,SDIST*SF*SGEO/(4*MAX(.06,SNDV))) : RETURN
9000 REM Display controls, mesh size, simulation rate and measured FPS.
9010 SH$="OFF" : IF SHADOWS THEN SH$="ON"
9015 PS$="" : IF FROZEN THEN PS$=" [PAUSED]"
9020 INK RGB(215,220,232) : LOCATE 3,2
9025 GPRINT "FPS: ";INT(FPS+.5);"  PHYS: ";INT(1/H+.5);"HZ  SPACE: PAUSE  N: STEP  S: SHADOWS ";SH$;"  R: RESTART";PS$
9030 RETURN
9500 REM Pick a visible node and drag it in the camera plane at its original hit depth.
9510 ML=ABS(MOUSELEFT) : MX=MOUSEX : MY=MOUSEY
9520 IF ML=0 THEN GRAB=-1:LASTLEFT=0:RETURN
9530 IF LASTLEFT THEN GOTO 9580
9540 LASTLEFT=1 : GBEST=28^2 : GRAB=-1
9550 IF MX<0 OR MX>=WID OR MY<0 OR MY>=HEI THEN RETURN
9560 FOR GI=0 TO N-1 : GD2=(SX(GI)-MX)^2+(SY(GI)-MY)^2 : IF GD2>=GBEST THEN GOTO 9568
9562 GSX=INT(SX(GI)) : GSY=INT(SY(GI)) : IF GSX<0 OR GSX>=WID OR GSY<0 OR GSY>=HEI THEN GOTO 9568
9564 IF ABS(VQ(GI)-ZBUF(GSX,GSY))<.05*VQ(GI)^2+.0005 THEN GRAB=GI:GBEST=GD2
9568 NEXT GI
9570 IF GRAB>=0 THEN GDEP=1/VQ(GRAB)
9580 IF GRAB<0 THEN RETURN
9590 GDX=(MX-XC)*GDEP/FOC : GDY=(MY-YC)*GDEP/FOC : GTX=CAMX-BACKX*GDEP+RIGHTX*GDX+UPX*GDY : GTY=CAMY-BACKY*GDEP+UPY*GDY : GTZ=CAMZ-BACKZ*GDEP+RIGHTZ*GDX+UPZ*GDY
9592 GEX=GTX-X(GRAB) : GEY=GTY-Y(GRAB) : GEZ=GTZ-Z(GRAB) : GL=SQR(GEX^2+GEY^2+GEZ^2) : GS=MIN(1,.12/MAX(.0001,GL)) : X(GRAB)=X(GRAB)+GS*GEX : Y(GRAB)=Y(GRAB)+GS*GEY : Z(GRAB)=Z(GRAB)+GS*GEZ
9594 GEX=X(GRAB)-BX0 : GEY=Y(GRAB)-BY0 : GEZ=Z(GRAB)-BZ0 : GL=SQR(GEX^2+GEY^2+GEZ^2)
9595 IF GL<.00000001 THEN GEX=0:GEY=0:GEZ=.00000001:GL=.00000001
9596 IF GL<BRAD+PHTHICK THEN GS=(BRAD+PHTHICK)/MAX(.0001,GL):X(GRAB)=BX0+GEX*GS:Y(GRAB)=BY0+GEY*GS:Z(GRAB)=BZ0+GEZ*GS
9598 IF FLOORCONTACT THEN Y(GRAB)=MAX(.035+PHTHICK,Y(GRAB))
9600 OX(GRAB)=X(GRAB) : OY(GRAB)=Y(GRAB) : OZ(GRAB)=Z(GRAB) : RETURN
9700 REM Read keyboard controls and handle mouse dragging.
9710 K$=UPPER$(INKEY$) : IF K$=CHR$(27) THEN DONE=1:RETURN
9715 IF K$=" " THEN FROZEN=1-FROZEN:ACCUM=0:WALLDT=0:LASTWALL=TIME:RENDERALPHA=1:GOSUB 4800
9720 IF K$="N" AND FROZEN THEN ONESTEP=1
9730 IF K$="S" THEN SHADOWS=1-SHADOWS
9735 IF K$="M" THEN MATERIAL=(MATERIAL+1) MOD 3
9740 IF K$="W" THEN WIND=1-WIND
9745 IF K$="B" THEN BALLMOVE=1-BALLMOVE:BALLT=T:BALLBX=BX0:BALLBY=BY0:BALLBZ=BZ0
9750 IF K$="+" OR K$="=" THEN DIST=MAX(4.8,DIST-.3)
9755 IF K$="-" THEN DIST=MIN(12,DIST+.3)
9760 IF K$="R" THEN GOSUB 9800 : RETURN
9765 IF KEYDOWN(28) THEN AZ=AZ-.8*DT
9770 IF KEYDOWN(29) THEN AZ=AZ+.8*DT
9775 IF KEYDOWN(30) THEN EL=MIN(.8,EL+.6*DT)
9780 IF KEYDOWN(31) THEN EL=MAX(-.15,EL-.6*DT)
9785 IF FROZEN THEN GRAB=-1:LASTLEFT=0:RETURN
9790 GOSUB 9500 : RETURN
9800 REM Restart the fall from a flat sheet.
9810 T=0 : FRAMEI=0 : FROZEN=0 : ONESTEP=0
9820 BX0=0 : BY0=1.45 : BZ0=-.25 : BALLT=0 : BALLBX=BX0 : BALLBY=BY0 : BALLBZ=BZ0
9830 GRAB=-1 : LASTLEFT=0 : ACCUM=0 : WALLDT=0
9840 GOSUB 1000 : GOSUB 4800 : RENDERALPHA=1
9850 LASTWALL=TIME : COUNT=0 : TLAST=LASTWALL : FPS=0 : RETURN
