100 REM A red and blue mathematical surface illuminated by a rotating light.
110 REM SPACE pauses the light; C toggles the 60 FPS limit; ESC exits.
120 SCREEN : MODE 640 : DEG : PAPER 0 : CLG
130 W=WIDTH : H=HEIGHT : N=50 : NV=(N+1)*(N+1)
140 DEF FNZ(X,Y)=(X^2+3*Y^2)*EXP(1-X^2-Y^2)
150 SCAL=72 : DIST=100 : FOC=SCAL*DIST : ALPHA=235 : BETA=45
160 CA=COS(ALPHA) : SA=SIN(ALPHA) : CB=COS(BETA) : SB=SIN(BETA)
170 DIM D(W-1,H-1),PX(NV-1),PY(NV-1),Q(NV-1),Z0(NV-1)
180 DIM NX0(NV-1),NY0(NV-1),NZ0(NV-1),R0(NV-1),B0(NV-1),R(NV-1),B(NV-1)
190 ZMIN=1E30 : ZMAX=-1E30
200 FOR I=0 TO N : X=-2.5+5*I/N
210 FOR J=0 TO N : Y=-2.5+5*J/N : K=I*(N+1)+J
220 Z=FNZ(X,Y) : Z0(K)=Z : ZMIN=MIN(ZMIN,Z) : ZMAX=MAX(ZMAX,Z)
230 EE=EXP(1-X*X-Y*Y) : ZZ=X*X+3*Y*Y
240 FX=2*X*EE*(1-ZZ) : FY=2*Y*EE*(3-ZZ) : LNG=SQR(FX*FX+FY*FY+1)
250 NX0(K)=-FX/LNG : NY0(K)=-FY/LNG : NZ0(K)=1/LNG
260 DEPTH=DIST+SB*(X*SA+Y*CA)-CB*Z : Q(K)=1/DEPTH
270 PX(K)=W/2+FOC*(X*CA-Y*SA)*Q(K)
280 PY(K)=H/2+FOC*((X*SA+Y*CA)*CB+Z*SB)*Q(K)
290 NEXT J : NEXT I
300 FOR K=0 TO NV-1
310 T=(Z0(K)-ZMIN)/(ZMAX-ZMIN) : R0(K)=255*T : B0(K)=255*(1-T)
320 NEXT K
340 AZ=135 : EL=25 : PAUSED=0 : CAP=1 : FPS=0 : COUNT=0 : TLAST=TIME : TSIM=TIME
350 SMALLFONT TRANSPARENT
400 TNOW=TIME : DT=MIN(TNOW-TSIM,.1) : TSIM=TNOW
410 IF PAUSED=0 THEN AZ=(AZ+45*DT) MOD 360
420 LX=COS(EL)*COS(AZ) : LY=COS(EL)*SIN(AZ) : LZ=SIN(EL)
430 CLG OFFSCREEN : MAT D=0
440 FOR K=0 TO NV-1
450 BR=MIN(1,.15+.9*MAX(0,NX0(K)*LX+NY0(K)*LY+NZ0(K)*LZ))
460 R(K)=R0(K)*BR : B(K)=B0(K)*BR
470 NEXT K
500 FOR I=0 TO N-1 : FOR J=0 TO N-1
510 IA=I*(N+1)+J : IB=IA+N+1 : IC=IB+1 : ID=IA+1
520 GTRIANGLE D,PX(IA),PY(IA),Q(IA),R(IA),0,B(IA),PX(IB),PY(IB),Q(IB),R(IB),0,B(IB),PX(IC),PY(IC),Q(IC),R(IC),0,B(IC)
530 GTRIANGLE D,PX(IA),PY(IA),Q(IA),R(IA),0,B(IA),PX(IC),PY(IC),Q(IC),R(IC),0,B(IC),PX(ID),PY(ID),Q(ID),R(ID),0,B(ID)
540 NEXT J : NEXT I
600 INK RGB(235,240,255) : LOCATE 3,2 : GPRINT "GTRIANGLE - REAL-TIME SURFACE LIGHTING  ";USING "###.0";FPS;" FPS"
610 CP$="OFF" : IF CAP THEN CP$="ON"
620 PS$="" : IF PAUSED THEN PS$="  [PAUSED]"
630 LOCATE 3,28 : GPRINT "SPACE: PAUSE LIGHT  C: CAP ";CP$;"  ESC: EXIT";PS$
640 IF CAP THEN FRAME 60 ELSE FRAME
650 COUNT=COUNT+1 : TNOW=TIME
660 IF TNOW-TLAST>=.5 THEN FPS=COUNT/(TNOW-TLAST) : COUNT=0 : TLAST=TNOW
670 K$=UPPER$(INKEY$)
680 IF K$=CHR$(27) THEN SCREEN CLOSE : END
690 IF K$=" " THEN PAUSED=1-PAUSED
700 IF K$="C" THEN CAP=1-CAP : COUNT=0 : TLAST=TIME
710 GOTO 400

