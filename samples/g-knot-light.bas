100 REM A rotating knot with smooth shading and a mouse-controlled light.
110 REM SPACE pauses rotation; the mouse-controlled light remains active.
115 REM C toggles the 60 FPS limit; ESC exits.
120 SCREEN : MODE 640 : RAD : PAPER RGB(7,10,18) : CLG : MOUSE ON
130 W=WIDTH : H=HEIGHT : FOC=500 : DIST=7.2
140 NR=64 : NS=16 : NV=NR*NS : TAU=8*ATN(1)
150 MAJOR=1.6 : WAVE=.65 : TUBE=.28
160 DIM D(W-1,H-1),CV(NS-1),SV(NS-1)
170 DIM OX(NV-1),OY(NV-1),OZ(NV-1),NX0(NV-1),NY0(NV-1),NZ0(NV-1)
180 DIM PX(NV-1),PY(NV-1),Q(NV-1),R(NV-1),G(NV-1),B(NV-1)
200 REM Generate positions and smooth outward normals once.
210 FOR J=0 TO NS-1 : CV(J)=COS(TAU*J/NS) : SV(J)=SIN(TAU*J/NS) : NEXT J
220 FOR I=0 TO NR-1
230 U=TAU*I/NR : C2=COS(2*U) : S2=SIN(2*U) : C3=COS(3*U) : S3=SIN(3*U)
240 RHO=MAJOR+WAVE*C3 : CX=RHO*C2 : CY=RHO*S2 : CZ=WAVE*S3
250 NU1=C3*C2 : NU2=C3*S2 : NU3=S3
260 LNG=SQR(4*RHO*RHO+9*WAVE*WAVE)
270 BV1=(2*RHO*S3*C2-3*WAVE*S2)/LNG
280 BV2=(2*RHO*S3*S2+3*WAVE*C2)/LNG : BV3=-2*RHO*C3/LNG
290 FOR J=0 TO NS-1
300 K=I*NS+J
310 NX0(K)=CV(J)*NU1+SV(J)*BV1 : NY0(K)=CV(J)*NU2+SV(J)*BV2 : NZ0(K)=CV(J)*NU3+SV(J)*BV3
320 OX(K)=CX+TUBE*NX0(K) : OY(K)=CY+TUBE*NY0(K) : OZ(K)=CZ+TUBE*NZ0(K)
330 NEXT J : NEXT I
350 A1=.7 : A2=.35 : PAUSED=0 : SMALLFONT TRANSPARENT
351 CAP=1 : FPS=0 : COUNT=0 : TLAST=TIME : TSIM=TIME
355 REM Light depth and ambient brightness control local contrast.
360 MX=210 : MY=340 : LZ=-4.0 : AMBIENT=.055
370 ON MOUSE MOVE GOSUB 1000 : ON MOUSE LEFTDRAG GOSUB 1000 : ON MOUSE RIGHTDRAG GOSUB 1000
400 REM Sample the light independently of the rotation pause.
410 SX=MX : SY=MY : LX=(SX-W/2)*LZ/FOC : LY=(SY-H/2)*LZ/FOC
420 TNOW=TIME : DT=MIN(TNOW-TSIM,.15) : TSIM=TNOW
430 IF PAUSED=0 THEN A1=A1+DT*.32 : A2=A2+DT*.43
440 S1=SIN(A1) : C1=COS(A1) : S2=SIN(A2) : C2=COS(A2)
450 CLG OFFSCREEN : MAT D=0
460 FOR K=0 TO NV-1
470 Y=OY(K)*C1-OZ(K)*S1 : Z=OZ(K)*C1+OY(K)*S1
480 X=OX(K)*C2-Z*S2 : Z=Z*C2+OX(K)*S2-DIST
490 PX(K)=X*FOC/Z+W/2 : PY(K)=Y*FOC/Z+H/2 : Q(K)=-1/Z
500 NY=NY0(K)*C1-NZ0(K)*S1 : NZ=NZ0(K)*C1+NY0(K)*S1
510 NX=NX0(K)*C2-NZ*S2 : NZ=NZ*C2+NX0(K)*S2
520 DX=LX-X : DY=LY-Y : DZ=LZ-Z : D2=DX*DX+DY*DY+DZ*DZ
530 DIFF=MAX(0,(NX*DX+NY*DY+NZ*DZ)/SQR(D2))
540 BR=AMBIENT+3.6*DIFF/(1+.55*D2) 'Lambert + faster distance falloff
545 IF BR>.8 THEN BR=.8+.2*(BR-.8)/(.2+BR-.8) 'Keep gradients in bright regions
550 R(K)=245*BR : G(K)=195*BR : B(K)=120*BR
560 NEXT K
600 REM Join adjacent rings and close both seams; draw every triangle.
610 FOR I=0 TO NR-1
620 NI=(I+1) MOD NR
630 FOR J=0 TO NS-1
640 NJ=(J+1) MOD NS
650 IA=I*NS+J : IB=I*NS+NJ : IC=NI*NS+NJ : ID=NI*NS+J
660 GTRIANGLE D,PX(IA),PY(IA),Q(IA),R(IA),G(IA),B(IA),PX(IB),PY(IB),Q(IB),R(IB),G(IB),B(IB),PX(IC),PY(IC),Q(IC),R(IC),G(IC),B(IC)
670 GTRIANGLE D,PX(IC),PY(IC),Q(IC),R(IC),G(IC),B(IC),PX(ID),PY(ID),Q(ID),R(ID),G(ID),B(ID),PX(IA),PY(IA),Q(IA),R(IA),G(IA),B(IA)
680 NEXT J : NEXT I
700 INK RGB(255,232,155) : CIRCLE SX,SY,9 : FCIRCLE SX,SY,3
710 PS$="" : IF PAUSED THEN PS$="  [PAUSED]"
720 INK RGB(235,240,255) : LOCATE 3,2 : GPRINT "GTRIANGLE - KNOT  ";USING "####.0";FPS;" FPS  LIGHT STAYS ACTIVE WHEN PAUSED"
725 CP$="OFF" : IF CAP THEN CP$="ON"
730 LOCATE 3,28 : GPRINT "MOUSE: LIGHT  SPACE: PAUSE  C: CAP ";CP$;"  ESC: EXIT";PS$
740 IF CAP THEN FRAME 60 ELSE FRAME
741 COUNT=COUNT+1 : TNOW=TIME
742 IF TNOW-TLAST>=.5 THEN FPS=COUNT/(TNOW-TLAST) : COUNT=0 : TLAST=TNOW
750 K$=UPPER$(INKEY$)
760 IF K$=CHR$(27) THEN ON MOUSE MOVE GOSUB 0 : ON MOUSE LEFTDRAG GOSUB 0 : ON MOUSE RIGHTDRAG GOSUB 0 : SCREEN CLOSE : END
770 IF K$=" " THEN PAUSED=1-PAUSED
775 IF K$="C" THEN CAP=1-CAP : COUNT=0 : TLAST=TIME
780 GOTO 410
1000 MX=MAX(0,MIN(W-1,MOUSEX)) : MY=MAX(0,MIN(H-1,MOUSEY)) : RETURN
