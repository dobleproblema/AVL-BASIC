100 REM Optional final transparent color, just like SPRITE: 6 is magenta.
110 REM Compare both rows: adding the final 6 makes magenta transparent. ESC exits.
120 SCREEN : MODE 640 : PAPER RGB(12,17,27) : CLG : SMALLFONT TRANSPARENT
130 REM Draw a pale grille on magenta, then capture it as a 32x32 texture.
140 FOR Y=0 TO 31 : FOR X=0 TO 31
150 CC=6 : IF X MOD 8<2 OR Y MOD 8<2 THEN CC=RGB(235,220,180)
160 PLOT X,Y,CC
170 NEXT X : NEXT Y : TEX$=SPRITE$(0,0,31,31)
180 CLG OFFSCREEN
190 REM The same checker background appears behind both rows.
200 FOR Y=64 TO 367 STEP 16 : FOR X=16 TO 623 STEP 16
210 CC=RGB(32,48,65) : IF (X/16+Y/16) MOD 2 THEN CC=RGB(51,71,88)
220 FRECTANGLE X,Y,X+15,Y+15,CC
230 NEXT X : NEXT Y
240 FRECTANGLE 16,192,623,239,RGB(12,17,27)
250 REM Opaque: omit the final color. Explicit UVs repeat the rectangle twice.
260 TRECTANGLE TEX$,24,256,136,352
270 TRECTANGLE TEX$,184,256,296,352,0,0,64,32
280 TTRIANGLE TEX$,344,256,0,0,456,256,32,0,400,352,16,32
290 TQUAD TEX$,504,272,0,0,600,256,32,0,616,336,32,32,520,352,0,32
300 REM Transparent: identical shapes and UVs, 192 pixels lower, with a final 6.
310 TRECTANGLE TEX$,24,64,136,160,6
320 TRECTANGLE TEX$,184,64,296,160,0,0,64,32,6
330 TTRIANGLE TEX$,344,64,0,0,456,64,32,0,400,160,16,32,6
340 TQUAD TEX$,504,80,0,0,600,64,32,0,616,144,32,32,520,160,0,32,6
350 INK RGB(235,240,250) : LOCATE 3,1 : GPRINT "2D TEXTURES: ADD A FINAL TRANSPARENT COLOR"
360 LOCATE 3,2 : GPRINT "ONE TEXTURE / COLOR 6 = MAGENTA / HOLES KEEP THE BACKGROUND"
370 LOCATE 3,4 : GPRINT "TRECTANGLE" : LOCATE 23,4 : GPRINT "TRECTANGLE UV" : LOCATE 43,4 : GPRINT "TTRIANGLE" : LOCATE 63,4 : GPRINT "TQUAD"
380 LOCATE 3,5 : GPRINT "AUTO UV" : LOCATE 23,5 : GPRINT "UV 0..64 / 0..32" : LOCATE 43,5 : GPRINT "3 VERTICES" : LOCATE 63,5 : GPRINT "4 VERTICES"
390 LOCATE 3,6 : GPRINT "OPAQUE: NO FINAL COLOR"
400 LOCATE 3,16 : GPRINT "TRANSPARENT: ADD FINAL COLOR 6"
410 LOCATE 3,27 : GPRINT "FOR PERSPECTIVE AND DEPTH: G-CUBE-TRANSPARENT.BAS"
420 LOCATE 3,28 : GPRINT "ESC: EXIT"
430 FRAME 60
440 IF INKEY$<>CHR$(27) THEN GOTO 430
450 SCREEN CLOSE : END
