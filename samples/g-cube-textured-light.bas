100 REM Perspective-correct textured cube with a nearby point light.
110 REM 1: texture only; 2: light; T: quads/triangles; G: Gouraud fin.
120 REM F: near/broad light; V: vertex percentages; SPACE: rotate/pause.
125 REM M: automatic light; C: FPS cap; ESC: exit. Starts paused.
130 REM No assets: the copper tile is drawn here and captured with SPRITE$.
140 SCREEN : MODE 640 : RAD : PAPER RGB(7,10,18) : CLG : MOUSE ON
150 W=WIDTH : H=HEIGHT : FOC=430 : DIST=4.8 : TW=64 : TH=64
160 DIM D(W-1,H-1)
170 DIM P1(8),P2(8),P3(8),WX(8),WY(8),WZ(8),PX(8),PY(8),Q(8)
180 DIM F(6,4),R(4),G(4),B(4)
185 DIM MARKX(4),MARKY(4),MARKBR(4)
190 FOR I=1 TO 8 : READ P1(I) : NEXT I
200 FOR I=1 TO 8 : READ P2(I) : NEXT I
210 FOR I=1 TO 8 : READ P3(I) : NEXT I
220 FOR I=1 TO 6 : FOR J=1 TO 4 : READ F(I,J) : NEXT J : NEXT I
230 GOSUB 1000
240 A1=.45 : A2=.65 : PAUSED=1 : CAP=1 : LIGHTING=1 : QUADS=1 : FIN=0
250 MX=290 : MY=410 : FOCUSED=1 : VERTICES=1 : AUTOMOVE=0 : SMALLFONT TRANSPARENT
260 FPS=0 : COUNT=0 : FRAMEI=0 : TSTART=TIME : TLAST=TSTART : TSIM=TSTART
270 MAXFRAMES=0 : FIXEDDT=0 : FINALPNG$=""
280 REM Optional repeatable capture: MAXFRAMES=120, FIXEDDT=1/60, FINALPNG$="cube.png".
290 ON MOUSE MOVE GOSUB 4000 : ON MOUSE LEFTDRAG GOSUB 4000 : ON MOUSE RIGHTDRAG GOSUB 4000
300 TNOW=TIME : DT=MIN(TNOW-TSIM,.15) : TSIM=TNOW
310 IF FIXEDDT>0 THEN DT=FIXEDDT
320 IF PAUSED=0 THEN A1=A1+.72*DT : A2=A2+.96*DT
330 LT=TNOW-TSTART : IF FIXEDDT>0 THEN LT=FRAMEI*FIXEDDT
340 IF AUTOMOVE THEN MX=W/2+230*COS(LT*.8) : MY=H/2+170*SIN(LT*.8)
345 LZ=-2 : IF FOCUSED THEN LZ=-3
350 SX=MX : SY=MY : LX=(SX-W/2)*LZ/FOC : LY=(SY-H/2)*LZ/FOC
360 S1=SIN(A1) : C1=COS(A1) : S2=SIN(A2) : C2=COS(A2)
370 CLG OFFSCREEN : MAT D=0 : BESTAREA=0 : INSPECTFACE=0
380 FOR I=1 TO 8
390 Y=P2(I)*C1-P3(I)*S1 : Z=P3(I)*C1+P2(I)*S1
400 X=P1(I)*C2-Z*S2 : Z=Z*C2+P1(I)*S2-DIST
410 WX(I)=X : WY(I)=Y : WZ(I)=Z
420 PX(I)=X*FOC/Z+W/2 : PY(I)=Y*FOC/Z+H/2 : Q(I)=-1/Z
430 NEXT I
440 REM A blue Gouraud triangle passes through the cube's centre plane.
450 REM Draw it first: the shared depth buffer decides which surface is nearer.
460 IF FIN THEN GTRIANGLE D,W/2-2*FOC/DIST,H/2-.65*FOC/DIST,1/DIST,40,170,255,W/2+2*FOC/DIST,H/2-.65*FOC/DIST,1/DIST,25,70,170,W/2,H/2+1.7*FOC/DIST,1/DIST,110,215,255
470 REM One native quad or two triangles per face; no perspective subdivision.
480 REM Draw all faces in their DATA order: there is no sorting or culling.
490 FOR FACE=1 TO 6
500 IA=F(FACE,1) : IB=F(FACE,2) : IC=F(FACE,3) : ID=F(FACE,4)
510 REM For the unit cube, face centre minus cube centre is its unit normal.
520 NX=(WX(IA)+WX(IB)+WX(IC)+WX(ID))/4
530 NY=(WY(IA)+WY(IB)+WY(IC)+WY(ID))/4
540 NZ=(WZ(IA)+WZ(IB)+WZ(IC)+WZ(ID))/4+DIST
545 AREA=ABS((PX(IB)-PX(IA))*(PY(IC)-PY(IA))-(PY(IB)-PY(IA))*(PX(IC)-PX(IA)))+ABS((PX(IC)-PX(IA))*(PY(ID)-PY(IA))-(PY(IC)-PY(IA))*(PX(ID)-PX(IA)))
550 FOR J=1 TO 4
560 IV=F(FACE,J) : DX=LX-WX(IV) : DY=LY-WY(IV) : DZ=LZ-WZ(IV)
570 D2=DX*DX+DY*DY+DZ*DZ
580 DIFF=MAX(0,(NX*DX+NY*DY+NZ*DZ)/SQR(D2))
590 BR=MIN(1,.18+1.7*DIFF/(1+.12*D2))
595 IF FOCUSED THEN BR=MIN(1,.07+2.4*DIFF/(1+1.6*D2))
600 REM Warm light: these are texel multipliers, not replacement surface colors.
610 R(J)=255*BR : G(J)=235*BR : B(J)=205*BR
620 NEXT J
630 GOSUB 2000
635 IF -(NX*NX+NY*NY+NZ*(NZ-DIST))>0 AND AREA>BESTAREA THEN BESTAREA=AREA : INSPECTFACE=FACE : GOSUB 5100
640 NEXT FACE
645 IF VERTICES AND INSPECTFACE>0 THEN GOSUB 5000
650 INK RGB(255,232,155) : CIRCLE SX,SY,9 : FCIRCLE SX,SY,3
660 INK RGB(235,240,255) : LOCATE 3,2 : GPRINT "PERSPECTIVE TEXTURES + SHARED DEPTH  ";USING "####.0";FPS;" FPS"
670 MD$="TEXTURE" : IF LIGHTING THEN MD$="TEXTURE + LIGHT"
680 PR$="TTRIANGLE" : IF QUADS THEN PR$="TQUAD"
685 LN$="BROAD LIGHT" : IF FOCUSED THEN LN$="NEAR POINT LIGHT"
690 LOCATE 3,3 : GPRINT MD$;"  ";PR$;"  ";LN$
695 LOCATE 3,26 : GPRINT "F:NEAR/BROAD  V:VERTEX LIGHT %  FACE ";INSPECTFACE
700 LOCATE 3,27 : GPRINT "1:TEXTURE  2:LIGHT  T:PRIMITIVE  G:FIN  M:AUTO LIGHT"
710 PS$="" : IF PAUSED THEN PS$="  [PAUSED]"
720 CP$="OFF" : IF CAP THEN CP$="ON"
730 LOCATE 3,28 : GPRINT "MOUSE:LIGHT  SPACE:PAUSE  C:CAP ";CP$;"  ESC:EXIT";PS$
740 IF CAP THEN FRAME 60 ELSE FRAME
750 FRAMEI=FRAMEI+1 : COUNT=COUNT+1 : TNOW=TIME
760 IF TNOW-TLAST>=.5 THEN FPS=COUNT/(TNOW-TLAST) : COUNT=0 : TLAST=TNOW
770 IF MAXFRAMES>0 AND FRAMEI>=MAXFRAMES THEN GOTO 900
780 K$=UPPER$(INKEY$)
790 IF K$=CHR$(27) THEN GOTO 900
800 IF K$=" " THEN PAUSED=1-PAUSED
810 IF K$="C" THEN CAP=1-CAP : COUNT=0 : TLAST=TIME
820 IF K$="1" THEN LIGHTING=0
830 IF K$="2" THEN LIGHTING=1
840 IF K$="T" THEN QUADS=1-QUADS
850 IF K$="G" THEN FIN=1-FIN
860 IF K$="M" THEN AUTOMOVE=1-AUTOMOVE
862 IF K$="F" THEN FOCUSED=1-FOCUSED
864 IF K$="V" THEN VERTICES=1-VERTICES
870 GOTO 300
900 IF FINALPNG$<>"" THEN BSAVE FINALPNG$
910 ON MOUSE MOVE GOSUB 0 : ON MOUSE LEFTDRAG GOSUB 0 : ON MOUSE RIGHTDRAG GOSUB 0
920 SCREEN CLOSE : END
1000 REM Copper checker with dark panel seams and small bright rivets.
1010 FOR TY=0 TO 3 : FOR TX=0 TO 3
1020 CC=RGB(208,157,93) : IF (TX+TY) MOD 2 THEN CC=RGB(135,91,54)
1030 FRECTANGLE TX*16,TY*16,TX*16+15,TY*16+15,CC
1040 INK RGB(52,38,30) : DRAW TX*16,TY*16,TX*16+15,TY*16
1050 DRAW TX*16,TY*16,TX*16,TY*16+15
1060 FCIRCLE TX*16+3,TY*16+3,1,RGB(248,223,175)
1070 NEXT TX : NEXT TY
1080 TEX$=SPRITE$(0,0,TW-1,TH-1) : RETURN
2000 REM Per vertex: x,y,q,u,v[,r,g,b]. White is the default multiplier.
2010 IF QUADS=0 THEN GOTO 2100
2020 IF LIGHTING=0 THEN GOTO 2060
2030 TQUAD TEX$,D,PX(IA),PY(IA),Q(IA),0,0,R(1),G(1),B(1),PX(IB),PY(IB),Q(IB),TW,0,R(2),G(2),B(2),PX(IC),PY(IC),Q(IC),TW,TH,R(3),G(3),B(3),PX(ID),PY(ID),Q(ID),0,TH,R(4),G(4),B(4)
2040 RETURN
2060 TQUAD TEX$,D,PX(IA),PY(IA),Q(IA),0,0,PX(IB),PY(IB),Q(IB),TW,0,PX(IC),PY(IC),Q(IC),TW,TH,PX(ID),PY(ID),Q(ID),0,TH
2070 RETURN
2100 IF LIGHTING=0 THEN GOTO 2150
2110 TTRIANGLE TEX$,D,PX(IA),PY(IA),Q(IA),0,0,R(1),G(1),B(1),PX(IB),PY(IB),Q(IB),TW,0,R(2),G(2),B(2),PX(IC),PY(IC),Q(IC),TW,TH,R(3),G(3),B(3)
2120 TTRIANGLE TEX$,D,PX(IA),PY(IA),Q(IA),0,0,R(1),G(1),B(1),PX(IC),PY(IC),Q(IC),TW,TH,R(3),G(3),B(3),PX(ID),PY(ID),Q(ID),0,TH,R(4),G(4),B(4)
2130 RETURN
2150 TTRIANGLE TEX$,D,PX(IA),PY(IA),Q(IA),0,0,PX(IB),PY(IB),Q(IB),TW,0,PX(IC),PY(IC),Q(IC),TW,TH
2160 TTRIANGLE TEX$,D,PX(IA),PY(IA),Q(IA),0,0,PX(IC),PY(IC),Q(IC),TW,TH,PX(ID),PY(ID),Q(ID),0,TH
2170 RETURN
3000 DATA -1,1,1,-1,-1,1,1,-1
3010 DATA 1,1,-1,-1,1,1,-1,-1
3020 DATA 1,1,1,1,-1,-1,-1,-1
3030 DATA 1,2,3,4
3040 DATA 5,6,2,1
3050 DATA 8,7,6,5
3060 DATA 4,3,7,8
3070 DATA 2,6,7,3
3080 DATA 5,1,4,8
4000 MX=MAX(0,MIN(W-1,MOUSEX)) : MY=MAX(0,MIN(H-1,MOUSEY)) : AUTOMOVE=0 : RETURN
5000 REM Inspect the largest visible face: four samples, no extra surface mesh.
5010 FOR J=1 TO 4
5020 INK RGB(125,225,255) : CIRCLE MARKX(J),MARKY(J),4
5030 DX=MARKX(J)-MARKCX : DY=MARKY(J)-MARKCY : DL=SQR(DX*DX+DY*DY)
5040 VTEXT$="V"+STR$(J)+": "+STR$(INT(MARKBR(J)*100+.5))+"%"
5050 AX=MARKX(J)+36*DX/DL : AY=MARKY(J)+36*DY/DL+8
5052 IF AY>H-80 THEN AX=MARKX(J)-12-LEN(VTEXT$)*4
5054 AY=MAX(88,MIN(H-80,AY))
5056 INK RGB(235,240,255) : MOVE AX-LEN(VTEXT$)*4,AY : LABEL VTEXT$
5060 NEXT J : RETURN
5100 MARKCX=0 : MARKCY=0
5110 FOR J=1 TO 4
5120 IV=F(FACE,J) : MARKX(J)=PX(IV) : MARKY(J)=PY(IV) : MARKBR(J)=R(J)/255
5130 IF LIGHTING=0 THEN MARKBR(J)=1
5140 MARKCX=MARKCX+MARKX(J)/4 : MARKCY=MARKCY+MARKY(J)/4
5150 NEXT J : RETURN
