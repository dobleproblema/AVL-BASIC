100 DEF SUB SINEGRAPH(L,R,T,B,BRD,OFS,PW1,PW2)
110   ORIGIN 0,0,L,R,T,B
120   SCALE -PI,PI,-1,1.5,BRD
130   CROSSAT 0,0
140   PENWIDTH PW1 : INK 14
150   XAXIS PI/2,-PI,PI,1,1
160   YAXIS 0.5,-1,1.5,1
170   PENWIDTH PW2 : INK 2
180   GRAPH "SIN(X)"
190   SCALE
200   INK 5 : MOVE L+OFS,T-OFS : LABEL "SIN(X)  [-PI, PI]"
210   PENWIDTH PW2 : INK 8 : RECTANGLE L,B,R,T
220 SUBEND
230 DEF SUB INVGRAPH(L,R,T,B,BRD,OFS,PW1,PW2,XTIC)
240   ORIGIN 0,0,L,R,T,B
250   SCALE -10,2,-10,2,BRD
260   CROSSAT 0,0 : PENWIDTH PW1 : INK 14
270   XAXIS XTIC,-8.5,0,1
280   YAXIS -1,-8.5,0,1
290   CROSSAT 0,2 : XAXIS 0
300   CROSSAT 0,-10 : XAXIS 0
310   CROSSAT 2,0 : YAXIS 0
320   CROSSAT -10,0 : YAXIS 0
330   GRAPHRANGE -8.5,0,-8.5,0
340   PENWIDTH 2 : INK 2 : MASK &X10000001
350   GRAPH "1/X"
360   INK 4 : MASK
370   GRAPHRANGE -2,-0.5,-2,0
380   GRAPH "1/X"
390   SCALE
400   INK 5 : MOVE L+OFS,T-OFS : LABEL "1/X  [-8.5, 0]"
410   PENWIDTH PW2 : INK 8 : RECTANGLE L,B,R,T
420 SUBEND
430 DEF SUB BARCHART(L,R,T,B,BRD,OFS,PW1,PW2)
440   LOCAL A,V
450   ORIGIN 0,0,L,R,T,B
460   SCALE 1960,1990,0,200,BRD
470   RESTORE 1020
480   PENWIDTH PW1 : INK 10
490   FOR A=1964.5 TO 1984.5
500     READ V
510     RECTANGLE A,0,A+1,V
520   NEXT A
530   CROSSAT 1960,0 : INK 14
540   XAXIS 10,,,,,10
550   YAXIS 40,,,,4
560   PENWIDTH PW2 : INK 2 : PLOT 1975,90
570   SCALE
580   INK 5 : MOVE L+OFS,T-OFS : LABEL "DATA  [1965, 1985]"
590   PENWIDTH PW2 : INK 8 : RECTANGLE L,B,R,T
600 SUBEND
610 DEF SUB SIERGRAPH(L,R,T,B,BRD,OFS,PW1,PW2)
620   LOCAL AR,X,Y,Z,D,SP
630   LOCAL FX(20),FY(20),FZ(20),FD(20)
640   ORIGIN 0,0,L,R,T,B
650   AR=(R-L-2*BRD)/(T-B-2*BRD)
660   SCALE 0,AR,0,1,BRD
670   Z=0.9 : X=(AR-Z)/2 : Y=0.1
680   SP=1 : FX(SP)=X : FY(SP)=Y : FZ(SP)=Z : FD(SP)=5
690   PENWIDTH PW1 : INK 11
700   WHILE SP>0
710     X=FX(SP) : Y=FY(SP) : Z=FZ(SP) : D=FD(SP) : SP=SP-1
720     IF D=0 THEN
730       MOVE X,Y : DRAW X+Z,Y : DRAW X+Z/2,Y+SQR(3)*Z/2 : DRAW X,Y
740     ELSE
750       D=D-1 : Z=Z/2
760       SP=SP+1 : FX(SP)=X : FY(SP)=Y : FZ(SP)=Z : FD(SP)=D
770       SP=SP+1 : FX(SP)=X+Z : FY(SP)=Y : FZ(SP)=Z : FD(SP)=D
780       SP=SP+1 : FX(SP)=X+Z/2 : FY(SP)=Y+SQR(3)*Z/2 : FZ(SP)=Z : FD(SP)=D
790     END IF
800   WEND
810   SCALE
820   INK 5 : MOVE L+OFS,T-OFS : LABEL "SIERPINSKI  [LEVEL 5]"
830   PENWIDTH PW2 : INK 8 : RECTANGLE L,B,R,T
840 SUBEND
850 S=MIN(WIDTH/1024,HEIGHT/768)
860 X0=(WIDTH-1024*S)/2 : Y0=(HEIGHT-768*S)/2
870 L1=ROUND(X0+60*S) : R1=ROUND(X0+500*S)
880 L2=ROUND(X0+523*S) : R2=ROUND(X0+963*S)
890 T1=ROUND(Y0+707*S) : B1=ROUND(Y0+407*S)
900 T2=ROUND(Y0+360*S) : B2=ROUND(Y0+60*S)
910 BR1=MAX(1,ROUND(36*S)) : BR2=MAX(1,ROUND(50*S))
920 BR3=MAX(1,ROUND(54*S)) : BR4=MAX(1,ROUND(28*S))
930 OFS=MAX(1,ROUND(12*S))
940 PW1=MAX(1,ROUND(S)) : PW2=MAX(1,ROUND(2*S))
950 XTIC=-MAX(1,ROUND(1/S))
960 SCREEN : CLG : SMALLFONT TRANSPARENT
970 CALL SINEGRAPH(L1,R1,T1,B1,BR1,OFS,PW1,PW2)
980 CALL BARCHART(L2,R2,T1,B1,BR3,OFS,PW1,PW2)
990 CALL SIERGRAPH(L1,R1,T2,B2,BR4,OFS,PW1,PW2)
1000 CALL INVGRAPH(L2,R2,T2,B2,BR2,OFS,PW1,PW2,XTIC)
1010 END
1020 DATA 90,110,180,120,100,90,120,140,120,90
1030 DATA 80,70,95,120,140,180,170,180,40,60,50
