10 CLG : BIGFONT : DEG
20 T$="ROTATING LETTERS AROUND THE CIRCLE - "
30 T1=T2=P1=P2=1 : L=LEN(T$) : A=360/L
40 CLG OFFSCREEN
50 FOR I=1 TO L
60 X=T1+(I-1)*A : MOVE WIDTH\2+SIN(X)*200,HEIGHT\2+COS(X)*200
70 C$=MID$(T$,P1,1)
80 P1=(P1 MOD L)+1
90 LDIR -X : LABEL C$
100 NEXT
110 FOR I=1 TO L
120 X=T2+(I-1)*A : MOVE WIDTH\2+SIN(X)*100,HEIGHT\2+COS(X)*100
130 C$=MID$(T$,P2,1)
140 P2=(P2 MOD L)+1
150 LDIR -X : LABEL C$,1,-1
160 NEXT
170 P1=(P1 MOD L)+1 : P2=(P2 MOD L)+1
175 FRAME 60 : T1=T1+A-1 : T2=T2+A-4
180 GOTO 40
