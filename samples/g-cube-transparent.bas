100 REM A rotating grille cube over a four-corner Gouraud background.
110 REM SPACE: pause; T: transparent/opaque; C: FPS cap; ESC: exit.
120 REM No assets: capture a pale grille on magenta, with a complete outer rim.
130 SCREEN : MODE 640 : RAD : PAPER 0 : CLG : SMALLFONT TRANSPARENT
140 W=WIDTH : H=HEIGHT : FOC=460 : DIST=4.8 : TW=34 : TH=34
150 DIM D(W-1,H-1),X0(8),Y0(8),Z0(8),X3(8),Y3(8),Z3(8),PX(8),PY(8),Q(8)
160 DIM F(6,4),R(4),G(4),B(4)
170 FOR I=1 TO 8 : READ X0(I) : NEXT I
180 FOR I=1 TO 8 : READ Y0(I) : NEXT I
190 FOR I=1 TO 8 : READ Z0(I) : NEXT I
200 FOR I=1 TO 6 : FOR J=1 TO 4 : READ F(I,J) : NEXT J : NEXT I
210 FOR Y=0 TO TH-1 : FOR X=0 TO TW-1
220 CC=6 : IF X MOD 8<2 OR Y MOD 8<2 THEN CC=RGB(235,220,180)
230 PLOT X,Y,CC
240 NEXT X : NEXT Y : TEX$=SPRITE$(0,0,TW-1,TH-1)
250 A=.45 : B=.65 : C=.12 : LT=0 : PAUSED=0 : CUTOUT=1 : CAP=1
260 FPS=0 : COUNT=0 : FRAMEI=0 : TSIM=TIME : TLAST=TSIM
270 MAXFRAMES=0 : FIXEDDT=0 : FINALPNG$=""
280 REM Optional capture: MAXFRAMES=120, FIXEDDT=1/60, FINALPNG$="cube.png".
290 TNOW=TIME : DT=MIN(TNOW-TSIM,.15) : TSIM=TNOW
300 IF FIXEDDT>0 THEN DT=FIXEDDT
310 IF PAUSED=0 THEN A=A+.48*DT : B=B+.67*DT : C=C+.19*DT : LT=LT+DT
320 SA=SIN(A) : CA=COS(A) : SB=SIN(B) : CB=COS(B) : SC=SIN(C) : CC=COS(C)
330 CLG OFFSCREEN : MAT D=0
340 REM Project each vertex once; all faces share q=1/z and the same buffer.
350 FOR I=1 TO 8
360 RY=Y0(I)*CA-Z0(I)*SA : RZ=Z0(I)*CA+Y0(I)*SA
370 RX=X0(I)*CB+RZ*SB : RZ=RZ*CB-X0(I)*SB
380 X3(I)=RX*CC-RY*SC : Y3(I)=RY*CC+RX*SC : Z3(I)=RZ+DIST
390 Q(I)=1/Z3(I) : PX(I)=W/2+X3(I)*FOC*Q(I) : PY(I)=H/2+Y3(I)*FOC*Q(I)
400 NEXT I
410 REM Draw all six sides, including the back faces visible through holes.
420 FOR FACE=1 TO 6
430 IA=F(FACE,1) : IB=F(FACE,2) : IC=F(FACE,3) : ID=F(FACE,4)
440 REM Unit face normal = face centre minus cube centre; a fixed soft light.
450 NX=(X3(IA)+X3(IB)+X3(IC)+X3(ID))/4
460 NY=(Y3(IA)+Y3(IB)+Y3(IC)+Y3(ID))/4
470 NZ=(Z3(IA)+Z3(IB)+Z3(IC)+Z3(ID))/4-DIST
480 BR=.32+.68*MAX(0,-.38*NX+.58*NY-.72*NZ) : CR=255*BR : CG=245*BR : CBM=225*BR
490 IF CUTOUT=0 THEN GOTO 520
500 TQUAD TEX$,D,PX(IA),PY(IA),Q(IA),0,0,CR,CG,CBM,PX(IB),PY(IB),Q(IB),TW,0,CR,CG,CBM,PX(IC),PY(IC),Q(IC),TW,TH,CR,CG,CBM,PX(ID),PY(ID),Q(ID),0,TH,CR,CG,CBM,6
510 GOTO 530
520 TQUAD TEX$,D,PX(IA),PY(IA),Q(IA),0,0,CR,CG,CBM,PX(IB),PY(IB),Q(IB),TW,0,CR,CG,CBM,PX(IC),PY(IC),Q(IC),TW,TH,CR,CG,CBM,PX(ID),PY(ID),Q(ID),0,TH,CR,CG,CBM
530 NEXT FACE
540 REM Four slowly changing corner colors, interpolated by two GTRIANGLEs.
550 FOR I=1 TO 4
560 HUE=LT*.22+(I-1)*PI/2
570 R(I)=35+60*(1+SIN(HUE)) : G(I)=25+55*(1+SIN(HUE+2*PI/3)) : B(I)=40+65*(1+SIN(HUE+4*PI/3))
580 NEXT I
590 REM Far background LAST: a transparent texel must leave depth untouched.
600 GTRIANGLE D,0,0,.05,R(1),G(1),B(1),W,0,.05,R(2),G(2),B(2),W,H,.05,R(3),G(3),B(3)
610 GTRIANGLE D,0,0,.05,R(1),G(1),B(1),W,H,.05,R(3),G(3),B(3),0,H,.05,R(4),G(4),B(4)
620 INK RGB(245,245,255) : LOCATE 3,2 : GPRINT "TRANSPARENT CUBE + GOURAUD BACKGROUND"
630 MD$="TRANSPARENT" : IF CUTOUT=0 THEN MD$="OPAQUE"
640 LOCATE 3,3 : GPRINT MD$;"  ";USING "###.0";FPS;" FPS"
650 LOCATE 3,27 : GPRINT "SIX FACES / ONE SHARED DEPTH BUFFER"
660 PS$="" : IF PAUSED THEN PS$="  [PAUSED]"
670 CP$="ON" : IF CAP=0 THEN CP$="OFF"
680 LOCATE 3,28 : GPRINT "SPACE:PAUSE  T:TRANSPARENCY  C:CAP ";CP$;"  ESC:EXIT";PS$
690 IF CAP THEN FRAME 60 ELSE FRAME
700 FRAMEI=FRAMEI+1 : COUNT=COUNT+1 : TNOW=TIME
710 IF TNOW-TLAST>=.5 THEN FPS=COUNT/(TNOW-TLAST) : COUNT=0 : TLAST=TNOW
720 IF MAXFRAMES>0 AND FRAMEI>=MAXFRAMES THEN GOTO 800
730 K$=UPPER$(INKEY$) : IF K$=CHR$(27) THEN GOTO 800
740 IF K$=" " THEN PAUSED=1-PAUSED
750 IF K$="T" THEN CUTOUT=1-CUTOUT
760 IF K$="C" THEN CAP=1-CAP : COUNT=0 : TLAST=TIME
770 GOTO 290
800 IF FINALPNG$<>"" THEN BSAVE FINALPNG$
810 SCREEN CLOSE : END
1000 DATA -1,1,1,-1,-1,1,1,-1
1010 DATA 1,1,-1,-1,1,1,-1,-1
1020 DATA 1,1,1,1,-1,-1,-1,-1
1030 DATA 1,2,3,4
1040 DATA 5,6,2,1
1050 DATA 8,7,6,5
1060 DATA 4,3,7,8
1070 DATA 2,6,7,3
1080 DATA 5,1,4,8
