1000 REM INTEGER POWERS WITH ARBITRARY PRECISION
1010 DEF SUB MULTIPLY(FACTOR)
1020   LOCAL I,CARRY,VALUE
1030   CARRY=0
1040   FOR I=LASTBLOCK TO 0 STEP -1
1050     VALUE=RESULT(I)*FACTOR+CARRY
1060     CARRY=VALUE\BLOCKBASE
1070     RESULT(I)=VALUE MOD BLOCKBASE
1080   NEXT I
1090 SUBEND
1100 REM **Main program**
1110 POWERBASE=7 : EXPONENT=1000
1120 IF EXPONENT<0 OR EXPONENT<>INT(EXPONENT) THEN PRINT "EXPONENT MUST BE A NON-NEGATIVE INTEGER":END
1130 BLOCKDIGITS=9 : BLOCKBASE=10^BLOCKDIGITS
1140 LASTBLOCK=0
1150 IF ABS(POWERBASE)>1 THEN LASTBLOCK=INT(EXPONENT*LOG(ABS(POWERBASE))/LOG(BLOCKBASE))
1160 DIM RESULT(LASTBLOCK)
1170 RESULT(LASTBLOCK)=1 : T1=TIME
1180 FOR I=1 TO EXPONENT : CALL MULTIPLY(ABS(POWERBASE)) : NEXT
1190 T2=TIME
1200 REM Print
1210 IF POWERBASE<0 AND EXPONENT MOD 2 THEN PRINT "-";
1220 PRINT USING STRING$(BLOCKDIGITS,"#")+" ";RESULT(0);
1230 FORMAT$="0"+STRING$(BLOCKDIGITS-1,"#")+" "
1240 FOR I=1 TO LASTBLOCK
1245   PRINT USING FORMAT$;RESULT(I);
1250   IF I>0 AND I MOD 8 = 7 THEN PRINT
1260 NEXT I
1270 PRINT : PRINT USING "#.###";T2-T1;" SEG."
1280 END
