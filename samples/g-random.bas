10 REM RANDOM WALK
15 MODE 1024 : CLG : SMALLFONT : DEG
20 T=0 : H=HEIGHT : W=WIDTH : X=W\2 : Y=H\2 : SB=5 : BB=20
25 RECTANGLE SB,BB,W-SB,H-SB : PLOT X,Y
30 WHILE X>SB AND X<W-SB AND Y>BB AND Y<H-SB
35   R=10*RND : A=360*RND
40   X=X+R*COS(A) : Y=Y+R*SIN(A) : T=T+1
45   DRAW X,Y : FRAME 60
50 WEND
55 MOVE SB,16 : LABEL "IT TOOK "+STR$(T)+" STEPS TO EXIT."
60 END
