10 REM RANDOM WALK
15 MODE 1024 : CLG : SMALLFONT : DEG
20 RANDOMIZE TIME
25 T=0 : H=HEIGHT : W=WIDTH : X=W\2 : Y=H\2 : SB=5 : BB=20
30 RECTANGLE SB,BB,W-SB,H-SB : PLOT X,Y
35 WHILE X>SB AND X<W-SB AND Y>BB AND Y<H-SB
40   R=10*RND : A=360*RND
45   X=X+R*COS(A) : Y=Y+R*SIN(A) : T=T+1
50   DRAW X,Y : FRAME 60
55 WEND
60 MOVE SB,16 : LABEL "IT TOOK "+STR$(T)+" STEPS TO EXIT."
65 END
