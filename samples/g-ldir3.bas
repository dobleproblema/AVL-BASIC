10 CLG : BIGFONT : DEG
20 T$="ROTATING LETTERS AROUND THE CIRCLE - "
30 T=P=1 : L=LEN(T$) : A=360/L
40 CLG OFFSCREEN
50 FOR I=1 TO L
60 X=T+(I-1)*A : MOVE WIDTH\2+SIN(X)*200,HEIGHT\2+COS(X)*200
70 C$=MID$(T$,P,1)
80 P=(P MOD L)+1
90 LDIR -X : LABEL C$,1,-1
100 NEXT
110 P=(P MOD L)+1 : FRAME 60 : T=T+A-1
120 GOTO 40
