[commands]
RUN "first"
RUN "second"
[output]
FIRST START
FIRST BEFORE
FIRST AFTER
SECOND START
SECOND BEFORE
SECOND AFTER
[input first.bas]
10 PRINT "FIRST START"
20 PRINT "FIRST BEFORE"
30 GOSUB 100
40 PRINT "FIRST AFTER"
50 END
100 MERGE "delete":MERGE "insert":RETURN
[input second.bas]
10 PRINT "SECOND START"
20 PRINT "SECOND BEFORE"
30 MERGE "delete":GOSUB 100
40 PRINT "SECOND AFTER"
50 END
100 MERGE "insert":RETURN
[input delete.bas]
30
[input insert.bas]
25 PRINT "WRONG EARLIER LINE"
