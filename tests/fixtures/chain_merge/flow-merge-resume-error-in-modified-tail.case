[commands]
RUN "deleted"
RUN "replaced"
[output]
 30
DELETED TAIL
DELETED AFTER
 30
REPLACED TAIL
REPLACED AFTER
[input deleted.bas]
10 ON ERROR GOTO 100
30 MERGE "delete":ERROR 15:PRINT "DELETED TAIL"
40 PRINT "DELETED AFTER":END
100 PRINT ERL:RESUME NEXT
[input replaced.bas]
10 ON ERROR GOTO 100
30 MERGE "replace":ERROR 15:PRINT "REPLACED TAIL"
40 PRINT "REPLACED AFTER":END
100 PRINT ERL:RESUME NEXT
[input delete.bas]
30
[input replace.bas]
30 PRINT "WRONG REPLACEMENT"
